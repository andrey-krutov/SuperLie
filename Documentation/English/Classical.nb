Cell[CellGroupData[{

Cell["Algebra \[GothicV]\[GothicA]\[GothicS](4|4) ", "Subsubsection",
 CellTags->{
  "c:43", "i:37", 
   "b:4.3.11"},ExpressionUUID->"f222f0dc-d5e5-4dee-8326-158af8bf12e6"],

Cell[TextData[{
 "This algebra is implemented as a subalgebra in \[GothicV]\[GothicE]\
\[GothicC]\[GothicT](4|4). The subalgebra is singled out by the following \
equations for the vector field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Sum]", 
