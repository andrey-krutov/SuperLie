Cell[CellGroupData[{

Cell["\<\
Lie Superalgebra of divergence-free polynomial vector fields \[GothicS]\
\[GothicV]\[GothicE]\[GothicC]\[GothicT](m|n)\
\>", "Subsection",
 CellTags->{
  "c:24", "i:21", 
   "b:4.3.1"},ExpressionUUID->"a38b27bc-95f5-4939-9d7e-ac206f3438cd"],

Cell[TextData[{
 "Use ",
 StyleBox["VectorLieAlgebra",
  FontFamily->"Courier"],
 " and use the divergence-free elements only:"
}], "Text",
 CellChangeTimes->{{3.45598516215625*^9, 3.455985162640625*^9}},
 CellTags->"b:4.3.1",ExpressionUUID->"828a99c5-84e4-466f-ac78-9ce48fef9308"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Linear", "[", "Tp", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"VectorSpace", "[", 
   RowBox[{"x", ",", 
    RowBox[{"Dim", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], ",", 
    RowBox[{"CoLeft", "\[Rule]", "v"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VectorLieAlgebra", "[", 
   RowBox[{"g", ",", "x"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "3"}], ";", 
  RowBox[{"n", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basis", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"GeneralBasis", "[", 
       RowBox[{
        RowBox[{"GeneralSum", "[", 
         RowBox[{"c", ",", 
          RowBox[{"Basis", "[", 
           RowBox[{"v", ",", "i"}], "]"}], ",", "Div"}], "]"}], ",", "c"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"m", "+", "n"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SubAlgebra", "[", 
   RowBox[{"u", ",", "g", ",", "basis"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.455985215140625*^9, 3.455985329375*^9}, {
  3.45598543734375*^9, 3.45598545203125*^9}, {3.45598552746875*^9, 
  3.45598553778125*^9}},
 CellTags->"b:4.3.1",ExpressionUUID->"1d0fba26-7a78-4df3-b7f4-bbf684c751ac"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Algebra ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[GothicS]\[GothicV]\[GothicE]\[GothicC]\[GothicT]", 
    "\[Prime]"], TraditionalForm]],ExpressionUUID->
  "d72b8358-e12c-4944-9c67-298fbd4792c4"],
 "(1|n)"
}], "Subsection",
 CellChangeTimes->{{3.423736699125675*^9, 3.423736699125675*^9}},
 CellTags->{
  "c:25", "i:22", 
   "b:4.3.2"},ExpressionUUID->"a2cc75e4-5a6c-4976-b0f1-2dd6324aa8ee"],

Cell["<Not implemented yet>", "Text",
 CellChangeTimes->{{3.455985365875*^9, 3.455985385515625*^9}},
