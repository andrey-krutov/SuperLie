      SubscriptBox["v", "k"], ")"}], "-", "2"}]}], TraditionalForm]],
  ExpressionUUID->"407a322d-0a23-4154-9dee-bdaeb089302c"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["x", "i"], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"ee0f703e-e12f-4417-a4b5-575dbbe025ef"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"1.", ".", "r"}]}], TraditionalForm]],ExpressionUUID->
  "165df814-4033-4202-a96a-0ac97d56478b"],
 " and 2 for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "1"}], ")"}], ".."}], "n"}]}], TraditionalForm]],
  ExpressionUUID->"b0072649-9163-40ba-a7f1-1a5d4ed63b45"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["y", "i"], ")"}], "=", 
    RowBox[{"2", "-", 
     RowBox[{"gr", "(", 
      SubscriptBox["x", "i"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "4baeb8f8-6f3f-43b6-b371-06f3908252c6"]
}], "Text",
 CellTags->"b:4.3.7",ExpressionUUID->"02bbfcc8-2e87-4c85-a7ce-1c7713debf75"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "\"Odd\" contact algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicM]", "(", "n", ")"}], TraditionalForm]],ExpressionUUID->
  "7322ee15-4235-4fb9-8d34-0b5dc56d2771"]
}], "Subsection",
 CellTags->{
  "c:36", "i:28", 
   "b:4.3.8"},ExpressionUUID->"05ca23f4-015e-4778-a95c-a139749993fd"],

Cell[TextData[{
 "The function ",
 StyleBox["OKAlgebra",
  FontFamily->"Courier"],
 " defines the Schouten antibracket and the \"odd contact bracket\" on \
polynomials in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["x", "n"]}], ",", " ", 
    SubscriptBox["y", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["y", "n"]}], ",", "\[Tau]", ","}], TraditionalForm]],
  ExpressionUUID->"4fd11d80-9fb3-4f33-a91c-fdd202269c53"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["y", "i"], ")"}], "=", 
    RowBox[{"1", "-", 
     RowBox[{"P", "(", 
      SubscriptBox["x", "i"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "1e391881-280e-4bd3-968c-419ea8b4c788"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "\[Tau]", ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"d981e4d6-14ca-46e9-8cd5-4b310de90364"],
 ":"
}], "Text",
 CellChangeTimes->{{3.421510964618005*^9, 3.4215109689642544`*^9}},
 CellTags->"b:4.3.8",ExpressionUUID->"ec8441d7-4450-4e2c-9332-8457e21a66b1"],

Cell[BoxData[{
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["x",
    FontSlant->"Italic"], ",", "..."}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["x",
    FontSlant->"Italic"], ",", "..."}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["OKAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   RowBox[{
    StyleBox["{",
     FontSlant->"Italic"], 
    RowBox[{
     StyleBox["x",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["y",
      FontSlant->"Italic"], ",", "\[Tau]"}], 
    StyleBox["}",
     FontSlant->"Italic"]}]}], "]"}]}], "Input",
 CellTags->"b:4.3.8",ExpressionUUID->"260bfdf5-af12-4da5-8f73-8bacb694dc34"],

Cell[TextData[{
 "No need to declare ",
 Cell[BoxData[
  FormBox["\[Tau]", TraditionalForm]],ExpressionUUID->
  "69eb9c9f-8fd8-4479-9105-dad236374383"],
 " as an odd 1-dimensional space; this is done by the function ",
 StyleBox["OKAlgebra", "Name"],
 ".\n\nOn the odd contact algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicM]", "(", "n"}], TraditionalForm]],ExpressionUUID->
  "9c17a796-91cf-45ef-95a8-4bba1e8207af"],
 "), the following functions are defined (in addition to the functions in the \
Buttin algebra):"
}], "Text",
 CellChangeTimes->{{3.421511074986707*^9, 3.421511077059688*^9}, {
  3.423736275987232*^9, 3.4237362811646767`*^9}, {3.4237363134310737`*^9, 
  3.423736319129267*^9}, {3.4237363526574783`*^9, 3.4237363636733184`*^9}},
 CellTags->"b:4.3.8",ExpressionUUID->"1702e0c7-5659-4242-86fc-98727ddda2c2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Ob", "[", 
     RowBox[{"f", ",", "g"}], "]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], 
      RowBox[{"O", ".", "b", "."}]], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "b"], "[", "f", "]"}], 
       FractionBox[
        RowBox[{"\[PartialD]", "g"}], 
        RowBox[{"\[PartialD]", "t"}]]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"P", "(", "f", ")"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "f"}], 
        RowBox[{"\[PartialD]", "t"}]], 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "b"], "[", "g", "]"}]}], "-", 
      SubscriptBox[
       RowBox[{"{", 
        RowBox[{"f", ",", "g"}], "}"}], 
       RowBox[{"B", ".", "b", "."}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "136a806f-12a6-47d7-bcfa-4c38722022d7"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "g"], "=", 
    RowBox[{"2", "-", 
     SubscriptBox[
      StyleBox["EulerOp", "Name"], "g"]}]}], TraditionalForm]],ExpressionUUID->
  "115fbc28-5467-41bc-a657-5b7bf8ed12cc"],
 ", is the odd contact bracket;\n\nob[x,y] is the unevaluated expression of \
the odd contact bracket;\n"
}], "Text",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.4355955429622416`*^9, 3.4355955482097874`*^9}},
 CellTags->"b:4.3.8",ExpressionUUID->"66080aaf-3221-4a79-8bbd-9e95aa09bfe0"],

Cell[TextData[{
 "The names of the ",
 "functions ",
 "may be changed using options, e.g., ",
 StyleBox["OKAlgebra",
  FontFamily->"Courier"],
 "[..., Ob\[Rule]Ok].\n\nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Variables",
     FontFamily->"Courier"], "->", 
    RowBox[{"{", 
     RowBox[{"v", ",", "..."}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "e0a17685-13c9-4802-9979-9ce34b83c2f7"],
 " extends the domain of the algebra to polynomials in ",
 StyleBox["v ",
  FontSlant->"Italic"],
 "(the bracket does not depend on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "333d0f8a-cb28-41db-8e1f-f07053a3ca32"],
 ")."
}], "Text",
 CellChangeTimes->{{3.421511053866338*^9, 3.4215110578120112`*^9}},
 CellTags->"b:4.3.8",ExpressionUUID->"1430ca66-21a2-4226-a27f-265e61554e71"],

Cell[TextData[{
 StyleBox["Gradings",
  FontWeight->"Bold"],
