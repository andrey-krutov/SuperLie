Cell["It is implemented as a subalgebra in \[GothicV]\[GothicE]\[GothicC]\
\[GothicT](4|4) with basis", "Text",
 CellTags->"b:4.1.3",ExpressionUUID->"11ccc152-3973-45a7-b2d3-512f27e3f437"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", 
     RowBox[{"i", ",", "j"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "j"]}]]}], "-", 
     RowBox[{
      SubscriptBox["\[Xi]", "j"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Xi]", "i"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "7bb9acd8-9aa5-472a-ba12-3b06a4ee11b2"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]],ExpressionUUID->
  "30f2c381-676d-42c9-b8f3-edb5285df49c"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], "=", 
    RowBox[{
     SubscriptBox["a", 
      RowBox[{"i", ",", "i"}]], "-", 
     SubscriptBox["a", 
      RowBox[{
       RowBox[{"i", "+", "1"}], ",", 
       RowBox[{"i", "+", "1"}]}]]}]}], TraditionalForm]],ExpressionUUID->
  "31193f0b-1074-4267-802b-214419ccd00f"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["b", 
     RowBox[{"i", ",", "j"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Xi]", "j"]}]]}], "+", 
     RowBox[{
      SubscriptBox["x", "j"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Xi]", "i"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "ab5609f1-4aa4-4f29-a1f4-cfd12eb2a16c"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"i", ",", "j"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Xi]", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "j"]}]]}], "-", 
     RowBox[{
      SubscriptBox["\[Xi]", "j"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "i"]}]]}], "-", 
     RowBox[{"\[Lambda]", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "k"], 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["\[Xi]", "l"]}]]}], "-", 
       RowBox[{
        SubscriptBox["x", "l"], 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["\[Xi]", "k"]}]]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"b1fd445d-264b-4aed-932c-d9aa24690f95"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"i", ",", "j", ",", "k", ",", "l"}], ")"}], "\[Element]", 
    SubscriptBox["A", "4"]}], TraditionalForm]],ExpressionUUID->
  "743675e0-1b15-471a-877b-d90d365a9811"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     RowBox[{"\[Lambda]", 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"i", "=", "1"}], "4"], 
       RowBox[{
        SubscriptBox["x", "i"], 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", 
          SubscriptBox["x", "i"]}]]}]}]}], "+", 
     RowBox[{
      SubscriptBox["\[Xi]", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "i"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "c74ed51a-f213-4e3b-b36b-8f3d9d9f6ed4"]
}], "Text",
 CellTags->"b:4.1.3",ExpressionUUID->"f526eedb-f126-4017-bb4e-95b71142bb1f"],

