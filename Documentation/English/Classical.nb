  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   StyleBox["x",
    FontSlant->"Italic"]}], "]"}]}], "Input",
 CellTags->"b:4.3.4",ExpressionUUID->"dd02cf70-f3ba-4fc7-a39f-5ae8e50d763e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[GothicP]\[GothicO](x;c)", "Subsubsection",
 CellTags->{
  "c:32", "b:4.3.4"},ExpressionUUID->"fa0ca833-d0cf-4e48-8553-0a68bdd36948"],

Cell[TextData[{
 "The Poisson bracket in the general form \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "[", "f", "]"}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "m"], 
      RowBox[{
       SubscriptBox["c", "k"], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "f"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["x", 
          SubscriptBox["i", "k"]]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "g"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["x", 
          SubscriptBox["j", "k"]]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"2eeed0be-070c-4a35-bfe9-e2d211c1cc30"],
 ". \n\n",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " does not verify that this bracket does define a Lie (super)algebra."
}], "Text",
 CellChangeTimes->{{3.421510721969093*^9, 3.4215107307917795`*^9}, {
  3.4237359335448236`*^9, 3.4237359789200706`*^9}},
 CellTags->"b:4.3.4",ExpressionUUID->"4529d80e-8d25-4723-b913-844328c80cf2"],

Cell[BoxData[{
 RowBox[{"VecorSpace", "[", 
  RowBox[{"x", ",", 
   RowBox[{"Dim", "\[Rule]", "..."}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["PoissonAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", "x", ",", " ", 
   FormBox[
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["c", "1"], ",", 
        SubscriptBox["i", "1"], ",", 
        SubscriptBox["j", "1"]}], "}"}], ",", "...", ",", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["c", "m"], ",", 
        SubscriptBox["i", "m"], ",", 
        SubscriptBox["j", "m"]}], "}"}]}], "}"}],
    TraditionalForm]}], "]"}]}], "Input",
 CellTags->"b:4.3.4",ExpressionUUID->"f0a8842e-b83e-49b0-a6db-0e47dd785d31"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hamilton algebra \[GothicH](2n|m)", "Subsection",
 CellTags->{
  "c:33", "i:25", 
   "b:4.3.5"},ExpressionUUID->"e343e3f1-9f31-453a-86b8-6eed899b13e3"],

Cell[TextData[{
 "Algebra \[GothicH](2n|m) is implemented as the quotient \
\[GothicP]\[GothicO](2n|m)",
 StyleBox["/", "Program"],
 "\[LeftAngleBracket]center\[RightAngleBracket];"
}], "Text",
 CellChangeTimes->{{3.421510757440098*^9, 3.421510758481595*^9}},
 CellTags->"b:4.3.5",ExpressionUUID->"b54e2209-7d4b-46e2-8e7d-189dd605fba6"],

Cell[TextData[{
 StyleBox["Gradings",
  FontWeight->"Bold"],
 " ",
 StyleBox["r",
  FontSlant->"Italic"],
 "=0,...,",
 StyleBox["m",
  FontSlant->"Italic"],
 "/2:"
}], "Text",
 CellChangeTimes->{{3.4237366552425747`*^9, 3.4237366641854334`*^9}},
 CellTags->"b:4.3.5",ExpressionUUID->"4b5b9f70-8496-4da9-b52f-5606a41b8703"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Grade", "(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["v", "1"], 
        SubscriptBox["v", "2"]}], "..."}], 
      SubscriptBox["v", "k"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gr", "(", 
        SubscriptBox["v", "1"], ")"}], "+", 
       RowBox[{"gr", "(", 
        SubscriptBox["v", "2"], ")"}], "+"}], "..."}], "+", 
     RowBox[{"gr", "(", 
      SubscriptBox["v", "k"], ")"}], "-", "2"}]}], TraditionalForm]],
  ExpressionUUID->"dd5343e8-a2ca-4225-8f86-dfd1dfe4bbd7"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["p", "i"], ")"}], "=", 
    RowBox[{
     RowBox[{"gr", "(", 
      SubscriptBox["q", "i"], ")"}], "=", 
     RowBox[{
      RowBox[{"gr", "(", 
       SubscriptBox["\[Theta]", "j"], ")"}], "=", "1"}]}]}], 
   TraditionalForm]],ExpressionUUID->"2cb9dd18-8195-43e2-8140-c524ab713f67"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["\[Zeta]", "i"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"41ee7989-5f25-46d0-a088-6c76c4acfc5c"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"1.", ".", "r"}]}], TraditionalForm]],ExpressionUUID->
  "eb05cde9-8c04-4b15-9c8d-029f07c2f294"],
 " and 1 for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "1"}], ")"}], ".."}], "n"}]}], TraditionalForm]],
  ExpressionUUID->"66b0b22f-e231-494e-ba60-bd124d80eb74"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["\[Eta]", "i"], ")"}], "=", 
    RowBox[{"2", "-", 
     RowBox[{"gr", "(", 
      SubscriptBox["\[Zeta]", "i"], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"1daa5f9c-ec59-477c-b178-7aed04b2574d"]
}], "Text",
 CellTags->"b:4.3.5",ExpressionUUID->"72179efe-c809-476b-b8de-e4f657605e09"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Contact algebra \[GothicK](2m+1|n)", "Subsection",
 CellTags->{
  "c:34", "i:26", 
   "b:4.3.6"},ExpressionUUID->"63ea528f-35f5-4edc-8a64-a0ebda9d13f7"],

Cell["\<\
The contact bracket is defined with the help of the Poisson bracket. All \
forms of the Poisson bracket described above, except \
\[GothicP]\[GothicO](x;c), are supported.
Here we show only the version \[GothicP]\[GothicO]({p,q}):\
\>", "Text",
 CellTags->"b:4.3.6",ExpressionUUID->"cf4983b0-06be-48dd-bab0-ce68d783472b"],

Cell[BoxData[{
 RowBox[{"dim", "=", " ", "..."}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["p",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["q",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["ContactAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   StyleBox[
    RowBox[{"{", 
     RowBox[{"p", ",", "q"}], "}"}],
    FontSlant->"Italic"], ",", 
   StyleBox["t",
    FontSlant->"Italic"]}], "]"}]}], "Input",
 CellTags->"b:4.3.6",ExpressionUUID->"3474ef07-d6f2-46a3-a58f-2c52434a31b6"],

Cell[TextData[{
 "No need to declare ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "30f5faa6-64a4-4f7d-a4e6-0a6213b25369"],
 " as a 1-dimensional space; this is done by the function ",
 StyleBox["ContactAlgebra",
  FontFamily->"Courier"],
 ".\n\nIn a contact algebra ",
 StyleBox["g",
  FontSlant->"Italic"],
 ", the following functions are defined (in addition to ",
 StyleBox["PoissonAlgebra",
  FontFamily->"Courier"],
 " functions):"
}], "Text",
 CellChangeTimes->{{3.423736060076768*^9, 3.423736068859397*^9}},
 CellTags->"b:4.3.6",ExpressionUUID->"fdfdbc08-15e6-402c-b737-9a2c72548f06"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Kb",
      FontFamily->"Courier"], "[", 
     RowBox[{"x", ",", "y"}], "]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], 
      RowBox[{"K", ".", "b", "."}]], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "g"], "[", "x", "]"}], 
       FractionBox[
        RowBox[{"\[PartialD]", "y"}], 
        RowBox[{"\[PartialD]", "t"}]]}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "x"}], 
        RowBox[{"\[PartialD]", "t"}]], 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "g"], "[", "y", "]"}]}], "+", 
      SubscriptBox[
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], 
       RowBox[{"P", ".", "b", "."}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "7ed5e905-c5e0-4ba0-b0c0-be553f764dfa"],
 " is the contact bracket, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "g"], "=", 
    RowBox[{"2", "-", 
     SubscriptBox[
      StyleBox["EulerOp", "Name"], "g"]}]}], TraditionalForm]],ExpressionUUID->
  "4b3a96e8-a226-4174-8f1b-5193a20e0c09"],
 ";\n\n",
 StyleBox["kb",
  FontFamily->"Courier"],
 "[x,y] is the unevaluated expression of the contact bracket;\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox[
       RowBox[{
        StyleBox["Contact",
         FontFamily->"Courier"], "K"}]], "g"], "[", "x", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "g"], "[", "x", "]"}], 
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], 
       RowBox[{"-", 
        RowBox[{
         SubscriptBox[
          StyleBox[
           RowBox[{
            StyleBox["Hamiltonian",
             FontFamily->"Courier"], "H"}]], "g"], "[", "x", "]"}]}]}]}], " ",
      "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[PartialD]", "x"}], 
       RowBox[{"\[PartialD]", "t"}]], 
      SubscriptBox[
       StyleBox["EulerOp",
        FontFamily->"Courier"], "g"]}]}]}], TraditionalForm]],ExpressionUUID->
  "c29b4166-227d-480e-94c7-4a07fed9e4d9"],
 " is the contact operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox[
      RowBox[{
       StyleBox["Contact",
        FontFamily->"Courier"], "K"}]], "g"], "\[Colon]", 
    RowBox[{"g", "\[Rule]", 
     RowBox[{"\[GothicD]\[GothicE]\[GothicR]", "(", "g", ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"975e4ae8-6b60-4887-a115-585bf875b9c0"],
 ";"
}], "Text",
 CellMargins->{{25, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.421510800041355*^9, 3.4215108307154627`*^9}, {
  3.4237361221360044`*^9, 3.42373615826796*^9}},
 CellTags->"b:4.3.6",ExpressionUUID->"34bda41f-b592-40c8-9f6b-67ba0ad33844"],

Cell[TextData[{
 "The function names may be changed using options, e.g., ",
 StyleBox["ContactAlgebra",
  FontFamily->"Courier"],
 "[..., ",
 StyleBox["Kb",
  FontFamily->"Courier"],
 "\[Rule]Cb].\n\nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Variables",
     FontFamily->"Courier"], "->", 
    RowBox[{"{", 
     RowBox[{"v", ",", "..."}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "b1cec0f1-59d7-405a-97c4-59f22fa5e9f3"],
 " extends the algebra to polynomials in ",
 StyleBox["v ",
  FontSlant->"Italic"],
 "(the bracket does not depend on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "044e97f2-fae1-4bc5-968a-eb21f60367c6"],
 ")."
}], "Text",
 CellChangeTimes->{3.421510839287789*^9},
 CellTags->"b:4.3.6",ExpressionUUID->"23de43c2-d8ea-4085-90f2-d7b21c02c31f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Buttin algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicB]", "(", "n", ")"}], TraditionalForm]],ExpressionUUID->
  "de2a5938-f7fc-4b16-8872-ff69fd3a66ca"]
}], "Subsection",
 CellTags->{
  "c:35", "i:27", 
   "b:4.3.7"},ExpressionUUID->"b1fa3621-62b2-468d-94b4-ef0de16886fa"],

Cell[TextData[{
 "The function ",
 StyleBox["ButtinAlgebra",
  FontFamily->"Courier"],
 " defines the Schouten antibracket on polynomial in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"], ",", " ", 
    SubscriptBox["y", "1"], ",", "...", ",", 
    SubscriptBox["y", "n"]}], TraditionalForm]],ExpressionUUID->
  "6506da04-9a80-4b56-a7d2-6853569eb072"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["y", "i"], ")"}], "=", 
    RowBox[{"1", "-", 
     RowBox[{"P", "(", 
      SubscriptBox["x", "i"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "ef6d84cd-f7cb-41dc-87bd-6e8eab55802f"],
 ":"
}], "Text",
 CellChangeTimes->{{3.421510865996194*^9, 3.4215108701721983`*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"fd6b9201-3a4d-450a-893b-a376ac079298"],

Cell[BoxData[{
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["x",
    FontSlant->"Italic"], ",", "..."}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["x",
    FontSlant->"Italic"], ",", "..."}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["ButtinAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   StyleBox[
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}],
    FontSlant->"Italic"], ",", 
   StyleBox["t",
    FontSlant->"Italic"]}], "]"}]}], "Input",
 CellTags->"b:4.3.7",ExpressionUUID->"d3d704fa-b567-40d9-89d0-ef90990cb5b9"],

Cell[TextData[{
 "On the Buttin algebra ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", the following functions are defined:"
}], "Text",
 CellChangeTimes->{{3.960908555365244*^9, 3.9609085575399647`*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"6c37e5ff-feca-4802-b860-6983ca7dd318"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Bb",
      FontFamily->"Courier"], "[", 
     RowBox[{"f", ",", "g"}], "]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], 
      RowBox[{"B", ".", "b", "."}]], "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{"P", "(", "f", ")"}], 
         RowBox[{"P", "(", 
          SubscriptBox["x", "i"], ")"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "f"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "g"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "i"]}]]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{"P", "(", "f", ")"}], 
         RowBox[{"P", "(", 
          SubscriptBox["y", "i"], ")"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "f"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "g"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "6640bb98-fa12-4158-8753-351d5b1b54c1"],
 " is the antibracket;\n\n",
 StyleBox["bb",
  FontFamily->"Courier"],
 "[x,y] is the unevaluated expression of Poisson bracket;\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["EulerOp",
      FontFamily->"Courier"], "b"], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{
       SubscriptBox["x", "i"], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]]}]}], "+", 
     RowBox[{
      SubscriptBox["y", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["y", "i"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "b8aaf64b-c1df-4aca-b6fb-d0c7e19957a3"],
 "  is the Euler operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "\[Colon]", 
     RowBox[{"b", "\[LongRightArrow]", "b"}]}], ";"}], TraditionalForm]],
  ExpressionUUID->"423ac6e3-2a59-49ad-baaf-e3ef584b6829"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "b"], "=", 
    RowBox[{"2", "-", 
     SubscriptBox[
      StyleBox["EulerOp",
       FontFamily->"Courier"], "b"]}]}], TraditionalForm]],ExpressionUUID->
  "9c7782f2-c6dc-4c65-854b-ff27feede917"],
 "."
}], "Text",
 CellMargins->{{27, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.459415543390625*^9, 3.459415547765625*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"aef672ba-0d60-40af-a6cd-fa3336636dcc"],

Cell[TextData[{
 "The names of the functions (except \[CapitalDelta]) may be changed using \
options, e.g., ",
 StyleBox["ButtinAlgebra",
  FontFamily->"Courier"],
 "[..., ",
 StyleBox["EulerOp",
  FontFamily->"Courier"],
 "\[Rule]Eu].\n\nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Variables",
     FontFamily->"Courier"], "->", 
    RowBox[{"{", 
     RowBox[{"v", ",", "..."}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "4fe0bc99-dade-41ee-896d-aa75697bae27"],
 " extends the domain of the algebra to polynomials in ",
 StyleBox["v ",
  FontSlant->"Italic"],
 "(the bracket does not depend on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "aba65f64-186f-4aae-9840-ff83a64d17a3"],
 ")."
}], "Text",
 CellChangeTimes->{{3.421510896329811*^9, 3.4215109062040095`*^9}, {
  3.421510945891077*^9, 3.42151094942616*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"cb4bad55-ee18-4dff-aacb-1ad6cf322d6b"],

Cell[TextData[{
 StyleBox["Gradings",
  FontWeight->"Bold"],
 " ",
 StyleBox["r",
  FontSlant->"Italic"],
 "=0,...,",
 StyleBox["n",
  FontSlant->"Italic"],
 " (grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{"n", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "03e69b43-5f03-47a7-8f09-244aaf5f5d54"],
 " is not a Weisfeiler one):"
}], "Text",
 CellChangeTimes->{{3.423736629064933*^9, 3.423736633230923*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"2cb4e4d5-1041-40af-b859-64a762bb9cd0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Grade", "(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["v", "1"], 
        SubscriptBox["v", "2"]}], "..."}], 
      SubscriptBox["v", "k"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gr", "(", 
        SubscriptBox["v", "1"], ")"}], "+", 
       RowBox[{"gr", "(", 
        SubscriptBox["v", "2"], ")"}], "+"}], "..."}], "+", 
     RowBox[{"gr", "(", 
      SubscriptBox["v", "k"], ")"}], "-", "2"}]}], TraditionalForm]],
  ExpressionUUID->"6d6f2c0c-5fc4-4282-b077-e2fd499db34a"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["x", "i"], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"f0ce395b-4c4c-4ada-86de-ab3a1506f7c7"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{"1.", ".", "r"}]}], TraditionalForm]],ExpressionUUID->
  "df4e3cff-9860-42cd-80e9-ad4379f76492"],
 " and 2 for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "1"}], ")"}], ".."}], "n"}]}], TraditionalForm]],
  ExpressionUUID->"79018a3e-b3cd-47dc-8fdb-5049832b4fbc"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["y", "i"], ")"}], "=", 
    RowBox[{"2", "-", 
     RowBox[{"gr", "(", 
      SubscriptBox["x", "i"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "548c5348-97fe-4e79-82bb-d3a81ce979f9"]
}], "Text",
 CellTags->"b:4.3.7",ExpressionUUID->"4186e4a0-9e93-4bf6-875a-2975a7131d14"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Schouten algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicB]", "(", "n", ")"}], TraditionalForm]],ExpressionUUID->
  "678d80c3-0e4c-42a1-afc8-4afb649de14b"]
}], "Subsection",
 CellChangeTimes->{{3.96103912253638*^9, 3.961039125340712*^9}},
 CellTags->{
  "c:35", "i:27", 
   "b:4.3.7"},ExpressionUUID->"0bb4ad93-0e4f-4e95-831d-60d9172c0c58"],

Cell[TextData[{
 "The function ",
 StyleBox["SchoutenAlgebra",
  FontFamily->"Courier"],
 " defines the Schouten antibracket on polynomial in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"], ",", " ", 
    SubscriptBox["d", "1"], ",", "...", ",", 
    SubscriptBox["d", "n"]}], TraditionalForm]],ExpressionUUID->
  "4808cc99-2325-4095-b006-6b3d957b412c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["y", "i"], ")"}], "=", 
    RowBox[{"1", "-", 
     RowBox[{"P", "(", 
      SubscriptBox["x", "i"], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "f2ec9bfb-ea3f-4bcd-813a-6bc6c48677db"],
 ":"
}], "Text",
 CellChangeTimes->{{3.421510865996194*^9, 3.4215108701721983`*^9}, {
  3.961039130572451*^9, 3.961039160468562*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"9a5d2b99-c069-49f1-a472-3d5de5076c35"],

Cell[BoxData[{
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["x",
    FontSlant->"Italic"], ",", "..."}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["x",
    FontSlant->"Italic"], ",", "..."}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["SchoutenAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   StyleBox[
    RowBox[{"{", 
     RowBox[{"x", ",", "d"}], "}"}],
    FontSlant->"Italic"], ",", 
   StyleBox["t",
    FontSlant->"Italic"]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9610391705941277`*^9, 3.961039195102745*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"f0e59cbc-6e98-4a72-b3d0-29b461f116b6"],

Cell[TextData[{
 "The Schouten bracket is used in the form more common in differential \
geometry: if ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "40cf7a30-76ba-44c2-8bae-70d6deed3947"],
 " are coordinate functions on a (super)manifold, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "i"], "=", 
    RowBox[{"\[CapitalPi]", "(", 
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SubscriptBox["x", "i"]}]], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b45077c2-0dbd-4a3d-b32f-7ec0a47bf383"],
 "."
}], "Text",
 CellChangeTimes->{{3.961039243992264*^9, 3.961039267290509*^9}, {
  3.961039325242391*^9, 
  3.9610394232546797`*^9}},ExpressionUUID->"a467f0f8-6f03-48dd-b462-\
f11b0b81b528"],

Cell[TextData[{
 "On the Buttin algebra ",
 StyleBox["b",
  FontSlant->"Italic"],
 ", the following functions are defined:"
}], "Text",
 CellChangeTimes->{{3.960908555365244*^9, 3.9609085575399647`*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"d7436bf2-7d1b-4086-9169-4bc25e8b613e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Bb",
      FontFamily->"Courier"], "[", 
     RowBox[{"f", ",", "g"}], "]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], 
      RowBox[{"B", ".", "b", "."}]], "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{
          RowBox[{"P", "(", "f", ")"}], 
          RowBox[{"P", "(", 
           SubscriptBox["x", "i"], ")"}]}], "+", 
         RowBox[{"P", "(", 
          SubscriptBox["d", "i"], ")"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "f"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "g"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["d", "i"]}]]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{
         RowBox[{
          RowBox[{"P", "(", "f", ")"}], 
          RowBox[{"P", "(", 
           SubscriptBox["d", "i"], ")"}]}], "+", 
         RowBox[{"P", "(", 
          SubscriptBox["d", "i"], ")"}]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "f"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["y", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "g"}], 
        RowBox[{"\[PartialD]", 
         SubscriptBox["d", "i"]}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "22236e28-bfc8-488c-8f3a-bb28ffe975b5"],
 " is the antibracket;\n\n",
 StyleBox["bb",
  FontFamily->"Courier"],
 "[x,y] is the unevaluated expression of Poisson bracket;\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["EulerOp",
      FontFamily->"Courier"], "b"], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{
       SubscriptBox["x", "i"], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "i"]}]]}]}], "+", 
     RowBox[{
      SubscriptBox["y", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["y", "i"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "f9b56466-4c4a-43bd-851a-47f44f822436"],
 "  is the Euler operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "\[Colon]", 
     RowBox[{"b", "\[LongRightArrow]", "b"}]}], ";"}], TraditionalForm]],
  ExpressionUUID->"e2d8a97f-4c26-4f0a-92cf-cda8978b7483"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "b"], "=", 
    RowBox[{"2", "-", 
     SubscriptBox[
      StyleBox["EulerOp",
       FontFamily->"Courier"], "b"]}]}], TraditionalForm]],ExpressionUUID->
  "0fbe7b3c-7784-40ea-b2c3-865e9b0b9140"],
 "."
}], "Text",
 CellMargins->{{27, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.459415543390625*^9, 3.459415547765625*^9}, {
  3.961039214215413*^9, 3.961039220208177*^9}, {3.961039281560711*^9, 
  3.961039311248266*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"7655c906-bfba-4dad-93c5-a95fee54d561"],

Cell[TextData[{
 "The names of the functions (except \[CapitalDelta]) may be changed using \
options, e.g., ",
 StyleBox["ButtinAlgebra",
  FontFamily->"Courier"],
 "[..., ",
 StyleBox["EulerOp",
  FontFamily->"Courier"],
 "\[Rule]Eu].\n\nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Variables",
     FontFamily->"Courier"], "->", 
    RowBox[{"{", 
     RowBox[{"v", ",", "..."}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "c39c1581-cc63-4f55-9aea-f18af806b383"],
 " extends the domain of the algebra to polynomials in ",
 StyleBox["v ",
  FontSlant->"Italic"],
 "(the bracket does not depend on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "007699c6-55e6-4a97-832e-3ae062fb6d61"],
 ")."
}], "Text",
 CellChangeTimes->{{3.421510896329811*^9, 3.4215109062040095`*^9}, {
  3.421510945891077*^9, 3.42151094942616*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"65c8b0f0-9a5f-4514-96a7-f873b3947704"],

Cell[TextData[{
 StyleBox["Gradings",
  FontWeight->"Bold"],
 " ",
 StyleBox["r",
  FontSlant->"Italic"],
 "=0,...,",
 StyleBox["n",
  FontSlant->"Italic"],
 " (grading ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{"n", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "67e5feee-f46b-4d08-9c0d-e9bba8811b13"],
 " is not a Weisfeiler one):"
}], "Text",
 CellChangeTimes->{{3.423736629064933*^9, 3.423736633230923*^9}},
 CellTags->"b:4.3.7",ExpressionUUID->"98214eac-a160-43c8-93a9-42694f7de77c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Grade", "(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["v", "1"], 
        SubscriptBox["v", "2"]}], "..."}], 
      SubscriptBox["v", "k"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gr", "(", 
        SubscriptBox["v", "1"], ")"}], "+", 
       RowBox[{"gr", "(", 
        SubscriptBox["v", "2"], ")"}], "+"}], "..."}], "+", 
