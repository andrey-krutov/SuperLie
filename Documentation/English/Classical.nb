       RowBox[{"P", "(", "\[Xi]", ")"}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["f", "0"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Theta]", "k"]}]]}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"c944bc02-ec80-4a96-ae30-4882225218b7"],
