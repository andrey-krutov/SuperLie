Cell[CellGroupData[{

Cell[TextData[{
 "Leites algebras ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicL]\[GothicE]", "(", "n", ")"}], TraditionalForm]],
  ExpressionUUID->"740e4315-4524-4816-bbc1-f40d3e583a89"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicS]\[GothicL]\[GothicE]", "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"d18bde57-607e-4c8f-bb63-94613a1ec3e6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[GothicS]\[GothicL]\[GothicE]", "\[Prime]"], "(", "n", 
    ")"}], TraditionalForm]],ExpressionUUID->
  "8fc0c4bf-bbaf-4146-91fa-c906f03a9fa3"]
}], "Subsection",
 CellChangeTimes->{{3.421511505575864*^9, 3.4215115283686385`*^9}},
 CellTags->{
  "c:38", "i:30", "i:31", "i:32", 
   "b:4.3.10"},ExpressionUUID->"d16b2895-19bc-4f16-a276-acfd7f682029"],

Cell[TextData[{
 "Algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicL]\[GothicE]", "(", "n", ")"}], TraditionalForm]],
  ExpressionUUID->"8dd82b44-f9b4-4d14-8a64-3698e60c0975"],
 " is implemented as the quotient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[GothicB]", "(", "n", ")"}], "/", 
    RowBox[{"\[LeftAngleBracket]", "center", "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"7125bba9-a954-4db8-b467-cada8c613dd2"],
 ";\nAlgebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[GothicS]\[GothicL]\[GothicE]", "(", "n", ")"}], "\[Subset]", 
    RowBox[{"\[GothicL]\[GothicE]", "(", "n", ")"}]}], TraditionalForm]],
  ExpressionUUID->"8f4711c5-13b4-44e4-8f76-96ed0d0a1860"],
 " is determines as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[GothicS]\[GothicL]\[GothicE]", "(", "n", ")"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "\[Element]", 
        RowBox[{"\[GothicL]\[GothicE]", "(", "n", ")"}]}], "|", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "n"], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "f"}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "i"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["y", "i"]}]}]]}]}], "=", "0"}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"518d0f39-4414-4877-ae4e-e45d06885d75"],
 ";\nAlgebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[GothicS]\[GothicL]\[GothicE]", "\[Prime]"], "(", "n", 
     ")"}], "\[Subset]", 
    RowBox[{"\[GothicS]\[GothicL]\[GothicE]", "(", "n", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"69086b0f-7abb-48f0-8890-2d070fdd1d42"],
 " is an ideal, the codimension 1 complement to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     RowBox[{
      SubscriptBox["y", "1"], "..."}], 
     SubscriptBox["y", "n"]}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"963e43eb-67f5-4613-ac4d-f75eec6a7f4e"],
 "."
}], "Text",
 CellChangeTimes->{{3.4215115346576815`*^9, 3.4215115443816643`*^9}},
 CellTags->"b:4.3.10",ExpressionUUID->"b3d9e718-c8e2-4dc9-bdfc-e19236ed2a22"],

