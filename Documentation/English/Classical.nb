Cell[CellGroupData[{

Cell["Moebius\[Dash]Poisson Algebra ", "Subsection",
 CellTags->{
  "c:46", "i:40", 
   "b:4.4.0"},ExpressionUUID->"6c5b18f4-c033-4886-960f-3113aea619ea"],

Cell[TextData[{
 "The Moebius\[Dash]Poisson bracket is defined in terms of the Poisson \
bracket. All forms of the Poisson bracket described above, except for \
\[GothicP]\[GothicO](x;c), are supported. Here we show only the version \
\[GothicP]\[GothicO]({p,q}).\n\nThe function ",
 StyleBox["MoebiusAlgebr",
  FontFamily->"Courier"],
 "a defines the Poisson bracket and the Moebius\[Dash]Poisson bracket on the \
space of polynomials in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], ",", 
    SubscriptBox["q", "i"], ",", " ", "\[Theta]", ",", " ", "t", ",", 
    SuperscriptBox["t", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "fbdc9b89-289a-4a58-87fe-68322e11445a"],
 ":"
}], "Text",
 CellChangeTimes->{{3.4215134005106463`*^9, 3.421513424885696*^9}},
 CellTags->"b:4.4.0",ExpressionUUID->"582e5e51-bdfb-4d1f-96c7-5a57957ce12f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dim", "=."}], ".."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["p",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["q",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["MoebiusAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     StyleBox[
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}],
      FontSlant->"Italic"], ",", "\[Theta]", ",", "t"}], "}"}]}], 
  "]"}]}], "Input",
 CellTags->"b:4.4.0",ExpressionUUID->"54566f40-1e1d-456e-b4de-a8c1a3848ba1"],

Cell[TextData[{
 "No need to declare ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "f4deab04-d743-45c8-9fbb-210062c0abc2"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "68af12fc-7ae7-46d1-9192-4fed8ea2fb1b"],
 " as a 1-dimensional spaces; this is done by the function ",
 StyleBox["MoebiusAlgebra", "Name"],
 ".\n\nOn the Moebius\[Dash]Poisson algebra ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "bf05409d-e6ce-4fa3-8d2e-bfbc9f921ad2"],
 ", the following function are defined (in addition to the functions in the \
Poisson algebra; the functions ",
 StyleBox["EulerOp",
  FontFamily->"Courier"],
 " and \[CapitalDelta] are redefined):"
}], "Text",
 CellChangeTimes->{{3.423736869009957*^9, 3.4237368729055586`*^9}},
 CellTags->"b:4.4.0",ExpressionUUID->"511647c3-c21c-4f56-9650-e8a78be3b6c4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Mb", "Program"], "[", 
     RowBox[{"f", ",", "g"}], "]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], 
      RowBox[{"M", ".", "b", "."}]], "=", 
     RowBox[{
      SubscriptBox[
       RowBox[{"{", 
        RowBox[{"f", ",", "g"}], "}"}], 
       RowBox[{"P", ".", "b", "."}]], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"P", "(", "f", ")"}]], 
       FractionBox["1", "t"], 
       FractionBox[
        RowBox[{"\[PartialD]", "f"}], 
        RowBox[{"\[PartialD]", "\[Theta]"}]], 
       FractionBox[
        RowBox[{"\[PartialD]", "g"}], 
        RowBox[{"\[PartialD]", "\[Theta]"}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ceab087a-ea75-4ab7-99da-58e238dbab1a"],
 " "
}], "Text",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{
  3.4237369031490464`*^9, {3.423736965418586*^9, 3.4237369725989103`*^9}, {
   3.4237370238325806`*^9, 3.4237370247238626`*^9}, 3.4355959222075696`*^9},
 CellTags->"b:4.4.0",ExpressionUUID->"1ce5810f-9517-4a92-85b8-bce35173fc5a"],

Cell["is the Moebius\[Dash]Poisson bracket;", "Text",
 CellChangeTimes->{3.4355959288070593`*^9},
 CellTags->"b:4.4.0",ExpressionUUID->"b74685bd-65dd-481f-b7dd-72f1a49ede27"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["mb", "Program"], "[", 
    RowBox[{"f", ",", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "f1ab957a-e82b-41cb-99c8-fed9b47f3911"],
 " is the unevaluated expression of Moebius\[Dash]Poisson bracket;"
}], "Text",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{
  3.4237369031490464`*^9, {3.423736965418586*^9, 3.423736969534504*^9}, 
   3.423737065212082*^9},
 CellTags->"b:4.4.0",ExpressionUUID->"4997bca8-cba7-460e-9664-888442552ec4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["EulerOp", "Program"], "m"], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["EulerOp", "Program"], "\[GothicP]\[GothicO]"], "+", 
     RowBox[{"\[Theta]", 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", "\[Theta]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"012f6e8d-214a-4c25-ab54-f1e27299eca5"],
 " is  the Euler operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"E", "\[Colon]", 
     RowBox[{"m", "\[LongRightArrow]", "m"}]}], ";"}], TraditionalForm]],
  ExpressionUUID->"a4955762-4e6b-42f2-b46a-11268bd8c529"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "m"], "=", 
    RowBox[{"2", "-", 
     SubscriptBox[
      StyleBox["EulerOp", "Program"], "m"]}]}], TraditionalForm]],
  ExpressionUUID->"273cf185-e793-40c9-b1b3-7605e7452fa6"],
 "."
}], "Text",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{
  3.4237369031490464`*^9, {3.423736965418586*^9, 3.423736969534504*^9}, {
   3.423737065212082*^9, 3.4237370683165455`*^9}},
 CellTags->"b:4.4.0",ExpressionUUID->"30b3be27-cc36-4439-97b5-d8d2230a3b3f"],

Cell[TextData[{
 "The names of the functions (except \[CapitalDelta]) may be changed using \
options, e.g., ",
 StyleBox["MoebiusAlgebra",
  FontFamily->"Courier"],
 "[..., ",
 StyleBox["EulerOp",
  FontFamily->"Courier"],
 "\[Rule]Eu].\n\nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Variables",
     FontFamily->"Courier"], "->", 
    RowBox[{"{", 
     RowBox[{"v", ",", "..."}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "003bf578-1b8d-485d-a0d6-ae125b325e2b"],
 " extends the domain of the algebra to polynomials in ",
 StyleBox["v ",
  FontSlant->"Italic"],
 "(the bracket does not depend on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "8c05e9fe-122c-443a-9645-a74e741adf90"],
 ")."
}], "Text",
 CellChangeTimes->{{3.421513519421632*^9, 3.421513522946701*^9}},
 CellTags->"b:4.4.0",ExpressionUUID->"f4cd87f2-9f92-469b-98b1-c4b0f12d0d2d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Moebius Contact (Ramond) algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[GothicK]", "M"], "(", 
    RowBox[{"1", "|", "n"}], ")"}], TraditionalForm]],ExpressionUUID->
  "77d972e3-ad8b-4194-8663-7673a987f243"]
}], "Subsection",
 CellTags->{
  "c:47", "i:41", "i:42", 
   "b:4.4.1"},ExpressionUUID->"86ca96ca-2793-4d70-9de9-5ac48ea0979a"],

Cell[TextData[{
 "The Ramond bracket is defined with the help of the Moebius\[Dash]Poisson \
bracket which, in turn, is defined with the help of the Poisson bracket. All \
forms of the Poisson bracket described above, except \
\[GothicP]\[GothicO](x;c), are supported. Here we show only the version \
\[GothicP]\[GothicO]({p,q}).\n\nThe function ",
 StyleBox["RamondAlgebra",
  FontFamily->"Courier"],
 " defines the Poisson bracket, the Moebius\[Dash]Poisson bracket, and the \
Ramond bracket on the space of polynomial in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], ",", 
    SubscriptBox["q", "n"], ",", "\[Theta]", ",", "t", ",", " ", 
    SuperscriptBox["t", 
     RowBox[{"-", "1"}]], ","}], TraditionalForm]],ExpressionUUID->
  "92d237ce-baab-4ba0-afd7-2969febbe256"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["p", "i"], ")"}], "=", 
    RowBox[{"P", "(", 
     SubscriptBox["q", "i"], ")"}]}], TraditionalForm]],ExpressionUUID->
  "dd23df46-e15b-4006-9e92-3986c8200721"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "\[Theta]", ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"9de8e008-25ce-4803-b81c-520fa0787c9e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"3248c020-7dbe-4e01-92ce-3bc3a39a8e4a"],
 ":"
}], "Text",
 CellTags->"b:4.4.1",ExpressionUUID->"ba222597-2f8f-42f6-bfd1-caafa8c6d5d3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dim", "=."}], ".."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["p",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["q",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["RamondAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     StyleBox[
      RowBox[{"{", 
       RowBox[{"p", ",", "q"}], "}"}],
      FontSlant->"Italic"], ",", "\[Theta]", ",", "t"}], "}"}]}], 
  "]"}]}], "Input",
 CellTags->"b:4.4.1",ExpressionUUID->"b95a4e09-113b-4387-a96a-3b6226e1a96d"],

Cell[TextData[{
 "No need to declare ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "fd4de450-c321-4146-a5c7-482eb82d08db"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "b4c083b5-3dca-4687-9b7f-10eebe925900"],
 " as  trivial spaces; this is done by the function ",
 StyleBox["RamondAlgebra",
  FontFamily->"Courier"],
 ".\n\nOn the Ramond algebra, r, the following functions are defined (in \
addition to the functions on Poisson and Moebius\[Dash]Poisson algebras):"
}], "Text",
 CellTags->"b:4.4.1",ExpressionUUID->"f85f2ef6-aa7f-459a-b9a1-5b155081eb12"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Rb", "Program"], "[", 
     RowBox[{"f", ",", "g"}], "]"}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"f", ",", "g"}], "}"}], 
      RowBox[{"R", ".", "b", "."}]], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "r"], "[", "f", "]"}], 
       RowBox[{"\[ScriptCapitalD]", "(", "g", ")"}]}], "-", 
      RowBox[{
       RowBox[{"\[ScriptCapitalD]", "(", "f", ")"}], " ", 
       RowBox[{
        SubscriptBox["\[CapitalDelta]", "r"], "[", "g", "]"}]}], "-", 
      SubscriptBox[
       RowBox[{"{", 
        RowBox[{"f", ",", "g"}], "}"}], 
       RowBox[{"M", ".", "b", "."}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "c6d2da97-58b6-4640-82cd-a838bd3794ce"],
 "\nis the Ramond bracket, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalD]", "=", 
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", "t"}]], "-", 
     RowBox[{
      FractionBox["\[Theta]", 
       RowBox[{"2", "t"}]], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", "\[Theta]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"9d549658-ce07-46d4-916f-4530ac49d609"],
 ";"
}], "Text",
 CellMargins->{{26, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.421513550766704*^9, 3.4215135780359154`*^9}, {
  3.423737089637203*^9, 3.423737100322568*^9}},
 CellTags->"b:4.4.1",ExpressionUUID->"b8e71ed4-ae8a-40fa-94ff-1aaff67d76d8"],

Cell[TextData[{
 StyleBox["rb", "Program"],
 "[x,y] is the unevaluated expression of the Ramond bracket;"
}], "Text",
 CellMargins->{{26, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.421513550766704*^9, 3.4215135780359154`*^9}, {
  3.423737089637203*^9, 3.4237371057603874`*^9}},
 CellTags->"b:4.4.1",ExpressionUUID->"b1165532-8cb9-4427-b662-48cf7ec46ba5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["HamiltonianH",
       FontFamily->"Courier"], "r"], "[", "f", "]"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["HamiltonianH", "Program"], "\[GothicP]\[GothicO]"], "[", "f",
       "]"}], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "(", "f", ")"}]], 
      FractionBox["1", "t"], 
      FractionBox[
       RowBox[{"\[PartialD]", "f"}], 
       RowBox[{"\[PartialD]", "\[Theta]"}]], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", "\[Theta]"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"fa3e879a-9561-4979-b960-3bd465c99016"],
 ";"
}], "Text",
 CellMargins->{{26, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.421513550766704*^9, 3.4215135780359154`*^9}, {
  3.423737089637203*^9, 3.423737111849142*^9}},
 CellTags->"b:4.4.1",ExpressionUUID->"3e5b22dc-9b75-49e9-b99b-385855ae0e14"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["RamondK", "Program",
       FontFamily->"Courier"], "r"], "[", "f", "]"}], " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[CapitalDelta]", "r"], "[", "f", "]"}], 
      "\[ScriptCapitalD]"}], "-", 
     RowBox[{
      SubscriptBox[
       StyleBox["HamiltonianH",
        FontFamily->"Courier"], "r"], "[", "f", "]"}], "+", 
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "(", "f", ")"}], 
      SubscriptBox[
       StyleBox["EulerOp",
        FontFamily->"Courier"], "r"]}]}]}], TraditionalForm]],ExpressionUUID->
  "3a9a2816-0d06-42fd-885f-5fd4e2be8077"],
 " is the operator  R: r\[LongRightArrow]\[GothicD]\[GothicE]\[GothicR](r)."
}], "Text",
 CellMargins->{{26, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.421513550766704*^9, 3.4215135780359154`*^9}, {
  3.423737089637203*^9, 3.423737111849142*^9}},
 CellTags->"b:4.4.1",ExpressionUUID->"722f3c70-3881-4daf-a87f-696b8d53f2c9"],

Cell[TextData[{
 "The function names ",
 StyleBox["Rb", "Program"],
 " and ",
 StyleBox["rb", "Program"],
 " may be changed using options, e.g., ",
 StyleBox["RamondAlgebra",
  FontFamily->"Courier"],
 "[..., ",
 StyleBox["Rb", "Program"],
 "\[Rule]Bk]."
}], "Text",
 CellTags->"b:4.4.1",ExpressionUUID->"6d2c8df8-50b8-4922-a774-fd959ccaf290"]
