Notebook[{

Cell[CellGroupData[{
Cell["Classical Lie Superalgebras in SuperLie ", "Title",
 FontSize->24,
 CellTags->{
  "Classical Lie Superalgebras", 
   "c:1"},ExpressionUUID->"f00bcdd9-363c-4cbf-8fde-248f1891cd51"],

Cell[TextData[{
 "Here we describe how to define \[OpenCurlyDoubleQuote]classical\
\[CloseCurlyDoubleQuote] Lie superalgebras when working in ",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 ". In that follows \[OpenCurlyDoubleQuote]algebra\[CloseCurlyDoubleQuote] \
means \[OpenCurlyDoubleQuote]Lie (super)algebra",
 "\[CloseCurlyDoubleQuote]."
}], "Abstract",
 CellChangeTimes->{{3.4215094271572447`*^9, 
  3.421509531347062*^9}},ExpressionUUID->"2b41420f-718a-4c08-bedc-\
23041794997e"],

Cell["\<\
Note that, strictly speaking, some of the following Lie (super)algebras have \
no Cartan matrix; it is certain algebras of derivations of their central \
extensions that have Cartan matrix, see \[OpenCurlyDoubleQuote]Basics\
\[CloseCurlyDoubleQuote] part of [GL].\
\>", "Text",
 CellChangeTimes->{{3.4237347537984324`*^9, 3.423734967936347*^9}, {
   3.4237350992151165`*^9, 3.423735118292549*^9}, 
   3.4355950076424894`*^9},ExpressionUUID->"749dffe9-65da-4062-bc27-\
d93a34e632dd"],

