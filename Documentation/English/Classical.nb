    RowBox[{"n", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "56fe09c8-70ce-4597-9149-b1397bffa17e"],
 " which is not a Weisfeiler one):"
}], "Text",
 CellChangeTimes->{{3.421511147881525*^9, 3.4215112021796017`*^9}, {
  3.421511416317517*^9, 3.421511425791139*^9}, {3.423736618079136*^9, 
  3.4237366227458467`*^9}},
 CellTags->"b:4.3.8",ExpressionUUID->"f123e861-6812-4288-b549-7334731184ce"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Grade", "(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["v", "1"], 
        SubscriptBox["v", "2"]}], "..."}], 
      SubscriptBox["v", "k"]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gr", "(", 
        SubscriptBox["v", "1"], ")"}], "+", 
       RowBox[{"gr", "(", 
        SubscriptBox["v", "2"], ")"}], "+"}], "..."}], "+", 
     RowBox[{"gr", "(", 
      SubscriptBox["v", "k"], ")"}], "-", "2"}]}], TraditionalForm]],
  ExpressionUUID->"f34da031-0023-4f49-a39f-1196872d02ec"],
 ",\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"gr", "(", 
     SubscriptBox["x", "i"], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"9a71f1df-de84-46ac-a25a-c0ee74ce5913"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "=", 
