Cell[TextData[{
 "This algebra is implemented as a subalgebra in the odd-contact algebra \
\[GothicM](4|5) generated as the CTS prolong of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"-", "2"}]], ",", " ", 
     SubscriptBox["g", 
      RowBox[{"-", "1"}]], ",", 
     SubscriptBox["g", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "f2a2fd88-d685-41e4-90ac-d03fca7b84a8"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"-", "2"}]], "=", 
    RowBox[{"\[LeftAngleBracket]", "1", "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"8687b155-0d0c-4391-adbc-43906cecb73b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["q", "0"], ",", 
      RowBox[{"...", 
       SubscriptBox["q", "3"]}], ",", 
      SubscriptBox["\[Xi]", "0"], ",", 
      RowBox[{"...", 
       SubscriptBox["\[Xi]", "3"]}]}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"79a60eb7-17b7-4334-a2a7-27a5914ce6a3"],
 " coincide with the corresponding components in \[GothicM](4|5), and where \
for the basis of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "0"], TraditionalForm]],ExpressionUUID->
  "bd4fd42e-e71a-425f-aef3-df06c7b27a22"],
 " we take"
}], "Text",
 CellChangeTimes->{{3.421511950415512*^9, 3.4215119772541037`*^9}},
 CellTags->"b:4.3.11",ExpressionUUID->"bbe75c70-0649-4f8f-b176-123a21ec133c"],

