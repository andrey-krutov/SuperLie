Cell[CellGroupData[{

Cell["Algebra \[GothicV]le(4|3)", "Subsubsection",
 CellTags->{
  "c:44", "i:38", 
   "b:4.3.11"},ExpressionUUID->"8417a4e9-55ab-41cf-899b-e444ad1d780e"],

Cell[TextData[{
 "This algebra is implemented as a subalgebra in \[GothicV]\[GothicE]\
\[GothicC]\[GothicT](4|3). The subalgebra is singled out by the following \
equations for the vector field ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Xi]", "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], "3"], 
      RowBox[{
       SubscriptBox["f", "i"], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["p", "i"]}]]}]}], "+", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "3"], 
      RowBox[{
       SubscriptBox["g", "i"], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["\[Theta]", "i"]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"89d711cc-e399-4c9c-92a9-b85c64612421"],
 ":"
}], "Text",
 CellChangeTimes->{{3.421513289721339*^9, 3.4215132901719875`*^9}},
 CellTags->"b:4.3.11",ExpressionUUID->"eaa7fbbd-41f2-4309-85d6-14c57c9e9102"],

Cell[TextData[{
 "(1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["f", "i"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["p", "j"]}]], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "(", "\[Xi]", ")"}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "j"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Theta]", "i"]}]]}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"b6f6cf60-7ed7-4a6b-a1c9-94df7296ac1d"],
 "\tfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "1", "\[LessEqual]", "i", "\[NotEqual]", "j", "\[LessEqual]", "3"}], 
   TraditionalForm]],ExpressionUUID->"47f19ce1-9131-4a42-b7bd-c1b4d7ab53f5"],
 ";\n(1a) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["f", "i"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["p", "i"]}]], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "(", "\[Xi]", ")"}]], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "i"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["\[Theta]", "i"]}]]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], "3"], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["f", "j"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["p", "j"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "66baa6dd-5b4f-4d21-8ecf-cee8c9493cda"],
 "\tfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessEqual]", "i", "\[LessEqual]", "3"}], TraditionalForm]],
  ExpressionUUID->"a67f5674-82a7-4ef8-9d28-b5ce8504a24a"],
 ";\n(2)  ",
 Cell[BoxData[
  FormBox[
