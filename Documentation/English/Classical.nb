Cell[TextData[{
 StyleBox["Second implementation",
  FontWeight->"Bold"],
 ": as a submodule in \
\[GothicS]\[GothicV]\[GothicE]\[GothicC]\[GothicT](5|10) generated as the \
Cartan prolongation of the pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"-", "1"}]], ",", " ", 
     SubscriptBox["g", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "6e9bf7fb-ac02-41bf-8a1a-78a0d4fff7ff"],
 ", where\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["n", 
       RowBox[{"i", ",", "j"}]], ",", " ", 
      RowBox[{"i", "\[LessEqual]", "i", "<", "j", "\[LessEqual]", "5"}]}], 
     "\[RightAngleBracket]"}]}], TraditionalForm]],ExpressionUUID->
  "b6043f8c-28ef-4961-89bf-fdb0d7c4d3a6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", 
     RowBox[{"i", ",", "j"}]], "=", 
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", 
       SubscriptBox["\[Theta]", 
        RowBox[{"i", ",", "j"}]]}]], "+", 
     RowBox[{"\[Sum]", 
      RowBox[{
       SubscriptBox["\[Theta]", 
        RowBox[{"k", ",", "l"}]], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["x", "m"]}]]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "6d0dc83c-20fd-46d9-bc5f-f3a5a208ba1f"],
 ", the sum over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"k", ",", "l", ",", "m"}], ")"}], TraditionalForm]],
  ExpressionUUID->"649eaf0d-7672-4a7a-bd81-815716dd4da6"],
 " such as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "m"}], ")"}], "\[Element]", 
    SubscriptBox["A", "5"]}], TraditionalForm]],ExpressionUUID->
  "f93c069e-8be0-42bb-b19e-3b3a4b44c3c5"],
 ";\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "0"], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox["z", 
       RowBox[{"i", ",", "j"}]], ",", 
      RowBox[{"1", "\[LessEqual]", "i", "\[NotEqual]", "j", "\[LessEqual]", 
       RowBox[{"5", " ", "\[Union]", 
        RowBox[{
         SubscriptBox["z", 
          RowBox[{"i", ",", "i"}]], "-", 
         SubscriptBox["z", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", 
           RowBox[{"i", "+", "1"}]}]]}]}]}], ",", 
      RowBox[{"1", "\[LessEqual]", "i", "\[LessEqual]", "4"}]}], 
     "\[RightAngleBracket]"}]}], TraditionalForm]],ExpressionUUID->
  "64c1b14a-a8f6-4768-a2d9-87bc7945f4c3"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", 
     RowBox[{"i", ",", "j"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "j"]}]]}], "+", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "5"], 
      RowBox[{
       SubscriptBox["\[Theta]", 
        RowBox[{"j", ",", "k"}]], 
       FractionBox["\[PartialD]", 
        RowBox[{"\[PartialD]", 
         SubscriptBox["\[Theta]", 
          RowBox[{"k", ",", "i"}]]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"30ac26f5-5bc8-4fe6-a42f-06f3cda37078"],
 "."
}], "Text",
 CellChangeTimes->{{3.421511762244936*^9, 3.421511762244936*^9}, {
  3.4215118055171585`*^9, 3.421511893433576*^9}},
 CellTags->"b:4.3.11",ExpressionUUID->"27ecd6ed-921c-4803-81b3-ba64ffb381d9"],

