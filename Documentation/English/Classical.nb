Cell[CellGroupData[{

Cell[TextData[{
 "The deformation of the Buttin algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[GothicB]", "\[Lambda]"], "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"c538942d-1487-47fc-a902-b8e38bcabda7"]
}], "Subsection",
 CellTags->{
  "c:37", "i:29", 
   "b:4.3.9"},ExpressionUUID->"59c39536-c400-469e-85e0-ea0bcff03e9e"],

Cell[TextData[{
 "The algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[GothicB]", "\[Lambda]"], "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"293daafc-20d4-4066-afa6-822b0c46ce52"],
 ", where \[Lambda]=",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"2", "a"}], 
    RowBox[{"n", "(", 
     RowBox[{"a", "-", "b"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "e9d7d136-4a6c-4a97-b49b-40f951df3ac3"],
 " is implemented as a subalgebra in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicM]", "(", "n", ")"}], TraditionalForm]],ExpressionUUID->
  "11d35446-250c-4a5b-a9d0-0f4d15b68db5"],
 ", namely, as"
}], "Text",
 CellChangeTimes->{{3.421511216990899*^9, 3.4215112311312323`*^9}},
 CellTags->"b:4.3.9",ExpressionUUID->"094f7415-1eff-4bb0-b30e-8b0e24ffec3e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[GothicB]", "\[Lambda]"], "(", "n", ")"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "\[Element]", 
        RowBox[{"\[GothicM]", "(", "n", ")"}]}], "\[VerticalSeparator]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"b", " ", "n"}], "-", 
          RowBox[{"a", " ", 
           SubscriptBox[
            StyleBox["EulerOp", "Program"], "\[GothicM]"]}]}], ")"}], 
        FractionBox[
         RowBox[{"\[PartialD]", "f"}], 
         RowBox[{"\[PartialD]", "\[Tau]"}]]}]}], "=", 
      RowBox[{"a", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], "n"], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "f"}], 
         RowBox[{
          RowBox[{"\[PartialD]", 
           SubscriptBox["x", "i"]}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["y", "i"]}]}]]}]}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"9a822ec5-97a6-413a-beb3-38881313918e"],
 "."
}], "Text",
 CellMargins->{{35.5625, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{
  3.421511226654795*^9, {3.421511311126259*^9, 3.421511337584304*^9}},
 TextAlignment->Left,
 TextJustification->0,
 CellTags->"b:4.3.9",ExpressionUUID->"69e05316-b1b3-4fc8-a39d-f650867a4caf"],

Cell[TextData[{
 StyleBox["Special cases to be treated with extra care",
  FontWeight->"Bold"],
 ":\n\[Lambda]=0: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[GothicB]", "0"], "(", "n", ")"}], "=", 
    RowBox[{"\[GothicB]", "(", "n", ")"}]}], TraditionalForm]],ExpressionUUID->
  "df3ca12a-5375-4f64-9b03-c9a3d5d3e9c7"],
 " is not simple; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[GothicB]", "(", "n", ")"}], "/", 
     RowBox[{"\[LeftAngleBracket]", "center", "\[RightAngleBracket]"}]}], "=", 
    RowBox[{"\[GothicL]\[GothicE]", "(", "n", ")"}]}], TraditionalForm]],
  ExpressionUUID->"ed8cdf6f-3577-44bb-801c-a1fc687461c6"],
 ";\n\n\[Lambda]=1: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[GothicB]", "1"], "(", "n", ")"}], TraditionalForm]],
  ExpressionUUID->"6b7f1a3f-448d-45ba-9998-708fd2038e5f"],
 " contains an ideal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[GothicB]", "1", "0"], "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"8fc2e06b-f383-4c89-95fb-2bd653181dc5"],
 " of codimension 1;\n\n\[Lambda]=\[Infinity]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[GothicB]", "\[Infinity]"], "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"64e9d44c-8e6b-49e1-b6e8-6dd8f5744acc"],
 " contains an ideal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[GothicB]", "\[Infinity]", "0"], "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"9b21c26e-a9eb-41dc-b60c-a6ebef919d7f"],
 " of codimension 1;\n\n\[Lambda]=",
 Cell[BoxData[
  FormBox[
   FractionBox["2", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "569a1aea-68f2-49cb-9c43-46bd51e9b13e"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[GothicB]", "\[Lambda]"], "(", "n", ")"}], 
   TraditionalForm]],ExpressionUUID->"27a812af-de59-4443-b3b9-29287a33bc77"],
 " preserves the volume;  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[GothicB]", "\[Lambda]"], "(", "n", ")"}], "=", 
    RowBox[{"\[GothicS]\[GothicM]", "(", "n", ")"}]}], TraditionalForm]],
  ExpressionUUID->"5cf70cc5-7ba2-43ad-adab-e07b7d0612e0"],
 ";\n\n\[Lambda]=",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "n"], ";", " ", 
    FractionBox["2", "n"]}], TraditionalForm]],ExpressionUUID->
  "15d16448-7641-49a6-95fd-a44c45ee7a8a"],
 ".\n\nFor n=2, additionally, \[Lambda]=-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "05aa4da1-96e4-4213-b0bf-8c188d1df13a"],
 "abd ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    FractionBox["3", "2"]}], TraditionalForm]],ExpressionUUID->
  "92b2ec55-a247-4e1c-bf9a-6fb6a2968b45"],
 ": at these points there are extra deformations."
}], "Text",
 CellChangeTimes->{{3.421511350923485*^9, 3.4215113757591968`*^9}},
 CellTags->"b:4.3.9",ExpressionUUID->"d25efa53-4f8a-4442-af30-b4d666a5d5dc"],

