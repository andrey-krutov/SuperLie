}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Algebra ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[GothicS]\[GothicV]\[GothicE]\[GothicC]\[GothicT]", "~"], 
   TraditionalForm]],ExpressionUUID->"ed12f226-2849-4d4a-9432-400e6c3d4699"],
 "(0|n)"
}], "Subsection",
 CellTags->{
  "c:26", "i:23", 
   "b:4.3.3"},ExpressionUUID->"fa046adf-a4c1-4ee1-8fa7-e8b1f283d7d8"],

Cell["May be implemented as subalgebra in \[GothicV]\[GothicE]\[GothicC]\
\[GothicT](0|n):", "Text",
 CellChangeTimes->{{3.45598539028125*^9, 3.4559854204375*^9}, {
  3.455985456421875*^9, 3.4559854675625*^9}},
 CellTags->"b:4.3.3",ExpressionUUID->"86cca53c-41ac-430c-a4a0-5ce8b78be5ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Linear", "[", "Tp", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VectorSpace", "[", 
   RowBox[{"\[Xi]", ",", 
    RowBox[{"Dim", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "n"}], "}"}]}], ",", 
    RowBox[{"CoLeft", "\[Rule]", "\[Delta]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VectorLieAlgebra", "[", 
   RowBox[{"g", ",", "\[Xi]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basis", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"VTimes", "[", "]"}], "+", 
           RowBox[{"VTimes", "@@", 
            RowBox[{"Basis", "[", "\[Xi]", "]"}]}]}], ")"}], "**", 
         SubscriptBox["\[Delta]", "i"]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"GeneralBasis", "[", 
         RowBox[{
          RowBox[{"GeneralSum", "[", 
           RowBox[{"c", ",", 
            RowBox[{"Basis", "[", 
             RowBox[{"v", ",", "i"}], "]"}], ",", "Div"}], "]"}], ",", "c"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SubAlgebra", "[", 
   RowBox[{"u", ",", "g", ",", "basis"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.4559854935*^9, 3.455985584390625*^9}, {
  3.455985621296875*^9, 3.45598562284375*^9}},
 CellTags->"b:4.3.3",ExpressionUUID->"9e401c21-8a58-41cd-8ae3-5f29138f7b2f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Poisson algebra \[GothicP]\[GothicO](2n|m)", "Subsection",
 CellTags->{
  "PoissonAlgebra", "c:27", "i:24", 
   "b:4.3.4"},ExpressionUUID->"8370750d-b62f-47ba-bb16-3497059f6a7b"],

Cell[TextData[{
 "The Poisson algebra is implemented for different forms of the Poisson \
bracket.\n\nThe vector spaces ",
 StyleBox["x, p, q",
  FontSlant->"Italic"],
 ", \[Zeta], \[Eta], \[Theta] should be defined with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VectorSpace",
     FontFamily->"Courier"], "[", 
    RowBox[{"x", ",", "..."}], "]"}], TraditionalForm]],ExpressionUUID->
  "638de017-4981-4285-b27e-ae585e4f4cfa"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TrivialSpace",
     FontFamily->"Courier"], "[", 
    RowBox[{"x", ",", "..."}], "]"}], TraditionalForm]],ExpressionUUID->
  "9abf6b31-f4a5-4d26-b3a1-f22fc5a4df7d"],
 " .\n\nThe vector multiplication ",
 StyleBox["VTimes",
  FontFamily->"Courier"],
 " is used as supersymmetric multiplication of polynomials, so it should be \
declared symmetric.\n\nNote that the odd variables are denoted here by \
\[Zeta] and \[Eta]. The commonly used notation \[Xi] and \[Eta] is not \
convenient because the variables are sorted alphabetically and \[Zeta] \
(unlike \[Xi]) preceeds \[Eta] in Greek."
}], "Text",
 CellChangeTimes->{{3.4215104752343054`*^9, 3.4215105090028625`*^9}, {
  3.421510539737056*^9, 3.421510570361091*^9}, {3.4237357551583166`*^9, 
  3.4237357586533422`*^9}},
 CellTags->"b:4.3.4",ExpressionUUID->"65dbd099-7632-4858-9b67-d25b7ee09427"],

Cell[TextData[{
 "In a Poisson algebra ",
 StyleBox["g",
  FontSlant->"Italic"],
 ", the following functions are defined:"
}], "Text",
 CellChangeTimes->{3.4215105987819586`*^9},
 CellTags->"b:4.3.4",ExpressionUUID->"5be3e150-0395-44ce-a345-24b350323874"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Pb", "Program"], "[", 
     RowBox[{"x", ",", "y"}], "]"}], "=", 
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]]}], TraditionalForm]],ExpressionUUID->
  "1aac2bfb-c754-4128-85b0-96f83fb827bc"],
 "  is the Poisson bracket;\n",
 StyleBox["pb", "Program"],
 "[x,y] is the unevaluated expression of the Poisson bracket;\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox[
      StyleBox["EulerOp", "Program"], "g"],
     TraditionalForm], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SubscriptBox["x", "i"], 
      FractionBox["\[PartialD]", 
       RowBox[{"\[PartialD]", 
        SubscriptBox["x", "i"]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "308b7303-d00f-4978-b723-d03fa773fe67"],
 " is the Euler operator E\[Colon]g\[LongRightArrow]g (here ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     RowBox[{"...", 
      SubscriptBox["x", "n"]}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "e1f99f6b-d14b-433f-8fbb-f2bddd158b6a"],
 " is the basis of the base space);\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["HamiltonianH", "Program"], 
      RowBox[{"g", ",", "x"}]], "[", "y", "]"}], "=", 
    RowBox[{"-", 
     SubscriptBox[
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], 
      RowBox[{"P", ".", "b", "."}]]}]}], TraditionalForm]],ExpressionUUID->
  "03ba88fc-d982-4730-9f06-0bbe999094f3"],
 " is  the Hamiltonian g\[LongRightArrow]\[GothicD]\[GothicE]\[GothicR](g)."
}], "Text",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{3.4237358064420595`*^9},
 CellTags->"b:4.3.4",ExpressionUUID->"04b7a215-1229-4757-98a4-851fbefdf086"],

Cell[TextData[{
 "The names of the functions may be changed using options, e.g., ",
 Cell[BoxData[
  RowBox[{"PoissonAlgebra", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"EulerOp", "\[Rule]", "Eu"}]}], "]"}]],ExpressionUUID->
  "31dd2e2d-4214-4c5e-815e-9c8c14d1473e"]
}], "Text",
 CellChangeTimes->{{3.4215106433260098`*^9, 3.4215106538912015`*^9}, {
  3.435595164397893*^9, 3.4355951662806*^9}},
 CellTags->"b:4.3.4",ExpressionUUID->"1217debd-daab-48a5-8376-52b5f3a94d77"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["name",
      FontSlant->"Italic"], ",", 
     StyleBox["x",
      FontSlant->"Italic"], ",", 
     RowBox[{
      StyleBox["Variables", "Program"], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"v", ",", "..."}], "}"}]}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"32e9a171-7e2a-4e87-a61e-fd6a9240b5e9"],
 " to define a Poisson bracket on ",
 StyleBox["x",
  FontSlant->"Italic"],
 " extended to polynomials in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "68c81cce-57fe-43c6-9e4b-e440f5b330f5"],
 " and ",
 StyleBox["v ",
  FontSlant->"Italic"],
 "(the bracket and the Euler operator will not depend on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "8620f98d-b0b3-40dc-8e2f-9fd1a2393f79"],
 ")."
}], "Text",
 CellTags->"b:4.3.4",ExpressionUUID->"3be0676b-3d5e-48a7-b0d8-ca3d0711ef0a"],

Cell[CellGroupData[{

Cell["\[GothicP]\[GothicO]({p,q})", "Subsubsection",
 CellTags->{
  "c:28", "b:4.3.4"},ExpressionUUID->"4359e6bf-ecd6-4a08-8e8a-b7c59b9a76c8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"P", "(", "f", ")"}], 
        RowBox[{"P", "(", 
         SubscriptBox["p", "i"], ")"}]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["p", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["q", "i"]}]]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"P", "(", 
           SubscriptBox["p", "i"], ")"}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["q", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["p", "i"]}]]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"e508b988-9e8c-40bc-81ac-2a224a52a65e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Par", "(", "p", ")"}], "=", 
    RowBox[{"Par", "(", "q", ")"}]}], TraditionalForm]],ExpressionUUID->
  "22c6b6c0-2479-4936-8ecb-5eccb9397a8e"],
 ":"
}], "Text",
 CellChangeTimes->{3.4355952085613966`*^9},
 CellTags->"b:4.3.4",ExpressionUUID->"6ebd1fc2-99d9-4848-b6ff-54662eec09c5"],

Cell[BoxData[{
 RowBox[{"dim", "=", " ", "..."}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["p",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"VecorSpace", "[", 
  RowBox[{
   StyleBox["q",
    FontSlant->"Italic"], ",", 
   RowBox[{"Dim", "\[Rule]", "dim"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PoissonAlgebra", "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["p",
      FontSlant->"Italic"], ",", 
     StyleBox["q",
      FontSlant->"Italic"]}], "}"}]}], "]"}]}], "Input",
 CellTags->"b:4.3.4",ExpressionUUID->"8d11a4f3-e0d1-4853-8ff3-1e1f71bd0d4d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[GothicP]\[GothicO]({\[Theta]})", "Subsubsection",
 CellTags->{
  "c:29", "b:4.3.4"},ExpressionUUID->"1a7918fa-4208-461d-996e-3c453b3d978b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       StyleBox["P",
        FontSlant->"Plain"], "[", "f", "]"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", " ", "f"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["\[Theta]", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "g"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["\[Theta]", "i"]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"14b614e6-a127-4346-9339-a8711ef6a5eb"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["P",
      FontSlant->"Plain"], "(", 
     SubscriptBox["\[Theta]", "i"], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"01ca0379-b018-4576-a6f4-fc62bb4c7c42"],
 ":"
}], "Text",
 Evaluatable->False,
 InitializationCell->True,
 TextAlignment->Left,
 TextJustification->0,
 AspectRatioFixed->True,
 CellTags->"b:4.3.4",ExpressionUUID->"7291d458-e6a3-467f-afc1-b1ca7512f57e"],

Cell[BoxData[{
 RowBox[{"VecorSpace", "[", 
  RowBox[{"\[Theta]", ",", 
   RowBox[{"Dim", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "n"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Symmetric", "[", "VTimes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["PoissonAlgebra",
   FontFamily->"Courier New"], "[", 
  RowBox[{
   StyleBox["name",
    FontSlant->"Italic"], ",", " ", 
   RowBox[{"{", "\[Theta]", "}"}]}], "]"}]}], "Input",
 CellTags->"b:4.3.4",ExpressionUUID->"12588a9c-95a1-4cfc-bd49-0833e77bb150"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[GothicP]\[GothicO]({p,\[Zeta],...,\[Eta],q}) and \
\[GothicP]\[GothicO]({p,\[Zeta],...,\[Theta],...,\[Eta],q})", "Subsubsection",\

 CellTags->{
  "c:30", "b:4.3.4"},ExpressionUUID->"7b388017-8f26-41ac-bfd8-ab7fc36082c2"],

Cell[TextData[{
 "This is a combination of the two forms above (where ",
 StyleBox["p",
  FontSlant->"Italic"],
 ", ",
 StyleBox["q",
  FontSlant->"Italic"],
 ", \[Zeta], \[Eta] are arbitrary superspaces,  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Par", "(", "p", ")"}], "=", 
    RowBox[{"Par", "(", "q", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c7abc10a-48c0-4441-a3f0-f2d92dc97f8c"],
 " and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Par", "(", "\[Zeta]", ")"}], "=", 
    RowBox[{"Par", "(", "\[Eta]", ")"}]}], TraditionalForm]],ExpressionUUID->
  "9d71373b-0f76-44b7-95a7-d6d95d971df6"],
 "; Both in \[GothicP]\[GothicO]({p,\[Zeta],...,\[Eta],q}) and in \[GothicP]\
\[GothicO]({p,\[Zeta],...,\[Theta],...,\[Eta],q}) any number of such pairs is \
possible; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["\[Theta]", "i"], ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"98f73dff-7911-4995-92ff-ec760010b135"],
 "):"
}], "Text",
