  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["f", "i"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["\[Theta]", "j"]}]], "-", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       SubscriptBox["f", "j"]}], 
      RowBox[{"\[PartialD]", 
       SubscriptBox["\[Theta]", "i"]}]], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "(", "\[Xi]", ")"}]], "2", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        SubscriptBox["g", "k"]}], 
       RowBox[{"\[PartialD]", 
        SubscriptBox["p", "0"]}]]}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"0984f101-6fdd-4f8e-940f-1369aeacec62"],
 "\tfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"i", ",", "j", ",", "k"}], ")"}], "\[Element]", 
    SubscriptBox["A", "3"]}], TraditionalForm]],ExpressionUUID->
  "492ae7d3-5bf4-435c-8b0a-cf9bbc830598"],
 "."
}], "Text",
