Cell[CellGroupData[{

Cell["Mapping", "Subsubsection",
 CellTags->{
  "i:116", "Mapping", "b:3.12", 
   "c:131"},ExpressionUUID->"75157109-9e4b-410f-b025-45df9c4b5329"],

Cell[TextData[{
 "The option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Mapping", "Name"], "\[Rule]", "f"}], TraditionalForm]],
  ExpressionUUID->"ddbcbeb3-6e5e-4c46-8564-591fc8046e14"],
 " instructs the sub- and quotientspace  constructors to define ",
 StyleBox["fn",
  FontSlant->"Italic"],
 " as a mapping function (immersion or projection). \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Mapping", "Name"], "[", 
    RowBox[{"U", ",", "V"}], "]"}], TraditionalForm]],ExpressionUUID->
  "efc1e50e-3f0c-42b5-a45e-103df80eee80"],
 " returns the last defined map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "\[LongRightArrow]", "V"}], TraditionalForm]],ExpressionUUID->
  "0697caec-d46a-4a9c-b98e-17b6c0b8a827"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Mapping", "b:3.12"},ExpressionUUID->"e5c2edb5-cac6-40dc-8588-70aa47865070"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MappingRule", "Subsubsection",
 CellTags->{
  "i:117", "MappingRule", "b:3.12", 
   "c:132"},ExpressionUUID->"83851157-a330-42ca-adbd-62f16d27c725"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["MappingRule", "Name"], "[", 
    RowBox[{"U", ",", "V"}], "]"}], TraditionalForm]],ExpressionUUID->
