Cell[CellGroupData[{

Cell["FilterBasis", "Subsubsection",
 CellTags->{
  "i:69", "FilterBasis", "b:3.5", 
   "c:73"},ExpressionUUID->"9fd0bc1b-ab91-4dc3-b1b4-77ea1966132f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FilterBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "f6bd065a-a746-49dc-89b8-f279e3164b9b"],
 " returns the list of elements of grades 0 to ",
 StyleBox["d",
  FontSlant->"Italic"],
 " in the symmetric algebra in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["x", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "ce192665-429c-4f74-a816-572aa75b9e01"],
 ". The grades of the indeterminates  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "4afeea2d-119c-476a-83ef-49d539e7eb50"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "5173f8a9-587d-4b88-a125-1627001d75ac"],
 " must be predefined.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FilterBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "6a0eaa89-3665-4a2c-96ab-3047b32871b8"],
 " uses ",
 StyleBox["op",
  FontSlant->"Italic"],
 " instead of ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FilterBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     FormBox[
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         RowBox[{"...", 
          SubscriptBox["x", "n"]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["d", "1"], ",", "...", ",", 
         SubscriptBox["d", "n"]}], "}"}]}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "c411d7ac-3b1e-4063-aeb1-73c1a31c72a2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FilterBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", "...", ",", 
       SubscriptBox["d", "n"]}], "}"}], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "b13e66e4-8949-4801-89bc-9213bbe7d1b6"],
 " list the monomials of grades 0 to ",
 StyleBox["d",
  FontSlant->"Italic"],
 " where the degree of each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "44bad02e-7d24-47c7-82b3-07502f9184dd"],
 " does not exceed ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "i"], TraditionalForm]],ExpressionUUID->
  "f81d2b47-8dc2-4e50-a846-00821042380c"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FilterBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7351e060-6e32-4ec5-99a7-6f3e1b1df88c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FilterBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     StyleBox["op",
      FontSlant->"Italic"], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "d7702c02-b2bd-49ce-8b7d-d76e865a8afe"],
 " return the list of elements in antisymmetric algebra.\nSee also ",
 ButtonBox["GradeBasis",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellChangeTimes->{{3.421503216526797*^9, 3.4215032186097918`*^9}},
 CellTags->{
  "FilterBasis", 
   "b:3.5"},ExpressionUUID->"f6415d2b-c84b-4c9e-984d-7127d893d176"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ForSplit", "Subsubsection",
 CellTags->{
  "i:70", "ForSplit", "b:3.5", 
   "c:74"},ExpressionUUID->"38d1d30b-1d73-4c42-9048-0f2d6497cb5a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ForSplit", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["expr",
        FontSlant->"Italic"], ",", " ", 
       StyleBox["memb",
        FontSlant->"Italic"], ",", " ", 
       StyleBox["cnt",
        FontSlant->"Italic"]}], "}"}], ",", " ", 
     StyleBox["body",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "2be1bfb0-9647-472f-b16b-f44fe9bd8428"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ForSplit", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["expr",
        FontSlant->"Italic"], ",", " ", 
       RowBox[{
        StyleBox["sel",
         FontSlant->"Italic"], "\[Rule]", 
        StyleBox["memb",
         FontSlant->"Italic"]}], ",", " ", 
       StyleBox["cnt",
        FontSlant->"Italic"]}], "}"}], ",", " ", 
     StyleBox["body",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "954381f1-6baf-407d-a3fa-89325fb0d09c"],
 " evaluates the ",
 StyleBox["body",
  FontSlant->"Italic"],
 " for each term of the",
 " ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " ",
 "sum or list ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ". The variables ",
 StyleBox["sel",
  FontSlant->"Italic"],
 " and ",
 StyleBox["memb",
  FontSlant->"Italic"],
 " are assigned to the current values of the selector and the member of the \
",
 StyleBox["expr",
  FontSlant->"Italic"],
 ", respectively. The optional ",
 StyleBox["cnt",
  FontSlant->"Italic"],
 " is the loop counter. The functions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Break", "Program"], "[", "]"}], TraditionalForm]],
  ExpressionUUID->"0a8eee66-7e43-4196-951e-c2c9cb4c5fe9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Continue", "Program"], "[", "]"}], TraditionalForm]],
  ExpressionUUID->"e5e46ac9-cf91-4928-93dd-e14b157e8d06"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Return", "Program"], "[", 
    StyleBox["value",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "248a24e5-b614-4029-83cd-53d6eaaf5a7b"],
 " can be used in the ",
 StyleBox["body",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{3.5828061589996376`*^9},
 CellTags->{
  "ForSplit", "b:3.5"},ExpressionUUID->"a05511e8-bf4f-4ee6-9427-a6267e0185e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FreeLieAlgebra", "Subsubsection",
 CellTags->{
  "i:71", "FreeLieAlgebra", "b:3.5", 
   "c:75"},ExpressionUUID->"ad93e616-1216-46b1-aa02-508b003da903"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["FreeLieAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", 
       RowBox[{"...", 
        SubscriptBox["g", "n"]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["r", "1"], ",", 
       RowBox[{"...", 
        SubscriptBox["r", "k"]}]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"5349d034-fbcc-4931-9c69-dbc294aaa2e7"],
 " defines the Lie (super)algebra \[GothicG] generated (as free Lie \
(super)algebra) by the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "cbf3219d-2c81-46ab-8d0e-7d852777b81c"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "n"], TraditionalForm]],ExpressionUUID->
  "5ebb47d4-32b0-4afa-b054-262f27c59afc"],
 " modulo relations ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "645092fa-c7f4-4fd3-82d1-bdda61ae4343"],
 ", ... ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "k"], TraditionalForm]],ExpressionUUID->
  "01a9a0e5-0e84-4fbd-8e73-8d04d87bdd6b"],
 ".\n\[FilledSmallSquare] Options ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Grade", "Program"], 
    StyleBox["\[Rule]", "Program"], 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["d", "1"], ",", 
      RowBox[{"...", 
       SubscriptBox["d", "n"]}]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "f7bea9d3-01ac-4605-9b56-94fd4e322a7e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PList", "Program"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["p", "1"], ",", "...", ",", 
      SubscriptBox["p", "n"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "0fbea13c-5d8a-439c-b786-0de0c156a4ff"],
 " define, respectively, the degrees and parities of the generators. By \
default, all degrees are equal to 1 and all parities are equal to 0.\n\
\[FilledSmallSquare] Options ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToGrade", "Program"], 
    StyleBox["\[Rule]", "Program"], "g"}], TraditionalForm]],ExpressionUUID->
  "71640638-240d-4857-9634-7dd0d0777a17"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToDegree", "Program"], "\[Rule]", "d"}], TraditionalForm]],
  ExpressionUUID->"b621109a-81fa-45be-9db2-814c22d53e8f"],
 " restrict the computation to elements with grade ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessEqual]", 
    StyleBox["g",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "ba7ff270-8d22-46ea-9e40-dd35de8dc2ec"],
 " that are expressed via generators as \"polynomials\" of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessEqual]", "d"}], TraditionalForm]],ExpressionUUID->
  "1d0895c9-42bc-4e4f-aca0-49ce763cc048"],
 ".\n\[FilledSmallSquare] Option ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Squaring", "\[Rule]", "True"}], "Program"], TraditionalForm]],
  ExpressionUUID->"47777bee-820f-442d-a5f9-d008757c56b0"],
 " instructs to include ",
 StyleBox["Squaring[", "Program"],
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["act]", "Program"],
 " instead of ",
 StyleBox["act[", "Program"],
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 StyleBox["]", "Program"],
 " in the basis of the generated algebra. This option is included by default \
if the algebras are over a field of charcteristic 2."
}], "Text",
