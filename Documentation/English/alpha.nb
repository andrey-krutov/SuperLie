Cell[CellGroupData[{

Cell["$ParamAssume", "Subsubsection",
 CellChangeTimes->{{3.5828119606402626`*^9, 3.5828119682027626`*^9}},
 CellTags->{
  "i:281", "$ParamAssume", "b:3.24", 
   "c:317"},ExpressionUUID->"a4786ec2-4bb0-4da1-8635-fc0491fb1333"],

Cell[TextData[{
 "The value of ",
 StyleBox["$ParamAssume", "Program"],
 " collects the cumulative list of assumptions made by consecuteve calls of \
",
 ButtonBox["ParamSolve",
  BaseStyle->"RefGuideLink"],
 " (including calls from other functions in case  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["$Solve",
     BaseStyle->"RefGuideLink"], "\[Equal]", 
    StyleBox["ParamSolve", "Program"]}], TraditionalForm]],ExpressionUUID->
  "69732771-0c4e-483b-8cb6-e5a5e5f8eb24"],
 "). The cases when these assumptions are violated should be regarded \
separately as exceptional cases."
}], "Text",
 CellChangeTimes->{{3.421509170147683*^9, 3.4215091893853455`*^9}, {
   3.5828120080308876`*^9, 3.5828121070465126`*^9}, {3.5828121423746376`*^9, 
   3.5828122318277626`*^9}, {3.5828122770777626`*^9, 
   3.5828123010152626`*^9}, {3.5828125773902626`*^9, 3.5828127005465126`*^9}, 
   3.5828130085152626`*^9, {3.5828130428590126`*^9, 3.5828131893121376`*^9}},
 CellTags->{
  "$ParamAssume", 
   "b:3.24"},ExpressionUUID->"8c7e80ed-32b0-4fee-8415-f65946967eb4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"$ParamAssume", "=", "False"}], "Program"], TraditionalForm]],
  ExpressionUUID->"0e660cac-dc19-4889-a1ff-4a5fc00e99ff"],
 " disables cumulative assumptions.\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"$ParamAssume", "=", 
     RowBox[{"{", "}"}]}], "Program"], TraditionalForm]],ExpressionUUID->
  "e780c940-3214-4566-9520-6938ac1b796d"],
 " clears the list of assumptions.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$ParamAssume", "Program"], 
    StyleBox["=", "Program"], 
    StyleBox["list", "Var"]}], TraditionalForm]],ExpressionUUID->
  "b3391e1f-51ae-4363-ba9b-fe100ec8fdd7"],
 " defines a set user-defined assumptions"
}], "Text",
 CellChangeTimes->{{3.421509170147683*^9, 3.4215091893853455`*^9}, {
   3.5828120080308876`*^9, 3.5828121070465126`*^9}, {3.5828121423746376`*^9, 
   3.5828122318277626`*^9}, {3.5828122770777626`*^9, 
   3.5828123819371376`*^9}, {3.5828124163590126`*^9, 3.5828125106090126`*^9}, 
   3.5828129922652626`*^9},
 CellTags->{
  "$ParamAssume", 
   "b:3.24"},ExpressionUUID->"e92fcde0-df2a-4234-ae8d-b107e11b237a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["$Solve", "Subsubsection",
 CellTags->{
  "i:282", "$Solve", "b:3.24", 
   "c:318"},ExpressionUUID->"db50d7bb-055f-4692-9bb3-4cb537f82bd0"],

Cell[TextData[{
 "The value of ",
 StyleBox["$Solve", "Program"],
 " is a user-defined function for solving the scalar equations. The default \
setting is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$Solve", "Program"], "=", 
    ButtonBox[
     StyleBox["Solve", "RefGuideLink"],
     BaseStyle->"Link",
     ButtonData:>"paclet:ref/Solve"]}], TraditionalForm]],ExpressionUUID->
  "0c9482d6-b691-4a78-a087-04ffebee9aaf"],
 ". "
}], "Text",
 CellChangeTimes->{
  3.4215092147918787`*^9, {3.6233149009523067`*^9, 3.623314915102337*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "$Solve", "b:3.24"},ExpressionUUID->"6bb870a4-ed63-4dd5-b4e5-cc6e2d070357"],

Cell[TextData[{
 "When the characteristic of the base field is changed (by means of ",
 ButtonBox["FieldChar",
  BaseStyle->"RefGuideLink"],
 "), the value of ",
 StyleBox["$Solve", "Program"],
 " is changed to  ",
 ButtonBox["ModSolve",
  BaseStyle->"RefGuideLink"],
 " (for positive characteristic) or ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    StyleBox["Solve", "RefGuideLink"],
    BaseStyle->"Link",
    ButtonData:>"paclet:ref/Solve"], TraditionalForm]],ExpressionUUID->
  "3e0a2f77-8dd2-4266-aa09-8fd51b4fc5a4"],
 " (zero characteristic). "
}], "Text",
 CellChangeTimes->{{3.4215092311353793`*^9, 3.421509235481629*^9}, {
  3.6233149674664373`*^9, 3.6233149874324727`*^9}, {3.623315037121567*^9, 
  3.6233150610766153`*^9}},
 CellTags->{
  "$Solve", "b:3.24"},ExpressionUUID->"f2888697-91a4-4dd7-bb75-2711ba80ab4c"],

Cell[TextData[{
 "See also ",
 ButtonBox["ParamSolve",
  BaseStyle->"RefGuideLink"],
 "."
}], "Text",
 CellChangeTimes->{{3.5828115883746376`*^9, 3.5828116260465126`*^9}},
 CellTags->{
  "b:3.24", "$Solve"},ExpressionUUID->"daa4cf3d-7204-4f7e-8e29-0ddcbcca356c"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
