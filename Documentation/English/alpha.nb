Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UpToDegreeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "...", ",", 
       SubscriptBox["x", "n"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"86a2a08e-20ad-4152-b8c5-14b49a0a7ec4"],
 " returns the a list of the elements of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessEqual]", "d"}], TraditionalForm]],ExpressionUUID->
  "ee7eb67d-e310-4be3-a44a-e3ebdebd13de"],
 " in the symmetric algebra in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"]}], TraditionalForm]],ExpressionUUID->
  "54c03ce5-f039-4f59-b90a-0f57523257a0"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UpToDegreeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "...", ",", 
       SubscriptBox["x", "n"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", "...", ",", 
       SubscriptBox["d", "n"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"4e9ee43e-a5b2-4855-b7a7-cab7001cdaa7"],
 " returns a list of the elements of degree ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LessEqual]", "d"}], TraditionalForm]],ExpressionUUID->
  "36485ece-99f6-4355-b3fd-2cb442cc3251"],
 " in the symmetric algebra in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"]}], TraditionalForm]],ExpressionUUID->
  "e58dbe12-ba59-4d83-b42a-49c53454d27f"],
 ", where the degree of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "6b339896-36e8-4f01-a84b-eb2b7eef91a0"],
 " does not exceed  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "i"], TraditionalForm]],ExpressionUUID->
  "0d623503-7525-4753-9f53-37d8be1321cc"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UpToDegreeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "...", ",", 
       SubscriptBox["x", "n"]}], "}"}], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "2f8cff5a-5410-4e10-a558-01d511b1a196"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UpToDegreeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "...", ",", 
       SubscriptBox["x", "n"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", "...", ",", 
       SubscriptBox["d", "n"]}], "}"}], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7e8cb4dc-8942-4137-b6f4-5dd779bc56ca"],
 " use ",
 StyleBox["op",
  FontSlant->"Italic"],
 " instead of ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UpToDegreeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "...", ",", 
       SubscriptBox["x", "n"]}], "}"}], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7788fc82-eb1f-4685-9182-68c67b464743"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UpToDegreeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "...", ",", 
       SubscriptBox["x", "n"]}], "}"}], ",", 
     StyleBox["op",
      FontSlant->"Italic"], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "91ab2288-decd-49d5-a950-b9779f718302"],
 " return the elements of an antisymmetric algebra. "
}], "Text",
 CellChangeTimes->{{3.4215076887475348`*^9, 3.421507737167158*^9}, {
  3.421507770154592*^9, 3.4215077709857874`*^9}},
 CellTags->{
  "UpToDegreeBasis", 
   "b:3.20"},ExpressionUUID->"edb7fa17-8db5-4110-9778-34988620aab3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["UseAsSymbol", "Subsubsection",
 CellTags->{
  "i:247", "UseAsSymbol", "b:3.20", 
   "c:276"},ExpressionUUID->"371c30d2-d488-4f32-9789-4f4ff3b866ee"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UseAsSymbol", "Program"], "[", "e", "]"}], TraditionalForm]],
  ExpressionUUID->"049d700c-e5f1-48e5-8592-0b0f6a15fd5e"],
 " allows one to use the expression ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "0508d185-8008-42e9-9fec-f39ca772a09d"],
 " as a single symbol. So ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "120c1521-27e6-4686-a5ba-8ba104cd29d2"],
 " may be used, e.g.,  as a module's name. Typically, expressions in a \
symbol-like standard form (such as ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "^"], TraditionalForm]],ExpressionUUID->
  "fe62f721-78f7-42d2-91ec-6f489896e521"],
 ") are used as symbols. "
}], "Text",
 CellChangeTimes->{{3.421507779738373*^9, 3.4215077806596975`*^9}},
 CellTags->{
  "UseAsSymbol", 
   "b:3.20"},ExpressionUUID->"dd8e4ccb-505a-4bae-880d-c674c16edea2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["V", "Subsection",
 CellTags->{
  "b:3.21", "c:277"},ExpressionUUID->"238eecbc-df07-40cf-ad38-3529258d754f"],

Cell[CellGroupData[{

Cell["VBasis", "Subsubsection",
 CellTags->{
  "i:248", "VBasis", "b:3.21", 
   "c:278"},ExpressionUUID->"7f97732a-b006-41fa-ac30-f8aaeecd1074"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VBasis", "Program"], "[", 
    StyleBox["expr",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "c93951f7-1ea8-483e-b010-be9d23daa85c"],
 " returns the list of different linear vector terms encountered in the \
expression. "
}], "Text",
 CellTags->{
  "VBasis", "b:3.21"},ExpressionUUID->"b09f5e9a-5c01-4723-b8f8-45b0ecf9f223"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VCollect", "Subsubsection",
 CellTags->{
  "i:249", "VCollect", "b:3.21", 
   "c:279"},ExpressionUUID->"5be0f70b-6b4c-406a-acb5-e9f9bc7fbae2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VCollect", "Program"], "[", 
    StyleBox["expr", "Var"], "]"}], TraditionalForm]],ExpressionUUID->
  "3f0d2d8b-0487-4d11-947b-71b4b6e0ee55"],
 " tries to simplify the expression ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " by collecting together the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "i"], "*", "v"}], TraditionalForm]],ExpressionUUID->
  "df0db7aa-b305-4e95-9333-4da628c08804"],
 " with the same ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "0bfe8ede-342c-4bb1-8983-035d38f7adf5"],
 ". "
}], "Text",
 CellTags->{
  "VCollect", 
   "b:3.21"},ExpressionUUID->"f3d6413a-7cdd-4d97-a105-a4bfd73b18cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Vector", "Subsubsection",
 CellTags->{
  "i:250", "Vector", "b:3.21", 
   "c:280"},ExpressionUUID->"1cb6d458-3d84-4469-80be-042280eb02be"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Vector", "Program"], "[", 
    RowBox[{"v", ",", 
     RowBox[{"w", "..."}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "e8bbb526-d00f-4ba7-b7c0-9bff2010f26d"],
 " declares that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", ",", " ", "w", ",", " ", "..."}], TraditionalForm]],
  ExpressionUUID->"5cb01a1f-51a4-4c84-83ed-be5f4ff73256"],
 " are vectors. Any expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "[", "...", "]"}], TraditionalForm]],ExpressionUUID->
  "56fed40f-6ab3-4248-b9fb-5c10a7d5c84b"],
 " whose header is declared a vector, is also a vector. So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Vector", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"7d34d95b-3a9b-4b89-89cd-8ce019232448"],
 " may be used to declare function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "d6295ecd-6323-45aa-907c-0c860879de32"],
 " vector-valued. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Vector", "Name"], "[", 
    RowBox[{"f", "\[Rule]", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "2899a511-c8c0-4348-8d4d-17b37559e9ff"],
 " declares the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "6e43a785-81ae-4268-bd8a-4a5d30686d68"],
 "-th operand of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "4cc6f95a-0264-4378-a04a-4ddc769706f3"],
 " a vector. Here ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "a54f9db3-4232-4081-9e91-e50bfce5baaf"],
 " may be a number, ",
 StyleBox["First", "Program"],
 ", ",
 StyleBox["Last", "Program"],
 ", ",
 StyleBox["All", "Program"],
 " or ",
 StyleBox["_", "Program"],
 ". "
}], "Text",
 CellChangeTimes->{{3.421507803372357*^9, 3.4215078453927794`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Vector", "b:3.21"},ExpressionUUID->"ce735fef-aa41-488a-9dfa-20bf4dc3df31"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VectorLieAlgebra", "Subsubsection",
 CellTags->{
  "i:251", "VectorLieAlgebra", "b:3.21", 
   "c:281"},ExpressionUUID->"392853e6-76f1-49fa-af2c-3f38eeb1f392"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VectorLieAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "x"}], "]"}], TraditionalForm]],
  ExpressionUUID->"0e8c08dd-da4c-4177-bcb9-672d48d23762"],
 " defines a Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "=", 
    RowBox[{"\[GothicV]\[GothicE]\[GothicC]\[GothicT]", "(", "x", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"15308d41-6790-48be-a644-216014a42840"],
 " of vector fields on the space ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "8fb68d16-56ed-4735-8709-96a58ead1ce2"],
 " and its action on the (super)space of polynomials and polyvectors on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "8db387ea-e2bc-4044-a640-22f9c05b7fcb"],
 ". The space ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "930427e2-4e72-415c-b4ff-941b36a71afe"],
 " should be defined, together with the space of left even forms on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "ff1b2ba6-387a-4992-800d-cf857ac26395"],
 " (",
 ButtonBox["CoLeft",
  BaseStyle->"AddOnsLink"],
 " space). "
}], "Text",
 CellChangeTimes->{{3.421508462139618*^9, 3.4215084791040115`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VectorLieAlgebra", 
   "b:3.21"},ExpressionUUID->"15bc11ca-f2ff-4d85-b955-01ee52cdad8c"],

Cell[TextData[{
 "The basis of ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "a0e285a0-91a1-4d86-b840-746c7fd8f6ba"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "i"], "[", "x", "]"}], "**", 
     RowBox[{"v", "[", "j", "]"}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "90f91bca-071f-4118-b6c2-16b58417df1b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["p", "i"], "[", "x", "]"}], "}"}], TraditionalForm]],
  ExpressionUUID->"462482c2-bbf8-4a1e-93c1-7e0501409ddb"],
 " is the basis of the (super)space of polynomials on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "9d328a26-b433-446a-a6c5-860f69b22a99"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"v", "[", "j", "]"}], "}"}], TraditionalForm]],ExpressionUUID->
  "eb837ee0-f783-458d-8e70-48325e9efa68"],
 " is the basis of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CoLeft", "Program"], "[", "x", "]"}], TraditionalForm]],
  ExpressionUUID->"29d57e94-23ac-49fd-9707-bfb0fedf8342"],
 " (the space of left even linear forms on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "68aef752-e465-4d03-ae0d-10d3fa54a2fe"],
 "). The name of the Lie bracket and the action is (by default) ",
 StyleBox["Lb", "Program"],
 ", the unevaluated form is ",
 StyleBox["lb", "Program"],
 ". \nUnless the space ",
 StyleBox["x",
  FontSlant->"Italic"],
 " was already graded, the standard grading is defined on ",
 StyleBox["x",
  FontSlant->"Italic"],
 " assuming ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Deg", "Name"], "[", 
     SubscriptBox["x", "i"], "]"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"1846a023-beb1-4dbd-9097-09907a450c55"],
 ". The grading of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "60d226fd-bb05-4464-8a82-83caf7553534"],
 " induces a grading of ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "2d5d2d4d-c113-4ac6-9645-da0c861dd1dc"],
 ". \nThe algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "8a4e6113-08c8-457a-beb1-a39397c8c21b"],
 " may be regraded by calling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["ReGrade",
     BaseStyle->"AddOnsLink"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     StyleBox["grading",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "38ee41aa-9bf1-4af7-9b71-14e9ebc78fc1"],
 ". The predefined gradings are numbered from 0 to the odd dimension of ",
 StyleBox["x", "Var"],
 ". In the ",
 StyleBox["i", "Var"],
 "-th grading, the first ",
 StyleBox["i",
  FontSlant->"Italic"],
 " odd element of the basis of ",
 StyleBox["x",
  FontSlant->"Italic"],
 " have degree 0, all other ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "j"], "'"}], "s"}], TraditionalForm]],ExpressionUUID->
  "b1e28a5d-98fe-4940-a43b-7e1fb775d1b6"],
 " have degree 1. "
}], "Text",
 CellChangeTimes->{{3.421508513022784*^9, 3.4215085220257297`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VectorLieAlgebra", 
   "b:3.21"},ExpressionUUID->"7cc685a8-9bda-4992-81d3-a0e4b6f6f5b8"],

Cell[TextData[{
 "The following options alter the default operation names: \n",
 StyleBox["Lb", "Program"],
 " is the name of the Lie bracket (the default is ",
 StyleBox["Lb", "Program"],
 ") \n",
 StyleBox["CTimes", "Program"],
 " is the name of the tensor multiplication ",
 StyleBox["**", "Program"],
 " (the default is ",
 StyleBox["NonCommutativeMultiply", "Program"],
 ", a synonym of ",
 StyleBox["Tp", "Program"],
 ") \n",
 StyleBox["Wedge", "Program"],
 " is the associative multiplication in the (super)space of polyvectors (the \
default is ",
 StyleBox["wedge", "Program"],
 "). "
}], "Text",
 CellChangeTimes->{{3.4215085665197086`*^9, 3.421508626205533*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VectorLieAlgebra", 
   "b:3.21"},ExpressionUUID->"3e5fc9bc-e2aa-41dc-9b40-e571dc0b2002"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VectorRepresentation", "Subsubsection",
 CellTags->{
  "i:251", "VectorRepresentation", "b:3.21", 
   "c:282"},ExpressionUUID->"f48833b1-021f-4169-a9c1-f5ae4192be8b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VectorRepresentation", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "v"}], "]"}], TraditionalForm]],
  ExpressionUUID->"7935d6b9-4c01-46b4-8f3b-44534aaab16b"],
 " defines the ",
 ButtonBox["Mapping",
  BaseStyle->"AddOnsLink"],
 " of the Lie (super)algebra \[GothicG] to the vectorial Lie algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"\[GothicV]\[GothicE]\[GothicC]\[GothicT]", "(", "x", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"d3b85e28-c30a-4916-ba3d-6faf1e172dca"],
 ", where ",
 StyleBox["x",
  FontSlant->"Italic"],
 " is a \[GothicG]-module. \nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Mapping", "Program"], "\[Rule]", 
    StyleBox["fn",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "b2492ecb-0b58-4c19-9136-cab27bfd7ce9"],
 " gives the function that implements the mapping. "
}], "Text",
 CellChangeTimes->{{3.4215086588224335`*^9, 3.421508673713846*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VectorRepresentation", 
   "b:3.21"},ExpressionUUID->"117f02fc-3da7-4662-953f-c71406c1a975"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VectorQ", "Subsubsection",
 CellTags->{
  "i:252", "VectorQ", "b:3.21", 
   "c:283"},ExpressionUUID->"626c22ce-1909-44a1-937c-0e5cc60f2ab9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VectorQ", "Program"], "[", "x", "]"}], TraditionalForm]],
  ExpressionUUID->"614f2871-9bef-4903-b266-bc3d8abec83e"],
 " returns ",
 StyleBox["True", "Program"],
 " if ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "df4c44fc-ac12-4e19-87a6-0d664484efb0"],
 " is an object of ",
 StyleBox["Vector", "Program"],
 " domain. "
}], "Text",
 CellTags->{
  "VectorQ", "b:3.21"},ExpressionUUID->"eced31ab-bbbb-45de-8898-b0b374c3c002"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VectorSpace", "Subsubsection",
 CellTags->{
  "i:253", "VectorSpace", "b:3.21", 
   "c:284"},ExpressionUUID->"4155c5db-db60-4691-b280-b6647ab2ce16"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VectorSpace", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"83169943-0d86-4e18-857b-6cb05f61452c"],
 " defines the vector space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "734a0f97-9f02-4fde-acf5-e41f84669ce2"],
 ". The dimension and parities may be given by optional parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["Dim", "Program"],
      BaseStyle->"AddOnsLink"], "Program"], "\[Rule]", "d"}], 
   TraditionalForm]],ExpressionUUID->"f6d56d70-2d22-4927-b766-bd27fbeb5483"],
 " or  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["PList", "Program"],
      BaseStyle->"AddOnsLink"], "Program"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["p", "1"], ",", 
      RowBox[{"...", 
       SubscriptBox["p", "n"]}]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "89c74b44-f9ba-414d-9754-6c4fb77d5c3f"],
 ". "
}], "Text",
 CellChangeTimes->{{3.42150881126163*^9, 3.4215088122129984`*^9}},
 CellTags->{
  "VectorSpace", 
   "b:3.21"},ExpressionUUID->"0c3fb2aa-dc3a-42eb-9f2b-de3771ead10a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VExpand", "Subsubsection",
 CellTags->{
  "i:254", "VExpand", "b:3.21", 
   "c:285"},ExpressionUUID->"a569da1c-770c-4477-b459-40faa277cba9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VExpand", "Program"], "[", 
    StyleBox["expr",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "2f0271e9-445c-4db4-9fd4-c7ccdec1b6f7"],
 " expands out all ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["SVTimes",
  BaseStyle->"AddOnsLink"],
 "  products in ",
 StyleBox["expr",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellTags->{
  "VExpand", "b:3.21"},ExpressionUUID->"a2afe099-52b9-4f0e-8256-6cbbd1f292d3"]
}, Open  ]],

