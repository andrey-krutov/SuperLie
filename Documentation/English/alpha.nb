Cell[CellGroupData[{

Cell["OKAlgebra", "Subsubsection",
 CellTags->{
  "i:136", "OKAlgebra", "b:3.14", 
   "c:152"},ExpressionUUID->"b96313f5-c1d5-4fa3-b841-c7b1cd6acccd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["OKAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", " ", ",", "t"}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"1f0fcc51-00c0-4dd3-b8cb-055a2d1383dc"],
 "  defines the \"odd\" Contact algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "aca6d1e6-9fa6-4775-a8c9-bdc33f728a3a"],
 " as the contact algebra on the space of polynomials in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox["x", "1"],
     TraditionalForm], ",", "...", 
    RowBox[{",", 
     SubscriptBox["x", "n"], ",", 
     SubscriptBox["y", "1"], ",", 
     RowBox[{"...", 
      SubscriptBox["y", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "49fc9899-e216-4633-8bd0-0f1c7cf95f4f"],
 " and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "ab580fb6-c4ef-46d5-8467-598e65159e64"],
 " with the odd contact bracket ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"{", 
     RowBox[{".", 
      RowBox[{",", "."}]}], "}"}], 
    RowBox[{"m", ".", "b", "."}]], TraditionalForm]],ExpressionUUID->
  "7d8ea31d-3bb3-4bf9-a9df-3ea74e189fe9"],
 ". The Buttin bracket ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"{", 
     RowBox[{".", 
      RowBox[{",", "."}]}], "}"}], 
    RowBox[{"B", ".", "b", "."}]], TraditionalForm]],ExpressionUUID->
  "933b457e-f563-48ea-8bc1-a47df76e70d9"],
 " is also defined. The spaces ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "5ba85039-577c-4576-a361-0d27a513b7bf"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "f0feba91-f83e-4791-a2d4-1c1b594245bb"],
 " should be already defined (as for ",
 ButtonBox["ButtinAlgebra",
  BaseStyle->"AddOnsLink"],
 ")."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.4215046876621857`*^9, 3.4215046957337923`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "OKAlgebra", 
   "b:3.14"},ExpressionUUID->"72d7f404-3a69-47e0-a25b-64c39c8fb19c"]
}, Open  ]],

