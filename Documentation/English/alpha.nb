Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SplitList", "Program"], "[", 
    RowBox[{
     StyleBox["list",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["ptrn",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7f1ca84d-ec94-4049-834e-0ec582122692"],
 " transforms the list of vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], "*", 
      SubscriptBox["v", "1"]}], ",", " ", 
     RowBox[{
      SubscriptBox["c", "2"], "*", 
      SubscriptBox["v", "2"]}], ",", " ", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"0c9ff908-fda4-454b-bd2e-940cb7c41d6d"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", " ", 
    SubscriptBox["v", "2"], ",", "..."}], TraditionalForm]],ExpressionUUID->
  "bbba5c10-e0ea-40e3-869a-928d5e7f34bb"],
 " matching pattern ",
 StyleBox["ptrn",
  FontSlant->"Italic"],
 ", gathering terms with equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"v", "'"}], "s"}], TraditionalForm]],ExpressionUUID->
  "e934039c-471e-4289-8117-7c8a41657bac"],
 ". The result is the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["v", 
       SubscriptBox["\[Sigma]", "1"]], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["c", 
         SubscriptBox["\[Tau]", "11"]], ",", 
        SubscriptBox["c", 
         SubscriptBox["\[Tau]", "12"]], ",", ".."}], "}"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["v", 
       SubscriptBox["\[Sigma]", "2"]], "\[Rule]", 
      RowBox[{"{", "...", "}"}]}], ",", " ", "..."}], " ", "}"}], 
   TraditionalForm]],ExpressionUUID->"9107b99f-acbb-4d48-8bf5-aa4ab787c637"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", 
    RowBox[{
     SubscriptBox["v", 
      SubscriptBox["\[Sigma]", "1"]], ",", 
     SubscriptBox["v", 
      SubscriptBox["\[Sigma]", "2"]], ",", "..."}], " ", "}"}], 
   TraditionalForm]],ExpressionUUID->"90f2fda6-a3dc-4c05-930a-cba03a5b4ba5"],
 " is a sorted list of different ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["v", "i"], "'"}], "s"}], TraditionalForm]],ExpressionUUID->
  "4a6d0577-179e-4b57-803e-e2e50eb8296d"],
 " in the ",
 StyleBox["list",
  FontSlant->"Italic"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["c", 
      SubscriptBox["\[Tau]", 
       RowBox[{"i", ",", "1"}]]], ",", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"e697aa37-c970-416d-84da-494adfb0803b"],
 " is the list of coefficients of all vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "k"], TraditionalForm]],ExpressionUUID->
  "9bd6f44b-0623-4097-a7c3-36130545a661"],
 " equal to",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["v", 
     SubscriptBox["\[Sigma]", "i"]]}], TraditionalForm]],ExpressionUUID->
  "111b8491-d721-44ab-8d77-bf9c57edc032"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SplitList", "Program"], "[", 
    RowBox[{
     StyleBox["list",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["ptrn",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["f",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "bf3f2ed1-5cc0-4da0-b14d-260fef50aa2f"],
 " transforms the list of vectors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], "*", 
      SubscriptBox["v", "1"]}], ",", " ", 
     RowBox[{
      SubscriptBox["c", "2"], "*", 
      SubscriptBox["v", "2"]}], ",", " ", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"298d2498-7bcf-4763-8b9d-b670d39faace"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", " ", 
    SubscriptBox["v", "2"], ",", "..."}], TraditionalForm]],ExpressionUUID->
  "49e12521-a55c-4f95-91a8-a1fe6061c6cc"],
 " matching pattern ",
 StyleBox["ptrn",
  FontSlant->"Italic"],
 " into a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["f", "1"], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["e", "11"], ",", "..."}], "}"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["f", "2"], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["e", "21"], ",", "..."}], "}"}]}], ",", " ", "..."}], 
    " ", "}"}], TraditionalForm]],ExpressionUUID->
  "d9079654-ccc9-4705-8a9b-7637fc5723ad"],
 ",  where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", 
    RowBox[{
     SubscriptBox["f", "1"], ",", " ", 
     SubscriptBox["f", "2"], ",", " ", "..."}], " ", "}"}], TraditionalForm]],
  ExpressionUUID->"66f6a81b-b612-4c14-aa43-f1d3556eb5c6"],
 " is a sorted list of different values ",
 Cell[BoxData[
  FormBox[
   RowBox[{"of", " ", 
    RowBox[{"f", "[", 
     SubscriptBox["v", "i"], "]"}]}], TraditionalForm]],ExpressionUUID->
  "e87b9da2-fc04-475d-96e2-726811e16ec4"],
 " and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["e", 
      RowBox[{"i", " ", "1"}]], ",", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"7f5686c6-c556-4e93-93f6-3cc725af5385"],
 " is the list of the terms of ",
 StyleBox["list",
  FontSlant->"Italic"],
 " giving value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "i"], TraditionalForm]],ExpressionUUID->
  "a625a7ff-2546-4470-be5e-6ce8cba0263c"],
 " of the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "b24641ce-2c16-4306-bf72-8689be046881"],
 " (not including members with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     SubscriptBox["v", "i"], "]"}], "\[Equal]", 
    StyleBox["SkipVal", "Program"]}], TraditionalForm]],ExpressionUUID->
  "f7b1515f-5575-40c1-ace8-f732d8ee3b0d"],
 ")."
}], "Text",
 CellChangeTimes->{{3.42150659241108*^9, 3.421506595235141*^9}},
