   RowBox[{
    StyleBox["Image", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"a636cb89-6994-4d8a-8c4e-057ee6372326"],
 " returns the list of images of basis elements of ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "87812a52-6b3e-430b-8835-569d787ed7b7"],
 " if ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "c3e9cd3d-5a0c-488c-9bc6-7a1bfe61218d"],
 " is defined as a subspace (subalgebra, submodule)."
}], "Text",
 CellTags->{
  "Image", "b:3.8"},ExpressionUUID->"867737d7-d918-492e-bf8e-87a5efb5cb8d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["InSpace", "Subsubsection",
 CellTags->{
  "i:97", "InSpace", "b:3.8", 
   "c:110"},ExpressionUUID->"bc660909-5d6e-4e90-9b3d-fdc6ecca5255"],

Cell[TextData[{
 "If a space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "0a174057-1055-4051-9e33-726cd007b559"],
 " is defined as subspace (subalgebra, submodule), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["InSpace", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"83f26e8a-b6cf-4e5d-b394-be932c7c90ae"],
 " returns the name of the ambient space."
}], "Text",
 CellTags->{
  "InSpace", "b:3.8"},ExpressionUUID->"44784c23-325b-4fb4-86b5-8aaadd8ee702"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["J", "Subsection",
 CellTags->{
  "b:3.9", "c:111"},ExpressionUUID->"07637858-4735-4692-a12e-abea614d538f"],

Cell[CellGroupData[{

Cell["Jacobi", "Subsubsection",
 CellTags->{
  "i:98", "Jacobi", "b:3.9", 
   "c:112"},ExpressionUUID->"3b62cefe-c895-46b0-a285-9da56091839a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Jacobi", "Program"], "[", 
    RowBox[{"f", "\[Rule]", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "81ddd095-d7cf-475a-b5ce-fd176c4d3b75"],
 " introduces the property (",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "f1f2033c-5aa4-4896-9be3-13b42888f356"],
 " acts as a bracket in Lie superalgebras):\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", " ", 
      RowBox[{"g", "[", 
       RowBox[{
        SubscriptBox["y", "1"], ",", 
        SubscriptBox["y", "2"], ",", ".."}], "]"}]}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"x", ",", 
           SubscriptBox["y", "1"]}], "]"}], ",", 
         SubscriptBox["y", "2"], ",", ".."}], "]"}], " ", "\[PlusMinus]", " ", 
       RowBox[{"g", "[", 
        RowBox[{
         SubscriptBox["y", "1"], ",", 
         RowBox[{"f", "[", 
          RowBox[{"x", ",", 
           SubscriptBox["y", "2"]}], "]"}], ",", "..."}], "]"}]}], " ", 
      "\[PlusMinus]"}], " ", "..."}]}], TraditionalForm]],ExpressionUUID->
  "b9086062-afdc-4f41-925c-ca496183d332"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Jacobi", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "..."}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"88e50586-4c85-41d7-ba93-585544d0047d"],
 " introduces this property for every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "b7b21e8f-c26a-4e54-91ab-583ed0d2d0cc"],
 "."
}], "Text",
 CellChangeTimes->{{3.421504401841195*^9, 3.4215044021716704`*^9}, {
  3.423237731591669*^9, 3.423237735597429*^9}},
 CellTags->{
  "Jacobi", "b:3.9"},ExpressionUUID->"4a4496be-b1d4-499c-ab30-6c0286c5b663"]
}, Open  ]],

Cell[CellGroupData[{

Cell["JacobiRule", "Subsubsection",
 CellTags->{
  "i:99", "JacobiRule", "b:3.9", 
   "c:113"},ExpressionUUID->"7d4636b7-b0d1-4632-8ee6-5cb616b77b0e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["JacobiRule", "Program"], "[", 
    RowBox[{"f", ",", " ", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ba38bf05-6afc-47c6-a912-1ac3d6439451"],
 " returns the rule which expands  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{"g", "[", 
      RowBox[{
       SubscriptBox["x", "1"], ",", "..."}], "]"}], ",", "..."}], "]"}], 
   TraditionalForm]],ExpressionUUID->"c7d8c498-3b40-4e86-bb7c-a347e1474641"],
 " into the sum of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", " ", 
    RowBox[{"g", "[", 
     RowBox[{"...", ",", " ", 
      RowBox[{"f", "[", 
       RowBox[{
        SubscriptBox["x", "i"], ",", "..."}], "]"}], " ", ",", "..."}], 
     "]"}]}], TraditionalForm]],ExpressionUUID->
  "c5e3ab9c-9839-4e40-94ef-5d96ea2ea54b"],
 " (like the bracket in the Lie superalgebra).\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["JacobiRule", "Name"], "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"10ec1b8f-43e7-4934-bc96-41c6b08954ff"],
 " returns the list of rules for the functions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "d8f5e30f-a2d0-4fdc-9163-db03516d6e8f"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "k"], TraditionalForm]],ExpressionUUID->
  "361d5436-e000-4bfd-93db-431afee481a9"],
 "."
}], "Text",
 CellChangeTimes->{{3.421504418705445*^9, 3.421504421890024*^9}},
 CellTags->{
  "JacobiRule", 
   "b:3.9"},ExpressionUUID->"77a1cacb-cc00-46d3-bc36-35082fa71022"]
}, Open  ]],

