 ". The function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "64cb974b-7be4-408f-af37-df01b10a6cec"],
 " should be declared  vector- or scalar-valued. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LogPowerRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1b44c917-d8b9-4b03-b73f-669ff3146fd3"],
 " returns the rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     SuperscriptBox["x", "r"], "]"}], "\[Rule]", 
    RowBox[{
     StyleBox["op",
      FontSlant->"Italic"], "[", 
     RowBox[{"r", ",", 
      RowBox[{"f", "[", "x", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"87718a02-8484-48b2-9f64-c2db147ccc1f"],
 "."
