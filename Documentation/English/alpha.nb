Cell[CellGroupData[{

Cell["RestrictModule", "Subsubsection",
 CellTags->{
  "i:174", "RestrictModule", "b:3.17", 
   "c:195"},ExpressionUUID->"2f0c7d59-ddd3-417a-9afa-46716db429f0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RestrictModule", "Program"], "[", 
    RowBox[{"V", ",", "\[GothicG]"}], "]"}], TraditionalForm]],ExpressionUUID->
  "6bc3cafc-7459-4b99-8e0a-4647e98ab49f"],
 " defines an action of \[GothicG] on ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "b3f31a07-ca49-4a64-ada5-808b67c3b26e"],
 ", if ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "db983481-1e8a-4074-a022-b096c20c5489"],
 " is a defined as a subspace of some \[GothicG]-module. It is an error if \
the ",
 StyleBox["V",
  FontSlant->"Italic"],
 " is not closed with respect to the action of \[GothicG]."
}], "Text",
 CellChangeTimes->{{3.421506356882406*^9, 3.4215063575934286`*^9}},
 CellTags->{
  "RestrictModule", 
   "b:3.17"},ExpressionUUID->"aef218a3-21de-4a10-8478-6dafb80f5bc6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RootReflection", "Subsubsection",
 CellTags->{
  "RootReflection", "b:3.17", 
   "c:196"},ExpressionUUID->"beb68d3e-b703-496c-a6c5-d8f4d2d2c748"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RootReflection", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "\[Alpha]", ",", "\[Lambda]"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"e542b438-e9c5-40d5-b175-d472b483935d"],
 " reflects the weight \[Lambda] with respect to the root ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], ",", "..."}], "}"}]}]],ExpressionUUID->
  "5a15879f-1b30-4b82-8fb3-8116c3ccfdd2"],
 ". This function is defined for Lie (super)algebras built from Cartan \
matrix, see ",
 ButtonBox["CartanMatrixAlgebra",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RootReflection", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "i", ",", "\[Lambda]"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"3548dc09-e14e-4782-8a93-8fe3b07aa601"],
 " for integer ",
 StyleBox["i",
  FontSlant->"Italic"],
 " reflects the weight \[Lambda] with respect to the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "-th simple root.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RootReflection", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "\[Alpha]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"ee94af2e-76bd-4b44-a833-54aa8943534b"],
 " returns the matrix of the reflection with respect to the root \[Alpha]."
}], "Text",
 CellChangeTimes->{{3.4215063871759663`*^9, 3.4215063926137857`*^9}, {
   3.4215064289460287`*^9, 3.4215064339031568`*^9}, 3.421506489563192*^9},
 CellTags->{
  "RootReflection", 
   "b:3.17"},ExpressionUUID->"4247d863-9db3-4214-8140-9440d494b786"]
}, Open  ]]
}, Open  ]],

