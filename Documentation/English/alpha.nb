Cell[TextData[{
 "For any space name or other vector symbol or expression ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "16e19cb3-8403-4182-8750-c8d3acc8afb4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TheSpace", "Program"], "[", "x", "]"}], TraditionalForm]],
  ExpressionUUID->"c4f49bbf-8f91-497d-89ea-4f7df11c7c8a"],
