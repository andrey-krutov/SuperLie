  "2e97425d-b7a8-4139-a3b0-333b466f7417"],
 " of a given space ",
 StyleBox["W",
  FontSlant->"Italic"],
 " under the action of operator the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", ":", "V"}], "\[Rule]", "W"}], TraditionalForm]],
  ExpressionUUID->"9435a447-d608-4a7f-b19a-a531cedb22d9"],
 ". Each of the spaces ",
 StyleBox["V",
  FontSlant->"Italic"],
 " and ",
 StyleBox["W",
  FontSlant->"Italic"],
 " is given either as a general sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["c", "1"], 
        SubscriptBox["v", "1"]}], "+"}], "..."}], "+", 
     RowBox[{
      SubscriptBox["c", "n"], 
      SubscriptBox["v", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d87b038a-9337-4f91-88bc-d2ff11299d4a"],
 " with arbitrary vector expressions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", "...", ",", 
    SubscriptBox["v", "n"]}], TraditionalForm]],ExpressionUUID->
  "6eeb7566-44c4-4511-8260-bc4a48706f84"],
 " or as a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["v", "1"], ",", "...", ",", 
      SubscriptBox["v", "n"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "cb0efb98-fba3-4866-b754-a1e5517fd2b2"],
 ". The result is represented as a general sum  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["e", "1"]}], "+"}], "..."}], "+", 
    RowBox[{
     SubscriptBox["c", "k"], 
     SubscriptBox["e", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "449142c0-a584-4c5c-99e7-eabd846819bd"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "i"], TraditionalForm]],ExpressionUUID->
  "1b3f53af-fe6e-446e-8792-1bdb4e3ba032"],
 " are linear combinations of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "2b20e005-a2a1-4d10-a9db-d5e49d47632c"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralInverseImage", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["f", "1"], ",", "..."}], "}"}], ",", 
     StyleBox["v",
      FontSlant->"Italic"], ",", 
     StyleBox["cv",
      FontSlant->"Italic"], ",", "w", ",", 
     StyleBox["cw",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "dda9563a-6465-4582-9752-b622677d91a7"],
 " returns the intersection of the preimages ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["f", "i", 
     RowBox[{"-", "1"}]], "[", "W", "]"}], TraditionalForm]],ExpressionUUID->
  "f70f8781-f674-4d2e-8d4e-7e75f4873249"],
 "."
}], "Text",
