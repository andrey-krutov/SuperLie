Cell[CellGroupData[{

Cell["Times$", "Subsubsection",
 CellTags->{
  "i:219", "Times$", "b:3.19", 
   "c:245"},ExpressionUUID->"391a1e47-e276-4eac-9b61-7b1bf00b7465"],

Cell[TextData[{
 "When parsing the user's input, the operation ",
 StyleBox["Times", "Program"],
 " is first replaced by ",
 StyleBox["GTimes$", "Program"],
 " and then, depending on operands, may be replaced by ",
 StyleBox["Times$", "Program"],
 ", ",
 StyleBox["VTimes$", "Program"],
 ", or ",
 StyleBox["SVTimes$", "Program"],
 ". In the last step, the operations ",
 StyleBox["Times$", "Program"],
 ", ",
 StyleBox["VTimes$", "Program"],
 ", ",
 StyleBox["SVTimes$", "Program"],
 ", and ",
 StyleBox["GTimes$", "Program"],
 " are replaced  by ",
 StyleBox["Times", "Program"],
 ", ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["SVTimes",
  BaseStyle->"AddOnsLink"],
 ", and ",
 ButtonBox["GTimes",
  BaseStyle->"AddOnsLink"],
 ", respectively. \nTo ensure that the final operation will be ",
 StyleBox["Times", "Program"],
 " independently of operands, one can enter ",
 StyleBox["Times$", "Program"],
 " instead of ",
 StyleBox["Times", "Program"],
 ". "
}], "Text",
 CellChangeTimes->{{3.4215072540424595`*^9, 3.4215073260760384`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Times$", "b:3.19"},ExpressionUUID->"9183dded-327f-4590-9016-14449fea88c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ToDegree", "Subsubsection",
 CellTags->{
  "i:89", "ToDegree", "b:3.19", 
   "c:246"},ExpressionUUID->"ec4327b4-2a90-4e22-bc71-ba952acb7b59"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToDegree", "Program"], "\[Rule]", "n"}], TraditionalForm]],
  ExpressionUUID->"2e4fbdea-e280-44ab-a169-09f044ad68b0"],
 " is an optional parameter for space constructors. It restricts the \
calculations to the degree ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "4ff24d7e-3ee4-45bd-b0ad-646cc3c9000f"],
 " in terms of generators (the generators are assumed to have degree 1) . ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToDegree", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"e58008a3-da6d-45d2-acce-4d43da41b193"],
 " returns this limit. See also  ",
 ButtonBox["ToGrade",
  BaseStyle->"AddOnsLink"],
 ". "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ToDegree", 
   "b:3.19"},ExpressionUUID->"0ca9accf-1fcf-4456-80b1-6aa4bf1fa88f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ToGrade", "Subsubsection",
 CellTags->{
  "i:89", "ToGrade", "b:3.19", 
   "c:247"},ExpressionUUID->"fc3aea58-20b0-4145-960a-017ffe6cf6cc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToGrade", "Program"], "\[Rule]", "n"}], TraditionalForm]],
  ExpressionUUID->"606690b0-9a08-4c25-93f0-69a99688565f"],
 " is an optional parameter for space constructors. It restricts the \
calculations to the grade ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "94e1a828-c731-4447-96aa-26ac4b547467"],
 " (the grade of generators must be given). The function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToGrade", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"96b8b103-6b3a-439d-a2ba-4c2175c7d217"],
 " returns this limit. The results of operations in ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "af2ec8a1-cdb7-4e6a-8ba0-7de6029d3938"],
 " are evaluated only if their grades are between  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{
     StyleBox["ToGrade", "Name"], "[", "V", "]"}]}], TraditionalForm]],
  ExpressionUUID->"1ff58aa7-3a03-437c-9036-d8f50562787e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    RowBox[{
     StyleBox["ToGrade", "Name"], "[", "V", "]"}]}], TraditionalForm]],
  ExpressionUUID->"fd30c025-4593-4c19-a335-fa7a518fbe75"],
 ". See also  ",
 ButtonBox["ToDegree",
  BaseStyle->"AddOnsLink"],
 ". "
}], "Text",
 CellChangeTimes->{{3.421507396417184*^9, 3.421507405960907*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ToGrade", "b:3.19"},ExpressionUUID->"f1bb1eb2-9b34-4bc6-b10f-d0f3d5d4134a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tp", "Subsubsection",
 CellTags->{
  "i:220", "Tp", "b:3.19", 
   "c:248"},ExpressionUUID->"f6d727a7-a243-4d7c-9d06-f68139b24d75"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Tp", "Program"], "[", 
    RowBox[{"f", ",", "v"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ecbd1133-f5ab-4a91-8cbb-5eb9f13d3e78"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "**", "v"}], TraditionalForm]],ExpressionUUID->
  "9809f363-cdca-40f9-b59d-f5bb45adbe88"],
 " denotes the multiplication of functions (elements of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleStruckK]", "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", ",", 
     SubscriptBox["x", "n"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "90fe0d65-40de-438b-b49e-5b8d66de045a"],
 ") and tensor fields (for example, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "**", 
    StyleBox["dx",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "ab866d6c-8983-400c-8419-2dd3aa284c9f"],
 "). In the internal ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " format the operation ",
 StyleBox["NonCommutativeMultiply", "Program"],
 " is used instead of ",
 StyleBox["Tp", "Program"],
 ". "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Tp", "b:3.19"},ExpressionUUID->"38428332-2ad8-45ff-b04e-86d44e611735"]
}, Open  ]],

