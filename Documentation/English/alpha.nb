Cell[CellGroupData[{

Cell["TCollect", "Subsubsection",
 CellTags->{
  "i:207", "TCollect", "b:3.19", 
   "c:233"},ExpressionUUID->"7e13d62a-0e3b-4124-96d8-d70c6538fe54"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TCollect", "Program"], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ",", 
     StyleBox["case",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "ae00a2ca-4da2-4920-89ec-74b2221818a2"],
 " collects together the terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "**", "b"}], TraditionalForm]],ExpressionUUID->
  "6ff42864-ce7c-408d-8411-13d8e6bb7533"],
 " with the same ",
 StyleBox["a",
  FontSlant->"Italic"],
 " (if ",
 StyleBox["case",
  FontSlant->"Italic"],
 "=",
 StyleBox["First", "Program"],
 ")   or with the same",
 StyleBox[" b",
  FontSlant->"Italic"],
 " (if ",
 StyleBox["case",
  FontSlant->"Italic"],
 "=",
 StyleBox["Last", "Program"],
 "). \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TCollect", "Program",
     FontSize->12,
     FontWeight->"Plain",
     FontSlant->"Plain",
     FontVariations->{"StrikeThrough"->False,
     "Underline"->False},
     FontColor->GrayLevel[0]], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ",", 
     StyleBox["case",
      FontSlant->"Italic"], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "43b03e60-4cf8-4fc7-a42f-48a0efa4b691"],
 " collect terms of operation  ",
 StyleBox["op",
  FontSlant->"Italic"],
 " rather than ",
 Cell[BoxData[
  FormBox["**", TraditionalForm]],ExpressionUUID->
  "6691a45d-3fba-48d8-8ed4-b730902320b0"],
 ". The operation should be declared neither ",
 ButtonBox["Additive",
  BaseStyle->"AddOnsLink"],
 " nor ",
 ButtonBox["Linear",
  BaseStyle->"AddOnsLink"],
 ". "
}], "Text",
 CellChangeTimes->{{3.421507142371885*^9, 3.4215071620902386`*^9}},
 CellTags->{
  "TCollect", 
   "b:3.19"},ExpressionUUID->"19deb8c6-6b6d-47fa-bcf8-3d63b39c225f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TensorSpace", "Subsubsection",
 CellTags->{
  "i:208", "TensorSpace", "b:3.19", 
   "c:234"},ExpressionUUID->"8989cab1-9a25-4276-bc1b-9fc54ff62985"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TensorSpace", "Program"], "[", 
    RowBox[{"T", ",", "V", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["C", "1"], ",", 
       RowBox[{
        SubscriptBox["C", "2."], ".."}]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"980567c7-a23b-41a0-9bcb-258084cec86d"],
 " defines the space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["C", "1"], "\[CircleTimes]", 
      SubscriptBox["C", "2"], "\[CircleTimes]"}], "..."}]}], 
   TraditionalForm]],ExpressionUUID->"d27cd3ff-a6d0-4f80-9e7c-6a9153624497"],
 " . Repeated components may be written as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", "n"], TraditionalForm]],ExpressionUUID->
  "a9590b71-0e00-49d8-a54a-11be093f248e"],
 ". All components must be relatives of the space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "8fb5b4bf-97e3-4929-a8d2-9ff0a1759b11"],
 ". The basis of ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "42da6860-07f0-4e32-aeeb-b514177af3f5"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "[", 
    RowBox[{
     SubscriptBox["i", "1"], ",", 
     SubscriptBox["i", "2"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"a741db58-12b3-4ff0-903e-4452b7a87c64"],
 ". "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "TensorSpace", 
   "b:3.19"},ExpressionUUID->"5f16cc7b-f8a6-43a1-a521-72334fcba7d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TestFirst", "Subsubsection",
 CellTags->{
  "i:209", "TestFirst", "b:3.19", 
   "c:235"},ExpressionUUID->"8a34960c-262f-4cd6-bed0-c5d60074f14f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TestFirst", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"a49fd0d0-1257-4056-bb7f-6d02c78a839a"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", "1"], "+"}], "..."}], "]"}], " ", "=", " ", 
    RowBox[{"f", "[", 
     SubscriptBox["x", "1"], "]"}]}], TraditionalForm]],ExpressionUUID->
  "1e482661-0027-45c7-8f88-03efd3fe6df8"],
 ". This property reduces the time of the calculation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "1"], "+"}], "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"a5770d67-26bf-4e12-b08e-374c78ad23c5"],
 ", but restricts ",
 StyleBox["f",
  FontSlant->"Italic"],
 " to homogeneous arguments only. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "TestFirst", 
   "b:3.19"},ExpressionUUID->"b36be608-5e18-4ef4-96dc-e982d4304787"]
}, Open  ]],

