Cell[CellGroupData[{

Cell["Homogen", "Subsubsection",
 CellTags->{
  "i:92", "Homogen", "b:3.7", 
   "c:104"},ExpressionUUID->"dba92ed0-7174-4577-82d3-23a5939333af"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Homogen", "Program"], "[", 
    RowBox[{"f", "\[Rule]", "r"}], "]"}], TraditionalForm]],ExpressionUUID->
  "5cc5d5f8-7006-49ba-9449-3a85e7199a8d"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"...", ",", 
      RowBox[{"c", "*", "v"}], ",", "..."}], "]"}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["c", "r"], "*", 
     RowBox[{"f", "[", 
      RowBox[{"...", ",", "v", ",", "..."}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"91ae9164-882a-44ad-aebc-28a2a7ed0b5d"],
 " for a scalar ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "de862143-5057-453c-8396-070b6f35b6fa"],
 " and a vector ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "6660d409-e2ad-4a4d-bc49-b1f65affb40b"],
 ". Except for the case ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "74e346dd-a8b6-4f42-9b60-e2ba18b577b6"],
 ", the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "417477aa-89ad-4273-9c69-7558b6db5cb0"],
 " should be declared as ",
 ButtonBox["Vector",
  BaseStyle->"AddOnsLink"],
 " or ",
 ButtonBox["Scalar",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Homogen", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"b0824d59-3894-48cb-881e-7af26a9c177e"],
 " is equivalent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Homogen", "Program"], "[", 
    RowBox[{"f", "\[Rule]", "1"}], "]"}], TraditionalForm]],ExpressionUUID->
  "3ca01ddc-6394-4a00-9025-12cfa0695edd"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Homogen", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "34e17f2b-a305-4136-b9cd-fe98edc959ab"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Homogen", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "cb7c962d-cd0b-4a50-bbc9-5257d3c67e6c"],
 " introduce homogeneity (of degree 1) in only the first or only the last \
argument of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "c08655f7-173c-46b4-abbb-6f81040bc10b"],
 "."
}], "Text",
 CellChangeTimes->{{3.42150421915851*^9, 3.421504219509014*^9}},
 CellTags->{
  "Homogen", "b:3.7"},ExpressionUUID->"c0fcc34b-b694-43de-962f-fec50509d7d1"],

Cell[TextData[{
 "If a \[OpenCurlyDoubleQuote]power\[CloseCurlyDoubleQuote] function ",
 StyleBox["pw",
  FontSlant->"Italic"],
 " is assosiated with f (i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     ButtonBox["PowerOp",
      BaseStyle->"AddOnsLink"], "[", "f", "]"}], "\[Equal]", 
    StyleBox["pw", "Var"]}], TraditionalForm]],ExpressionUUID->
  "cbe06f90-c0b7-43e8-8d3a-cc13146bab3d"],
 ") then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Homogen", "Program"], "[", 
    RowBox[{"f", "\[Rule]", "r"}], "]"}], TraditionalForm]],ExpressionUUID->
  "03998350-666a-4f3d-be3e-2b8c0e515795"],
 " also introduces property",
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["pw", "Var"], "[", 
     RowBox[{
      RowBox[{"c", "*", "v"}], ",", "k"}], "]"}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox["c", 
      RowBox[{"r", "\[CenterDot]", "k"}]], "*", 
     RowBox[{
      StyleBox["pw", "Var"], "[", 
      RowBox[{"v", ",", "k"}], "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "cceb6416-fb95-4fab-94af-a36dcf288be7"],
 " "
}], "Text",
 CellChangeTimes->{{3.5828167801090126`*^9, 3.5828169892496376`*^9}},
 CellTags->{
  "b:3.7", "Homogen"},ExpressionUUID->"55a3c606-42a4-49be-ac20-6e93b0fcc168"]
}, Open  ]],

Cell[CellGroupData[{

Cell["HomogenRule", "Subsubsection",
 CellTags->{
  "i:93", "HomogenRule", "b:3.7", 
   "c:105"},ExpressionUUID->"fdde7c16-47f6-436f-8aa6-ac21ebe3eb35"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HomogenRule", "Program"], "[", 
    RowBox[{"f", ",", "r"}], "]"}], TraditionalForm]],ExpressionUUID->
  "2dad4c40-7cc8-4ce1-8333-a6af2b5f9ea2"],
 " is the replacement rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"...", ",", 
      RowBox[{"c", "*", "v"}], ",", "..."}], "]"}], " ", "\[Rule]", " ", 
    RowBox[{
     SuperscriptBox["c", "r"], "*", 
     RowBox[{"f", "[", 
      RowBox[{"...", ",", "v", ",", "..."}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"a1086593-a06e-44e5-9567-88751eaff1f7"],
 ", where ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "772795f1-3f5f-4de9-8b50-3de3cdace224"],
 " is any scalar and ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "31e2aed0-cec6-4db4-8cb1-a4a130521d33"],
 " any vector. The parameter ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "8953b171-55e4-4d1b-b61e-bc224a6042b1"],
 " is optional, the default value is 1.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HomogenRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["First", "Program"], ",", "r"}], "]"}], TraditionalForm]],
  ExpressionUUID->"3cde4ebd-44b5-4534-91eb-c6daa45fb563"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HomogenRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["Last", "Program"], ",", "r"}], "]"}], TraditionalForm]],
  ExpressionUUID->"46069810-297e-416b-bf61-b4af3da1e32d"],
 " act only on the first/last argument of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "235ad261-e300-4936-8a15-dcc57188a24d"],
 "."
}], "Text",
 CellTags->{
  "HomogenRule", 
   "b:3.7"},ExpressionUUID->"c7056cf2-d07f-4773-9a66-0e72e15a17c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["HWModule", "Subsubsection",
 CellTags->{
  "i:94", "HWModule", "b:3.7", 
   "c:106"},ExpressionUUID->"992047b7-ca40-4403-a982-4ce0686c7286"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HWModule", "Program"], "[", 
    RowBox[{"\[GothicM]", ",", " ", "\[GothicG]", ",", " ", "w"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"f34df65b-5267-4a7c-a057-a835894876a0"],
 " builds the irreducible \[GothicG]-module \[GothicM] with highest weight ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]],ExpressionUUID->
  "0630d226-9718-4303-af0a-6be4ff465089"],
 ". The algebra \[GothicG] should be expressed as the direct sum of spaces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "=", 
    RowBox[{
     SubscriptBox["\[GothicG]", "+"], "\[CirclePlus]", 
     SubscriptBox["\[GothicG]", "0"], "\[CirclePlus]", 
     SubscriptBox["\[GothicG]", "-"]}]}], TraditionalForm]],ExpressionUUID->
  "30fd930b-1751-4e48-b243-964a021c43db"],
 " using functions ",
 ButtonBox["DecompositionList",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["DecompositionRule",
  BaseStyle->"AddOnsLink"],
 " with ",
 ButtonBox["CartanTriade",
  BaseStyle->"AddOnsLink"],
 " as the name of the decomposition.These functions are defined by some \
constructors of Lie algebras. The function ",
 ButtonBox["Grade",
  BaseStyle->"AddOnsLink"],
 " should be defined on ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "2860c773-c1ed-4676-81da-8366d46e975c"],
 " and should agree with  decomposition (the sign of the grade should \
distinguish the parts). The function ",
 ButtonBox["Weight",
  BaseStyle->"AddOnsLink"],
 " should be defined on ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "bb5ff1ec-8886-497f-bc5d-980d9a81ff34"],
 " and should agree with subalgebra ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicG]", "0"], TraditionalForm]],ExpressionUUID->
  "f25be18a-9e84-4384-b789-2e04febd77fd"],
 ":  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["h", "i"], ",", "g"}], "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["Weight", "Program"], "[", "g", "]"}], "\[LeftDoubleBracket]",
       "i", "\[RightDoubleBracket]"}], "g"}]}], TraditionalForm]],
  ExpressionUUID->"ac1ba30b-3f86-4474-9c64-3f186d9c2e40"],
 "."
}], "Text",
 CellChangeTimes->{{3.4215042478497667`*^9, 3.4215042536481037`*^9}, {
  3.423237656263352*^9, 3.423237656924302*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "HWModule", "b:3.7"},ExpressionUUID->"681f935a-64e2-471a-a5bd-1c6c9e46e6bc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HWModule", "Program"], "[", 
    RowBox[{"\[GothicM]", ",", " ", "\[GothicG]", ",", " ", "w", ",", " ", 
     RowBox[{
      StyleBox["ToGrade", "Program"], "\[Rule]", " ", "r"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"a84a48d7-5a31-4e4e-8a69-e99049f1d6d9"],
 " makes all calculations down to grade ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "r"}], TraditionalForm]],ExpressionUUID->
  "214029fd-8d6b-4f78-8292-631a04e829b2"],
 ". The algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "ffb253e3-8e5f-419b-8cfa-8fc33700f15d"],
 " should be graded. The grade of the highest vector is assumed to be 0."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->"b:3.7",ExpressionUUID->"e0f18d5b-3392-46ae-9805-e8b569c9efe3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HWModule", "Program"], "[", 
    RowBox[{"\[GothicM]", ",", " ", "\[GothicG]", ",", " ", "w", ",", " ", 
     RowBox[{
      StyleBox["ToGrade", "Program"], "\[Rule]", " ", "r"}], ",", " ", 
     RowBox[{
      StyleBox["Quotient", "Program"], "\[Rule]", 
      StyleBox["False", "Program"]}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"450fa21c-b192-4fb3-a93a-f73ab17bfa91"],
 " builds the Verma module with given highest weight (does not make the \
quotient modulo the maximal submodule)."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->"b:3.7",ExpressionUUID->"b08bdebd-b910-4ba3-a385-aaf1e31b9d87"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Order", "Program"], 
    StyleBox["\[Rule]", "Program"], 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["y", "1"], ",", "...", ",", 
      SubscriptBox["y", "m"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "10820fff-8335-4a29-a067-82840a1e140b"],
 " gives the order in which the elements of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[GothicG]", "-"], TraditionalForm]],ExpressionUUID->
  "0a3962db-d9b5-4e15-9351-5edb46d55486"],
 " should appear in the expressions of the basis of ",
 Cell[BoxData[
  FormBox["\[GothicM]", TraditionalForm]],ExpressionUUID->
  "0ebf2f6b-d019-4563-abb4-e8631f08d9d0"],
 " in terms of generators of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "(", 
    SubscriptBox["\[GothicG]", "-"], ")"}], TraditionalForm]],ExpressionUUID->
  "af5ca4c3-74fc-4617-b9a2-d9f766b733cb"],
 ". Default order is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["Basis", "Program"],
      BaseStyle->"AddOnsLink"], "Program"], "[", 
    SubscriptBox["\[GothicG]", "-"], "]"}], TraditionalForm]],ExpressionUUID->
  "9be3decb-1fc7-4f44-80e0-8af7a0c15f1d"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->"b:3.7",ExpressionUUID->"ea7b5db8-8d4a-43cb-9358-00c9dcd0e224"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "Program",
     FontSlant->"Plain"], "\[Rule]", "p"}], TraditionalForm]],ExpressionUUID->
  "378ebda9-6f6b-4946-9438-3bbc5f3ffe13"],
 " gives the parity of the highest vector (default is 0)."
}], "Text",
 CellTags->"b:3.7",ExpressionUUID->"8a33e70d-f932-4887-9038-35057f01639d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["I", "Subsection",
 CellTags->{
  "b:3.8", "c:107"},ExpressionUUID->"510db86a-0580-4bd1-9bd5-fa868682300a"],

Cell[CellGroupData[{

Cell["Ideal", "Subsubsection",
 CellTags->{
  "i:95", "Ideal", "b:3.8", 
   "c:108"},ExpressionUUID->"c070de4c-62b0-48b6-90f0-a1ec6fe44aa2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Ideal", "Program"], "[", 
    RowBox[{"\[GothicI]", ",", "\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"421df672-b68c-42e6-a4d0-ab5e74c0f7dc"],
 "  defines the ideal \[GothicI] in the Lie (super)algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "787c8d16-f393-4c7c-8186-289afb0c3aca"],
 ", generated by elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", "...", ",", 
    SubscriptBox["g", "k"]}], TraditionalForm]],ExpressionUUID->
  "06c11ed8-5d3e-4a92-9a0f-9b762cea9e95"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Ideal", "Program"], "[", 
    RowBox[{"\[GothicI]", ",", "\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "}"}], ",", " ", 
     RowBox[{
      StyleBox["Split", "Program"], "\[Rule]", 
      StyleBox["wt",
       FontSlant->"Italic"]}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "0f460853-8aa0-48e8-acfb-8cc1bf06652f"],
 " builds a graded ideal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicI]", "\[Subset]", "\[GothicG]"}], TraditionalForm]],
  ExpressionUUID->"1271604e-21e2-4752-9b1a-db8af71909d4"],
 " generated by the elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["g", "1"], ",", "...", ",", 
     RowBox[{
      SubscriptBox["g", "k"], "\[Element]", "\[GothicG]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"e0970df6-28cc-4822-ae75-e89a57c8b989"],
 ". The argument ",
 StyleBox["wt",
  FontSlant->"Italic"],
 " is the grading function. Graded ideals are calculated faster than \
non-graded ones. \nThe function ",
 StyleBox["Ideal", "Program"],
 " is implemented only for finite dimensional algebras having simple \
representation of basis as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", "...", ",", 
    SubscriptBox["g", "n"]}], TraditionalForm]],ExpressionUUID->
  "93f2d7d7-2d4c-4015-a775-3506049bf871"],
 ", where ",
 StyleBox["g",
  FontSlant->"Italic"],
 " is the algebra name. To work with algebras that have different \
representations (e.g., matrix algebras or algebras of vector fields), use ",
 ButtonBox["SubAlgebra",
  BaseStyle->"AddOnsLink"],
 " to build a subalgebra ",
 StyleBox["s",
  FontSlant->"Italic"],
 " with basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["s", "l"]}]}], TraditionalForm]],ExpressionUUID->
  "ce1ee304-a6ca-4fab-9d94-a475e78e62e5"],
 " (the subalgebra should coincide with the original algebra) and then build \
ideals of this subalgebra."
}], "Text",
 CellChangeTimes->{{3.421504330608768*^9, 3.421504360671997*^9}},
 CellTags->{
  "Ideal", "b:3.8"},ExpressionUUID->"4d75588f-fae5-4a3a-b965-0a8371927d1b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Image", "Subsubsection",
 CellTags->{
  "i:96", "Image", "b:3.8", 
   "c:109"},ExpressionUUID->"7627d3e2-0155-4a63-bcdb-5aaa6dff844b"],

