Cell[CellGroupData[{

Cell["ZeroArg", "Subsubsection",
 CellTags->{
  "i:273", "ZeroArg", "b:3.23", 
   "c:306"},ExpressionUUID->"3e219ff8-fac3-4643-961b-cf2344ef34b5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZeroArg", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"92fc3c67-ab50-40ac-8c3a-b35a946677c8"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"...", ",", "0", ",", "..."}], "]"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"f5f76722-5164-4183-bd72-0ca3aa2e08fc"],
 ". ",
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZeroArg", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "90bbd64b-501d-4bc2-b6ad-5fa5b0c9c236"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZeroArg", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "cd4a3296-28d3-47b0-97b3-312b0e8aedd6"],
 " acts on the first/last argument of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "ccb82b03-8a01-40f3-b0e3-25c7140e6381"],
 " only. "
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellTags->{
  "ZeroArg", "b:3.23"},ExpressionUUID->"7d914fd0-ae19-4beb-b0ca-472041b62646"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ZeroArgRule", "Subsubsection",
 CellTags->{
  "i:274", "ZeroArgRule", "b:3.23", 
   "c:307"},ExpressionUUID->"523c11d6-d274-4ea7-bbdb-2825fc3cce49"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZeroArgRule", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"8605021c-7f92-4437-94ad-902e3fb19948"],
 " returns the replacement rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"...", ",", "0", ",", "..."}], "]"}], "\[Rule]", "0"}], 
   TraditionalForm]],ExpressionUUID->"96c0102d-8a75-4bd7-85bc-b4fd8e9dea44"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZeroArg", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "ff93bb5e-1b80-4691-8d06-785e9252bd75"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZeroArg", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1bbc2ee9-d06e-4927-82a0-0da2274a24e4"],
 " return rules ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"0", ",", "..."}], "]"}], "\[Rule]", "0"}], TraditionalForm]],
  ExpressionUUID->"fc7f957d-0d59-4d14-b5eb-16d8aa68b22f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"...", ",", "0"}], "]"}], "\[Rule]", "0"}], TraditionalForm]],
  ExpressionUUID->"250ce1b8-8443-48b8-b513-e0db51ae2cc4"],
 ". "
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellTags->{
  "ZeroArgRule", 
   "b:3.23"},ExpressionUUID->"dc5e3e7d-580e-4738-a546-3a2ab134177a"]
}, Open  ]],

