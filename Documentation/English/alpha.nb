Cell[CellGroupData[{

Cell["SchoutenAlgebra", "Subsubsection",
 CellChangeTimes->{{3.9836714090225677`*^9, 3.983671412123897*^9}},
 CellTags->{
  "i:25", "ButtinAlgebra", "b:3.1", 
   "c:25"},ExpressionUUID->"510ad2a3-03da-46c2-b89f-0a3b02c41447"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SchoutenAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"eb582c4f-e714-469d-bb2a-1e67ea18ef31"],
 " defines a Buttin algebra \[GothicG], the algebra of polynomials on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"], ",", 
    SubscriptBox["y", "1"], ",", "...", ",", 
    SubscriptBox["y", "n"]}], TraditionalForm]],ExpressionUUID->
  "a13d5e53-137d-4002-ae80-df3a60667bcf"],
 " with the standard Schouten bracket. The spaces ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "abb70e1a-1a3a-42f0-9de1-0d928a207dda"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "80e4c032-fbf7-4210-b306-c90d2af3a5a0"],
 " should be already declared and should have the same dimension. For every \
",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "3a028c31-1c50-479f-8651-56ee01ca6ded"],
 ", the parities of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "9ebadeb2-20da-4a2c-949e-4fc98b8103fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "7f271472-7d2c-4fb4-9e9c-4749134cd3c7"],
 " should be different. The form of the bracket assume that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "i"], "=", 
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", 
      SubscriptBox["x", "i"]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18ee3a16-ef27-439c-9abb-8a0cf0e9195f"],
 "."
}], "Text",
 CellChangeTimes->{{3.4214327823676834`*^9, 3.42143282289596*^9}, {
  3.983671436836895*^9, 3.983671459152884*^9}, {3.98367178343474*^9, 
  3.983671848055065*^9}},
 CellTags->{
  "ButtinAlgebra", 
   "b:3.1"},ExpressionUUID->"6fd9fa4b-67a4-48ea-83d4-fe13c8ef11af"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SeqForm", "Subsubsection",
 CellTags->{
  "i:178", "SeqForm", "b:3.18", 
   "c:201"},ExpressionUUID->"3f338747-93bd-42a2-a8af-7cbd7e0aa318"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["SeqForm", "Program"], "[", 
     RowBox[{
      SubscriptBox["e", "1"], ",", "..."}], "]"}], " ", "[", 
    RowBox[{"h", "[", 
     RowBox[{
      SubscriptBox["a", "1"], ",", ".."}], "]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"edacd53a-7add-4a9c-91e0-6f680a725599"],
 " prints the sequence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["e", "1"], ",", "...", ","}], TraditionalForm]],
  ExpressionUUID->"37ed0498-51fc-4270-89cd-a6a267b0a423"],
 " substituting    ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", ",", " ", 
    SubscriptBox["a", "1"], ",", "..."}], TraditionalForm]],ExpressionUUID->
  "3d99176b-824c-43d6-93a8-1f5825f49170"],
 " instead of placeholders ",
 StyleBox["#0", "Program"],
 ", ",
 StyleBox["#1", "Program"],
 ", ... ."
}], "Text",
 CellTags->{
  "SeqForm", "b:3.18"},ExpressionUUID->"7b90af89-572e-4226-8a90-09c69ab4eb58"]
}, Open  ]],

