Cell["ZId", "Subsubsection",
 CellTags->{
  "i:275", "ZId", "b:3.23", 
   "c:308"},ExpressionUUID->"540bd8bf-2499-4391-988f-e1d66fb86772"],

Cell[TextData[{
 StyleBox["ZId", "Program"],
 " is the identity operator. It is used in symbolic calculations. "
}], "Text",
 CellTags->{
  "ZId", "b:3.23"},ExpressionUUID->"d7b0a4a3-634c-4cff-90a1-56176538bd3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ZLDer", "Subsubsection",
 CellTags->{
  "i:276", "ZLDer", "b:3.23", 
   "c:309"},ExpressionUUID->"6da6fd90-044c-4165-b42b-2501a2e3aa30"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZLDer", "Program"], "[", 
    RowBox[{"x", ",", 
     StyleBox["ptrn",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "858a909d-bf3a-4a62-ba04-9d24a14e1271"],
 " is the operator of left partial derivative with respect to ",
 StyleBox["x",
  FontSlant->"Italic"],
 ". ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["ZLDer", "Program"], "[", 
     RowBox[{"x", ",", 
      StyleBox["ptrn",
       FontSlant->"Italic"]}], "]"}], "[", 
    StyleBox["expr",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "5e38872d-5c32-4ed4-b49f-d624e7cd296c"],
 " is the left partial derivative of expression ",
 Cell[BoxData[
  FormBox[
   StyleBox["expr",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "dcbae97b-fe4d-455d-8749-d7c11ac8a046"],
 " with respect to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "."}], TraditionalForm]],ExpressionUUID->
  "eb0adc4c-5c00-4445-923f-59991827ab12"],
 " The pattern ",
 StyleBox["ptrn",
  FontSlant->"Italic"],
 " should match all the independent and none of the dependent variables. The \
operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZLDer", "Program"], "[", 
    RowBox[{"x", ",", 
     StyleBox["ptrn",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "6ed36cf2-6232-4e35-ae85-e8f62909a3cd"],
 " may be used in symbolic calculations. "
}], "Text",
 CellChangeTimes->{{3.4215089835794115`*^9, 3.4215089960273104`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ZLDer", "b:3.23"},ExpressionUUID->"982927ed-cef0-4134-84b0-a8869356ee5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ZRamondD", "Subsubsection",
 CellTags->{
  "i:277", "ZRamondD", "b:3.23", 
   "c:310"},ExpressionUUID->"d0ebafca-def9-488f-8b4c-42a478ca6c63"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ZRamondD", "Program"], "[", 
    RowBox[{"t", ",", " ", "\[Theta]", ",", " ", 
     StyleBox["ptrn",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1aeb1481-5fb7-42ac-9465-d90f22910b7d"],
 " returns the Ramond operator  \[ScriptCapitalD] as a differential operator \
acting on the space of Laurent polynomials in ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "9f21a635-a041-4609-acae-41d6b5aff529"],
 ", ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "ddae8d10-8ea1-4477-8267-7cb60b7f5d76"],
 ", and the indeterminates matching the pattern ",
 StyleBox["ptrn",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellTags->{
  "ZRamondD", 
   "b:3.23"},ExpressionUUID->"76f60585-f1ab-4411-b446-231338896aec"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["$", "Subsection",
 CellTags->{
  "b:3.24", "c:311"},ExpressionUUID->"21b37fdf-d68e-4863-a8ff-422b9fbc3e5f"],

Cell[CellGroupData[{

Cell["$DPrint", "Subsubsection",
 CellTags->{
  "i:278", "$DPrint", "b:3.24", 
   "c:312"},ExpressionUUID->"98d252bd-ae84-499d-84af-255fea3ce504"],

Cell[TextData[{
 "The value of ",
 StyleBox["$DPrint", "Program"],
 " determines the debug level.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["DPrint", "Program"],
      BaseStyle->"AddOnsLink"], "Program"], "[", 
    RowBox[{
     StyleBox["level",
      FontSlant->"Italic"], ",", " ", 
     RowBox[{
      StyleBox["data",
       FontSlant->"Italic"], "..."}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"0b4e5a90-c9ae-42a0-aa20-f81bc5a86a4b"],
 " prints ",
 StyleBox["data ...",
  FontSlant->"Italic"],
 " (using ",
 ButtonBox["Print",
  BaseStyle->"Link",
  ButtonData:>"paclet:ref/Print"],
 ") if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$DPrint", "Program"], "\[GreaterEqual]", 
    StyleBox["level",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "5424a369-fd28-4e22-b31b-91dc0e1fa789"],
 ". "
}], "Text",
 CellChangeTimes->{{3.6233147974551134`*^9, 3.6233148077751293`*^9}},
 CellTags->{
  "$DPrint", "b:3.24"},ExpressionUUID->"dd31cacb-3028-417c-ad73-7e280ba99c7d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["$DPrintLabel", "Subsubsection",
 CellTags->{
  "i:279", "$DPrintLabel", "b:3.24", 
   "c:313"},ExpressionUUID->"bd360d12-f733-477a-b22b-cf2b8685fbe0"],

Cell[TextData[{
 "The value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$DPrintLabel", "Program"], "[", "]"}], TraditionalForm]],
  ExpressionUUID->"ccabffd4-c595-4761-a10d-98cef4167e2e"],
 " is printed as a label for the debug printing. Use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$DPrintLabel", "Program"], "=", 
    StyleBox["DateString", "Program"]}], TraditionalForm]],ExpressionUUID->
  "3ed296e6-7a41-4369-af6d-f10245a89309"],
 " or ",
 StyleBox["TimeString", "Program"],
 " to use [date and] time as label. Use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$DPrintLabel", "Program"], "=", 
    StyleBox["None", "Program"]}], TraditionalForm]],ExpressionUUID->
  "b90e9d5d-873b-415a-be00-103297c26344"],
 " for the debug printing without labels. "
}], "Text",
 CellChangeTimes->{{3.4215090468503904`*^9, 3.421509047791744*^9}, {
  3.4215091038022833`*^9, 3.421509104573392*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "$DPrintLabel", 
   "b:3.24"},ExpressionUUID->"79c36dbd-2905-4baa-a11f-42a7745acdd1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["$EnvLess", "Subsubsection",
 CellTags->{
  "i:280", "$EnvLess", "b:3.24", 
   "c:314"},ExpressionUUID->"ed64fa8a-0d7e-4a68-8f9c-459c24e3397b"],

Cell[TextData[{
 "The value of ",
 StyleBox["$EnvLess", "Program"],
 " is the default sorting function for the product in en",
 "velopin",
 "g algebras. The default value of ",
 StyleBox["$EnvLess", "Program"],
 " is ",
 StyleBox["OrderedQ[{#1,#2}]& ", "Program"]
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "$EnvLess", 
   "b:3.24"},ExpressionUUID->"3bac5598-d8e7-45c1-814a-9a548e2161ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["$SNormal", "Subsubsection",
 CellTags->{
  "i:281", "$SNormal", "b:3.24", 
   "c:315"},ExpressionUUID->"33ef9371-857f-4589-a973-595ea37989d4"],

Cell[TextData[{
 "The value of ",
 StyleBox["$SNormal", "Program"],
 " is the user-defined function which is called by ",
 ButtonBox["VNormal",
  BaseStyle->"AddOnsLink"],
 " to convert the scalar coefficients to the normal form. This function \
should always convert to 0 the scalars that are really equal to 0. The \
default value of ",
 StyleBox["$SNormal", "Program"],
 " is ",
 ButtonBox["Together",
  BaseStyle->"Link",
  ButtonData:>"paclet:ref/Together"],
 ". "
}], "Text",
 CellChangeTimes->{{3.4232395888522787`*^9, 3.4232396303719807`*^9}, {
  3.6233148329351816`*^9, 3.623314884723277*^9}},
 CellTags->{
  "$SNormal", 
   "b:3.24"},ExpressionUUID->"a69c9875-bbf4-4095-ba91-b671bff3f62f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["$p", "Subsubsection",
 CellTags->{
  "i:281", "$p", "b:3.24", 
   "c:316"},ExpressionUUID->"d1d34487-d972-478d-ba8a-bc9384c680f2"],

Cell[TextData[{
 "The value of ",
 StyleBox["$p", "Program"],
 " is the characteristic of the ground field. It may be zero or a prime. Use  \
",
 ButtonBox["FieldChar",
  BaseStyle->"RefGuideLink"],
 " to change the value of ",
 StyleBox["$p", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.421509170147683*^9, 3.4215091893853455`*^9}},
 CellTags->{
  "$p", "b:3.24"},ExpressionUUID->"dae7cd63-892c-4387-a062-6e5d5780bc57"]
