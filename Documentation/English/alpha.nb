     FontSlant->"Italic"], "//.", 
    StyleBox["VExpandRule", "Program"]}], TraditionalForm]],ExpressionUUID->
  "eb980e75-2383-4384-ba14-d948214aa86f"],
 " expands out all ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["SVTimes",
