Cell[CellGroupData[{

Cell["Basis ", "Subsubsection",
 CellTags->{
  "i:18", "Basis", "b:3.1", 
   "c:20"},ExpressionUUID->"32d444d5-1b59-44a4-9de1-ef388b9ec501"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Basis", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"aae1b560-a964-4f7f-88ae-be1bd7598502"],
 " returns the basis of the space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "aad9b754-ba9f-4932-8d53-cfff30dbe47c"],
 ". ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Basis", "Program"], "[", 
    RowBox[{"V", ",", "d"}], "]"}], TraditionalForm]],ExpressionUUID->
  "fd4d8c9f-98e6-4680-9b91-cd4464d877ee"],
 " returns the  basis of the ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "83de7086-fb7d-4286-bc35-e8673808ad65"],
 "-th grade component of the space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "0987b3a9-74ea-48ef-a9d2-0ad6c99048ee"],
 "."
}], "Text",
 CellTags->{
  "Basis", "b:3.1"},ExpressionUUID->"f4a271a0-3e2a-43ad-b581-41dfb97c7acf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["BasisPattern", "Subsubsection",
 CellTags->{
  "i:19", "BasisPattern", "b:3.1", 
   "c:21"},ExpressionUUID->"05c6c432-9233-4368-a587-c6975273c75a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["BasisPattern", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"2408db64-94f5-4ae3-aa01-bd480aa1d04c"],
 " returns the pattern for basis of the space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "8f016df2-8e09-4707-88f4-ad5c0df0c5b9"],
 ". This pattern matches all elements of the basis of ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "4bfb5dd6-2cf9-48b3-9608-d8971e56ab07"],
 ". No other expressions matching this pattern should be used in calculations."
}], "Text",
 CellTags->{
  "BasisPattern", 
   "b:3.1"},ExpressionUUID->"0ba21bbb-2f61-4a05-8cda-c49e15c758aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bb, bb", "Subsubsection",
 CellTags->{
  "i:20", "Bb", "bb", "b:3.1", 
   "c:22"},ExpressionUUID->"a380650c-d434-4809-81a6-e41d728cf549"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Bb", "Program"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "cd6ca70d-0c2b-443a-b7dd-3c0630a555b5"],
 " is the Buttin bracket (operator)."
}], "Text",
 CellTags->{
  "Bb", "bb", "b:3.1"},ExpressionUUID->"2852b1d5-0d68-4656-ba5f-1ee49eb78a5f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["bb", "Program"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "d0609334-7d4c-4127-922b-3ac5ef544801"],
 " is the Buttin bracket (unevaluated form)."
}], "Text",
 CellTags->{
  "bb", "Bb", "b:3.1"},ExpressionUUID->"fe2040ca-1185-443c-b229-ea5edea4de67"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bracket, bracket", "Subsubsection",
 CellTags->{
  "i:22", "bracket", "Bracket", "b:3.1", 
   "c:23"},ExpressionUUID->"2946cf69-49b2-4002-814b-f70096cacf3e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Bracket", "Program"], "[", "\[GothicG]", "]"}], 
   TraditionalForm]],ExpressionUUID->"e7a0755e-70a8-47d7-9356-8b30a6243e08"],
 " returns the name  of the bracket in Lie algebra \[GothicG]. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Bracket", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "\[GothicM]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"9fc759c2-5d5f-46ce-ba57-f4a01db19ea8"],
 " returns the name of the action of the Lie algebra \[GothicG] on the module \
\[GothicM] (not implemented yet)."
}], "Text",
 CellTags->{
  "Bracket", "bracket", 
   "b:3.1"},ExpressionUUID->"525cd2f7-1811-4bc3-a1cf-a9b50d5aee9b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["bracket", "Program"], "[", "\[GothicG]", "]"}], 
   TraditionalForm]],ExpressionUUID->"7e82d4d8-f515-472e-a4ae-8e0882fef395"],
 " returns the name of the unevaluated form of the bracket in Lie algebra \
\[GothicG]. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["bracket", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "\[GothicM]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"badb02c1-8b29-48eb-a4f8-e0d95741a490"],
 " returns the name of the unevaluated form of the action of the Lie algebra \
\[GothicG] on the module \[GothicM] (not implemented yet)."
}], "Text",
 CellTags->{
  "bracket", "Bracket", 
   "b:3.1"},ExpressionUUID->"ecf88b41-9af6-4875-aada-086f223307a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["BracketMode", "Subsubsection",
 CellTags->{
  "i:24", "BracketMode", "b:3.1", 
   "c:24"},ExpressionUUID->"8f1e952a-3bfd-48e8-a218-4fc2ef737998"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["BracketMode", "Program"], "[", "\[GothicM]", "]"}], 
   TraditionalForm]],ExpressionUUID->"b28fb145-58cd-4288-8539-3e88676cde5f"],
 " returns the method of the definition of the bracket operation on the \
algebra or of the action of the algebra on the module. The valid modes are ",
 StyleBox["Regular", "Program"],
 " or ",
 StyleBox["Tabular", "Program"],
 "."
}], "Text",
 CellTags->{
  "BracketMode", 
   "b:3.1"},ExpressionUUID->"edc87776-d771-418c-8d03-0c0750ca1ab5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ButtinAlgebra", "Subsubsection",
 CellTags->{
  "i:25", "ButtinAlgebra", "b:3.1", 
   "c:25"},ExpressionUUID->"4746f50d-8eb0-46b2-a00a-cf2d5eb4049f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ButtinAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"86f8dba1-593e-4c72-b55c-b2246dd42095"],
 " defines a Buttin algebra \[GothicG], the algebra of polynomials on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"], ",", 
    SubscriptBox["y", "1"], ",", "...", ",", 
    SubscriptBox["y", "n"]}], TraditionalForm]],ExpressionUUID->
  "bbdbb045-bdd0-4ef6-8913-8e86721c2799"],
 " with the standard Buttin bracket. The spaces ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "4cdc73ea-3beb-4413-b5bb-5c12a32d3d86"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "d407c39c-70de-41fb-a963-e8e0db197e71"],
 " should be already declared and should have the same dimension. For every \
",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "e43cc6c0-1320-4bc6-88d4-2ce8cbb89185"],
 ", the parities of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "b895b93d-a383-4865-ad83-fd613ec79fa9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "db8ad7f5-a528-484a-97b9-0a8d7e31b3f2"],
 " should be different."
}], "Text",
 CellChangeTimes->{{3.4214327823676834`*^9, 3.42143282289596*^9}},
 CellTags->{
  "ButtinAlgebra", 
   "b:3.1"},ExpressionUUID->"0dcda240-f87b-402f-9c54-28d91f5cfde7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["C", "Subsection",
 CellTags->{
  "b:3.2", "c:26"},ExpressionUUID->"4cb2b26e-bc1f-40db-a2d7-34498d61dfd1"],

Cell[CellGroupData[{

Cell["CartanMatrix", "Subsubsection",
 CellTags->{
  "CartanMatrix", "b:3.2", 
   "c:27"},ExpressionUUID->"ad591088-8c1f-4632-91c8-ebbc05a17730"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CartanMatrix", "Program"], "[", "\[GothicG]", "]"}], 
   TraditionalForm]],ExpressionUUID->"f7660c6b-b611-434d-b6d5-72b629ac366f"],
 " returns the Cartan matrix from which the algebra \[GothicG] is built. This \
function is only defined for algebras built from Cartan matrix (see ",
 ButtonBox["CartanMatrixAlgebra",
  BaseStyle->"AddOnsLink"],
 ")."
}], "Text",
 CellChangeTimes->{{3.421432832940403*^9, 3.421432833721526*^9}, {
  3.4232336920631123`*^9, 3.4232337135740433`*^9}, {3.4232338571304674`*^9, 
  3.4232338586726847`*^9}},
 CellTags->{
  "CartanMatrix", 
   "b:3.2"},ExpressionUUID->"7f7f1634-e609-45f5-8574-5b45b1572d52"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CartanMatrixAlgebra", "Subsubsection",
 CellTags->{
  "i:26", "CartanMatrixAlgebra", "b:3.2", 
   "c:28"},ExpressionUUID->"740531c0-dc99-48a7-acba-84fd81c3a1db"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CartanMatrixAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "h", ",", "y"}], "}"}], ",", " ", 
     StyleBox["matr",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "0b6f2b1a-6659-469a-8183-083e71372227"],
 " defines a Lie (super)algebra \[GothicG] with a given Cartan matrix ",
 StyleBox["matr",
  FontSlant->"Italic"],
 ". Its elements are named ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],ExpressionUUID->
  "02c43e79-0f04-4829-a984-36ed4484f938"],
 " (span the Cartan  subalgebra), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "8413527d-cca3-439c-8be5-ca5a079f94aa"],
 " (of positive weight), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "8416e236-3141-4ee1-9e0a-21949d5d9713"],
 " (of negative weight).\n\[FilledSmallSquare] Option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToDegree", "Program"], "\[Rule]", "r"}], TraditionalForm]],
  ExpressionUUID->"b89089aa-e4cc-4232-94f0-d43f69727a7f"],
 " ",
 StyleBox[" ", "ItemizedText",
  FontSize->10],
 "limits the computations up to terms of degree ",
 StyleBox["r",
  FontSlant->"Italic"],
 ".\n\[FilledSmallSquare] Option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PList", "Program"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["p", "1"], ",", 
      SubscriptBox["p", "2"], ",", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"601140ed-31f3-4536-9ef0-f8b602c418a7"],
 " speciffies the parities of the generators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "64987459-d65b-44da-8a4e-07adf7d0791b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "9962a282-8d6d-4039-8f1e-6125b87afee5"],
 ". By default the parities are equal to 0. \n\[FilledSmallSquare] Option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GList", "Program"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["g", "1"], ",", 
      SubscriptBox["g", "2"], ",", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"94ea5eab-87c7-4bba-99a3-10a58ed8a1bf"],
 " speciffies the gradings of the positive generators  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "bb022ec1-983b-4ce9-ae58-fd01a9fed180"],
 ". The default grades are equal to 1.\n\[FilledSmallSquare] Option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToGrade", "Program"], "\[Rule]", "g"}], TraditionalForm]],
  ExpressionUUID->"b8cd6c78-2518-42e4-94ef-df3b0b1252dc"],
 " limits computations up to terms of grade ",
 StyleBox["g",
  FontSlant->"Italic"],
 ".\n\[FilledSmallSquare] Option ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Squaring", "\[Rule]", "True"}], "Program"], TraditionalForm]],
  ExpressionUUID->"fbfa0089-e43a-4668-a8d4-73916a75388b"],
 " instructs to include ",
 StyleBox["Squaring[", "Program"],
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["act]", "Program"],
 " instead of ",
 StyleBox["act[", "Program"],
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 StyleBox["]", "Program"],
 " in the basis of the generated algebra. This option is included by default \
if the algebras are over a field of charcteristic 2."
}], "Text",
 CellChangeTimes->{{3.4214328939381137`*^9, 3.4214330067202864`*^9}},
 CellTags->{
  "CartanMatrixAlgebra", 
   "b:3.2"},ExpressionUUID->"2064e2d0-e27d-43be-9715-45f74bfaf53c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["CartanTriade", "Subsubsection",
 CellTags->{
  "i:27", "CartanTriade", "b:3.2", 
   "c:29"},ExpressionUUID->"45e2625e-163b-4bc4-8aa3-374afe98acd0"],

Cell[TextData[{
 StyleBox["CartanTriade", "Program"],
 " is the name of decomposition of algebras into 3 subalgebras ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[GothicG]", "\[LongRightArrow]", 
     SubscriptBox["\[GothicG]", "+"]}], "\[CirclePlus]", 
    SubscriptBox["\[GothicG]", "0"], "\[CirclePlus]", 
    SubscriptBox["\[GothicG]", "-"]}], TraditionalForm]],ExpressionUUID->
  "26bdacea-5b97-4439-b855-f945e9052e31"],
 ", the components of positive, zero and negative weight. See also ",
 ButtonBox["AlgebraDecomposition",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["DecompositionList",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["DecompositionRule",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellTags->{
  "CartanTriade", 
   "b:3.2"},ExpressionUUID->"27018117-9b80-4122-9f7f-c1b8b11a7f90"]
}, Open  ]],

