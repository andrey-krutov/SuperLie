Cell[CellGroupData[{

Cell["Plus$", "Subsubsection",
 CellTags->{
  "i:151", "Plus$", "b:3.15", 
   "c:169"},ExpressionUUID->"01fb589c-69a2-4a17-aaeb-8a9923171d9b"],

Cell[TextData[{
 "When parsing the user's input, the operation ",
 StyleBox["Plus", "Program"],
 " is first replaced by ",
 StyleBox["GPlus$", "Program"],
 " and then, depending on operands, it may be replaced by ",
 StyleBox["Plus$", "Program"],
 " or ",
 StyleBox["VPlus$", "Program"],
 ". In the last step, the operations ",
 StyleBox["Plus$", "Program"],
 ", ",
 StyleBox["VPlus$", "Program"],
 " and ",
 StyleBox["GPlus$", "Program"],
 " are replaced by, respectively, ",
 StyleBox["Plus", "Program"],
 ", ",
 ButtonBox["VPlus",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["GPlus",
  BaseStyle->"AddOnsLink"],
 ".\nTo ensure that the final operation will be ",
 StyleBox["Plus", "Program"],
 " independently of operands, one can enter ",
 StyleBox["Plus$", "Program"],
 " instead of ",
 StyleBox["Plus", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.4215054541343184`*^9, 3.4215054817239904`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Plus$", "b:3.15"},ExpressionUUID->"9aee0c9d-67de-4d3c-b3c5-95bfdcbcb827"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PoissonAlgebra", "Subsubsection",
 CellTags->{
  "i:152", "PoissonAlgebra", "b:3.15", 
   "c:170"},ExpressionUUID->"57c76f6e-90d9-475d-af98-7150af47632d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", " ", "x"}], "]"}], TraditionalForm]],
  ExpressionUUID->"27659cd0-0668-4945-8d71-e24b9cb30a65"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "7697d545-d89d-4ca4-a956-f48e3270739e"],
 " as the Poisson algebra on the (super)space of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "4de1b324-b3c5-4477-bbf6-fe515fd326ab"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"2", "n"}]], TraditionalForm]],ExpressionUUID->
  "e180bfd3-31da-413b-b41f-1bcce7e3d9d4"],
 " (the vector space ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "3dc65fd9-f661-4749-aba1-25eeeec9d428"],
 " should be already defined) with the Poisson bracket \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "[", "f", "]"}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", 
            RowBox[{
             RowBox[{"2", "n"}], "+", "1", "-", "i"}]]}]]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"P", "[", 
           SubscriptBox["x", "i"], "]"}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", 
            RowBox[{
             RowBox[{"2", "n"}], "+", "1", "-", "i"}]]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", "i"]}]]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c6734f16-b736-4022-94d8-a6e2d12c1959"],
 ".\n\t"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.42150550710048*^9, 3.4215055109760528`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "PoissonAlgebra", 
   "b:3.15"},ExpressionUUID->"ab0ae6de-7aeb-484a-bafa-5cfb00283476"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", "q"}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"bc7096be-1e43-4352-bc6f-c93dfdac0458"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "9bbac8fd-4cc5-434f-922a-1c30306d00e3"],
 " as the Poisson algebra on the (super)space of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "1"], TraditionalForm]],ExpressionUUID->
  "e471dcf4-0b9f-4c60-982d-fd8ef10f1524"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "n"], TraditionalForm]],ExpressionUUID->
  "9cb40323-54ab-4fe8-81e8-f60df1e127f9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "1"], TraditionalForm]],ExpressionUUID->
  "26ac73b3-a3b6-45f2-9169-8465ee2aa589"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "n"], TraditionalForm]],ExpressionUUID->
  "87e96bfb-3dda-441d-a663-f22311371d36"],
 " (the vector spaces ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "2c939cb7-b42c-48f8-82cb-e13e47099073"],
 " and ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "a291c2f2-767f-4920-a847-60e39380b889"],
 " should be already defined and have the same superdimension) with the \
Poisson bracket \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"P", "[", "f", "]"}], 
        RowBox[{"P", "[", 
         SubscriptBox["p", "i"], "]"}]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["p", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["q", "i"]}]]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"P", "[", 
           SubscriptBox["p", "i"], "]"}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["q", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["p", "i"]}]]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"1f8df383-ffe4-4a45-ae46-e9683e8d6a43"],
 ".\n\t"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.4215055237343984`*^9, 3.4215055353310738`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "PoissonAlgebra", 
   "b:3.15"},ExpressionUUID->"2bf8a0c1-84e3-4940-bec7-cd2ea5561244"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", " ", 
     RowBox[{"{", "\[Theta]", "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"c75556c7-6120-497e-8df3-1e0282a2ab98"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "4fb5dd11-c0f3-463f-91cd-059bc1726407"],
 " as the Poisson algebra on the (super)space of polynomials in the odd \
variables ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "1"], TraditionalForm]],ExpressionUUID->
  "24d0bd95-6238-499b-996b-b4f118b0c45d"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "n"], TraditionalForm]],ExpressionUUID->
  "694652c9-0f9f-4d20-9943-69f3feb43358"],
 " (the vector space ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "8fa84770-f2aa-4da8-99b6-b03a1d44fef2"],
 " should be already defined) with the Poisson bracket\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"P", "[", "f", "]"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", " ", "f"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["\[Theta]", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "g"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["\[Theta]", "i"]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"5ab6d649-73d0-4af6-a839-2bd071480fdd"],
 ".\n\t"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.4215055713628845`*^9, 3.421505574467349*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "PoissonAlgebra", 
   "b:3.15"},ExpressionUUID->"c6d40be7-52ea-4b76-a339-70fadbde96f1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["p", "n"]}], ",", 
        SubscriptBox["q", "n"], ",", 
        RowBox[{"...", 
         SubscriptBox["q", "1"]}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "855ca575-9317-446c-93fc-4e803f5b1b11"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["p", "n"]}], ",", "\[Theta]", ",", 
        SubscriptBox["q", "n"], ",", 
        RowBox[{"...", 
         SubscriptBox["q", "1"]}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "82aed5fa-9b4f-463a-9825-a8d297e92cc3"],
 ", where all ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "f31963d7-28c2-4330-bd07-e76fd1bfc95a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],ExpressionUUID->
  "b96847ee-6276-41d5-b75c-3338286fb5c2"],
 " and ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "dbc8404f-7209-4cd8-b0c2-2e8c68fde7c5"],
 " are (super)spaces, define the Lie (super)algebra ",
 StyleBox["\[GothicG]",
  FontSlant->"Italic"],
 " as the Poisson algebra on the (super)space of polynomials on the direct \
sum of vector (super)spaces with the Poisson bracket equal to the sum of the \
Poisson brackets on pairs  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "20748100-620d-4699-b659-762ac189db75"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],ExpressionUUID->
  "976b8850-4eac-422b-99b5-b282f91c4cda"],
 " and on ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "763b84be-4686-4025-a8b5-c3e1075b0a57"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.421505608546352*^9, 3.4215057085601645`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "PoissonAlgebra", 
   "b:3.15"},ExpressionUUID->"e637c34b-d2a4-4418-a469-82aa8df2aef6"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PoissonAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "x", ",", " ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["c", "1"], ",", 
          SubscriptBox["i", "1"], ",", 
          SubscriptBox["j", "1"]}], "}"}], ",", "...", ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["c", "m"], ",", 
          SubscriptBox["i", "m"], ",", 
          SubscriptBox["j", "m"]}], "}"}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "c502abd0-6d99-474b-867c-504d6e735a45"],
 " defines the Poisson algebra with the bracket \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"P", ".", "b", "."}]], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "[", "f", "]"}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "m"], 
      RowBox[{
       SubscriptBox["c", "k"], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "f"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["x", 
          SubscriptBox["i", "k"]]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "g"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["x", 
          SubscriptBox["j", "k"]]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ff2258c1-c9ba-47ba-8c1f-44318762a47b"],
 "."
}], "Text",
 Evaluatable->False,
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "PoissonAlgebra", 
   "b:3.15"},ExpressionUUID->"b0f5532c-1099-4cd0-9c4f-1d7047489087"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PolyGrade", "Subsubsection",
 CellTags->{
  "i:153", "PolyGrade", "b:3.15", 
   "c:171"},ExpressionUUID->"c4d77c3d-139d-449b-bee6-a2d916f7144f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PolyGrade", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"5e5ff979-8558-4a95-adc0-2b1f7ee7e918"],
 " is a polygrading function. For  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalZ]", "n"], TraditionalForm]],
  ExpressionUUID->"566aa718-5775-413f-a2fc-bc69dbb2ebcb"],
 "-graded or filtered modules, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PolyGrade", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"9a03319e-e740-4216-8d05-93c42eb1eb6c"],
 " returns a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["g", "1"], ",", 
     RowBox[{"...", 
      SubscriptBox["g", "n"]}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "c794ba42-59b6-4299-9bda-0b8684ec9399"],
 " that represents the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalZ]", "n"], TraditionalForm]],
  ExpressionUUID->"a89f1afb-a506-4494-a86a-183f85c42267"],
 "-grading or filtration of the vector ",
 StyleBox["v",
  FontSlant->"Italic"],
 ".\nFor filtered modules, the function is defined on the elements of the \
basis. For graded modules, the function is defined on homogeneous vectors.\n\
The function ",
 StyleBox["PolyGrade", "Name"],
 " is defined by some space constructors. When an algebra is built from \
generators, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PolyGrade", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"21ca3cb3-ee92-4185-861f-84321d2e4b11"],
 " is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["d", "1"], ",", 
     SubscriptBox["d", "2"], ",", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"02094aa2-c06e-4de7-8a44-d15250f9417b"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "i"], TraditionalForm]],ExpressionUUID->
  "6272fa68-8b2b-4f1f-9376-c9a9c3468571"],
 " is the degree of the ",
 StyleBox["i",
  FontSlant->"Italic"],
 "-th generator in the expression of ",
 StyleBox["v",
  FontSlant->"Italic"],
 " in term of generators."
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.4215057332857184`*^9, 3.4215057337964525`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "PolyGrade", 
   "b:3.15"},ExpressionUUID->"8c448d77-5a6d-4199-a734-25c707f81f25"]
}, Open  ]],

