 " in the expression expr by their images under the decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", ":", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "\[LongRightArrow]", 
       SubscriptBox["g", "1"]}], "\[CirclePlus]"}], "..."}]}], 
   TraditionalForm]],ExpressionUUID->"61c443e9-bdd9-4ab6-b9a5-d375241427cc"],
 " ."
}], "Text",
 CellChangeTimes->{{3.42143376950712*^9, 3.4214337779092016`*^9}},
