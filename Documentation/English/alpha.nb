Cell[CellGroupData[{

Cell["ThreadGraded", "Subsubsection",
 CellTags->{
  "i:215", "ThreadGraded", "b:3.19", 
   "c:241"},ExpressionUUID->"7dd5ea4f-39cc-438c-b223-ae92ad6e1de7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ThreadGraded", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"56156ca1-f87a-4654-b533-eb1dbc931a1a"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"a", "\[SmallCircle]", "b"}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"f", "[", "a", "]"}], "+", 
     RowBox[{"f", "[", "b", "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "929e06a2-d430-403b-bd01-f116a9573fff"],
 " for any graded operation \[SmallCircle]. The function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "714698f0-868d-4841-92c4-0d13dd311f40"],
 " should be declared to be scalar or vector. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ThreadGraded", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["plus",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "3cb885b0-62f5-4bd7-a917-00cb5f18d8bc"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"a", "\[SmallCircle]", "b"}], "]"}], "=", 
    RowBox[{
     StyleBox["plus",
      FontSlant->"Italic"], "[", 
     RowBox[{
      RowBox[{"f", "[", "a", "]"}], ",", 
      RowBox[{"f", "[", "b", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"c9cc4b4f-2464-4bbb-b6d2-70ee11e8236c"],
 ". "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ThreadGraded", 
   "b:3.19"},ExpressionUUID->"9401e629-09e8-420e-be3d-54f4f81e7e04"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ThreadGradedRule", "Subsubsection",
