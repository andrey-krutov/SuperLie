   "c:43"},ExpressionUUID->"c2c5c6a5-70de-4e43-bb33-fc627f4982f2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["expr",
     FontSlant->"Italic"], " ", "/.", " ", 
    RowBox[{
     StyleBox["DecompositionRule", "Program"], "[", "g", ",", "f", "]"}]}], 
   TraditionalForm]],ExpressionUUID->"6da76ebf-b5e9-45f9-8e59-b70d37edece1"],
