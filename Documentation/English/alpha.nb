Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["kb", "Program"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "59934d3e-4ed1-4fbd-9ab8-def586831ffa"],
 " represents the Contact bracket (the operator in the contact algebra) but \
is not unevaluated."
}], "Text",
