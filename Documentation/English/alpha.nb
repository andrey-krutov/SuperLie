Cell[CellGroupData[{

Cell["CondOp", "Subsubsection",
 CellTags->{
  "i:34", "CondOp", "b:3.2", 
   "c:36"},ExpressionUUID->"96e1571a-26e0-49a8-a36c-5b901c01d1b2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CondOp",
     FontFamily->"Courier New"], "[", 
    StyleBox["domain",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "8e4fc136-c854-4ca9-b3d0-70ccffeae886"],
 " returns the name of a conditional operation with values in ",
 StyleBox["domain",
  FontSlant->"Italic"],
 ". This operation is defined as \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["op",
      FontSlant->"Italic"], "[", 
     RowBox[{
      StyleBox["cond",
       FontSlant->"Italic"], ",", 
      StyleBox["value",
       FontSlant->"Italic"]}], "]"}], ":=", 
    RowBox[{
     StyleBox["{",
      SpanMaxSize->Infinity], 
     StyleBox[" ",
      SpanMaxSize->Infinity], GridBox[{
       {
        RowBox[{
         StyleBox["value",
          FontSlant->"Italic"], ","}], 
        RowBox[{
         RowBox[{
          RowBox[{"if", " ", 
           StyleBox["cond",
            FontSlant->"Italic"]}], "\[Equal]", 
          StyleBox["True", "Program"]}], 
         StyleBox[",",
          FontFamily->"Courier New"]}]},
       {
        RowBox[{"0", ","}], 
        RowBox[{
         RowBox[{
          RowBox[{"if", " ", 
           StyleBox["cond",
            FontSlant->"Italic"]}], "\[Equal]", 
          StyleBox["False", "Program"]}], 
         StyleBox[",",
          FontFamily->"Courier New"]}]},
       {
        RowBox[{"unevaluated", ","}], 
        RowBox[{"otherwise", "."}]}
      },
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[1.4]}, 
          Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}, "RowsIndexed" -> {}}]}]}], TraditionalForm]],
  TextAlignment->Left,ExpressionUUID->
  "3048deb6-4f74-4435-ad28-9c58a5aee488"],
 " \n\nThe conditional operation is involved in symbolic processing.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CondOp",
     FontFamily->"Courier New"], "[", 
    RowBox[{
     StyleBox["domain",
      FontSlant->"Italic"], "->", 
     StyleBox["name",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "6b909209-4879-4cd3-aaaf-622fff061209"],
 " defines this operation."
}], "Text",
 CellChangeTimes->{3.4232338981895075`*^9},
 CellTags->{
  "CondOp", "b:3.2"},ExpressionUUID->"83912467-e6d9-4d93-be27-fde3676143aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ContactAlgebra", "Subsubsection",
 CellTags->{
  "i:35", "ContactAlgebra", "b:3.2", 
   "c:37"},ExpressionUUID->"e8e7272e-55fe-4047-bad1-5ade6e66d76d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ContactAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "x", ",", " ", "t"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"62a09e8b-6325-4ae8-ad09-7e9ba655b574"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ContactAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "x", ",", " ", "t", ",", " ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["c", "1"], ",", 
          SubscriptBox["i", "1"], ",", 
          SubscriptBox["j", "1"]}], "}"}], ",", "...", ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["c", "m"], ",", 
          SubscriptBox["i", "m"], ",", 
          SubscriptBox["j", "m"]}], "}"}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "74755a8e-fbc4-48fd-87c2-b1d5cf14de54"],
 " define the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "8447a397-ae0d-429f-b493-25ecebe749a6"],
 " as the contact (super)algebra of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "76fb8000-8c5d-40a2-b2af-fb60e4865ed0"],
 ",... and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "ff6de3dc-89a5-4125-8a28-53adc80811ea"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ContactAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", "...", ",", "q"}], "}"}], ",", " ", "t"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"e711db78-a863-44c5-8c40-c0e2107cb534"],
 " defines the contact algebra of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "1"], TraditionalForm]],ExpressionUUID->
  "dd8f052b-b4fb-476a-8ca9-23cff04ae362"],
 ", ... ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "n"], TraditionalForm]],ExpressionUUID->
  "fee70bec-8bd5-41be-9e4c-9198cdc894e7"],
 ", ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "4802b1a2-5b88-409a-8ffa-68a308de87c9"],
 ". The Poisson bracket on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "544458f0-0f43-4d60-ad5b-2874a970b682"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"p", ",", 
     RowBox[{"...", "q"}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "7e67629f-5579-43f4-97cc-446b91fcc3d0"],
 " is also defined. The spaces ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "e2044def-46d0-4ca0-90dc-85d33484d0b3"],
 " or ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "b71bddc4-44ba-433d-b822-4ae4109f07cb"],
 ", ..., ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "4c0e4aec-2091-481c-b1e6-b0b0093aef3d"],
 " should be already defined (as for ",
 ButtonBox["PoissonAlgebra",
  BaseStyle->"AddOnsLink"],
 ")."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.4214332846499295`*^9, 3.421433293172184*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "ContactAlgebra", 
   "b:3.2"},ExpressionUUID->"6013879b-bfa8-4e3f-ad84-25f9b4dacd0f"]
}, Open  ]],

