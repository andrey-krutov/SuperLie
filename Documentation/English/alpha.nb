Cell[CellGroupData[{

Cell["Output", "Subsubsection",
 CellTags->{
  "i:139", "Output", "b:3.14", 
   "c:155"},ExpressionUUID->"034562db-9852-450f-be60-5a8fd1acdce7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Output", "Program"], "[", 
    RowBox[{
     StyleBox["v",
      FontSlant->"Italic"], "\[Rule]", "f"}], "]"}], TraditionalForm]],
  ExpressionUUID->"c47e3a3a-daef-4c34-ad90-d9648f515126"],
 " defines the format of expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "[", "...", "]"}], TraditionalForm]],ExpressionUUID->
  "168ca176-9677-4c07-bcb7-845343115063"],
 " in the Output form as  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     StyleBox["v", "Var"], "[", "...", "]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"b7b2abda-7f95-439b-ab96-0e45a91f2058"],
 " . \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Output", "Program"], "\[Rule]", "f"}], TraditionalForm]],
  ExpressionUUID->"a38a88fb-1821-49d7-8efd-46e90598a263"],
 " is an optional parameter to space constructors that defines the output \
format of the space elements."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Output", "b:3.14"},ExpressionUUID->"e2e25a1f-aae2-4d8a-9136-6b4afb6fdbeb"]
}, Open  ]]
}, Open  ]],

