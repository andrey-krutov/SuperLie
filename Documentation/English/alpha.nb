Cell[CellGroupData[{

Cell["MoebiusAlgebra", "Subsubsection",
 CellTags->{
  "i:125", "MoebiusAlgebra", "b:3.12", 
   "c:139"},ExpressionUUID->"180cc455-b23a-4429-8237-b3fd2f62f941"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["MoebiusAlgebra", "Program"], "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "\[Theta]", ",", "t"}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"dc368990-c711-479e-aacc-afe07434e6be"],
