Cell[CellGroupData[{

Cell["Kb, kb", "Subsubsection",
 CellTags->{
  "i:101", "Kb", "kb", "b:3.10", 
   "c:116"},ExpressionUUID->"38ebddeb-bf9b-45bd-bc69-20a8eedb0840"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Kb", "Program"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "47bdd6c9-48a5-4ea1-ad11-0c3226ca7be7"],
 " is the Contact bracket (the operator in the contact algebra)."
