Cell[TextData[{
 "If ",
 StyleBox["s",
  FontSlant->"Italic"],
 " denotes the passive form of some operator,  ",
 StyleBox["Operator", "Name"],
 "[",
 StyleBox["s", "Var",
  FontSlant->"Italic"],
 "] returns the name of the active form of the same operator."
}], "Text",
 CellTags->{
  "Operator", 
   "b:3.14"},ExpressionUUID->"4e6bab92-598b-4feb-aace-c93a4d89ee10"]
}, Open  ]],

