Cell[CellGroupData[{

Cell["PDim", "Subsubsection",
 CellTags->{
  "i:145", "PDim", "b:3.15", 
   "c:163"},ExpressionUUID->"182fca5b-25c2-4cae-9e89-8050023a0991"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PDim", "Program"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"2661ffd8-90b6-45de-96b2-87f4844ebd2b"],
 " returns the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["evenDim",
      FontSlant->"Italic"], ",", 
     StyleBox["oddDim",
      FontSlant->"Italic"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "afff5b1f-1092-488b-911f-aea2a69184bd"],
 " of dimensions of the even and odd components of the vector superspace ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "3c8a55d3-aed1-4fde-bb5c-72f8a0761a39"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PDim", "Program"], "[", 
    RowBox[{"V", ",", "r"}], "]"}], TraditionalForm]],ExpressionUUID->
  "0fbc12f4-37e6-4c96-9b2a-577c0615eb23"],
 " returns the superdimension of the component of degree ",
 StyleBox["r",
  FontSlant->"Italic"],
 " in the graded space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "adb7ce8c-fcd2-4b36-a307-2130d578f137"],
 "."
}], "Text",
 CellTags->{
