Cell[CellGroupData[{

Cell["Power$", "Subsubsection",
 CellTags->{
  "i:155", "Power$", "b:3.15", 
   "c:174"},ExpressionUUID->"bc008cb6-78ef-46dd-be93-f1d91c36aa76"],

Cell[TextData[{
 "When parsing the user's input, the operation ",
 StyleBox["Power", "Program"],
 " is first replaced by ",
 StyleBox["GPower$", "Program"],
 " and then, depending on the first operand, it may be replaced by ",
 StyleBox["Power$", "Program"],
 " or ",
 StyleBox["VPower$", "Program"],
 ". In the last step, the operations ",
 StyleBox["Power$", "Program"],
 ", ",
 StyleBox["VPower$", "Program"],
 " and ",
 StyleBox["GPower$", "Program"],
 " are replaced by, respectively, ",
 StyleBox["Power", "Program"],
 ", ",
 ButtonBox["VPower",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["GPower",
  BaseStyle->"AddOnsLink"],
 ".\nTo ensure that the final operation will be ",
 StyleBox["Power", "Program"],
 " independently of the first operands, one can enter ",
 StyleBox["Power$", "Program"],
 " instead of ",
 StyleBox["Power", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.421505749348816*^9, 3.421505766303195*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Power$", "b:3.15"},ExpressionUUID->"b05d5f53-94ca-4b6a-aaa5-2549583da869"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PreSL", "Subsubsection",
 CellTags->{
  "i:156", "PreSL", "b:3.15", 
   "c:175"},ExpressionUUID->"c0479d39-941e-4b2a-8f58-2d5918947076"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox["PreSL", "Program"], TraditionalForm]],ExpressionUUID->
  "9d542d98-c626-4bc8-b9a3-faa3c7736625"],
 " is preprocessor that converts operations ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    RowBox[{",", " ", 
     RowBox[{"-", 
      RowBox[{",", " ", 
       RowBox[{"*", 
        RowBox[{",", " ", 
         RowBox[{"/", 
          RowBox[{",", " ", "^"}]}]}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"0af07be2-db0c-4d5b-b9a1-5032f5ee4d2a"],
 "  to vector or scalar operations.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox["$Pre",
      BaseStyle->"Link",
      ButtonData:>"paclet:ref/$Pre"], "Program"], "=", 
    StyleBox["PreSL", "Program"]}], TraditionalForm]],ExpressionUUID->
  "74ca81de-0277-43dc-8a38-afc27f858e90"],
 " turns the preprocessor on. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox["$Pre",
      BaseStyle->"Link",
      ButtonData:>"paclet:ref/$Pre"], "Program"], "=."}], TraditionalForm]],
  ExpressionUUID->"fed64e4b-8e6e-4807-8ca0-cb9fb82e1b54"],
 " turns the preprocessor off."
}], "Text",
 CellChangeTimes->{{3.623314449399474*^9, 3.6233145173586006`*^9}, {
  3.6233146905539246`*^9, 3.6233146905539246`*^9}},
 CellTags->{
  "PreSL", "b:3.15"},ExpressionUUID->"36b51f4c-d1dc-439d-8325-513c5c1bbf13"]
}, Open  ]],

Cell[CellGroupData[{

Cell["pslAlgebra", "Subsubsection",
 CellTags->{
  "i:157", "pslAlgebra", "b:3.15", 
   "c:176"},ExpressionUUID->"f837c700-89e9-4feb-aa50-fd890d0a90e0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["pslAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "V"}], "]"}], TraditionalForm]],
  ExpressionUUID->"3141079c-25b5-47a7-a7ad-5b6a997f95b5"],
 "  defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "=", 
    RowBox[{
     RowBox[{"\[GothicP]\[GothicS]\[GothicL]", "(", "V", ")"}], "=", 
     RowBox[{
      RowBox[{"\[GothicS]\[GothicL]", "(", "V", ")"}], "/", 
      StyleBox[
       RowBox[{"\[LeftAngleBracket]", "center", "\[RightAngleBracket]"}], 
       "Program"]}]}]}], TraditionalForm]],ExpressionUUID->
  "9d5c9538-4339-4dfa-b270-62882b1eed7c"],
 ". The even and odd components of ",
 StyleBox["V",
  FontSlant->"Italic"],
 " should have the same dimension.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["pslAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{
      StyleBox["Dim", "Program"], "\[Rule]", "n"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"7dbaf528-6027-4b6b-8145-474131bfcabf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["pslAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{
      StyleBox["PList", "Program"], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["p", "n"]}]}], "}"}]}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"873dbb77-3df8-431b-a4d3-96a39d29effc"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "=", 
    RowBox[{
     RowBox[{"\[GothicP]\[GothicS]\[GothicL]", "(", "n", ")"}], "=", 
     RowBox[{
      RowBox[{"\[GothicS]\[GothicL]", "(", "n", ")"}], "/", 
      StyleBox[
       RowBox[{"\[LeftAngleBracket]", "center", "\[RightAngleBracket]"}], 
       "Program"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a2c2ff56-5567-47b3-83a2-f47b4803630e"],
 ". The dimension may be a number, an expression, or a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["n", "1"], ",", 
     SubscriptBox["n", "2"], ",", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"0eb1f32d-e030-48f8-8401-0440735443c0"],
 ", as for ",
 StyleBox["VectorSpace", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.4215057936925793`*^9, 3.421505811307909*^9}},
 CellTags->{
  "pslAlgebra", 
   "b:3.15"},ExpressionUUID->"44161776-1127-45d0-bc88-a36f2e1a50df"]
}, Open  ]],

