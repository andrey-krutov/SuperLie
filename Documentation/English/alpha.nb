      RowBox[{
       StyleBox["op",
        FontSlant->"Italic"], "[", 
       RowBox[{
        SubscriptBox["v", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["v", "n"]}]}], "]"}], ",", "x"}], "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        StyleBox["Deg", "Name"], "[", 
        RowBox[{
         SubscriptBox["v", "1"], ",", "x"}], "]"}], "+"}], "..."}], "+", 
     RowBox[{
      StyleBox["Deg", "Name"], "[", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "x"}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"6a26ea9b-31f1-4950-91f6-a96a08860821"],
