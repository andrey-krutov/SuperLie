  FormBox[
   OverscriptBox["x", "s"], TraditionalForm]],ExpressionUUID->
  "0a943cd1-0339-461b-a0ef-ebbea23c8988"],
 " in the standard and traditional formats. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["NewOverscript", "Program"], "[", 
    RowBox[{
     StyleBox["op",
      FontSlant->"Italic"], ",", "\"\<\>", 
     StyleBox["s",
      FontSlant->"Italic"], "\"\<\>", ",", 
     StyleBox["sTeX",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "5ab8028d-546d-4f36-a473-361d0bcb1680"],
