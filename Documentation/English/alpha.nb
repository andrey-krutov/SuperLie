   "c:44"},ExpressionUUID->"04ac4761-db94-4470-ab35-c119ab0df4cc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DefSubAlgebra", "Name"], "[", 
    RowBox[{"\[GothicH]", ",", " ", "\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "..."}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"aee799ef-b131-474a-ad86-2d89e7817d15"],
 " defines the subalgebra ",
 Cell[BoxData[
  FormBox["\[GothicH]", TraditionalForm]],ExpressionUUID->
  "c37bd54c-292a-48b5-b2ce-3fa95fc81bb9"],
 " of the Lie (super)algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "a382a515-b84f-4685-b4a8-d28da0f7c249"],
 "  on the vector space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicH]", "=", 
    RowBox[{
     RowBox[{"Span", "(", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "..."}], ")"}], "\[Subset]", 
     "\[GothicG]"}]}], TraditionalForm]],ExpressionUUID->
  "011c562e-81de-4747-a5cb-9c183590522c"],
 ". If the space ",
 "\[GothicH]",
 " is not closed with respect to the bracket in ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "0920fa9d-82c3-4d74-9ecd-8695683b78d8"],
 ", the missing commutators are added to the space.\nThe bracket in the \
subalgebra is defined in ",
 ButtonBox["Tabular",
  BaseStyle->"AddOnsLink"],
 " form. It is fastest for calculations and supported by all functions in ",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " package. \nOption ",
 ButtonBox["Split",
  BaseStyle->"AddOnsLink"],
 "\[Rule]",
 StyleBox["f", "Var"],
 "  instructs to split the space in order to accelerate calculations.\nSee \
also  ",
 ButtonBox["SubAlgebra",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellChangeTimes->{{3.4214338236950383`*^9, 3.421433845316128*^9}, {
  3.421433927714611*^9, 3.4214339353555984`*^9}},
 CellTags->{
  "DefSubAlgebra", 
   "b:3.3"},ExpressionUUID->"0b80d5e3-6510-4515-8f07-c8c7bbd796ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Deg", "Subsubsection",
 CellTags->{
  "i:44", "Deg", "b:3.3", 
   "c:45"},ExpressionUUID->"c729b267-c3b2-4891-ab32-8832cbab695d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Deg", "Program"], "[", 
    StyleBox["expr",
     FontSlant->"Italic"], ",", "x", "]"}], TraditionalForm]],ExpressionUUID->
  "7b0fc9af-2638-4b3b-a88c-3db2d4c528ba"],
 " returns the degree of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "edc2baef-589e-4c30-8e31-579903522811"],
 " (or of all elements matching pattern ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "485a5f45-7a97-4223-9067-162edf27f7a4"],
 ") in the vector expression ",
 Cell[BoxData[
  FormBox[
   StyleBox["expr",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "7f9366c1-6fa8-4fef-8cba-a9fc896d3475"],
 ". If the expression ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " is not homogeneous, the result is ",
 StyleBox["Mixed", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.421433994340414*^9, 3.4214340214393806`*^9}},
 CellTags->{
  "Deg", "b:3.3"},ExpressionUUID->"39cc2a60-e794-4c03-af3b-37dde3b7b2f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DegreeBasis", "Subsubsection",
 CellTags->{
  "i:45", "DegreeBasis", "b:3.3", 
   "c:46"},ExpressionUUID->"33b25c92-6564-4ff9-aeee-930bb9b38c55"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegreeBasis", "Program"], "[", 
    StyleBox["deg",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["vars",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "c43de514-3ea0-4643-bac3-11f696c558a1"],
 " returns the list of elements of degree ",
 StyleBox["deg",
  FontSlant->"Italic"],
 " in the symmetric algebra generated by variables ",
 StyleBox["vars",
  FontSlant->"Italic"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegreeBasis", "Program"], "[", 
    RowBox[{
     StyleBox["deg",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["vars",
      FontSlant->"Italic"], ",", 
     StyleBox["lim",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "62e4184b-258b-41da-8cbc-fe55540300ad"],
 " returns the list of monomial of degree ",
 StyleBox["deg",
  FontSlant->"Italic"],
 " with degrees of variables not exceeding the corresponding limits. The \
argument ",
 StyleBox["lim",
  FontSlant->"Italic"],
 " should be a list containing integers or ",
 StyleBox["Infinity", "Program"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegreeBasis", "Program"], "[", 
    StyleBox["deg",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["vars",
     FontSlant->"Italic"], ",", " ", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "ff96d17c-1ac8-4b74-9349-9c5a24c042de"],
 " and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegreeBasis", "Program"], "[", 
    RowBox[{
     StyleBox["deg",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["vars",
      FontSlant->"Italic"], ",", 
     StyleBox["lim",
      FontSlant->"Italic"], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "39e4deca-bf2b-4811-b282-0eed4cb2f166"],
 " use the symbol ",
 Cell[BoxData[
  FormBox[
   StyleBox["op",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "1581ebac-c53f-462e-8ba9-d38a0427cdd8"],
 " instead of ",
 StyleBox["VTimes", "Program"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegreeBasis", "Program"], "[", 
    RowBox[{
     StyleBox["deg",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["vars",
      FontSlant->"Italic"], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "4a0ec886-98dd-41ad-999e-4d87112c31d2"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegreeBasis", "Program"], "[", 
    RowBox[{
     StyleBox["deg",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["vars",
      FontSlant->"Italic"], ",", 
     StyleBox["op",
      FontSlant->"Italic"], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "0d59abf9-83c8-4f52-8ee2-182f2415903c"],
 " return the element of an antisymmetric algebra. "
}], "Text",
 CellChangeTimes->{{3.421434048107728*^9, 3.421434074455614*^9}},
 TextAlignment->Left,
 TextJustification->0,
 CellTags->{
  "DegreeBasis", 
   "b:3.3"},ExpressionUUID->"c4dd297e-c731-4154-9862-e5bd96b19f92"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DegTimes", "Subsubsection",
 CellTags->{
  "i:46", "DegTimes", "b:3.3", 
   "c:47"},ExpressionUUID->"596bfc6f-78e5-4225-97fd-655ae412794e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DegTimes", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "6135cd40-d536-4ee5-b786-90962348accc"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Deg", "Program"], "[", 
     RowBox[{
      StyleBox["op",
       FontSlant->"Italic"], "[", 
      SubscriptBox["v", "1"], ",", "...", 
      SubscriptBox["v", "n"], "]"}], ",", "x", "]"}], "=", 
    RowBox[{
     StyleBox["Deg", "Program"], "[", 
     SubscriptBox["v", "1"], ",", "x", "]"}], "+", "...", "+", 
    RowBox[{
     StyleBox["Deg", "Program"], "[", 
     SubscriptBox["v", "n"], ",", "x", "]"}]}], TraditionalForm]],
  ExpressionUUID->"b78783d0-3224-4f20-ab26-bdc34cbcd666"],
 " ."
}], "Text",
 CellTags->{
  "DegTimes", "b:3.3"},ExpressionUUID->"3ae7fd40-ea95-445c-85a3-dc269576f724"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Delta", "Subsubsection",
 CellTags->{
  "i:47", "Delta", "b:3.3", 
   "c:48"},ExpressionUUID->"a3d79868-facb-484a-a079-d1d9988e0e0c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Delta", "Program"], "[", 
     RowBox[{"x", ",", "y"}], "]"}], " ", "=", 
    StyleBox[" ",
     SpanMaxSize->Infinity], 
    RowBox[{
     StyleBox["{",
      SpanMaxSize->Infinity], GridBox[{
       {"1", 
        RowBox[{
         RowBox[{"if", " ", "x"}], "\[Equal]", "y", " "}]},
       {"0", 
        RowBox[{
         RowBox[{"if", " ", "x"}], "\[NotEqual]", 
         RowBox[{"y", "."}]}]}
      }]}]}], TraditionalForm]],ExpressionUUID->
  "9d9174bd-523e-45c7-9396-e28d76bd3399"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Delta", "Program"], "[", "x", "]"}], " ", "=", " ", 
    RowBox[{
     StyleBox["Delta", "Program"], "[", 
     RowBox[{"x", ",", "0"}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "7b0c7a7c-ee3b-4fc8-aa75-748853c7df90"],
 "."
}], "Text",
 CellChangeTimes->{{3.421434093593133*^9, 3.4214341290641375`*^9}},
 CellTags->{
  "Delta", "b:3.3"},ExpressionUUID->"b591438c-1d6d-4302-8d49-5f62765c6ed9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Der, der", "Subsubsection",
 CellTags->{
  "i:48", "Der", "der", "b:3.3", 
   "c:49"},ExpressionUUID->"abd92120-7f1e-4378-ac07-ee78bdfc7af4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Der", "Program"], "[", "\[Omega]", "]"}], TraditionalForm]],
  ExpressionUUID->"1963552a-8799-4fae-842b-5e62aaa4cf68"],
 " is the exterior derivative of the form \[Omega] (considered as a \
multilinear function) with scalar coefficients.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Der", "Program"], "[", 
    RowBox[{"m", "**", "\[Omega]"}], "]"}], TraditionalForm]],ExpressionUUID->
  "da450512-979e-46d0-a144-a036c7dd7c47"],
 " is the exterior derivative of the form  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "**", "\[Omega]"}], TraditionalForm]],ExpressionUUID->
  "6dabce3f-0307-4b0d-ab12-5a4c1c13ed40"],
 " with coefficients in a module.\nThe form \[Omega] may be an odd left form \
on a Lie algebra or an exterior product of such forms; ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "9140e80d-7746-4ad3-af7e-45b5c6dfa44a"],
 " must be an element of a module over the same algebra. The derivative of a \
0-form with coefficients in a \[GothicG]-module is written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Der0", "Program"], "[", 
    RowBox[{"m", ",", "\[GothicG]"}], "]"}], TraditionalForm]],ExpressionUUID->
  "5f45c179-960a-498d-bb51-e8965496cd33"],
 "."
}], "Text",
 CellChangeTimes->{{3.421434161851283*^9, 3.4214342173410735`*^9}},
 CellTags->{
  "Der", "der", 
   "b:3.3"},ExpressionUUID->"db7bc989-92ef-4517-ad8d-78c69bb86bc5"],

Cell[TextData[{
 StyleBox["der", "Program"],
 " is the passive form of the exterior derivative ",
 ButtonBox["Der",
  BaseStyle->"AddOnsLink"],
 ".\nProperties: ",
 ButtonBox["Linear",
  BaseStyle->"AddOnsLink"],
 StyleBox["\[Rule]First", "Name"]
}], "Text",
 CellTags->{
  "der", "Der", 
   "b:3.3"},ExpressionUUID->"6a26276b-3cf0-4fd4-ae0c-22b7c7ae68e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Der0", "Subsubsection",
 CellTags->{
  "i:50", "Der0", "b:3.3", 
   "c:50"},ExpressionUUID->"12115354-6d03-43a8-a250-986510312d58"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Der0", "Program"], "[", 
    RowBox[{"m", ",", "\[GothicG]"}], "]"}], TraditionalForm]],ExpressionUUID->
  "aa1420bc-6da7-475f-bcf5-e1c8084197de"],
 " is the exterior derivative of the 0-form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "**", 
    RowBox[{
     StyleBox["wedge", "Program"], "[", "]"}]}], TraditionalForm]],
  ExpressionUUID->"0cb8f279-35d4-4125-bf2c-8a1814b83cb1"],
 " with coefficients in a \[GothicG]-module."
}], "Text",
 CellTags->{
  "Der0", "b:3.3"},ExpressionUUID->"423c9e12-734e-4f60-801b-338e81fbdd81"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DiffAlgebra", "Subsubsection",
 CellTags->{
  "i:51", "DiffAlgebra", "b:3.3", 
   "c:51"},ExpressionUUID->"e74ed84b-64e4-4104-88bb-2abdf3174303"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DiffAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "V"}], "]"}], TraditionalForm]],ExpressionUUID->
  "7e1720fd-d5a1-40b0-929d-33b0fb43cdda"],
 " defines ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "ce85e578-3073-403e-91d6-7f12db02167a"],
 " as the Lie (super)algebra of  differential operators on the (super)space \
",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "05a4d622-8197-415d-891d-3df74c15c0e8"],
 ". The option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["D", "Program",
     FontSlant->"Plain"], "\[Rule]", "d"}], TraditionalForm]],ExpressionUUID->
  "94c56f8a-96c1-4b47-9238-fd62eba27ef8"],
 " defines the notation for partial derivative: ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[PartialD]", 
    RowBox[{"\[PartialD]", " ", "x"}]], TraditionalForm]],ExpressionUUID->
  "b5a04bc5-ddce-48b5-8213-2cd247ba330d"],
 "is denoted by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "[", "x", "]"}], TraditionalForm]],ExpressionUUID->
  "b9959f5a-b220-475c-9dca-6ef4bd08d361"],
 ". The option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Bracket", "Program"], "\[Rule]", "b"}], TraditionalForm]],
  ExpressionUUID->"edacbbcc-0cbe-4af3-87cc-b119df5c76fe"],
 " declares the name of the (super)commutator with respect to the standard \
parity induced by that of ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "8d91ef52-140a-4ddd-bdd1-11a9f7656223"],
 ". The default options are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["D", "Program",
     FontSlant->"Plain"], "\[Rule]", 
    StyleBox["d", "Program",
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "f36744c7-8479-40b6-9538-43c35ec36946"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Bracket", "Program"], "\[Rule]", 
    StyleBox["Dc", "Program"]}], TraditionalForm]],ExpressionUUID->
  "d33cc965-7a34-4020-9c85-877f32fd2a1f"],
 "."
}], "Text",
 CellChangeTimes->{{3.421434245862085*^9, 3.4214342701169615`*^9}},
 CellTags->{
  "DiffAlgebra", 
   "b:3.3"},ExpressionUUID->"b4006980-7395-4953-b83b-b7e9791cbb2b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dim", "Subsubsection",
 CellTags->{
  "i:52", "Dim", "b:3.3", 
   "c:52"},ExpressionUUID->"d1581e88-15ba-405a-bbb6-3efa2f4f697e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Dim", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"104267e2-e107-443e-9322-747956e11913"],
 " returns the dimension of the vector space ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "2af2b49b-345a-464a-9598-2a36030ca8b9"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Dim", "Program"], "[", 
    RowBox[{"v", ",", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "e008b662-06fc-4c9b-9bc3-206988d8ee9e"],
 " returns the dimension of the components of degree ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "0261acd0-9f40-42d7-877a-d261246e4ba7"],
 " of the space ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "15aa7585-da42-4fee-80b6-1a96e94d5539"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Dim", "Program"], "\[Rule]", "d"}], TraditionalForm]],
  ExpressionUUID->"92c1072b-7f60-4045-b3db-fe266e9e97db"],
 "  is the option of space constructors that defines the dimension of the \
constructed space. The value of d may be\n",
 StyleBox["\[FilledSmallSquare] a non-negative integer, a scalar expression, \
or ", "ItemizedText",
  FontSize->10],
 StyleBox["Infinity", "ItemizedText",
  FontFamily->"Courier",
  FontSize->10],
 StyleBox[". The result of the constructor will be an even vector space of a \
given dimension. \n\[FilledSmallSquare] ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["d", "0"], "|", 
     SubscriptBox["d", "1"]}], ")"}], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"2dc64d15-de60-4c27-bef0-c1c72ba07e6e"],
 ",",
 StyleBox[" where both  ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "0"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"16e6e295-4b37-4914-88a3-5f35186a29b5"],
 StyleBox[" and ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "1"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"5e4d2083-3689-4028-ba8a-31f16ac0f169"],
 StyleBox[" are non-negative integers, ", "ItemizedText",
  FontSize->10],
 StyleBox["Infinity", "ItemizedText",
  FontFamily->"Courier",
  FontSize->10],
 StyleBox[", or symbolic expressions. The result of the constructor will be a \
superspace of the given dimension. The parity of the elements of the basis \
are not defined (except for the case where ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "0"], "\[Equal]", "0"}], TraditionalForm]], 
  "ItemizedText",
  FontSize->10,ExpressionUUID->"685030d6-09ed-4075-bbe9-9b21bfddc79f"],
 StyleBox[" or ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "1"], "\[Equal]", "0"}], TraditionalForm]], 
  "ItemizedText",
  FontSize->10,ExpressionUUID->"a82f3b67-7ffd-4a13-8401-c5c571db314d"],
 StyleBox[").\n\[FilledSmallSquare] ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["d", "0"], ",", 
     SubscriptBox["d", "1"], ",", 
     SubscriptBox["d", "2"], ",", 
     RowBox[{"...", ",", 
      SubscriptBox["d", "m"]}]}], "}"}], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"02eeb66a-514d-49fe-bb82-6c2fe8e73981"],
 ",",
 StyleBox[" where all the ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "i"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"3e04a20d-783f-45c4-bcd1-7977ce5a60bd"],
 StyleBox[" are non-negative integers with two exceptions:\n (1) ", 
  "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "0"], " "}], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"26898c52-0d42-49c5-acbe-494963917277"],
 StyleBox["(or ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "1"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"66843f12-5df1-4e02-b756-f560a6006a2a"],
 StyleBox[" if ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "0"], "\[Equal]", "0"}], TraditionalForm]], 
  "ItemizedText",
  FontSize->10,ExpressionUUID->"2c257890-5d9d-4b78-ad1d-4fbe8ac933c7"],
 StyleBox[") may be ", "ItemizedText",
  FontSize->10],
 StyleBox["Infinity", "ItemizedText",
  FontFamily->"Courier",
  FontSize->10],
 StyleBox[" and \n (2) ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "m"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"e8c81925-5d15-45a4-b8bc-e1714fe5cd72"],
 StyleBox[" may be a symbolic expression or ", "ItemizedText",
  FontSize->10],
 StyleBox["Infinity", "ItemizedText",
  FontFamily->"Courier",
  FontSize->10],
 StyleBox[". The  first ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "0"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"33968a3c-98f5-4a55-b19f-9ea9aec85661"],
 StyleBox[" elements of the basis of the created space are  even, the next ", 
  "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "1"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"064ecb5d-5a08-4e97-b4e1-1ad828ef14ef"],
 StyleBox[" elements are odd, the further ", "ItemizedText",
  FontSize->10],
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "2"], TraditionalForm]], "ItemizedText",
  FontSize->10,ExpressionUUID->"5be99408-9623-46c6-b2e7-b6e0454b567f"],
 StyleBox[" elements are even, and so on. ", "ItemizedText",
  FontSize->10]
}], "Text",
 CellMargins->{{10.8125, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{
  3.421434294642227*^9, {3.4214343501320176`*^9, 3.4214344209538546`*^9}, {
   3.423234688686186*^9, 3.423234692020981*^9}},
 TextAlignment->Left,
 CellTags->{
  "Dim", "b:3.3"},ExpressionUUID->"4fed1d9b-2528-45a8-8806-9044d10e212f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Div", "Subsubsection",
 CellTags->{
  "i:53", "Div", "b:3.3", 
   "c:53"},ExpressionUUID->"ab65f9ab-0e4b-4698-be42-0f4a3f9fb2a8"],

Cell[TextData[{
 "The options ",
 StyleBox["Div", "Program"],
 "\[Rule]",
 StyleBox["operation",
  FontSlant->"Italic"],
 " of function ",
 ButtonBox["VectorLieAlgebra",
  BaseStyle->"AddOnsLink"],
 " gives the name the divergence of (poly)vector fields. The default name is \
also ",
 StyleBox["Div", "Program"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Div", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"8fa51dff-c026-4b90-9472-74c781700f80"],
 " calculates the divergence of the vector  (or polyvector) field ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "93b94827-8131-44ba-b7ce-de5187aa4f72"],
 "."
}], "Text",
 CellMargins->{{10.8125, Inherited}, {Inherited, Inherited}},
 TextAlignment->Left,
 CellTags->{
  "Div", "b:3.3"},ExpressionUUID->"c13c6a30-d587-4023-855d-4c70163b7c05"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DivPowers, DivPowersQ, UnDivPowers", "Subsubsection",
 CellTags->{
  "DivPowers", "DivPowersQ", "UnDivPowers", "b:3.3", 
   "c:54"},ExpressionUUID->"726e90e2-50d2-4542-96ae-70d6a674859f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DivPowers", "Program"], "[", "u", "]"}], TraditionalForm]],
  ExpressionUUID->"33a0a21c-c8c4-4073-b1c1-2050b6a8344a"],
 " redefines ",
 Cell[BoxData[
  StyleBox[
   SuperscriptBox["u", "n"],
   FontSlant->"Italic"]],ExpressionUUID->
  "27f301e7-3830-4b14-876e-68a40140c907"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["u",
     FontSlant->"Italic"], "[", "_", "]"}], 
   StyleBox["n",
    FontSlant->"Italic"]]],ExpressionUUID->
  "ddc1f5c4-54d6-4933-b9ae-00c8801fe74d"],
 " to denote ",
 StyleBox["divided powers",
  FontSlant->"Italic"],
 " of ",
 Cell[BoxData[
  StyleBox["u",
   FontSlant->"Italic"]],ExpressionUUID->
  "cd9368c3-fdcd-4dde-b00b-1516f78986a8"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["u",
    FontSlant->"Italic"], "[", "_", "]"}]],ExpressionUUID->
  "5b8e86ec-c198-4581-8fe4-efad2f5f6d30"],
 " rather than the ordinary power. The divided powers are defined from \
conditions\n",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["u", "0"], "=", "1"}]],ExpressionUUID->
  "298f06da-e707-41dd-8725-5767e90af539"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["u", "1"], "=", "u"}]],ExpressionUUID->
  "74f7299c-52e6-4b48-b4bc-676a6c4f7db7"],
 ", ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["u", "k"], 
    SuperscriptBox["u", "l"]}], "=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{"k", "+", "l"}]},
       {"k"}
      }], ")"}], 
    SuperscriptBox["u", 
     RowBox[{"k", "+", "l"}]]}]}]],ExpressionUUID->
  "e5034248-5675-43de-ae6f-0694e16cdf56"],
 ".            \[LineSeparator]The divided powers are particulary useful when \
working with fields of positive characteristic.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DivPowersQ", "Program"], "[", "u", "]"}], TraditionalForm]],
  ExpressionUUID->"9290e447-8586-482b-9c62-b83620ac4942"],
 " returns true if  ",
 Cell[BoxData[
  StyleBox[
   SuperscriptBox["u", "n"],
   FontSlant->"Italic"]],ExpressionUUID->
  "834ef1dc-77b8-47d1-9fcf-628a36aaa6a4"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["u",
     FontSlant->"Italic"], "[", "_", "]"}], 
   StyleBox["n",
    FontSlant->"Italic"]]],ExpressionUUID->
  "f3678558-2c9d-45b4-a1d1-5676af58b0d4"],
 " are redefined to denote ",
 StyleBox["divided powers.",
  FontSlant->"Italic"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["UnDivPowers", "Program"], "[", "u", "]"}], TraditionalForm]],
  ExpressionUUID->"41709514-3033-40a3-95d9-03924631d5ee"],
 " cancels the redefinition of  ",
 Cell[BoxData[
  StyleBox[
   SuperscriptBox["u", "n"],
   FontSlant->"Italic"]],ExpressionUUID->
  "05223aa4-9b32-4b0c-ba38-80b8188f3a5c"],
 " and ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    StyleBox["u",
     FontSlant->"Italic"], "[", "_", "]"}], 
   StyleBox["n",
    FontSlant->"Italic"]]],ExpressionUUID->
  "55c503d2-8bd4-467d-be96-72c7d31f76be"],
 " and restore the ordinary meaning of the power operation."
}], "Text",
 CellChangeTimes->{{3.421434463354824*^9, 3.4214345621368656`*^9}},
 CellTags->{
  "DivPowers", "DivPowersQ", "UnDivPowers", 
   "b:3.3"},ExpressionUUID->"180d879d-6c85-4099-aad6-da1d128a1989"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DLeft", "Subsubsection",
 CellTags->{
  "i:54", "DLeft", "b:3.3", 
   "c:55"},ExpressionUUID->"74b0bb36-8ae0-4177-a159-4d46192a9bd4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DLeft", "Program"], "[", 
    RowBox[{"\[GothicM]", "\[Rule]", "\[GothicD]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"275f1012-80d2-4002-830d-87a7635e61a6"],
 " builds the module \[GothicD] on the space of left odd linear forms on \
\[GothicM] (differential forms). If \[GothicM] is a Lie algebra, ",
 StyleBox["DLeft", "Program"],
 " also defines the exterior derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["Der", "Program"],
      BaseStyle->"AddOnsLink"], "Program"], " ", ":", " ", 
    RowBox[{
     RowBox[{"\[GothicD]", " ", "\[LongRightArrow]", " ", "\[GothicD]"}], "\[Wedge]",
      "\[GothicD]"}]}], TraditionalForm]],ExpressionUUID->
  "0e66a735-fac4-4291-baec-b20e448b538c"],
 ". The function is implemented only for finite-dimensional modules with \
one-indexed basis.\nOptions:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Algebra", "Program"], "\[Rule]", "\[GothicG]"}], 
   TraditionalForm]],ExpressionUUID->"273ab02d-d6fc-4a34-82a4-26288c800249"],
 " specifies the algeba acting on \[GothicG].\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Clear", "\[Rule]", "False"}], "Program"], TraditionalForm]],
  ExpressionUUID->"cb431cc1-7cbf-4ee4-be91-d880726e43f1"],
 " keeps the existing structores on \[GothicD].\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     ButtonBox[
      StyleBox["DivPowers", "Program"],
      BaseStyle->"AddOnsLink"], "\[Rule]", "True"}], "Program"], 
   TraditionalForm]],ExpressionUUID->"087c6d61-7b10-434c-87c8-f87f7a58d2c7"],
 " specifies that the exterior powers on \[GothicD] should be defined as \
divided powers."
}], "Text",
 CellChangeTimes->{
  3.421434579371648*^9, {3.5828198014215126`*^9, 3.5828198949371376`*^9}, {
   3.5828199995465126`*^9, 3.5828200762652626`*^9}, {3.5828201217183876`*^9, 
   3.5828201825152626`*^9}, {3.5828202302965126`*^9, 
   3.5828202518121376`*^9}, {3.5828203062965126`*^9, 3.5828204785777626`*^9}},
 
 CellTags->{
  "DLeft", "b:3.3"},ExpressionUUID->"86824045-daef-4f15-a9c1-228c157af303"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DLeft", "Program"], "[", "\[GothicM]", "]"}], TraditionalForm]],
  ExpressionUUID->"8e6ce73f-f985-41a2-8e4e-ecf6c3314a5b"],
 " returns the name of the space of left odd linear forms on \[GothicM] (",
 StyleBox["differential forms",
  FontSlant->"Italic"],
 ", for short), or ",
 StyleBox["None", "Name"],
 " if this space was not defined."
}], "Text",
 CellTags->{
  "b:3.3", "DLeft"},ExpressionUUID->"9df4fc5e-2524-4e0d-a71c-f3fce9eb5564"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DLeft", "Program"], "\[Rule]", "\[GothicD]"}], 
   TraditionalForm]],ExpressionUUID->"15cffb85-4f3e-457c-9da7-7245bd226e09"],
 " is the option of the ",
 ButtonBox["VectorSpace",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellChangeTimes->{
  3.421434579371648*^9, {3.5828198014215126`*^9, 3.5828198163433876`*^9}},
 CellTags->{
  "DLeft", "b:3.3"},ExpressionUUID->"deca76be-f481-425f-b237-5bba84fd6736"]
}, Open  ]],

Cell[CellGroupData[{

Cell["dNormal", "Subsubsection",
 CellTags->{
  "i:55", "dNormal", "b:3.3", 
   "c:56"},ExpressionUUID->"6febdc47-4c69-4411-9012-a4985d2917ae"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["dNormal", "Program"], "[", "e", "]"}], TraditionalForm]],
  ExpressionUUID->"6d1db518-2127-435a-a42a-af6ebe7cb8bc"],
 " gives the standard form of the differential expression ",
 StyleBox["e",
  FontSlant->"Italic"],
 ". The multiplication of vectors is interpreted as a composition of \
differential operators. See also ",
 ButtonBox["dSortRule",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["dSymbol",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["DiffAlgebra",
  BaseStyle->"AddOnsLink"],
 ", and ",
 ButtonBox["VNormal",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellChangeTimes->{{3.4214346179871745`*^9, 3.4214346230744896`*^9}},
 CellTags->{
  "dNormal", "b:3.3"},ExpressionUUID->"ade0d436-c91a-4ad7-a0f7-7eca8082923d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DPrint", "Subsubsection",
 CellTags->{
  "i:56", "DPrint", "b:3.3", 
   "c:57"},ExpressionUUID->"dd7e5f52-ee43-4555-b47a-6d55874fb4b9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DPrint", "Program"], "[", 
    RowBox[{
     StyleBox["level",
      FontSlant->"Italic"], ",", " ", 
     RowBox[{
      StyleBox["data",
       FontSlant->"Italic"], "..."}]}], " ", "]"}], TraditionalForm]],
  ExpressionUUID->"2c132e9f-beff-46e9-b157-f9830c8d350d"],
 " prints ",
 StyleBox["data",
  FontSlant->"Italic"],
 " (using ",
 StyleBox["Print", "Program"],
 ") if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["$DPrint", "Program"], "\[GreaterEqual]", 
    StyleBox["level",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "d74c9bc6-c1dc-4184-93d7-14d3f22cabac"],
 ". See also ",
 ButtonBox["$DPrintLabel",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellTags->{
  "DPrint", "b:3.3"},ExpressionUUID->"667ce268-53e9-493e-a418-ca895da2ec2d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DRight", "Subsubsection",
 CellTags->{
  "i:57", "DRight", "b:3.3", 
   "c:58"},ExpressionUUID->"77c854b1-f12e-4578-8d15-e420383900f8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DRight", "Program"], "[", "\[GothicM]", "]"}], 
   TraditionalForm]],ExpressionUUID->"d3a0505a-afa0-4912-8f0f-2dc6554a535f"],
 " returns the name of the space of right odd linear form on \[GothicM], or \
",
 StyleBox["None ", "Name"],
 "if this space was not defined.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DRight", "Program"], "[", 
    RowBox[{"m", "\[Rule]", 
     StyleBox["md",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "f9882239-f864-44fc-9014-2f4abc0f45c4"],
 " builds the module of right odd forms on ",
 Cell[BoxData[
  FormBox[
   StyleBox["m",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "c12c6981-8b54-4765-9fad-90a592fff6d5"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DRight", "Program"], "\[Rule]", "\[GothicD]"}], 
   TraditionalForm]],ExpressionUUID->"1b2c44c6-25d5-41ca-bc29-a69661a3295a"],
 " is an option of the ",
 ButtonBox["VectorSpace",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellTags->{
  "DRight", "b:3.3"},ExpressionUUID->"8693bf5c-ff59-4609-9c76-4bd29f9eb50e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["dSortRule", "Subsubsection",
 CellTags->{
  "i:58", "dSortRule", "b:3.3", 
   "c:59"},ExpressionUUID->"50941c87-5c6f-4fb1-bf90-8a323f21c312"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "//.", 
    StyleBox["dSortRule", "Program"]}], TraditionalForm]],ExpressionUUID->
  "4782f2a2-e455-41e5-955d-60232b5bbc53"],
 " sorts the terms in the differential expression ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "15264e35-ce59-4bb8-b524-ed1716d61238"],
 ":  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"d", "[", "x", "]"}], "x"}], "\[Rule]", 
    RowBox[{
     RowBox[{"x", " ", 
      RowBox[{"d", "[", "x", "]"}]}], "+", "1"}]}], TraditionalForm]],
  ExpressionUUID->"5a6f1178-bf2b-4d92-8761-f8ba0b352231"],
 ", where the symbol ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "1412dfcf-973e-4283-9552-61c863f07803"],
 " is defined by the function ",
 ButtonBox["dSymbol",
  BaseStyle->"AddOnsLink"],
 " or option ",
 StyleBox["D", "Program"],
 " of ",
 ButtonBox["DiffAlgebra",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellTags->{
  "dSortRule", 
   "b:3.3"},ExpressionUUID->"82864ac2-942b-4e4d-8965-c21c48011f55"]
}, Open  ]],

Cell[CellGroupData[{

Cell["dSymbol", "Subsubsection",
 CellTags->{
  "i:59", "dSymbol", "b:3.3", 
   "c:60"},ExpressionUUID->"c42d5f84-f287-4801-8a5a-795dfbe69a38"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["dSymbol", "Program"], "[", "d", "]"}], TraditionalForm]],
  ExpressionUUID->"8282e70d-bd8d-45f4-add2-78bc71c1b44f"],
 " assigns the symbol used as differential  operator: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"d", "[", "x", "]"}], "n"], TraditionalForm]],ExpressionUUID->
  "39e1bfb1-b23b-46ba-85ef-883643dba0e2"],
 " represents the differential operator ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["\[PartialD]", "n"], 
    RowBox[{"\[PartialD]", " ", 
     SuperscriptBox["x", "n"]}]], TraditionalForm]],ExpressionUUID->
  "a48791dc-842c-4cd3-b412-0319e0ac4dea"],
 "."
}], "Text",
 CellTags->{
  "dSymbol", "b:3.3"},ExpressionUUID->"ddf76efc-bb48-46fa-84bd-ae5dc6d2e88f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["E", "Subsection",
 CellTags->{
  "b:3.4", "c:61"},ExpressionUUID->"f91483df-8bd4-47ff-922f-351dba0a7ae9"],

Cell[CellGroupData[{

Cell["EnvelopingOperation", "Subsubsection",
 CellTags->{
  "i:60", "EnvelopingOperation", "b:3.4", 
   "c:62"},ExpressionUUID->"25ee658b-5a51-40d7-8c35-b15e7796b954"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["EnvelopingOperation", "Program"], "[", 
    RowBox[{
     StyleBox["times",
      FontSlant->"Italic"], ",", 
     StyleBox["power",
      FontSlant->"Italic"], ",", 
     StyleBox["brk",
      FontSlant->"Italic"], ",", 
     StyleBox["order",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7c8d6ea9-055f-4dad-bd4c-ffdb515ace54"],
 " defines ",
 StyleBox["times",
  FontSlant->"Italic"],
 " to be an operation in enveloping algebra with Lie bracket ",
 StyleBox["brk",
  FontSlant->"Italic"],
 ". The argument  ",
 StyleBox["power",
  FontSlant->"Italic"],
 " is the power operation corresponding to ",
 StyleBox["times.",
  FontSlant->"Italic"],
 " The parameter ",
 StyleBox["order",
  FontSlant->"Italic"],
 " is a user-supplied function that defines the what will be called in what \
follows the ",
 StyleBox["canonical",
  FontSlant->"Italic"],
 " order: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["order",
     FontSlant->"Italic"], "[", 
    RowBox[{"f", ",", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "5a1acafa-730f-42df-9437-4d651fd05f86"],
 " returns ",
 StyleBox["True", "Program"],
 " if f and g are in the canonical order. (In other words, the user defines \
any order in the enveloping algebra and it will be called ",
 StyleBox["canonical",
  FontSlant->"Italic"],
 " as a reference point.) The parameters ",
 StyleBox["power",
  FontSlant->"Italic"],
 ", ",
 StyleBox["brk",
  FontSlant->"Italic"],
 " and ",
 StyleBox["order",
  FontSlant->"Italic"],
 " are optional; the default values are ",
 StyleBox["None", "Program"],
 ", ",
 StyleBox["Act", "Program"],
 " and the value of ",
 StyleBox["$EnvLess, ", "Program"],
 "respectively."
}], "Text",
 CellChangeTimes->{
  3.4214346870364623`*^9, {3.4214347261627235`*^9, 3.421434732541896*^9}},
 CellTags->{
  "EnvelopingOperation", 
   "b:3.4"},ExpressionUUID->"6fa6452d-a000-4d0b-bedb-3288ac4679e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["EnvelopingSymbol", "Subsubsection",
 CellTags->{
  "i:61", "EnvelopingSymbol", "b:3.4", 
   "c:63"},ExpressionUUID->"beb35e7c-60b2-40dd-99fe-27d8f36ffa04"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["EnvelopingSymbol", "Program"], "[", 
    RowBox[{
     StyleBox["symb",
      FontSlant->"Italic"], ",", 
     StyleBox["mult",
      FontSlant->"Italic"], ",", 
     StyleBox["brk",
      FontSlant->"Italic"], ",", 
     StyleBox["order",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "bb9f3b6f-52c8-4839-8a98-5196ff4f04bd"],
 " introduces notations: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["symb",
     FontSlant->"Italic"], "[", "...", "]"}], TraditionalForm]],
  ExpressionUUID->"69e424e9-8680-4e62-8b3d-e806707d69e0"],
 " for the elements of basis of an enveloping algebra, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["mult",
     FontSlant->"Italic"], "[", "...", "]"}], TraditionalForm]],
  ExpressionUUID->"af7f5002-c3c3-4259-902a-c90d71063686"],
 " for the multiplication in enveloping algebras with bracket ",
 Cell[BoxData[
  FormBox[
   StyleBox["brk",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "70474f71-d091-4d08-a1dc-d95dfaaf1bdb"],
 ". The user-supplied function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["order",
     FontSlant->"Italic"], "[", 
    RowBox[{"f", ",", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "e6be7fa5-0214-48d8-8d0e-145656d6a26b"],
 " should return ",
 StyleBox["True", "Program"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["symb",
     FontSlant->"Italic"], "[", 
    RowBox[{"f", ",", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "9f895cfc-778a-4ef5-b0ee-b666f6dff95d"],
 " is in the canonical order in the enveloping algebra."
}], "Text",
 CellTags->{
  "EnvelopingSymbol", 
   "b:3.4"},ExpressionUUID->"36d55c86-46ce-4da2-812a-4c158dc574fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["EnvNormal", "Subsubsection",
 CellTags->{
  "i:62", "EnvNormal", "b:3.4", 
   "c:64"},ExpressionUUID->"a26de47a-40fe-4c49-924d-9c729adf71ab"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["EnvNormal", "Program"], "[", "e", "]"}], TraditionalForm]],
  ExpressionUUID->"e2c9a493-03dd-4701-b92a-13a7ffa3e419"],
 " gives the standard form of an element ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "c968fd59-2d15-4f94-b123-78a9648e0e7a"],
 " of the enveloping algebra with multiplication ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 " and bracket ",
 ButtonBox["Act",
  BaseStyle->"AddOnsLink"],
 ". The factors in the vector products are sorted (see ",
 ButtonBox["Sort",
  BaseStyle->"Link",
  ButtonData:>"paclet:ref/Sort"],
 ") using ordering function ",
 ButtonBox["$EnvLess",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["EnvNormal", "Program"], "[", 
    RowBox[{"e", ",", "p"}], "]"}], TraditionalForm]],ExpressionUUID->
  "b3e1bfdb-4284-4c42-93ef-c36bd6676f82"],
 " uses ",
 StyleBox["p", "Var"],
 " as an ordering function. The ordering function ",
 StyleBox["p",
  FontSlant->"Italic"],
 " is defined so that the value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "a30aaa29-a167-4eae-9c5c-a0e1f83ce561"],
 " is ",
 StyleBox["True", "Program"],
 " if the factors ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "9254efca-b7dc-4ffc-8f4e-48520d2cc06d"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "9dd9e269-dfca-41ff-bbae-0eb8b54a9818"],
 " should appear in the products in that order.\nSee also ",
 ButtonBox["VNormal",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellChangeTimes->{{3.421434807119133*^9, 3.421434807379507*^9}, {
  3.623314343409273*^9, 3.623314354982297*^9}},
 CellTags->{
  "EnvNormal", 
   "b:3.4"},ExpressionUUID->"e1929d71-1077-495f-970a-7a345ed2eea7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["EnvSortRule", "Subsubsection",
 CellTags->{
  "i:63", "EnvSortRule", "b:3.4", 
   "c:65"},ExpressionUUID->"51160759-7f01-4196-928e-281c89d598c8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"e", "//.", 
    StyleBox["EnvSortRule", "Program"]}], TraditionalForm]],ExpressionUUID->
  "1bd1b871-20c1-4307-9002-22531365f3a7"],
 " sorts the terms of the multiplication in the enveloping algebra (with \
multiplication ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 ", bracket ",
 ButtonBox["Act",
  BaseStyle->"AddOnsLink"],
 " and order function ",
 ButtonBox["$EnvLess",
  BaseStyle->"AddOnsLink"],
 ") into the canonical order."
}], "Text",
 CellTags->{
  "EnvSortRule", 
   "b:3.4"},ExpressionUUID->"7aaea2ae-4890-4c53-8bcd-9bb9ecaf2e78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["EulerOp", "Subsubsection",
 CellTags->{
  "i:64", "EulerOp", "b:3.4", 
   "c:66"},ExpressionUUID->"b0fcc216-9f6c-49fc-80f3-18c28a0c6520"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["EulerOp", "Program"], "[", "\[GothicG]", "]"}], 
   TraditionalForm]],ExpressionUUID->"62c12e4d-4d45-4cec-97b5-e026cbec5287"],
 " is the Euler operator in the algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "c0ecf4fb-93b8-425b-a2b5-383cff1f8666"],
 ". This operator is only defined by constructors PoissonAlgebra, \
ContactAlgebra, ButtinAlgebrs, OKAlgebrs."
}], "Text",
 CellChangeTimes->{{3.423236688221376*^9, 3.4232367559788065`*^9}, {
  3.4232368143627586`*^9, 3.423236868750965*^9}},
 CellTags->{
  "EulerOp", "b:3.4"},ExpressionUUID->"c9730f16-70f4-4a39-ac2d-03028ae31bd4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ExpandOp", "Subsubsection",
 CellTags->{
  "i:65", "ExpandOp", "b:3.4", 
   "c:67"},ExpressionUUID->"e6e0c891-cd68-42be-bc71-887f422d7c90"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ExpandOp", "Program"], "[", 
    RowBox[{"e", ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
