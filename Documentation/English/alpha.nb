Cell[CellGroupData[{

Cell["NewPower", "Subsubsection",
 CellTags->{
  "i:130", "NewPower", "b:3.13", 
   "c:146"},ExpressionUUID->"a4b557cd-4043-43db-b08a-4a4dfaed02b8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["NewPower", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], ",", "\"\<\>", 
    StyleBox["s",
     FontSlant->"Italic"], "\"\<\>", "]"}], TraditionalForm]],ExpressionUUID->
  "b7dc7613-4c53-4344-9781-f5cd61c8295a"],
 " introduces superscript notation for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["op",
      FontSlant->"Italic"], "[", 
     RowBox[{"x", ",", "r"}], "]"}], "\[LongLeftRightArrow]", 
    SuperscriptBox["x", 
     RowBox[{"s", " ", "r"}]]}], TraditionalForm]],ExpressionUUID->
  "4a752ca8-c94f-4795-916c-d28e909d548d"],
 "in the standard and traditional formats and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "^", "s"}], " ", "r"}], TraditionalForm]],ExpressionUUID->
  "ba202ebb-3875-4788-915c-fd669e1f26a8"],
 " for the output format and for the input in any format. The ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "e4d0b6e3-5a92-4bea-85c4-2390a4b7f64d"],
 " should be a single character (not a letter or digit).\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["NewPower", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], ",", "\"\<\>", 
    StyleBox["s",
     FontSlant->"Italic"], "\"\<\>", ",", 
    StyleBox["sTeX",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "9b19f343-bf9d-4f11-87e5-afc1401f7610"],
 "  introduces also TeX notation for ",
 Cell[BoxData[
  FormBox[
   StyleBox["s",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "ba807f03-a16c-491d-be70-0bf55b2a2f02"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "NewPower", 
   "b:3.13"},ExpressionUUID->"8a78ae40-3d2d-4a04-8112-6701a8ca31d3"]
}, Open  ]],

Cell[CellGroupData[{

