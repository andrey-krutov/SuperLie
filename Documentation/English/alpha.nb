Cell[CellGroupData[{

Cell["SVSolve", "Subsubsection",
 CellTags->{
  "i:201", "SVSolve", "b:3.18", 
   "c:226"},ExpressionUUID->"ba54d1e7-85b2-4a87-8d3a-d123e1029183"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SVSolve", "Program"], "[", 
    RowBox[{
     StyleBox["eqns",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["vars",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["...",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7eece993-49f1-4ec2-920f-13778986ef8f"],
 " attempts to solve a vector equation or set of equations ",
 StyleBox["eqns",
  FontSlant->"Italic"],
 " for the scalar variables ",
 StyleBox["vars",
  FontSlant->"Italic"],
 ". For other parameters and options, see ",
 ButtonBox["Solve",
  BaseStyle->"RefGuideLink"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SVSolve", "Program"], "[", 
    StyleBox["eqns",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "d9979cbc-9467-4d98-9206-a6a5243443c9"],
 " treats all non-vector variables  encountered as ",
 StyleBox["vars",
  FontSlant->"Italic"],
 " above. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "SVSolve", "b:3.18"},ExpressionUUID->"9f4bce1b-0699-4903-bd22-9f5dbafab518"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Symmetric", "Subsubsection",
 CellTags->{
  "i:202", "Symmetric", "b:3.18", 
   "c:227"},ExpressionUUID->"dc7f31a2-bd6d-404d-9a55-d1bfb34bf60b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Symmetric", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"305ccf91-2769-4e9b-8deb-270a391f08c2"],
 " introduces an automatic sorting of arguments of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "9cf29225-b262-4765-864b-d741706de43d"],
 " using supersymmetry \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"..", ",", "y", ",", "x", ",", ".."}], "]"}], " ", "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"P", "[", "x", "]"}], 
       RowBox[{"P", "[", "y", "]"}]}]], " ", 
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "x", ",", "y", ",", ".."}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"d16f65e5-2080-426b-8fd1-a09e2c8b71c0"],
 "."
}], "Text",
 CellTags->{
  "Symmetric", 
   "b:3.18"},ExpressionUUID->"ad372e25-8ed0-4e8e-bcdf-424799583140"]
}, Open  ]],

