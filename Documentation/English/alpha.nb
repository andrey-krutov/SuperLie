Cell[CellGroupData[{

Cell["GeneralAct", "Subsubsection",
 CellTags->{
  "i:73", "GeneralAct", "b:3.6", 
   "c:78"},ExpressionUUID->"562837b7-474e-4d7e-9ebf-a5cc2b53778b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralAct", "Program"], "[", 
    RowBox[{"g", ",", 
     StyleBox["v",
      FontSlant->"Italic"], ",", "c", ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "a43bf3b9-689d-4a84-b88a-9db4e36cc302"],
 " calculates the image ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ad", "g"], "V"}], TraditionalForm]],ExpressionUUID->
  "8109a977-665f-4052-afb9-d8e51761fcfc"],
 " of a sub(super)space ",
 StyleBox["V",
  FontSlant->"Italic"],
 " in a \[GothicG]-module under the action of the element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "\[Element]", "\[GothicG]"}], TraditionalForm]],
  ExpressionUUID->"aa6636ae-fcab-4a3d-913e-13bab26eae58"],
 ". The space ",
 StyleBox["V",
  FontSlant->"Italic"],
 " is given either as a general sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["c", "1"], 
        SubscriptBox["v", "1"]}], "+"}], "..."}], "+", 
     RowBox[{
      SubscriptBox["c", "n"], 
      SubscriptBox["v", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "62c6c9e8-6003-47a8-ba7d-6e3caa5927af"],
 " with arbitrary vector expressions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", "...", ",", 
    SubscriptBox["v", "n"]}], TraditionalForm]],ExpressionUUID->
  "8b99afcb-f702-4047-afa1-6bfb9eabbf24"],
 " or as a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["v", "1"], ",", "...", ",", 
      SubscriptBox["v", "n"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "6b0d7a52-5df8-4baa-8fbe-81e4e9af6203"],
 ". The result is representad as general sum  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["e", "1"]}], "+"}], "..."}], "+", 
    RowBox[{
     SubscriptBox["c", "k"], 
     SubscriptBox["e", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "6059c141-e772-4ff8-b0a7-1d6b76b13581"],
 ".\nThe optional argument ",
 StyleBox["op",
  FontSlant->"Italic"],
 " gives the name of the action of \[GothicG] on the module. The default name \
is ",
 ButtonBox["Act",
  BaseStyle->"AddOnsLink"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralAct", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "..."}], "}"}], ",", 
     StyleBox["v",
      FontSlant->"Italic"], ",", "c", ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "2aa3f467-0894-445b-ad45-5e06a2f58a44"],
 " returns the sum of the images ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ad", 
     SubscriptBox["g", "i"]], "V"}], TraditionalForm]],ExpressionUUID->
  "4b8e6909-9838-45df-954c-008bd0a63436"],
 "."
}], "Text",
 CellChangeTimes->{{3.421503346523723*^9, 3.4215034005113535`*^9}},
