Cell[CellGroupData[{

Cell["sqAlgebra", "Subsubsection",
 CellTags->{
  "i:190", "sqAlgebra", "b:3.18", 
   "c:213"},ExpressionUUID->"4c313b16-d44b-4ade-86fb-65e5f1c57e9b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["sqAlgebra", "Program"], "[", 
    RowBox[{"g", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", "n"}], "]"}], TraditionalForm]],
  ExpressionUUID->"80c59cdb-4fe1-4982-9a67-87d7d5e527aa"],
 " defines the Lie superalgebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "=", 
    RowBox[{"\[GothicS]\[GothicQ]", "(", "n", ")"}]}], TraditionalForm]],
  ExpressionUUID->"d0563ad3-b4af-4e41-af70-cd7ae62cae17"],
 "  with basis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "dc65e7e2-b8a6-496f-9fd1-a919b75e6062"],
 " (the even elements), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "6df0ed99-a136-45ed-b5ad-cd5c08279c39"],
 " (the odd diagonal elements), and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "bfe816e6-87ef-4a8d-8ddc-f812ed4fec77"],
 " (the odd off-diagonal elements, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]],ExpressionUUID->
  "9fa74d89-6f8b-405d-bea8-50b8aad50f16"],
 ")."
}], "Text",
 CellTags->{
  "sqAlgebra", 
   "b:3.18"},ExpressionUUID->"bb0f66a1-2f66-4185-93ba-9333a5ae2d8e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Squaring ", "Subsubsection",
 CellTags->{
  "Squaring", "b:3.18", 
   "c:214"},ExpressionUUID->"41562062-8981-439b-8fb7-c2f67e99ea66"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Squaring", "Program"], "[", 
    StyleBox[
     RowBox[{"g", ",", "bracket"}],
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "b603c80c-50ad-4a85-8bbc-bcfc79b78c2f"],
 " in case of the field of characteristic p\[NotEqual]2 is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     StyleBox["bracket", "Text",
      FontSlant->"Italic"], 
     StyleBox["[", "Program"], 
     StyleBox[
      RowBox[{"g", ",", "g"}], "Text"], 
     StyleBox["]", "Program"]}]}], TraditionalForm]],ExpressionUUID->
  "69a84987-e671-4d0b-a855-77c13f149f13"],
 ". In case of characteristic p=2, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["bracket", "Text",
     FontSlant->"Italic"], 
    StyleBox["[", "Program"], 
    StyleBox[
     RowBox[{"g", ",", "g"}], "Text"], 
    StyleBox["]", "Program"]}], TraditionalForm]],ExpressionUUID->
  "5f4f99ff-0c34-45b0-8776-1ba28405be53"],
 "is always zero and the squaring is defined separately.\nThe option ",
 StyleBox["Squaring\[Rule]True", "Program"],
 " for algebra constructors ",
 ButtonBox["SubAlgebra",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["FreeLieAlgebra",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["CartanMatrixAlgebra",
  BaseStyle->"AddOnsLink"],
 ", instructs these function to use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Squaring", "Program"], 
    StyleBox["[", "Program"], 
    RowBox[{
     StyleBox["g", "Text"], 
     StyleBox[",", "Text"], 
     StyleBox["act", "Program"]}], 
    StyleBox["]", "Program"]}], TraditionalForm]],ExpressionUUID->
  "30c66677-984d-4de6-9cc1-caf4a7b326bf"],
 " instead of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["act", "Program"], 
    StyleBox["[", "Program"], 
    StyleBox[
     RowBox[{"g", ",", "g"}], "Text"], 
    StyleBox["]", "Program"]}], TraditionalForm]],ExpressionUUID->
  "d7238014-a92e-40d5-8d43-a16b61e9434f"],
 " in the basis of the algebras generated. This may eliminate the division by \
2 in the structure constants of the algebras generated."
}], "Text",
 CellChangeTimes->{{3.4215067376098657`*^9, 3.421506769806162*^9}, {
  3.423238660307096*^9, 3.4232386652542095`*^9}},
 CellTags->{
  "Squaring", 
   "b:3.18"},ExpressionUUID->"78abb00b-9da4-4ac7-b280-34ab80982510"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Standard", "Subsubsection",
 CellTags->{
  "i:191", "Standard", "b:3.18", 
   "c:215"},ExpressionUUID->"48f214f3-2dc3-4c3a-99bf-3ad327473d83"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Standard", "Program"], "[", 
    RowBox[{
     StyleBox["v",
      FontSlant->"Italic"], "\[Rule]", "f"}], "]"}], TraditionalForm]],
  ExpressionUUID->"a98557d7-08a8-4d6d-869e-1acf0c68adea"],
 " defines the output format of the expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "[", "...", "]"}], TraditionalForm]],ExpressionUUID->
  "75a2e8e5-7351-499e-bdbc-71fd5f456a33"],
 " in Standard form as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     StyleBox["v", "Var"], "[", "...", "]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"143f59b9-e224-40f1-9473-95bdf35c84c5"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Standard", "Program"], "\[Rule]", "f"}], TraditionalForm]],
  ExpressionUUID->"2fc48d30-fbcb-4f9f-bbc5-52e0ce8de557"],
 " is an optional parameter to space constructors that defines the Standard \
output format of the space elements. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Standard", "Program"], "[", 
    RowBox[{
     StyleBox["v",
      FontSlant->"Italic"], "\[Rule]", 
     StyleBox["Subscripted", "Name"]}], "]"}], TraditionalForm]],
  ExpressionUUID->"fb3089aa-913b-4466-905b-16039816153b"],
 " defines also the interpretation of the subscripted ",
 StyleBox["v",
  FontSlant->"Italic"],
 " in ",
 StyleBox["Standard", "Program"],
 " input format:  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", 
     RowBox[{"i", ",", "..."}]], "\[Rule]", 
    RowBox[{"v", "[", 
     RowBox[{"i", ",", "..."}], "]"}]}], TraditionalForm]],ExpressionUUID->
  "08152eac-6745-4606-890a-6f0fb24051f8"],
 ". In other cases the output in the standard form produced by the function \
",
 StyleBox["Standard", "Program"],
 " may not be reused for the input. Use ",
 ButtonBox["MakeBoxes",
  BaseStyle->"RefGuideLink"],
 " and ",
 ButtonBox["InterpretationBox",
  BaseStyle->"RefGuideLink"],
 " to define reusable output forms."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Standard", 
   "b:3.18"},ExpressionUUID->"0aefdb55-a5e3-40a1-a5ad-4cfb2c5c31f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["STimesOp ", "Subsubsection",
 CellTags->{
  "b:3.18", "c:216"},ExpressionUUID->"f0427365-5873-4524-99cd-628264f3d62f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["STimesOp", "Program"], "[", 
    StyleBox["domain",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "c1640e3d-fdca-4815-844b-6b37381966d0"],
 " is the name of ",
 Cell[BoxData[
  FormBox["*", TraditionalForm]],ExpressionUUID->
  "5a322825-bc34-4d88-961d-54b8cba0ac84"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Scalar",
     FontSlant->"Italic"], "*", 
    StyleBox["domain",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "7e56e3b6-1029-403c-8e45-f629276c3d71"],
 "."
}], "Text",
 CellTags->"b:3.18",ExpressionUUID->"0559473f-c728-4439-8d72-1c4736545591"]
}, Open  ]],

Cell[CellGroupData[{

Cell["StopUseAsSymbol", "Subsubsection",
 CellTags->{
  "i:192", "StopUseAsSymbol", "b:3.18", 
   "c:217"},ExpressionUUID->"62da0275-4548-4f6a-872a-12a63e6fe795"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["StopUseAsSymbol", "Program"], "[", 
    StyleBox["expr",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "14e08a77-1a59-46a3-9ee5-e779d0ae05f2"],
 " cancels usage of the expression ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " (e.g., ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["v", "~"], TraditionalForm]],ExpressionUUID->
  "899b156e-dd92-4fe4-ac7e-e1bf70f02ad8"],
 ") as a single symbol."
}], "Text",
 CellTags->{
  "StopUseAsSymbol", 
   "b:3.18"},ExpressionUUID->"6cb46c35-8883-4373-9d1b-a2f9cc9ffd38"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SubAlgebra", "Subsubsection",
 CellTags->{
  "i:193", "SubAlgebra", "b:3.18", 
   "c:218"},ExpressionUUID->"40d78a0e-4a20-419a-b905-903f64335c70"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubAlgebra", "Program"], "[", 
    RowBox[{"\[GothicH]", ",", "\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"1e54b1c8-3f5d-4137-9bbb-47a698363676"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubAlgebra", "Program"], "[", 
    RowBox[{"\[GothicH]", ",", "\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["h", "1"], "\[Rule]", 
        SubscriptBox["g", "1"]}], ",", "...", ",", 
       RowBox[{
        SubscriptBox["h", "k"], "\[Rule]", 
        SubscriptBox["g", "k"]}]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"ef5ef423-57da-4b0b-b2f2-9447e8d4413d"],
 " builds the subalgebra ",
 Cell[BoxData[
  FormBox["\[GothicH]", TraditionalForm]],ExpressionUUID->
  "58dec919-4fba-412f-b679-c3b8eae49cd8"],
 " of the Lie (super)algebra ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "17c55992-a133-4591-a276-bc64d7b1f777"],
 " generated (as subalgebra) by the elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", 
    RowBox[{
     RowBox[{"...", 
      SubscriptBox["g", "k"]}], "\[Element]", "\[GothicG]"}]}], 
   TraditionalForm]],ExpressionUUID->"4f6bd3c4-f4da-4734-a99d-a8d1751e9bd1"],
 ". The second form gives also names for the generators of ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "b95c77fa-ea43-417e-866a-2d8d19fd2605"],
 ". \nSpecific options: \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToDegree", "Program"], "\[Rule]", "r"}], TraditionalForm]],
  ExpressionUUID->"69cb3a88-6b74-4167-ab54-515b10965a0b"],
 "  restricts the computations to degree ",
 StyleBox["r",
  FontSlant->"Italic"],
 " assuming all generators are of degree 1 (default is ",
 StyleBox["Infinity", "Program"],
 "); \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Grade", "Program"], "\[Rule]", 
    StyleBox["fn",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "8e886f49-56ce-427c-b77b-7e09e7860900"],
 "  defines a grading on \[GothicH]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Grade", "Program"], "[", "h", "]"}], "=", 
    RowBox[{
     StyleBox["fn",
      FontSlant->"Italic"], "[", 
     RowBox[{"image", "[", "h", "]"}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"742d8102-15ae-4c47-a8d9-92614868ae48"],
 " (default is ",
 ButtonBox["Grade",
  BaseStyle->"AddOnsLink"],
 "). \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToGrade", "Program"], "\[Rule]", "r"}], TraditionalForm]],
  ExpressionUUID->"19393496-99a0-49ae-a2e9-4ad47fc16044"],
 "   computes up to grade ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "5858e089-f3c6-4b73-926b-9006a9a88ce8"],
 " (",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "09c7015d-6171-481e-af69-47000ad1aaaf"],
 " should be a number; the ",
 StyleBox["Grade", "Program"],
 " function must be defined in \[GothicG]). \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Weight", "Program"], "\[Rule]", 
    StyleBox["fn",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "ee35beb1-bc82-4b04-aeb4-84514cc497ec"],
 "   defines a weight on ",
 Cell[BoxData[
  FormBox["\[GothicH]", TraditionalForm]],ExpressionUUID->
  "ba36a601-0c4f-473b-bca4-856859322647"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Weight", "Program"], "[", "h", "]"}], "=", 
    RowBox[{
     StyleBox["fn",
      FontSlant->"Italic"], "[", 
     RowBox[{
      ButtonBox["Image",
       BaseStyle->"AddOnsLink"], "[", "\[GothicH]", "]"}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"adfccf5d-c978-4b8e-8379-8f243f2f6646"],
 " (default is ",
 ButtonBox["Weight",
  BaseStyle->"AddOnsLink"],
 "). \n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"Squaring", "\[Rule]", "True"}], "Program"], TraditionalForm]],
  ExpressionUUID->"fe077d0f-2966-4561-886f-cef48fd02465"],
 " instructs to include ",
 ButtonBox["Squaring",
  BaseStyle->"AddOnsLink"],
 StyleBox["[", "Program"],
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["act]", "Program"],
 " instead of ",
 StyleBox["act[", "Program"],
 StyleBox["f",
  FontSlant->"Italic"],
 ", ",
 StyleBox["f",
  FontSlant->"Italic"],
 StyleBox["]", "Program"],
 " in the basis of the subalgebra generated. This option is included by \
default if the algebras are over a field of charcteristic 2.\nThe function ",
 StyleBox["SubAlgebra", "Name"],
 " calculates the basis of ",
 Cell[BoxData[
  FormBox[
   FormBox["\[GothicH]",
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "d1e87fb9-ba8e-4c53-9a48-2121a383b775"],
 " in terms of generators and relations between the generators. They are \
stored as respective properties ",
 ButtonBox["GenBasis",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["GenRel",
  BaseStyle->"AddOnsLink"],
 " of algebra ",
 Cell[BoxData[
  FormBox["\[GothicH]", TraditionalForm]],ExpressionUUID->
  "b77f987b-475f-47f8-97ab-8ba462a9c001"],
 ". "
}], "Text",
 CellChangeTimes->{{3.4215067975360355`*^9, 3.4215068101742077`*^9}, 
   3.4215068650130625`*^9, {3.423238714675274*^9, 3.423238717349118*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "SubAlgebra", 
   "b:3.18"},ExpressionUUID->"099c996f-b7cf-4455-b565-f7864b2352cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SubModule", "Subsubsection",
 CellTags->{
  "i:194", "SubModule", "b:3.18", 
   "c:219"},ExpressionUUID->"a8b44cd5-3d12-4617-a876-da0814383eb7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubModule", "Program"], "[", 
    RowBox[{"\[GothicN]", ",", "\[GothicM]", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "...", ",", 
       SubscriptBox["v", "k"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"41a8f441-09dd-4681-8e9c-fec34a6262dc"],
 " builds the submodule \[GothicN] of the module \[GothicM] generated (as \
submodule) by the elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["v", "1"], ",", "...", ",", 
     RowBox[{
      SubscriptBox["v", "k"], "\[Element]", "\[GothicM]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"349f2266-1a99-49e8-bdee-bc73b892826d"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubModule", "Program"], "[", 
    RowBox[{"\[GothicN]", ",", "\[GothicM]", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "...", ",", 
       SubscriptBox["v", "k"]}], "}"}], ",", " ", 
     RowBox[{
      StyleBox["Split", "Program"], "\[Rule]", 
      StyleBox["wt",
       FontSlant->"Italic"]}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "87c9e62b-5bfc-47c4-9330-89b7efb6e6a5"],
 " builds a graded submodule ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicN]", "\[Subset]", "\[GothicM]"}], TraditionalForm]],
  ExpressionUUID->"adb18026-a9e4-4e74-94cf-cc4a163316a4"],
 " generated by the elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["v", "1"], ",", "...", ",", 
     RowBox[{
      SubscriptBox["v", "k"], "\[Element]", "\[GothicM]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"5380a3bc-6658-4a32-9c48-a2a9b59bcbb5"],
 ". The argument ",
 StyleBox["wt",
  FontSlant->"Italic"],
 " is the grading function. Graded submodules are calculated faster than \
non-graded ones. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubModule", "Program"], "[", 
    RowBox[{"\[GothicN]", ",", "\[GothicM]", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "...", ",", 
       SubscriptBox["v", "k"]}], "}"}], ",", 
     RowBox[{
      StyleBox["Algebra", "Program"], "\[Rule]", "\[GothicG]"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"a40782e5-a58a-4b56-ac1c-c3c62cadcfd1"],
 " should be used if more than one algebra acts on the module ",
 Cell[BoxData[
  FormBox["\[GothicM]", TraditionalForm]],ExpressionUUID->
  "fbd1b75f-16a0-4488-96d7-4f9d8a46b604"],
 ". \nThe function ",
 StyleBox["SubModule", "Program"],
 " is implemented only for finite dimensional algebras having simple \
representation of basis as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", "...", ",", 
    SubscriptBox["g", "n"]}], TraditionalForm]],ExpressionUUID->
  "224bf61a-bc97-44b1-9bfd-e39a1e1e78f7"],
 " where ",
 StyleBox["g",
  FontSlant->"Italic"],
 " is the algebra name. To work with algebras that have different \
representations (e.g., matrix algebras or algebras of vector fields), use ",
 ButtonBox["SubAlgebra",
  BaseStyle->"AddOnsLink"],
 " to build a subalgebra ",
 StyleBox["s",
  FontSlant->"Italic"],
 " with basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["s", "l"]}]}], TraditionalForm]],ExpressionUUID->
  "3b858cd8-77ee-49f3-9db3-06741eaf3aa5"],
 " (the subalgebra can coincide with the original algebra) and then use ",
 StyleBox["SubModule", "Program"],
 " with option ",
 StyleBox["Algebra\[Rule]", "Program"],
 StyleBox["s", "Program",
  FontSlant->"Italic"],
 ". ",
 StyleBox["\n", "Program"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubModule", "Program"], "[", 
    RowBox[{"\[GothicN]", ",", "\[GothicM]", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "...", ",", 
       SubscriptBox["v", "k"]}], "}"}], ",", " ", 
     RowBox[{
      StyleBox["Act", "Program"], "\[Rule]", 
      RowBox[{
       StyleBox["{",
        FontSlant->"Italic"], 
       RowBox[{
        SubscriptBox[
         StyleBox["g",
          FontSlant->"Italic"], "1"], ",", "...", ",", 
        SubscriptBox["g", "l"]}], "}"}]}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"baa1c447-61d3-4f6e-9b4c-83465911558f"],
 " builds the subspace ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicN]", "\[Subset]", "\[GothicM]"}], TraditionalForm]],
  ExpressionUUID->"93bcf26e-a070-48b1-ba85-c66cec60c914"],
 " containing ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["v", "1"], ",", "...", ",", 
     SubscriptBox["v", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "48c732c8-7242-46ca-b86a-48e09d35ca54"],
 " and closed with respect to the action of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", "...", ",", 
    SubscriptBox["g", "l"]}], TraditionalForm]],ExpressionUUID->
  "0edd49bc-a361-481e-a449-cfc6dc7ab1ca"],
 ". This version of ",
 StyleBox["SubModule", "Program"],
 " is much faster and does not require the algebra to be finite dimensional \
and to have simple representation of the basis. But it builds the subspace \
only and does not calculate the action of the algebra on this subspace. "
}], "Text",
 CellChangeTimes->{{3.4215069881901827`*^9, 3.421507040535451*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "SubModule", 
   "b:3.18"},ExpressionUUID->"2ee23d38-1c4c-404b-bc8f-00ac0e737d7d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SubSpace", "Subsubsection",
 CellTags->{
  "i:195", "SubSpace", "b:3.18", 
   "c:220"},ExpressionUUID->"65b804e1-a8b4-4d3a-810d-a86d4d726e39"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SubSpace", "Program"], "[", 
    RowBox[{"U", ",", " ", "V", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "..."}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"fee03e7e-5e50-423a-9860-459d789f7b4d"],
 " defines a subspace ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "\[Element]", "V"}], TraditionalForm]],ExpressionUUID->
  "ca98b5d8-9723-4ed6-8640-d1d6c4162342"],
 " with a given basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["v", "1"], ",", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"9bb63d8c-b760-4893-bbf3-72f5213e607b"],
 ". "
}], "Text",
 CellTags->{
  "SubSpace", 
   "b:3.18"},ExpressionUUID->"05ed94c9-d55f-44cc-bc26-77da24a6ec50"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SumOp", "Subsubsection",
 CellTags->{
  "i:196", "SumOp", "b:3.18", 
   "c:221"},ExpressionUUID->"ce7a2db4-d3d6-46e2-ab45-78c30d2e71ff"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SumOp", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "a4310ad7-2517-4337-bb0a-82deafb466c7"],
 " returns the name of the \"Sum\" function, associated with the \"plus\" \
operation ",
 StyleBox["op",
  FontSlant->"Italic"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SumOp", "Program"], "[", 
    RowBox[{
     StyleBox["op",
      FontSlant->"Italic"], "\[Rule]", 
     StyleBox["name",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1e907c9e-8cef-4415-a62d-8f458be9b62e"],
 " defines this operation. "
}], "Text",
 CellChangeTimes->{{3.4215070840880766`*^9, 3.4215070850494595`*^9}},
 CellTags->{
  "SumOp", "b:3.18"},ExpressionUUID->"2bf08a87-c02c-40de-9640-f9dfa4875882"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SVExpandRule", "Subsubsection",
 CellTags->{
  "i:197", "SVExpandRule", "b:3.18", 
   "c:222"},ExpressionUUID->"f5bc6a27-48ae-4bcc-ab7e-4231bf433855"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["expr",
     FontSlant->"Italic"], "/.", 
    StyleBox["SVExpandRule", "Program"]}], TraditionalForm]],ExpressionUUID->
  "0889428a-1760-4954-816e-641634322bed"],
 " expands out all scalar coefficients in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "*", "v"}], TraditionalForm]],ExpressionUUID->
  "a655c6ee-4e02-447f-a0ac-961660493040"],
 ". "
}], "Text",
 CellTags->{
  "SVExpandRule", 
   "b:3.18"},ExpressionUUID->"33224a23-bfd1-4458-9b73-2794946052b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SVFactorRule", "Subsubsection",
 CellTags->{
  "i:198", "SVFactorRule", "b:3.18", 
   "c:223"},ExpressionUUID->"70731f9e-4f48-46d1-bf78-e680a90bccc0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["expr",
     FontSlant->"Italic"], " ", "/.", " ", 
    StyleBox["SVFactorRule", "Program"]}], TraditionalForm]],ExpressionUUID->
  "e8546707-1316-47fd-8a62-6c87ccddf20b"],
 " factorizes all scalar coefficients in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "*", "v"}], TraditionalForm]],ExpressionUUID->
