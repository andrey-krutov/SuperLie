}, Open  ]],

Cell[CellGroupData[{

Cell["CTimes", "Subsubsection",
 CellTags->{
  "i:38", "CTimes", "b:3.2", 
   "c:40"},ExpressionUUID->"f369a04b-8222-465c-acb5-093d97616d8f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CTimes", "Program"], "[", 
