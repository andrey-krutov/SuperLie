    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["e", "1"]}], "+"}], "..."}], "+", 
    RowBox[{
     SubscriptBox["c", "k"], 
     SubscriptBox["e", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "b432d488-4a2a-45cb-ac38-73168af475f0"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "i"], TraditionalForm]],ExpressionUUID->
  "7c4d1bde-1790-4455-a38d-8e8acc641282"],
 " are linear combinations of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "69e068d2-7179-4b2e-bd10-c9757624e238"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralKernel", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["f", "1"], ",", "..."}], "}"}], ",", 
     StyleBox["v",
      FontSlant->"Italic"], ",", "c"}], "]"}], TraditionalForm]],
  ExpressionUUID->"0131046a-2e37-40c3-993d-3c999df36408"],
 " returns the intersection of the kernels ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["f", "i", 
     RowBox[{"-", "1"}]], "[", "0", "]"}], TraditionalForm]],ExpressionUUID->
  "656c25a9-72d5-4476-8758-09f50b8d8cf5"],
 ".\nIf ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "d774c177-ee17-4d89-a90c-051d1dd4de5b"],
 " is a",
 " ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " ",
 "list or sum, the function is applied to the terms of ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "4a108296-4acb-478e-b0dd-d22c2e66c224"],
 "; the zero solutions are excluded from the result."
}], "Text",
 CellChangeTimes->{{3.421503674655554*^9, 3.421503734401464*^9}, {
   3.5828059266558876`*^9, 3.5828059290465126`*^9}, {3.5828059639996376`*^9, 
   3.5828059702183876`*^9}, 3.5828062476246376`*^9},
 CellTags->{
  "GeneralKernel", 
   "b:3.6"},ExpressionUUID->"e3a5bf65-286f-4858-b262-fd3455a83690"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneralPlus", "Subsubsection",
 CellTags->{
  "i:75", "GeneralPlus", "b:3.6", 
   "c:85"},ExpressionUUID->"7c13c431-2a9e-42b0-ae13-39a8a4ce6480"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralPlus", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", "...", ",", 
     SubscriptBox["v", "n"], " ", ",", "c"}], "]"}], TraditionalForm]],
  ExpressionUUID->"ecfce411-bf6c-4041-a9d4-9d212a07d3dd"],
 " returnns the sum of general sums ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", "...", ",", 
    SubscriptBox["v", "n"]}], TraditionalForm]],ExpressionUUID->
  "85d84213-8b8e-4ef7-9c78-776e2d9d8c85"],
 ", i.e., the general sum representing the sum of the spaces represented by \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", "...", ",", 
    SubscriptBox["v", "n"]}], TraditionalForm]],ExpressionUUID->
  "ff7bf270-4467-4047-adf3-0d61fbcd4efe"],
 ". Each of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "53813055-b77c-4c1e-804c-e433682bab90"],
 " may be either a general sum with coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "j"], TraditionalForm]],ExpressionUUID->
  "cc236624-fcf6-4755-8b3b-dc8da48a09f9"],
 " or a list of vectors.\nIf ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", "...", ",", 
    SubscriptBox["v", "n"]}], TraditionalForm]],ExpressionUUID->
  "ca8c4720-ee66-476e-9999-833c584393a2"],
 " are",
 " ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " ",
 "sums or lists, the function is applied to the terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "518237de-3b93-48ee-841f-38be541f9d42"],
 "."
}], "Text",
 CellChangeTimes->{{3.5828028656558876`*^9, 3.5828028692496376`*^9}, {
   3.5828030312965126`*^9, 3.5828030343902626`*^9}, 3.5828062574683876`*^9},
 CellTags->{
  "GeneralPlus", 
   "b:3.6"},ExpressionUUID->"60ab507b-e9ad-453d-a617-7df30ea6a7ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneralPreImage", "Subsubsection",
 CellTags->{
  "i:74", "GeneralPreImage", "b:3.6", 
   "c:86"},ExpressionUUID->"dbb944e7-b6b9-4122-9939-bf006bf7c3c1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralPreImage", "Program"], "[", 
    RowBox[{"g", ",", 
     StyleBox["v",
      FontSlant->"Italic"], ",", 
     StyleBox["cv",
      FontSlant->"Italic"], ",", "w", ",", 
     StyleBox["cw",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "77476c3d-320c-4b8f-a842-76904cf6e085"],
 " calculates the intersection of a subspace ",
 StyleBox["V ",
  FontSlant->"Italic"],
 "in a \[GothicG]-module and the preimage (or inverse image) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"ad", "[", "g", "]"}], 
     RowBox[{"-", "1"}]], "[", "W", "]"}], TraditionalForm]],ExpressionUUID->
  "51b835c5-11e0-4ec7-911f-51cfcb536804"],
 " of a subspace ",
 StyleBox["W",
  FontSlant->"Italic"],
 " in the same \[GothicG]-module under the action of an element g\[Element]\
\[GothicG]. Each of the spaces ",
 StyleBox["V",
  FontSlant->"Italic"],
 " and ",
 StyleBox["W",
  FontSlant->"Italic"],
 " is given either as a general sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["c", "1"], 
        SubscriptBox["v", "1"]}], "+"}], "..."}], "+", 
     RowBox[{
      SubscriptBox["c", "n"], 
      SubscriptBox["v", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "c5f4959e-7765-4cbb-a81f-ac2f0d8a6e91"],
 " with arbitrary vector expressions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", "...", ",", 
    SubscriptBox["v", "n"]}], TraditionalForm]],ExpressionUUID->
  "8ca8f862-9a5d-42b5-b854-03cdeaace789"],
 " or as a basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["v", "1"], ",", "...", ",", 
      SubscriptBox["v", "n"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "19f568c1-f349-42e9-ae52-204d73e971b4"],
 ".\nThe optional argument ",
 StyleBox["op",
  FontSlant->"Italic"],
 " gives the name of the action of \[GothicG] on the module. The default name \
is ",
 ButtonBox["Act",
  BaseStyle->"AddOnsLink"],
 ". \nThe result is represented as a general sum  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["e", "1"]}], "+"}], "..."}], "+", 
    RowBox[{
     SubscriptBox["c", "k"], 
     SubscriptBox["e", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "ca80d2e4-7622-43ca-8b10-dd8f12e1649e"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "i"], TraditionalForm]],ExpressionUUID->
  "4df0d0a9-7032-40ee-bbdd-1542d7a05cce"],
 " are linear combinations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "i"], TraditionalForm]],ExpressionUUID->
  "ceac963b-9f66-4991-a3ec-eb8507efe382"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralPreImage", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "..."}], "}"}], ",", 
     StyleBox["v",
      FontSlant->"Italic"], ",", 
     StyleBox["cv",
      FontSlant->"Italic"], ",", "w", ",", 
     StyleBox["cw",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "3fe69ce2-9e13-4800-868f-7deba74c40c6"],
 " returns the intersection of the ",
 StyleBox["V",
  FontSlant->"Italic"],
 " and all preimages ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"ad", "[", 
      SubscriptBox["g", "i"], "]"}], 
     RowBox[{"-", "1"}]], "[", "W", "]"}], TraditionalForm]],ExpressionUUID->
  "6849145f-b75f-4afa-b924-3d8baba0a9bc"],
 "."
}], "Text",
 CellChangeTimes->{{3.421503792204581*^9, 3.421503830018955*^9}},
 CellTags->{
  "GeneralImage", 
   "b:3.6"},ExpressionUUID->"150a0c14-da85-4bb1-ac89-ec2367334f4b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneralReduce", "Subsubsection",
 CellTags->{
  "i:75", "GeneralReduce", "b:3.6", 
   "c:87"},ExpressionUUID->"d12c900c-9f3c-450c-969d-4f479d948078"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralReduce", "Program"], "[", 
    RowBox[{"v", ",", " ", "c"}], "]"}], TraditionalForm]],ExpressionUUID->
  "552d3e0c-2a27-43e4-ad2a-be636812e81b"],
 " returns a general sum representing the same vector space as the general \
sum  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["e", "1"]}], "+"}], "..."}]}], TraditionalForm]],
  ExpressionUUID->"68a84820-b773-4b48-b5a4-76b69c87900a"],
 " , but using the minimal number of coefficients. This function is used if \
the dimension of the space of vectors of the form ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "783d2a5b-cb64-4f38-ae3c-3fdf392dc68f"],
 " is less than the number of coefficients ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "0387ad71-c913-4d7f-b97e-560f413e4d74"],
 ".\nIf ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "a097d803-90b6-4ee8-9b16-afd518f387ac"],
 " is a ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " sum, the function is applied to the terms of ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "d438b097-e786-436a-b8bf-df90c61bfe1c"],
 "; the zero terms are excluded from the result."
}], "Text",
 CellChangeTimes->{{3.421503856196597*^9, 3.421503868894856*^9}, {
  3.423237321381816*^9, 3.423237373687027*^9}, {3.5828028968277626`*^9, 
  3.5828028992808876`*^9}, {3.5828029443902626`*^9, 3.5828029979215126`*^9}, {
  3.5828062679840126`*^9, 3.5828062705621376`*^9}},
 CellTags->{
  "GeneralReduce", 
   "b:3.6"},ExpressionUUID->"46e317ce-2d68-4256-ac58-3f3354ad1e3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneralSolve", "Subsubsection",
 CellTags->{
  "i:76", "GeneralSolve", "b:3.6", 
   "c:88"},ExpressionUUID->"80e2811d-8845-44be-8bbb-c9d1cd2a1ee7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralSolve", "Program"], "[", 
    RowBox[{
     StyleBox["equ",
      FontSlant->"Italic"], ",", " ", "v", ",", " ", "c"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"43b2d8c1-9475-4cba-b3eb-bea671b235b5"],
 " solves the vector equation ",
 StyleBox["equ",
  FontSlant->"Italic"],
 " for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "1"], TraditionalForm]],ExpressionUUID->
  "8c9a897a-6885-4cef-ada8-f0a32092baf5"],
 ", ... , substitutes the found coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "1"], TraditionalForm]],ExpressionUUID->
  "890d7bd8-c781-4d7a-8cb4-c16fae2b6f6a"],
 ", ... in the general sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["e", "1"]}], "+"}], "..."}]}], TraditionalForm]],
  ExpressionUUID->"03a06a07-9b43-4d8a-a704-0089e7c49f85"],
 " , renumbers the remaining coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "cd8cd805-8ed1-40c8-b379-aa805b802a27"],
 ", and returns the result. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralSolve", "Program"], "[", 
    RowBox[{
     StyleBox["equ",
      FontSlant->"Italic"], ",", " ", "v", ",", " ", "c", ",", " ", 
     StyleBox["a",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "d86a0b5a-f03d-404c-aa23-4586721dc3c2"],
 " solves the equation  eliminating the scalar coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a", "Var"], "1"], TraditionalForm]],ExpressionUUID->
  "55f39363-9f25-4ce9-bfa5-85a9516e09a1"],
 ", ... .\nIf ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "5b2eb0f6-79a4-42da-b28d-69ec9a0eb0b0"],
 " is a",
 " ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " ",
 "sum, the function is applied to the terms of ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "cf2ef3d6-1cde-4005-9b4b-f43100c10649"],
 "; the zero solutions are excluded from the result."
}], "Text",
 CellChangeTimes->{{3.4215038967749453`*^9, 3.4215039148709664`*^9}, {
   3.4232375498803806`*^9, 3.423237550441187*^9}, {3.5828030514996376`*^9, 
   3.5828030557340126`*^9}, {3.5828030885465126`*^9, 3.5828030915308876`*^9}, 
   3.5828062812808876`*^9},
 CellTags->{
  "GeneralSolve", 
   "b:3.6"},ExpressionUUID->"259745c1-b5eb-413f-a227-526f261bd995"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneralSum", "Subsubsection",
 CellTags->{
  "i:77", "GeneralSum", "b:3.6", 
   "c:89"},ExpressionUUID->"010ec787-96b1-4706-8eaa-87b3dd825300"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralSum", "Program"], "[", 
    RowBox[{"c", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "..."}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"619679bc-c1df-497d-8931-1b10caca62d0"],
 " returns the general linear combination ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], 
      SubscriptBox["v", "1"]}], "+"}], "..."}], TraditionalForm]],
  ExpressionUUID->"43bcab9e-597b-4484-bd5c-3c48fdfacc7c"],
 " , declares ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "7968aa6a-0c9d-4ebe-8e80-2e6dbd2263ee"],
 " scalars and enables represent indices in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "4e5a091c-6454-453e-91db-a9f3740715f4"],
 " as subscripts. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralSum", "Program"], "[", 
    RowBox[{"c", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["v", "1"], ",", "..."}], "}"}], ",", " ", "f"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"aae189f1-0a5e-49b3-bdab-be1621ce45ad"],
 " returns the general linear combination ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], 
       SubscriptBox["v", "1"]}], " ", "+"}], " ", "..."}]}], 
   TraditionalForm]],ExpressionUUID->"173bc48c-70ae-49f8-8870-d7f9157b0103"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "v", "]"}], "\[Equal]", "0"}], TraditionalForm]],
  ExpressionUUID->"3ef808be-b085-4cb6-8b57-f1d0e8deab1d"],
 ".\nIf ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "05ff713a-07a9-4bea-840d-9adceadf5f56"],
 " is a",
 " ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " ",
 "list, the function is applied to the terms of ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "4b54353e-5836-4927-b631-d9804226f147"],
 "."
}], "Text",
 CellChangeTimes->{{3.4215039433419056`*^9, 3.4215039530258303`*^9}, {
   3.4215039867042575`*^9, 3.4215039929532433`*^9}, {3.5828057725933876`*^9, 
   3.5828057871715126`*^9}, 3.5828063021871376`*^9},
 CellTags->{
  "GeneralSum", 
   "b:3.6"},ExpressionUUID->"7d9415a8-411a-4712-9eba-5e3dc73e526d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GeneralZero", "Subsubsection",
 CellTags->{
  "i:78", "GeneralZero", "b:3.6", 
   "c:90"},ExpressionUUID->"3c8ccf18-c7d7-4cb1-849c-6eacda0dcd07"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralZero", "Program"], "[", 
    RowBox[{"g", ",", "v", ",", "c", ",", 
     StyleBox["brk",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "f550b960-a3af-4bed-92fc-a029e345d828"],
 " returns the general solution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["brk",
     FontSlant->"Italic"], "[", 
    RowBox[{"g", ",", " ", "v"}], "]"}], TraditionalForm]],ExpressionUUID->
  "3c3995ee-fb39-43ee-bd34-b2667e3ea176"],
 " with coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "1"], TraditionalForm]],ExpressionUUID->
  "a885b87c-e7cc-414e-a89a-b1f950ef8547"],
 ", ... . The ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "67897a72-880d-4939-b3ef-7e854e865863"],
 " is a given element, or a list of elements, of an algebra \[GothicG]; ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "ca8e3c21-6cf4-495d-89e1-b1f82f34105c"],
 " is a general sum (i.e., a linear combinations of vectors in a \
\[GothicG]-module with indeterminate coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "i"], TraditionalForm]],ExpressionUUID->
  "fd5538f0-62f4-4cc7-bcb1-f1463c00b4f0"],
 ", see ",
 ButtonBox["GeneralSum",
  BaseStyle->"AddOnsLink"],
 "). The default value for ",
 StyleBox["brk",
  FontSlant->"Italic"],
 " is ",
 StyleBox["Act", "Program"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralZero", "Program"], "[", 
    RowBox[{"g", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["e", "1"], ",", "..."}], "}"}], ",", "c", ",", 
     StyleBox["brk",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "368a2325-601d-408c-a7f1-491343bf3d61"],
 " is equivalent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GeneralZero", "Program"], "[", 
    RowBox[{"g", ",", 
     RowBox[{
      StyleBox["GeneralSum", "Program"], "[", 
      RowBox[{"c", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["e", "1"], ",", "..."}], "}"}]}], "]"}], ",", "c", ",", 
     
     StyleBox["brk",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "5dc73017-249f-4e23-ade1-22156a304591"],
 " \nIf ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "349208eb-5c7d-4f2b-8d64-16dd6c4be115"],
 " is a",
 " ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " ",
 "list or sum, the function is applied to the terms of ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "d95b04a3-7ee9-46c7-8af5-042b3e6cb8f3"],
 "; the zero solutions are excluded from the result."
}], "Text",
 CellChangeTimes->{{3.421504045368613*^9, 3.421504049324301*^9}, {
   3.5828058888902626`*^9, 3.5828059011715126`*^9}, 3.5828063082340126`*^9},
 CellTags->{
  "GeneralZero", 
   "b:3.6"},ExpressionUUID->"081d260c-71d0-45be-8155-2f2308284703"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GenRel", "Subsubsection",
 CellTags->{
  "i:79", "GenRel", "b:3.6", 
   "c:91"},ExpressionUUID->"c61ef851-04ae-4e77-b74f-cb3231b44928"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GenRel", "Program"], "[", "\[GothicG]", "]"}], 
   TraditionalForm]],ExpressionUUID->"377acd01-a98d-4816-88da-5c16438b7586"],
 " returns the list of relations between the generators of \[GothicG]. This \
list is prepared by some space constructors."
}], "Text",
 CellTags->{
  "GenRel", "b:3.6"},ExpressionUUID->"208304f2-677e-40b8-a21b-a9a80bac6255"]
}, Open  ]],

Cell[CellGroupData[{

Cell["glAlgebra", "Subsubsection",
 CellTags->{
  "i:80", "glAlgebra", "b:3.6", 
   "c:92"},ExpressionUUID->"330f9140-187d-4219-8bdf-dec48d8a90f3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["glAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "V", ",", 
     StyleBox["options",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "b457051f-d975-48dd-8572-b11718e01f60"],
 " defines \[GothicG] as a matrix Lie  (super)algebra on the space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "c2c642d2-bc32-4897-a831-ae1bf06925bc"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["glAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", 
     StyleBox["options",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "219f8d62-d61e-48c8-af48-0fb28b7e0447"],
 "  defines \[GothicG] as Lie (super)algebra of square matrices; the size of \
matrices and the parities of rows are given by options ",
 ButtonBox["Dim",
  BaseStyle->"AddOnsLink"],
 " or ",
 ButtonBox["PList",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellTags->{
  "glAlgebra", 
   "b:3.6"},ExpressionUUID->"3d888fb4-65ab-4251-8c0f-b0d9b6d0661e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GList", "Subsubsection",
 CellTags->{
  "i:81", "GList", "b:3.6", 
   "c:93"},ExpressionUUID->"291975aa-a196-4777-9607-eeaf8e689e75"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GList", "Program"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["d", "1"], ",", "..."}], " ", "}"}]}], TraditionalForm]],
  ExpressionUUID->"447a6aed-6bb9-41c2-b0ad-493cc84400b0"],
 " is the optional parameter of",
 " some space constructor",
 " functions. It is the list of degrees of generators of the new space."
}], "Text",
 CellTags->{
  "GList", "b:3.6"},ExpressionUUID->"502f4a3c-2a53-4935-8b61-0c5910c29d44"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GPlus", "Subsubsection",
 CellTags->{
  "i:82", "GPlus", "b:3.6", 
   "c:94"},ExpressionUUID->"8eb951c0-ccc1-4521-83e0-04b1d98043f4"],

Cell[TextData[{
 StyleBox["GPlus", "Program"],
 " is the name of \"+\" in the ",
 StyleBox["Common",
  FontFamily->"Courier"],
 " domain. The operation + is treated as ",
 StyleBox["GPlus", "Program"],
 " when (a) not all operands are defined as ",
 StyleBox["Vectors",
  FontFamily->"Courier"],
 " or ",
 StyleBox["Scalars",
  FontFamily->"Courier"],
 ", or (b) a scalar is added with a vector. The operation ",
 StyleBox["GPlus", "Program"],
 " is automatically replaced with ",
 ButtonBox["VPlus",
  BaseStyle->"AddOnsLink"],
 " if all operands become vectors and by ",
 StyleBox["Plus", "Program"],
 " if all operands become scalars."
}], "Text",
 CellChangeTimes->{{3.4215040676005807`*^9, 3.4215040678909984`*^9}},
 CellTags->{
  "GPlus", "b:3.6"},ExpressionUUID->"c44d019c-1786-4444-a792-ab0a31839535"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GPower", "Subsubsection",
 CellTags->{
  "i:83", "GPower", "b:3.6", 
   "c:95"},ExpressionUUID->"df833e90-5fe3-4073-a195-def8c0a05b10"],

Cell[TextData[{
 StyleBox["GPower", "Program"],
 " is the name of the power operation in the ",
 StyleBox["Common",
  FontFamily->"Courier"],
 " domain. The operations ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "^", "b"}], TraditionalForm]],ExpressionUUID->
  "b94e49f9-3f0d-4e74-bdce-3fb42ec98f3f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "b"], TraditionalForm]],ExpressionUUID->
  "1d562b8e-2c59-4133-a854-d1f6dd7a15f2"],
 " are treated as  ",
 StyleBox["GPower", "Program"],
 " when ",
 StyleBox["a",
  FontSlant->"Italic"],
 " is not defined as either ",
 StyleBox["Vectors",
  FontFamily->"Courier"],
 " or ",
 StyleBox["Scalars",
  FontFamily->"Courier"],
 ".\nThe operation ",
 StyleBox["GPower", "Program"],
 " is automatically replaced by ",
 ButtonBox["VPower",
  BaseStyle->"AddOnsLink"],
 " when ",
 StyleBox["a",
  FontSlant->"Italic"],
 " is a vector and by ",
 StyleBox["Power", "Program"],
 " when ",
 StyleBox["a",
  FontSlant->"Italic"],
 " is a scalar."
}], "Text",
 CellChangeTimes->{{3.421504079016997*^9, 3.421504086708056*^9}},
 CellTags->{
  "GPower", "b:3.6"},ExpressionUUID->"b3a5d7c6-22a1-4887-acfe-ac31ecb26ca5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Grade", "Subsubsection",
 CellTags->{
  "i:84", "Grade", "b:3.6", 
   "c:96"},ExpressionUUID->"bc13dd8a-2890-4c42-8b3e-e6f9643df214"],

Cell[TextData[{
 "For a graded object ",
 StyleBox["m, ",
  FontSlant->"Italic"],
 " the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Grade", "Program"], "[", "m", "]"}], TraditionalForm]],
  ExpressionUUID->"c01f64a9-862f-4366-80a3-7edbf2cd8082"],
 " is the grade (degree) of ",
 StyleBox["m",
  FontSlant->"Italic"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Grade", "Name"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["d", "1"], ",", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"ab8c7c7d-61b6-4c3f-9a94-5b01dc445865"],
 " is an option for space constructors."
}], "Text",
 CellChangeTimes->{{3.4215041076782093`*^9, 3.421504108809837*^9}},
 CellTags->{
  "Grade", "b:3.6"},ExpressionUUID->"ff452271-880a-4d71-89bb-42e14b35e900"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GradeBasis", "Subsubsection",
 CellTags->{
  "i:85", "GradeBasis", "b:3.6", 
   "c:97"},ExpressionUUID->"e4a9f212-feca-4623-aa1b-ca716757aeea"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "843621a0-8c1c-4918-b3d3-df5b285087f3"],
 " returns the list of elements of grade ",
 StyleBox["d",
  FontSlant->"Italic"],
 " in the symmetric algebra in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["x", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "2d85416c-6163-4f2d-85e9-119c30a59805"],
 ". The grades of the indeterminates must be predefined.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradeBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "431fb550-69e6-4783-a6e0-c33665103375"],
 " uses ",
 StyleBox["op",
  FontSlant->"Italic"],
 " instead of ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradeBasis", "Program"], "[", 
    RowBox[{"d", ",", " ", 
     FormBox[
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         RowBox[{"...", 
          SubscriptBox["x", "n"]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["d", "1"], ",", "...", ",", 
         SubscriptBox["d", "n"]}], "}"}]}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "673f09ab-4ae0-4194-a2b4-bff5ed4051bf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradeBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["d", "1"], ",", "...", ",", 
       SubscriptBox["d", "n"]}], "}"}], ",", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "c8686269-eab2-477b-b758-c52706bdb172"],
 " list the monomials of grade ",
 StyleBox["d,",
  FontSlant->"Italic"],
 " where the degree of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "a459a9ff-8d60-4e3c-a5d3-89a32ad0d0a1"],
 " does not exceed ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "i"], TraditionalForm]],ExpressionUUID->
  "7a05ba52-21d5-45e9-a797-73a70bae0887"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradeBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "db98b52c-e5bd-40b0-b21c-6ea1508638fa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradeBasis", "Program"], "[", 
    RowBox[{"d", ",", "  ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["x", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["x", "n"]}]}], "}"}],
      TraditionalForm], ",", 
     StyleBox["op",
      FontSlant->"Italic"], ",", 
     RowBox[{"-", "1"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "c8be094f-e191-4778-9f2c-82ca8b2e0096"],
 " return the list of element in an antisymmetric algebra.\nIf ",
 StyleBox["d",
  FontSlant->"Italic"],
 " is list, ",
 ButtonBox["PolyGrade",
  BaseStyle->"AddOnsLink"],
 " is used instead of ",
 ButtonBox["Grade",
  BaseStyle->"AddOnsLink"],
 " as grading function."
}], "Text",
 CellChangeTimes->{{3.421504143870251*^9, 3.421504162647251*^9}},
 CellTags->{
  "GradeBasis", 
   "b:3.6"},ExpressionUUID->"2d8eccaf-910e-4f4f-972b-b77e23d235ea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Graded", "Subsubsection",
 CellTags->{
  "i:86", "Graded", "b:3.6", 
   "c:98"},ExpressionUUID->"78128ef4-9616-457c-8bf2-c138e5e78cc9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Graded", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "470da5bc-75cd-4b87-adde-c702f1b44cca"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Grade", "Program"], "[", 
     RowBox[{"a", "~", 
      StyleBox["op",
       FontSlant->"Italic"], "~", "b"}], "]"}], " ", "=", 
    RowBox[{
     RowBox[{
      StyleBox["Grade", "Program"], "[", "a", "]"}], "+", 
     RowBox[{
      StyleBox["Grade", "Program"], "[", "b", "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"2b527e43-0f40-42ed-b982-0e4738173d9b"],
 "."
}], "Text",
 CellTags->{
  "Graded", "b:3.6"},ExpressionUUID->"34ef25a8-cf9a-4c22-9423-001d046e3de7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GradedKerSpace", "Subsubsection",
 CellTags->{
  "i:87", "GradedKerSpace", "b:3.6", 
   "c:99"},ExpressionUUID->"73122d09-a92b-47cb-ad3c-a833fdbcf938"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradedKerSpace", "Program"], "[", 
    RowBox[{"U", ",", " ", "V", ",", " ", "f"}], "]"}], TraditionalForm]],
  ExpressionUUID->"e1ab4eae-7908-417d-b411-6cc52e9f97a8"],
 " calculates the subspace ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", "\[Element]", "V"}], "\[VerticalSeparator]", 
      RowBox[{
       RowBox[{"f", "(", "v", ")"}], "\[Equal]", "0"}]}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"0b81a551-0760-4474-ae0f-ecd66e854116"],
 ". Here  ",
 StyleBox["f",
  FontSlant->"Italic"],
 " is a linear function or a list of linear functions on ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "6e604e54-f6e2-45f9-9029-cc0070ea7534"],
 ". The options ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["From", "Program"], "\[Rule]", 
    StyleBox["degree", "Var"]}], TraditionalForm]],ExpressionUUID->
  "a51afdfb-48a0-495a-a2fd-20f15e9cecdb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["To", "Program"], "\[Rule]", 
    StyleBox["degree", "Var"]}], TraditionalForm]],ExpressionUUID->
  "afa806ca-ee4c-4e18-8a5d-80c96fb39a7a"],
 " restricts the calculations to the specified degrees (the defaults are 0 \
and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ToGrade", "Name"], "[", "V", "]"}], TraditionalForm]],
  ExpressionUUID->"2ee73422-4675-45f1-bd5d-2d0e38a6e846"],
 ", respectively)."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "GradedKerSpace", 
   "b:3.6"},ExpressionUUID->"43eecb8f-e797-4915-b1ef-44fbdb2ddd3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GradedQ", "Subsubsection",
 CellTags->{
  "i:88", "GradedQ", "b:3.6", 
   "c:100"},ExpressionUUID->"89e24360-592e-4547-9de0-13ac80305b3d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GradedQ", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "5e55a6dd-989d-4ffb-870c-8256e63f6327"],
 " returns ",
 StyleBox["True", "Program"],
 " if the operation ",
 StyleBox["op",
  FontSlant->"Italic"],
 " is graded."
}], "Text",
 CellTags->{
  "GradedQ", "b:3.6"},ExpressionUUID->"a51ce9e7-2488-4b95-badf-6d2de04e3567"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GTimes", "Subsubsection",
 CellTags->{
  "i:90", "GTimes", "b:3.6", 
   "c:101"},ExpressionUUID->"335bb0fa-1564-4b5f-b622-f45285ab70f0"],

Cell[TextData[{
 StyleBox["GTimes", "Program"],
 " is the name of multiplication in the ",
 StyleBox["Common",
  FontFamily->"Courier"],
 " domain. The operation * is treated as ",
 StyleBox["GTimes", "Program"],
 " when not all operands are defined as ",
 StyleBox["Vectors",
  FontFamily->"Courier"],
 " or ",
 StyleBox["Scalars",
  FontFamily->"Courier"],
 ". The operation ",
 StyleBox["GTimes", "Program"],
 " is automatically replaced by ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["SVTimes",
  BaseStyle->"AddOnsLink"],
 ", and ",
 StyleBox["Times", "Program"],
 ", when all operands become vectors or scalars. "
}], "Text",
 CellChangeTimes->{{3.4215041937019053`*^9, 3.421504193992323*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "GTimes", "b:3.6"},ExpressionUUID->"ff9f0b58-ff6c-44e0-8071-cc1bfe261b68"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["H", "Subsection",
 CellTags->{
  "b:3.7", "c:102"},ExpressionUUID->"10e9b651-282b-4f41-ac75-ab43fa49d759"],

Cell[CellGroupData[{

Cell["HamiltonAlgebra", "Subsubsection",
 CellChangeTimes->{{3.7618263696208415`*^9, 3.7618263892975464`*^9}},
 CellTags->{
  "i:152", "b:3.15", "c:170", 
   "HamiltonAlgebra"},ExpressionUUID->"595eb40b-e1bc-43d3-a3ac-b9e1ee3a56c4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HamiltonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", " ", "x"}], "]"}], TraditionalForm]],
  ExpressionUUID->"b76c5601-5831-47aa-b265-c7d1459892f6"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "49cb55eb-1a45-4c0d-ba46-226af16902f2"],
 " as the Poisson algebra on the (super)space of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "af4c7735-f55b-42f3-9117-7a8fe096daef"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"2", "n"}]], TraditionalForm]],ExpressionUUID->
  "85390bc4-1431-4020-a22a-a65f040dbded"],
 " modulo constants (the vector space ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "e651db4d-7d0d-443e-9f2f-b531328af602"],
 " should be already defined) with the Poisson bracket \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"H", ".", "b", "."}]], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "[", "f", "]"}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", 
            RowBox[{
             RowBox[{"2", "n"}], "+", "1", "-", "i"}]]}]]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"P", "[", 
           SubscriptBox["x", "i"], "]"}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", 
            RowBox[{
             RowBox[{"2", "n"}], "+", "1", "-", "i"}]]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["x", "i"]}]]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f59c713f-faec-4547-b94d-d2541a203d59"],
 ".\n\t"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.42150550710048*^9, 3.4215055109760528`*^9}, {
  3.7618264106676035`*^9, 3.761826415684884*^9}, {3.7618264631118727`*^9, 
  3.761826467257321*^9}, {3.7618265104171658`*^9, 3.7618265104171658`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "b:3.15", 
   "HamiltonAlgebra"},ExpressionUUID->"95541caf-4cf0-43f2-b19d-0b8e01788bae"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HamiltonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p", ",", "q"}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"082fc1af-c7b3-4827-b70b-f69d9bfcede9"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "7edb965e-5994-414c-ac5f-3243ef49ee79"],
 " as the Poisson algebra on the (super)space of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "1"], TraditionalForm]],ExpressionUUID->
  "b46ec295-9644-410a-b0af-8fe0c7139365"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "n"], TraditionalForm]],ExpressionUUID->
  "4042a00c-1f44-40bd-bed6-6e850cd5d93a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "1"], TraditionalForm]],ExpressionUUID->
  "c6781226-a651-46d3-9a00-35497129bf13"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "n"], TraditionalForm]],ExpressionUUID->
  "a95cf3fd-481f-435d-bf7e-3be022bdc725"],
 " ",
 "modulo constants ",
 " (the vector spaces ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "204c274a-b489-4016-b5b3-13a8a4451678"],
 " and ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]],ExpressionUUID->
  "63ae2f02-ae92-4419-84ec-e631890d2057"],
 " should be already defined and have the same superdimension) with the \
Poisson bracket \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"H", ".", "b", "."}]], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "1"}], "n"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"P", "[", "f", "]"}], 
        RowBox[{"P", "[", 
         SubscriptBox["p", "i"], "]"}]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["p", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["q", "i"]}]]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"P", "[", 
           SubscriptBox["p", "i"], "]"}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "f"}], 
          RowBox[{"\[PartialD]", " ", 
           SubscriptBox["q", "i"]}]], 
         FractionBox[
          RowBox[{"\[PartialD]", " ", "g"}], 
          RowBox[{"\[PartialD]", 
           SubscriptBox["p", "i"]}]]}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"ed27abd9-7b0d-405a-bc14-c422d2d68920"],
 ".\n\t"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.4215055237343984`*^9, 3.4215055353310738`*^9}, {
  3.7618264847502785`*^9, 3.7618264847502785`*^9}, {3.7618265392304335`*^9, 
  3.7618265392304335`*^9}, {3.7618265764680905`*^9, 3.7618265774464903`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "b:3.15", 
   "HamiltonAlgebra"},ExpressionUUID->"8f40c02c-15c4-4860-b129-f1c5d738943c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HamiltonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", " ", 
     RowBox[{"{", "\[Theta]", "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"c488a8e0-6e7e-4fef-8288-7f66a50b8c67"],
 " defines the Lie (super)algebra ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[GothicG]",
    FontSlant->"Italic"], TraditionalForm]],ExpressionUUID->
  "32f1d247-4a49-4b26-bebb-15192ab4c029"],
 " as the Poisson algebra on the (super)space of polynomials in the odd \
variables ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "1"], TraditionalForm]],ExpressionUUID->
  "a88e5a64-399d-4b16-9d0b-b7cddff7b414"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "n"], TraditionalForm]],ExpressionUUID->
  "0ea88126-0ceb-4c80-bd6f-399b5ad690c5"],
 " ",
 "modulo constants ",
 "(the vector space ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "5084e98b-0cc8-48a4-8ac1-6d1e15625f6e"],
 " should be already defined) with the Poisson bracket\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"H", ".", "b", "."}]], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"P", "[", "f", "]"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], "n"], 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", " ", "f"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["\[Theta]", "i"]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "g"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["\[Theta]", "i"]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"6093b41d-9717-426b-8395-9d7e145565d3"],
 ".\n\t"
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.4215055713628845`*^9, 3.421505574467349*^9}, {
  3.7618265558302093`*^9, 3.761826584869917*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "b:3.15", 
   "HamiltonAlgebra"},ExpressionUUID->"880c1ace-8b0d-4561-8b0a-55fbc840d942"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HamiltonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["p", "n"]}], ",", 
        SubscriptBox["q", "n"], ",", 
        RowBox[{"...", 
         SubscriptBox["q", "1"]}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "7099f9cc-1c1f-4a81-8f8b-2793f00e7542"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HamiltonAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicG]",
      FontSlant->"Italic"], ",", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["p", "1"], ",", 
        RowBox[{"...", 
         SubscriptBox["p", "n"]}], ",", "\[Theta]", ",", 
        SubscriptBox["q", "n"], ",", 
        RowBox[{"...", 
         SubscriptBox["q", "1"]}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "eb77a4d0-d622-47ef-9460-07a17f97be28"],
 ", where all ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "e9310f63-5ef8-4977-80e5-6f9c43ce0f9e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],ExpressionUUID->
  "57996297-834c-44e0-aed9-0e71edfc211a"],
 " and ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "f6d706fb-2334-4c70-bf53-ef26b7aae3f9"],
 " are (super)spaces, define the Lie (super)algebra ",
 StyleBox["\[GothicG]",
  FontSlant->"Italic"],
 " as the Poisson algebra on the (super)space of polynomials on the direct \
sum of vector (super)spaces with the Poisson bracket equal to the sum of the \
Poisson brackets on pairs  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "i"], TraditionalForm]],ExpressionUUID->
  "a9b7b5f8-1153-443e-bae8-1c958a0420c0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],ExpressionUUID->
  "83897f31-e261-459c-a3ec-f007a02bc950"],
 " and on ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "b29aa8ee-9cac-48f2-b227-168edc9f8017"],
 ", ",
 "modulo constants",
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.421505608546352*^9, 3.4215057085601645`*^9}, {
  3.7618266040666213`*^9, 3.761826627071457*^9}, {3.761826720550008*^9, 
  3.7618267226747003`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "b:3.15", 
   "HamiltonAlgebra"},ExpressionUUID->"6dc74f0d-56c3-4c60-8837-127269718809"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["HamiltonAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "x", ",", " ", 
     FormBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["c", "1"], ",", 
          SubscriptBox["i", "1"], ",", 
          SubscriptBox["j", "1"]}], "}"}], ",", "...", ",", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["c", "m"], ",", 
          SubscriptBox["i", "m"], ",", 
          SubscriptBox["j", "m"]}], "}"}]}], "}"}],
      TraditionalForm]}], "]"}], TraditionalForm]],ExpressionUUID->
  "52df0d2d-e174-4777-ad3f-81fd46de5682"],
 " defines the Poisson algebra ",
 "on the (super)space of polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "01e72858-7281-40f3-99ab-c0422a8596d8"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"2", "n"}]], TraditionalForm]],ExpressionUUID->
  "135880e6-393d-4545-934b-28c9b2693bae"],
 " modulo constants (the vector space ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "1fe86468-381c-4860-b471-17d10e5fa95f"],
 " should be already defined) ",
 " with the bracket \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"{", 
      RowBox[{"f", ",", "g"}], "}"}], 
     RowBox[{"H", ".", "b", "."}]], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"P", "[", "f", "]"}]]}], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "m"], 
      RowBox[{
       SubscriptBox["c", "k"], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "f"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["x", 
          SubscriptBox["i", "k"]]}]], 
       FractionBox[
        RowBox[{"\[PartialD]", " ", "g"}], 
        RowBox[{"\[PartialD]", " ", 
         SubscriptBox["x", 
          SubscriptBox["j", "k"]]}]]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"f403e8ff-d529-4a11-a1b0-0c747d8ec508"],
 "."
}], "Text",
 Evaluatable->False,
 CellChangeTimes->{{3.761826689836917*^9, 3.761826689836917*^9}, {
  3.761826756220046*^9, 3.7618267829395947`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 AspectRatioFixed->True,
 CellTags->{
  "b:3.15", 
   "HamiltonAlgebra"},ExpressionUUID->"6f966c40-46c1-4813-bca5-376b7cc69537"]
}, Open  ]],

