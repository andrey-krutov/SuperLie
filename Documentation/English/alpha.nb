  "3f603226-3742-465e-af2f-9d1e02b11e7a"],
 " introduces also TeX notation for ",
 StyleBox["s",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellTags->{
  "NewSuperscript", 
   "b:3.13"},ExpressionUUID->"5c1443cd-8f52-40f5-82ba-d59016504eb1"]
}, Open  ]],

