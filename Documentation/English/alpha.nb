Cell[CellGroupData[{

Cell["MRight", "Subsubsection",
 CellTags->{
  "i:126", "MRight", "b:3.12", 
   "c:141"},ExpressionUUID->"e83fa426-7f81-4b50-b925-62c063f29316"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["MRight", "Program"], "[", "\[GothicM]", "]"}], 
   TraditionalForm]],ExpressionUUID->"c747edca-dd78-4fcf-a56e-115efe72e94f"],
 " returns the name of the module ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[CapitalPi]", "\[CircleTimes]", "\[GothicM]", "\[CircleTimes]", 
    "\[CapitalPi]"}], TraditionalForm]],ExpressionUUID->
  "1004b1bd-9428-4c49-9f86-3644ed02d57e"],
 ", where ",
 Cell[BoxData[
  FormBox["\[CapitalPi]", TraditionalForm]],ExpressionUUID->
  "15d02b39-9af2-4120-a5c5-4d8042a74da0"],
 "  is the 1-dimensional trivial odd module, or ",
 StyleBox["None", "Name"],
 " if this module was not defined.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["MRight", "Program"], "[", 
    RowBox[{"\[GothicM]", "\[Rule]", "\[GothicR]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"b8992803-d97d-4ebf-bdc4-6abdd84b37c6"],
 " builds the module ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicR]", "=", 
    RowBox[{
    "\[CapitalPi]", "\[CircleTimes]", "\[GothicM]", "\[CircleTimes]", 
     "\[CapitalPi]"}]}], TraditionalForm]],ExpressionUUID->
  "50577511-8d31-4f27-b306-00d17c770735"],
 ", where ",
 Cell[BoxData[
  FormBox["\[CapitalPi]", TraditionalForm]],ExpressionUUID->
  "05d913d8-5920-4817-9a4c-37617fbe2fb1"],
 "  is the 1-dimensional trivial odd module.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["MRight", "Program"], "\[Rule]", "\[GothicR]"}], 
   TraditionalForm]],ExpressionUUID->"23fa3c4d-e359-47aa-9dd5-d857b57dcb42"],
 " is an optional parameter to the constructor ",
 ButtonBox["VectorSpace",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "MRight", "b:3.12"},ExpressionUUID->"dcfd19aa-2e0c-48c2-ab15-ef778dc79a53"]
}, Open  ]]
}, Open  ]],

