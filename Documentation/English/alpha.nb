 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "41ea1c8b-7398-4fbb-a399-05c0f16c3233"],
 " as the algebra on the space of  polynomials in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox["x", "1"],
     TraditionalForm], ",", "...", 
    SubscriptBox["x", "n"]}], TraditionalForm]],ExpressionUUID->
  "8755608f-d69c-485c-bdd3-7f6cd48c1d4a"],
