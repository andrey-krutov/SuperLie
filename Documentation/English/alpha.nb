Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["TeX", "Program"], "[", 
    RowBox[{
     StyleBox["v",
      FontSlant->"Italic"], "\[Rule]", "f"}], "]"}], TraditionalForm]],
  ExpressionUUID->"f2a4b064-506a-42b3-904c-2c93d92e831d"],
