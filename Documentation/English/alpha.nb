Cell[CellGroupData[{

Cell["RemoveOverscript", "Subsubsection",
 CellTags->{
  "i:171", "RemoveOverscript", "b:3.17", 
   "c:192"},ExpressionUUID->"60e2c251-8dee-487f-b809-8a1c04ee3de0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RemoveOverscript", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "ea21fd8c-c1b9-43ff-a7ef-98196a3953ec"],
 " removes the overscript notation (such as ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["x", "_"], TraditionalForm]],ExpressionUUID->
  "0bcdd7ab-d3d9-49e4-bd6a-4f2232ed2fd6"],
 ") for the operation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["op",
     FontSlant->"Italic"], "[", "x", "]"}], TraditionalForm]],ExpressionUUID->
  "3145051d-cf7f-403c-971d-cf9e8b3ff4a5"],
 "."
}], "Text",
 CellTags->{
  "RemoveOverscript", 
   "b:3.17"},ExpressionUUID->"6b3256ac-407a-4ca9-bbd7-0c246d96de9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RemovePower", "Subsubsection",
 CellTags->{
  "i:172", "RemovePower", "b:3.17", 
   "c:193"},ExpressionUUID->"78afcbf0-627f-4dcb-a43e-281525c3ec02"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RemovePower", "Program"], "[", 
    StyleBox["op",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "706659fd-d2aa-424e-bd49-3c14627298a3"],
 " removes the power-like notation (such as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"\[CircleTimes]", "n"}]], TraditionalForm]],ExpressionUUID->
  "c24e772f-bfe7-4f0a-8fb8-a5db343113bc"],
 ") for the operation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["op",
     FontSlant->"Italic"], "[", 
    RowBox[{"x", ",", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "03fda662-8b49-4d6c-bc6a-d4afe59756b4"],
 "."
}], "Text",
 CellTags->{
  "RemovePower", 
   "b:3.17"},ExpressionUUID->"65db8459-056c-49a5-b2aa-dac1a2baff31"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RemoveSuperscript", "Subsubsection",
 CellTags->{
  "i:173", "RemoveSuperscript", "b:3.17", 
   "c:194"},ExpressionUUID->"a53af617-bdad-4804-8631-899cf4d9c72a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RemoveSuperscript", "Program"], "[", 
