 Cell[BoxData[
  StyleBox[
   RowBox[{"T", 
    AdjustmentBox["E",
     BoxBaselineShift->0.5,
     BoxMargins->{{-0.075, -0.085}, {0, 0}}], "X"}]]],ExpressionUUID->
  "f3a47be5-bb89-4d19-900d-7bd25035d6d6"],
 " output format of the space elements. "
}], "Text",
 CellChangeTimes->{{3.421507188698499*^9, 3.421507189119104*^9}},
 TextAlignment->Left,
