Cell[CellGroupData[{
Cell["Alphabetical list of symbols in SuperLie", "Title",
 FontSize->24,
 CellTags->{
  "i:1", "List of symbols", 
   "c:1"},ExpressionUUID->"3afb565e-7b07-481c-98aa-727aa503f482"],

Cell[CellGroupData[{

Cell["A", "Subsection",
 CellTags->{
  "b:3.0", "c:2"},ExpressionUUID->"6cfab820-ca74-433c-ba3e-08e01692bceb"],

Cell[CellGroupData[{

Cell["Act, act", "Subsubsection",
 CellTags->{
  "i:2", "Act", "act", "b:3.0", 
   "c:3"},ExpressionUUID->"aa715b1a-ad39-48d3-ae3e-8b0a65adffa4"],

Cell[TextData[{
 StyleBox["Act", "Program"],
 " is the default name of the ",
 "bracket",
 " operation in Lie (super)algebras and the action of algebras on modules.\n\
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Act", "Program"], "[", 
    RowBox[{
     SubscriptBox["g", "1"], ",", 
     SubscriptBox["g", "2"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "b68d2ba1-0553-4360-9676-22629f610409"],
 " for elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "b13ca4c1-c1d9-4507-8331-39b1f72c9e24"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "2"], TraditionalForm]],ExpressionUUID->
  "e69a9789-3d5c-4f3b-82f4-bb43e175f470"],
 " of a Lie (super)algebra is the bracket operation in this algebra. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Act", "Program"], "[", 
    RowBox[{"g", ",", " ", "v"}], "]"}], TraditionalForm]],ExpressionUUID->
  "4f258b69-8d82-47c8-8298-e92993c96488"],
 " for an element ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "6f2b149d-1cd6-453d-bde1-a993e917fb56"],
 " of the algebra and an element ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "038fb42a-2066-4ed7-ac6e-c7a4068d7f36"],
 " of the module over the algebra is the action of ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "8834a099-51e6-45c7-adf0-35ca81e5b423"],
 " on ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "f9b8768f-c637-4f76-b356-e965a1f60281"],
 ". The name of the operation can be different, ",
 StyleBox["Act", "Program"],
 " is only the default name.\nThe properties of ",
 StyleBox["Act", "Program"],
 " are ",
 ButtonBox["Vector",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["Linear",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["Graded",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["Jacobi",
  BaseStyle->"AddOnsLink"],
 StyleBox["\[Rule]{", "Program"],
 ButtonBox["CircleTimes",
  BaseStyle->"AddOnsLink"],
 StyleBox[",", "Program"],
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 StyleBox["}", "Program"],
 ". The output format of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Act", "Program"], "[", 
    RowBox[{"x", ",", " ", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ab3bbc88-3092-4aea-832d-f40388a44d42"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"x", ",", " ", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "2761af21-9adb-4664-997b-cb12e486abaa"],
 "."
}], "Text",
 CellTags->{
  "Act", "act", 
   "b:3.0"},ExpressionUUID->"f994e114-808e-4e97-bded-53363727b5e0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["act", "Program"], "[", 
    RowBox[{
     SubscriptBox["g", "1"], ",", 
     SubscriptBox["g", "2"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "d445769c-0ba6-45bf-9def-e86fc3133c94"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["act", "Program"], "[", 
    RowBox[{"g", ",", "v"}], "]"}], TraditionalForm]],ExpressionUUID->
  "f6f1621b-7b75-4beb-8b78-b941d2685038"],
 " represent the unevaluated operation ",
 StyleBox["Act", "Program"],
 "."
}], "Text",
 CellTags->{
  "act", "Act", 
   "b:3.0"},ExpressionUUID->"1395044e-5fd1-460b-95ad-ca1fc44adcf4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ActTable", "Subsubsection",
 CellTags->{
  "i:2", "ActTable", "b:3.0", 
   "c:4"},ExpressionUUID->"a9910706-a807-4446-9c5c-3a5843281342"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ActTable", "Program"], "[", "g", "]"}], TraditionalForm]],
  ExpressionUUID->"7d367599-ac32-481e-a2fd-1647876a3903"],
 " is the table used to define the bracket on algebra g if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["BracketMode", "Program"],
      BaseStyle->"AddOnsLink"], "Program"], "[", "g", "]"}], 
   TraditionalForm]],ExpressionUUID->"91d3325f-a0e9-47bf-b2a7-ab2823b9913b"],
 " is ",
 ButtonBox["Tabular",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ActTable", "Program"], "[", 
    RowBox[{"g", ",", "m"}], "]"}], TraditionalForm]],ExpressionUUID->
  "8c2f197b-9203-4b79-84d0-240bb3706ef1"],
 " is used to define the action of algebra ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "ce89ff39-7c35-45fb-b57e-6984047d6a8d"],
 " on module ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "25ab239e-62ec-4a10-b50d-a07226965a4d"],
 "."
}], "Text",
 CellTags->{
  "ActTable", "b:3.0"},ExpressionUUID->"3c19d053-35cc-4184-ac37-ad23018af1e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Additive", "Subsubsection",
 CellTags->{
  "i:4", "Additive", "b:3.0", 
   "c:5"},ExpressionUUID->"32600d54-0de9-4ba4-bd08-64cabe2031a2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Additive", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"337287f1-92be-4315-8011-e03c927e4885"],
 " constitutes the automatic additive expansion of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "5480d42f-c39f-42bf-931c-8a4e8624f3ef"],
 ":\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"...", ",", 
      RowBox[{"x", "+", "y"}], ",", "..."}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{
       RowBox[{"...", ",", "x"}], ",", "..."}], "]"}], "+", 
     RowBox[{"f", "[", 
      RowBox[{"...", ",", "y", ",", "..."}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"78fd27a5-96b8-4324-a57f-a9630ad29876"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Additive", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "4ed946ea-5ef1-4d85-b244-b67cfd38b6ea"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Additive", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "02e910a3-654a-4ad2-81d8-4f447bdd804a"],
 " see to that the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "6256099f-06b1-4388-bab9-bb79ccb794af"],
 " is only additive in the first (last) argument.\nHere + denote either ",
 ButtonBox["Plus",
  BaseStyle->"Link",
  ButtonData:>"paclet:ref/Plus"],
 " or ",
 ButtonBox["VPlus",
  BaseStyle->"AddOnsLink"],
 " depending on the definition of the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "46a6d53b-f344-48d8-a083-cc802d78d37b"],
 ". This property can be assigned to functions that are declared having ",
 StyleBox["All", "Program"],
 " (resp. ",
 StyleBox["First", "Program"],
 ", ",
 StyleBox["Last", "Program"],
 ")  ",
 ButtonBox["Scalar",
  BaseStyle->"AddOnsLink"],
 " or ",
 ButtonBox["Vector",
  BaseStyle->"AddOnsLink"],
 " arguments and scalar or vector values.\nSee also ",
 ButtonBox["AdditiveRule",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["UnAdditive",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellChangeTimes->{{3.6233142625161176`*^9, 3.6233142751031427`*^9}},
 CellTags->{
  "Additive", "b:3.0"},ExpressionUUID->"9f435885-6466-47b0-a839-43714e30b718"]
}, Open  ]],

Cell[CellGroupData[{

Cell["AdditiveRule", "Subsubsection",
 CellTags->{
  "i:5", "AdditiveRule", "b:3.0", 
   "c:6"},ExpressionUUID->"fd29902f-e9c8-4f2b-b055-715a00b0429f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AdditiveRule", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"b3bea1e6-c797-4ed1-934d-ba2fb7bb1286"],
 " is the replacement rule for the additive expansion of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "0e56e376-54fd-4d52-a151-fbfd57526569"],
 ": \n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"..", ",", 
      RowBox[{"x", "+", "y"}], ",", ".."}], "]"}], " ", "\[Rule]", " ", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "x", ",", ".."}], "]"}], " ", "+", " ", 
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "y", ",", ".."}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"ebfc59d9-2354-497f-a600-776cf5f3caed"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AdditiveRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "356cef5a-caf1-48c6-bf08-fe190d84dd6c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AdditiveRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1e95b6c4-ad77-4adf-ae8f-1e61363867db"],
 " are rules for the additive expansion of the first (last) argument of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "cfa6faff-f89b-4f18-a75f-d6306713dfc9"],
 ".\nThe rule is valid for functions that are declared having ",
 StyleBox["All", "Program"],
 " (resp. ",
 StyleBox["First", "Program"],
 ", ",
 StyleBox["Last", "Program"],
 ")  ",
 ButtonBox["Scalar",
  BaseStyle->"AddOnsLink"],
 " or ",
 ButtonBox["Vector",
  BaseStyle->"AddOnsLink"],
 " arguments and scalar or vector values.\nSee also ",
 ButtonBox["Additive",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["UnAdditive",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 CellTags->{
  "AdditiveRule", 
   "b:3.0"},ExpressionUUID->"34f932f7-d325-404d-84d0-1ec5a01785fb"]
}, Open  ]],

