Cell[CellGroupData[{

Cell["SkewSymmetric", "Subsubsection",
 CellTags->{
  "i:181", "SkewSymmetric", "b:3.18", 
   "c:204"},ExpressionUUID->"1fb92842-b6bf-4764-be32-83b3d3f3c6a5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SkewSymmetric", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"1029a1eb-4ef0-4145-afee-88b5cc04ad6f"],
 " introduces an automatical sorting of arguments of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "c13639bc-73da-469a-bf93-bf11fb1c8c59"],
 " using super-skew-symmetry\n\n  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "y", ",", "x", ",", ".."}], "]"}], " ", "=", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"P", "[", "x", "]"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"P", "[", "y", "]"}]}], ")"}]}]], " ", 
      RowBox[{"f", "[", 
       RowBox[{"..", ",", "x", ",", "y", ",", ".."}], "]"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"1d933824-a9a0-4ed1-bd22-19f3fd16374d"],
 "."
}], "Text",
 CellTags->{
  "SkewSymmetric", 
   "b:3.18"},ExpressionUUID->"381d157c-5edf-488c-8fd1-a850b2bbef66"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SkewSymmetricQ", "Subsubsection",
 CellTags->{
  "i:182", "SkewSymmetricQ", "b:3.18", 
   "c:205"},ExpressionUUID->"99c6277d-ce45-4e03-92d1-c8ca079b4a4d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SkewSymmetricQ", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"a90ce904-7eee-4d46-806f-0c87eb48ed3d"],
 " returns ",
 StyleBox["True", "Program"],
 " if ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "2cf519e5-fe2b-41d1-add9-9949a3329114"],
 " was declared skew-symmetric."
}], "Text",
 CellTags->{
  "SkewSymmetricQ", 
   "b:3.18"},ExpressionUUID->"66f4e3a9-6ae5-4a14-8dc4-e67c6e76b071"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SkewSymmetricRule", "Subsubsection",
 CellTags->{
  "i:183", "SkewSymmetricRule", "b:3.18", 
   "c:206"},ExpressionUUID->"7e63927f-8567-44bd-99f2-7d6c15de1da5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SkewSymmetricRule", "Program"], "[", "f", "]"}], 
   TraditionalForm]],ExpressionUUID->"ff7af061-ad1a-4740-a3a8-18d4271ff3b8"],
 " is the replacement rule for sorting of arguments of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "9ceebcb7-df6b-4cde-991a-a7d7f0bd8e6b"],
 " using super-skew-symmetry\n\n \t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"..", ",", "y", ",", "x", ",", ".."}], "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"P", "[", "x", "]"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"P", "[", "y", "]"}]}], ")"}]}]], " ", 
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "x", ",", "y", ",", ".."}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"1bee4d13-f42a-4d8d-9fdb-23159ddf6ffb"],
 "."
}], "Text",
 CellTags->{
  "SkewSymmetricRule", 
   "b:3.18"},ExpressionUUID->"b5a4ef8b-a359-4888-8eb4-3f730bdd5412"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SkipVal", "Subsubsection",
 CellTags->{
  "i:184", "SkipVal", "b:3.18", 
   "c:207"},ExpressionUUID->"d0ff252a-b3ba-4ef6-be5f-cf72d34d9c79"],

Cell[TextData[{
 StyleBox["SkipVal", "Program"],
 " is a special value of selection function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "a77affa7-36dd-457d-a20a-a3fab882b249"],
 " used in ",
 ButtonBox["SplitSum",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["SplitList",
  BaseStyle->"AddOnsLink"],
 ". If, for a term ",
 StyleBox["m",
  FontSlant->"Italic"],
 " of the splitting expression, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", "m", "]"}], "\[Equal]", 
    StyleBox["SkipVal", "Program"]}], TraditionalForm]],ExpressionUUID->
  "89eb2bd8-2ebb-4206-9e26-8e37e64acd2b"],
 ", then ",
 StyleBox["m",
  FontSlant->"Italic"],
 " is omitted."
}], "Text",
 CellChangeTimes->{{3.4215065562791247`*^9, 3.421506559093171*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "SkipVal", "b:3.18"},ExpressionUUID->"2265866e-a9d4-4d9a-81bb-2c2266828e91"]
}, Open  ]],

Cell[CellGroupData[{

Cell["slAlgebra", "Subsubsection",
 CellTags->{
  "i:185", "slAlgebra", "b:3.18", 
   "c:208"},ExpressionUUID->"43c0d00c-546b-4b14-a8fe-d116496b9ed3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["slAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", "V"}], "]"}], TraditionalForm]],
  ExpressionUUID->"72894c93-adb7-46e8-b005-d971ddc87123"],
 "  defines the Lie  (super)algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "=", 
    RowBox[{"\[GothicS]\[GothicL]", "(", "V", ")"}], " "}], TraditionalForm]],
  ExpressionUUID->"19b702f6-72c7-45bc-9a2a-5ccb27d4a116"],
 "of traceless matrices on the space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "0677102c-faba-465e-bffc-76e07edbe9c4"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["slAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{
      StyleBox["Dim", "Name"], "\[Rule]", "n"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"ea81bb08-beed-406a-87ad-7f00b391dcf7"],
 " defines the algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "=", 
    RowBox[{"\[GothicS]\[GothicL]", "(", "n", ")"}]}], TraditionalForm]],
  ExpressionUUID->"e3e3918d-edec-40be-8981-af1871fc55e5"],
 " of traceless ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "*", "n"}], TraditionalForm]],ExpressionUUID->
  "1f51a0d6-3532-4485-9dad-e0b15555276b"],
 " matrices. The dimension may be a number, expression, or a list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["n", "1"], ",", 
     SubscriptBox["n", "2"], ",", "..."}], "}"}], TraditionalForm]],
  ExpressionUUID->"67263628-722c-4b5e-9fbb-f34a1ecf9c28"],
 ", as for ",
 ButtonBox["VectorSpace",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "slAlgebra", 
   "b:3.18"},ExpressionUUID->"ccb15918-6e41-4c82-a0e7-6d468183b2cf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SpacePlus", "Subsubsection",
 CellTags->{
  "i:186", "SpacePlus", "b:3.18", 
   "c:209"},ExpressionUUID->"4601145c-569c-4b81-9064-b122c48fe9fc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SpacePlus", "Program"], "[", 
    RowBox[{"W", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["V", "1"], ",", 
       RowBox[{"...", 
        SubscriptBox["V", "n"]}]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"41b463ec-9ce8-4cb9-b9c0-b054a4e741cf"],
 " defines the space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"W", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["V", "1"], "\[CirclePlus]"}], "..."}], "\[CirclePlus]", 
     SubscriptBox["V", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "51006fc6-686d-4bcb-a746-40052d6f6b86"],
 " as the direct sum of the terms."
}], "Text",
