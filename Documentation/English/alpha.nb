}, Open  ]],

Cell[CellGroupData[{

Cell["CoRight", "Subsubsection",
 CellTags->{
  "i:37", "CoRight", "b:3.2", 
   "c:39"},ExpressionUUID->"ae5aec28-36c4-408f-a0c4-3d8f4c12ea87"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CoRight", "Program"], "[", "\[GothicM]", "]"}], 
   TraditionalForm]],ExpressionUUID->"3dd5898a-59af-46cd-b997-8928cc442247"],
 " returns the name of the space of right even linear forms on \[GothicM], or \
",
 StyleBox["None", "Name"],
 " if this space was not defined.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CoRight", "Program"], "[", 
    RowBox[{"\[GothicM]", "\[Rule]", "\[GothicR]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"9efa1e72-aa1c-49ab-86fe-dbebb1f43da8"],
 " builds the module \[GothicR] on the space of right even linear forms on \
\[GothicM]. The function is implemented only for finite-dimensional modules \
with one-indexed basis.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CoRight", "Program"], 
    StyleBox["\[Rule]", "Program"], "\[GothicR]"}], TraditionalForm]],
  ExpressionUUID->"54f3b06c-5f87-4cb9-a0da-f67c31d949db"],
