Cell[CellGroupData[{

Cell["ReGrade", "Subsubsection",
 CellTags->{
  "i:169", "ReGrade", "b:3.17", 
   "c:190"},ExpressionUUID->"babe5a07-f4bd-429f-9f8e-320d21855018"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ReGrade", "Program"], "[", 
    RowBox[{"V", ",", " ", 
     StyleBox["grading",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "d2a2e193-97c9-49cc-9082-5e016687384b"],
 StyleBox[" ",
  FontFamily->"Courier"],
 "changes the grading on the space ",
 StyleBox["V",
  FontSlant->"Italic"],
 " and all known relatives of ",
 StyleBox["V",
  FontSlant->"Italic"],
 ".",
 StyleBox["\n",
  FontFamily->"Courier"],
 "The parameter ",
 StyleBox["grading",
  FontSlant->"Italic"],
 " may be either a list of new degrees of the elements of the basis (or of \
the generators only if the algebra or the module ",
 StyleBox["V",
  FontSlant->"Italic"],
 " is built using generators), or the name (a symbol or a number) of a \
particular grading predefined by the space constructor of ",
 StyleBox["V",
  FontSlant->"Italic"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.4215062454021053`*^9, 3.421506300591464*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ReGrade", "b:3.17"},ExpressionUUID->"243fde5a-00a7-4d54-82ba-9a1202db7aad"]
}, Open  ]],

