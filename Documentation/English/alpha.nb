}, Open  ]],

Cell[CellGroupData[{

Cell["KerSpace", "Subsubsection",
 CellTags->{
  "i:103", "KerSpace", "b:3.10", 
   "c:117"},ExpressionUUID->"085570b8-25de-454e-b839-bb6884a79f25"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["KerSpace", "Program"], "[", 
    RowBox[{"U", ",", " ", "V", ",", " ", "f"}], "]"}], TraditionalForm]],
  ExpressionUUID->"eecdbf43-dc6a-4d8f-bbe1-ef098d92f84f"],
 " calculates the kernel subspace ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", "\[Element]", "V"}], "\[VerticalSeparator]", 
      RowBox[{
       RowBox[{"f", "(", "v", ")"}], "\[Equal]", "0"}]}], "}"}]}], 
   TraditionalForm]],ExpressionUUID->"e9a3ca61-2f81-4c78-9770-29f4550b6535"],
 ". Here  ",
 StyleBox["f",
  FontSlant->"Italic"],
 " is a linear function or a list of linear functions on ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "810c29e3-6a20-49ba-9aa2-2b84af0ec38e"],
 ". "
}], "Text",
 CellTags->{
  "KerSpace", 
   "b:3.10"},ExpressionUUID->"d411e71a-ada8-4918-bf67-22a659e81548"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["L", "Subsection",
 CellTags->{
  "b:3.11", "c:118"},ExpressionUUID->"e8e01d9c-ce2b-459f-98f6-ad7f48ebe353"],

Cell[CellGroupData[{

Cell["Lb, lb", "Subsubsection",
 CellTags->{
  "i:104", "Lb", "lb", "b:3.11", 
   "c:119"},ExpressionUUID->"81253138-bca8-422a-839a-acb0087c5fa3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Lb", "Program"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "90a40cae-730b-4c52-99b3-998f16a7d018"],
 " is the Lie bracket (the bracket in the Lie (super)algebra of vector \
fields)."
}], "Text",
 CellTags->{
  "Lb", "lb", 
   "b:3.11"},ExpressionUUID->"659226e3-7c76-48e2-90f2-eb956f1eec59"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["lb", "Program"], "[", 
    RowBox[{"x", ",", "y"}], "]"}], TraditionalForm]],ExpressionUUID->
  "982fc43c-1423-4793-979f-e4b7af6d2400"],
 " represents the Lie bracket (the operator in the Lie (super)algebra of \
vector fields) in the unevaluated form."
}], "Text",
 CellChangeTimes->{3.421504461897552*^9},
 CellTags->{
  "lb", "Lb", 
   "b:3.11"},ExpressionUUID->"d3cdba5d-dbc3-4873-b5aa-dfb51077d982"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LDer", "Subsubsection",
 CellTags->{
  "i:106", "LDer", "b:3.11", 
   "c:120"},ExpressionUUID->"4fe15f07-65b1-415c-8d05-41ea028825c2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LDer", "Program"], "[", 
    RowBox[{"e", ",", "x", ",", " ", 
     StyleBox["ptrn",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "37d6c606-6158-404c-9446-16d68a5b02d1"],
 " calculates the left partial derivative of expression ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "d4395e34-bc19-4a3a-9cd9-af4c2db28623"],
 " with respect to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "."}], TraditionalForm]],ExpressionUUID->
  "25e4c042-b9f8-44e3-908a-5ffc93ec1771"],
 " The pattern ",
 StyleBox["ptrn",
  FontSlant->"Italic"],
 " should match all independent and none of the dependent variables."
}], "Text",
 CellTags->{
  "LDer", "b:3.11"},ExpressionUUID->"02467ccf-55ab-481f-a20f-3c9a051fe33c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Leibniz", "Subsubsection",
 CellTags->{
  "i:107", "Leibniz", "b:3.11", 
   "c:121"},ExpressionUUID->"88bee064-07fc-46ba-9168-40ed52de070f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Leibniz", "Program"], "[", 
    RowBox[{"f", "\[Rule]", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "18538c40-5235-43d6-8ba8-611edd81feb2"],
 " introduces the property (",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "d57fc1f9-c246-4919-a8d8-e3c432f79ff9"],
 " acts on ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "209a7ea5-1d75-4827-a000-7eaf93263c29"],
 " as a derivation of parity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "Program",
     FontSlant->"Plain"], "[", "f", "]"}], TraditionalForm]],ExpressionUUID->
  "63599638-aaef-47db-8df2-98ca22d1f80a"],
 "): \n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "@", 
     RowBox[{"g", "[", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "2"], ",", "..."}], "]"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{
         RowBox[{"f", "@", 
          SubscriptBox["x", "1"]}], ",", 
         SubscriptBox["x", "2"], ",", "..."}], "]"}], " ", "\[PlusMinus]", 
       " ", 
       RowBox[{"g", "[", 
        RowBox[{
         SubscriptBox["x", "1"], ",", 
         RowBox[{"f", "@", 
          SubscriptBox["x", "2"]}], ",", "..."}], "]"}]}], " ", 
      "\[PlusMinus]"}], " ", "..."}]}], TraditionalForm]],ExpressionUUID->
  "c2a97f93-0caa-4cd5-acc0-1b4721937e15"],
 " . \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Leibniz", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "..."}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"8833c1e4-3398-4186-aeba-48b146d0a000"],
 " introduces this property for every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "0fe743bc-3e7a-4385-af0b-be4f19b88112"],
 "."
}], "Text",
 CellTags->{
  "Leibniz", "b:3.11"},ExpressionUUID->"c96ca23a-7f3e-4c2a-9090-c8f1b1b9f46d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LeibnizRule", "Subsubsection",
 CellTags->{
  "i:108", "LeibnizRule", "b:3.11", 
   "c:122"},ExpressionUUID->"da4719ad-2d38-44fc-a8b2-30c6dfed109e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LeibnizRule", "Program"], "[", 
    RowBox[{"f", ",", " ", "g"}], "]"}], TraditionalForm]],ExpressionUUID->
  "9b7b963f-99d1-451c-a883-ba8f3312f40c"],
 " returns the rule to expand  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{"g", "[", 
     RowBox[{
      SubscriptBox["x", "1"], ",", "..."}], "]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"7fd40975-2796-4d05-b0c9-daa30272c7bd"],
 " into the sum of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", " ", 
    RowBox[{"g", "[", 
     RowBox[{"...", ",", " ", 
      RowBox[{"f", "[", 
       SubscriptBox["x", "i"], "]"}], " ", ",", "..."}], "]"}]}], 
   TraditionalForm]],ExpressionUUID->"e779badf-ae29-465f-a420-22ed5ba96735"],
 " (so ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "9465be95-f31e-45e0-83cc-d633b58b0f7e"],
 " acts like the derivative of parity  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["P", "Program",
     FontSlant->"Plain"], "[", "f", "]"}], TraditionalForm]],ExpressionUUID->
  "a103883b-3f1e-4a60-917d-c9e7d05196e0"],
 ").\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LeibnizRule", "Program"], "[", 
    RowBox[{"f", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"7aaa06f4-48da-45a0-bd99-2ea96531be90"],
 " returns the list of rules for the functions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "1"], TraditionalForm]],ExpressionUUID->
  "2163cf84-f7a3-4535-b29f-1629e3b7e218"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "k"], TraditionalForm]],ExpressionUUID->
  "49c8d65b-75e6-45b4-9754-7d302fecb854"],
 "."
}], "Text",
 CellChangeTimes->{{3.4215044764084177`*^9, 3.4215044796831264`*^9}},
 CellTags->{
  "LeibnizRule", 
   "b:3.11"},ExpressionUUID->"11722cb0-0142-44ad-bf82-bbfc2147d6ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LeitesAlgebra", "Subsubsection",
 CellChangeTimes->{{3.7618268371656322`*^9, 3.761826839334296*^9}},
 CellTags->{
  "i:25", "b:3.1", "c:25", 
   "LeitesAlgebra"},ExpressionUUID->"24c588f1-9956-4431-aac9-e66f51fcd738"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LeitesAlgebra", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"0cd35614-da05-42e1-8d6b-a5f5dd1f2281"],
 " defines a Leites algebra \[GothicG], the algebra of polynomials on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", "...", ",", 
    SubscriptBox["x", "n"], ",", 
    SubscriptBox["y", "1"], ",", "...", ",", 
    SubscriptBox["y", "n"]}], TraditionalForm]],ExpressionUUID->
  "b01c9db6-c0e6-4a31-ae1c-ec8dd55c2827"],
 " modulo constants with the standard Shouten antibracket. The spaces ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "3876d92a-9e85-4eba-9730-287492994246"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "7c98d316-1c26-46d3-84bc-d219ac15218e"],
 " should be already declared and should have the same dimension. For every \
",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "a2b956cb-d4e9-4582-95eb-111509c4f6d0"],
 ", the parities of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]],ExpressionUUID->
  "b4b3eba9-8b21-4aa9-b951-396945f03091"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "i"], TraditionalForm]],ExpressionUUID->
  "f1d1207a-3bcc-4ca5-8ff6-c4c59210ddf9"],
 " should be different."
}], "Text",
 CellChangeTimes->{{3.4214327823676834`*^9, 3.42143282289596*^9}, {
  3.7618268453166127`*^9, 3.7618269122241344`*^9}},
 CellTags->{
  "b:3.1", "LeitesAlgebra"},ExpressionUUID->"829bda85-a1c5-498d-b996-\
0d47ecd35bbd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LieAlgebra", "Subsubsection",
 CellTags->{
  "i:109", "LieAlgebra", "b:3.11", 
   "c:123"},ExpressionUUID->"624edeea-93dc-49d9-960f-66a20c04b2c9"],

Cell[TextData[{
 StyleBox["Options[LieAlgebra]", "Program"],
 " holds default options for constructors of Lie (super)algebras."
}], "Text",
 CellChangeTimes->{{3.4215044937533584`*^9, 3.421504496477275*^9}},
 CellTags->{
  "LieAlgebra", 
   "b:3.11"},ExpressionUUID->"1e8b96f7-06c7-4ae5-a1e8-a81da9f803bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Linear", "Subsubsection",
 CellTags->{
  "i:110", "Linear", "b:3.11", 
   "c:124"},ExpressionUUID->"7947a236-4b48-4f47-b2a2-e0cb18fe310a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Linear", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"fdb919ad-dda0-4528-b961-7dc2eba9d385"],
 " introduces the (multi)linearity of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "a143e07d-2ef7-4e77-8c27-8e3829d755db"],
 ". The linearity is equivalent to the union of 3 properties: ",
 ButtonBox["Additive",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["Homogen",
  BaseStyle->"AddOnsLink"],
 StyleBox["\[Rule]", "Program"],
 "1 and ",
 ButtonBox["ZeroArg",
  BaseStyle->"AddOnsLink"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Linear", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "4fcaff82-6721-4b69-be58-980f84b05b65"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Linear", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "38b8522a-ab29-49aa-a1f8-0c927a020528"],
 " introduces linearity only in the first/last argument.\nThe function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "d8f32863-4d23-4ed9-a607-74d4de50860d"],
 " should be declared vector- or scalar-valued and having all (resp. first, \
last) vector argument."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Linear", "b:3.11"},ExpressionUUID->"a118a716-a42c-40aa-8f3a-a066396cc5fb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LinearChange", "Subsubsection",
 CellTags->{
  "i:111", "LinearChange", "b:3.11", 
   "c:125"},ExpressionUUID->"e2ff4e4e-db87-4390-9fe8-2099f68ef9b3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearChange", "Program"], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ",", " ", 
     StyleBox["rule",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "333adb85-076e-4598-b270-b8aea7c0b1fa"],
 " applies the ",
 StyleBox["rule",
  FontSlant->"Italic"],
 " (that may be also a list of rules) to the linear components of ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " in an attempt to transform the expression."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "LinearChange", 
   "b:3.11"},ExpressionUUID->"95d10f58-539f-4ea4-bc19-58b3bf4b5ca1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LinearCollectRule", "Subsubsection",
 CellTags->{
  "i:112", "LinearCollectRule", "b:3.11", 
   "c:126"},ExpressionUUID->"b5fcde0d-ab61-400a-8e45-a0f7aeed3cd1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearCollectRule", "Program"], "[", "f", "]"}], 
   TraditionalForm]],ExpressionUUID->"2d138607-b9f0-4fdd-a7d1-806f85139e73"],
 " returns the list of rules that may be used to collect together the term in \
the sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["y", "1"], ",", ".."}], "]"}], " ", "+", " ", 
     RowBox[{"f", "[", 
      RowBox[{
       SubscriptBox["x", "2"], ",", 
       SubscriptBox["y", "2"], ",", ".."}], "]"}], "+"}], "..."}], 
   TraditionalForm]],ExpressionUUID->"1a841053-7a48-4d16-81eb-851715b7eae3"],
 " which differ in one argument only. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearCollectRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "62907d59-9e4f-4794-a743-f1dbbd4a7632"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearCollectRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "2bf3c05a-4875-45b2-964f-26df1c128e3d"],
 " return the rules for linear collecting in the first or last argument of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "4f8573aa-7d02-4098-826e-3b7e65bc456c"],
 ".\nThe function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "b2eacea0-9db9-4fae-91f5-394649f8b5f8"],
 " should be declared vector- or scalar-valued and having all (resp. first, \
last) vector argument. Though the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "d287c71e-11a9-42ff-a9b4-b756b11695da"],
 " is (mathematically) linear, it should not be declared linear, homogeneous \
or additive."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "LinearCollectRule", 
   "b:3.11"},ExpressionUUID->"f53b4521-c1ab-4709-8f49-cc8f5e068a6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LinearRule", "Subsubsection",
 CellTags->{
  "i:113", "LinearRule", "b:3.11", 
   "c:127"},ExpressionUUID->"5620e7b8-5308-4f4b-9335-400b9da3eaf3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearRule", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"0659fa68-e2e6-418f-8a6b-6573c4dd112e"],
 " returns the list of rules for (multi)linear expansion of expressions \
containing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", "...", "]"}], TraditionalForm]],ExpressionUUID->
  "6f323aa6-9148-4e06-8884-a43ea375ac2e"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["First", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "556cefba-9501-4550-b06f-96cd6bbb688d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LinearRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["Last", "Program"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "00d0a48a-17f6-495e-ab81-962a09b216ba"],
 " return the rules for linear expansion in the first/last argument of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "1a490c6e-b02b-46c0-bdda-ab9ad0a72469"],
 " only.\nThe function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "3936d02c-0765-473a-8a75-03b2b811c569"],
 " should be declared vector- or scalar-valued and having all (resp. first, \
last) vector argument. It should not be declared linear."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "LinearRule", 
   "b:3.11"},ExpressionUUID->"08371845-9e69-4f21-acfa-e90f21156689"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LogPower", "Subsubsection",
 CellTags->{
  "i:114", "LogPower", "b:3.11", 
   "c:128"},ExpressionUUID->"47b554f6-eb1e-48cc-9012-9fe58afb66df"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LogPower", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"24c69c53-d316-426b-9d8b-812919283c00"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     SuperscriptBox["x", "r"], "]"}], "=", 
    RowBox[{"r", "*", 
     RowBox[{"f", "[", "x", "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "ca09da1d-ed93-4976-95f5-31def28329c3"],
 ". The function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "020f5349-7b16-410f-8cfa-851a952f51f5"],
 " should be declared  vector- or scalar-valued.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LogPower", "Program"], "[", 
    RowBox[{"f", "\[Rule]", 
     StyleBox["op",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1e180f75-7d86-42b4-9b1f-773438106c1a"],
 " introduces the property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     SuperscriptBox["x", "r"], "]"}], "=", 
    RowBox[{
     StyleBox["op",
      FontSlant->"Italic"], "[", 
     RowBox[{"r", ",", 
      RowBox[{"f", "[", "x", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"7b589b12-02ae-457f-bc6f-8a13a3e46c68"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "LogPower", 
   "b:3.11"},ExpressionUUID->"ac366c4b-0308-40c8-bc56-ba43cf256d70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["LogPowerPule", "Subsubsection",
 CellTags->{
  "i:115", "LogPowerPule", "b:3.11", 
   "c:129"},ExpressionUUID->"0f0feb9d-9493-4041-b083-4a871f529ce4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["LogPowerRule", "Program"], "[", "f", "]"}], TraditionalForm]],
