 ". The ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "2314961d-cddf-4019-af38-9876979a27c3"],
 " may be also a list of components, as in ",
 ButtonBox["PoissonAlgebra",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
