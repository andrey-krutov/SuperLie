Cell[CellGroupData[{

Cell["DecompositionList", "Subsubsection",
 CellTags->{
  "i:41", "DecompositionList", "b:3.3", 
   "c:42"},ExpressionUUID->"623573e7-0e1b-467a-9350-08fbcf2900d8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["DecompositionList", "Program"], "[", "g", ",", "f", "]"}], 
   TraditionalForm]],ExpressionUUID->"0d6a5353-0d2a-47f1-9dca-8339aa1d434b"],
 " returns the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["g", "1"], ",", "..."}], " ", "}"}], TraditionalForm]],
  ExpressionUUID->"ceebbac3-f598-4609-a836-4d29100384f1"],
 " of subalgebras in the decomposition ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "d7345993-d9ce-4592-92b9-734adddf917b"],
 " of the subalgebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["g", "1"], "\[CirclePlus]"}], "..."}], "\[Subset]", "g"}], 
   TraditionalForm]],ExpressionUUID->"2ec48bb3-afcc-45c5-a1e7-06e3e1a3cae6"],
 ". The bracket operation is defined for any pair of elements in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["g", "1"], "\[CirclePlus]"}], "..."}], TraditionalForm]],
  ExpressionUUID->"5a3ad862-737b-4867-a0af-d3d3d00b3686"],
 " ."
}], "Text",
