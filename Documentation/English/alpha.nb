Cell[CellGroupData[{

Cell["VIf", "Subsubsection",
 CellTags->{
  "i:256", "VIf", "b:3.21", 
   "c:287"},ExpressionUUID->"39e49d45-d288-42c6-83fb-e20ed751286d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VIf", "Program"], "[", 
    RowBox[{
     StyleBox["cond",
      FontSlant->"Italic"], ",", " ", "v"}], "]"}], TraditionalForm]],
  ExpressionUUID->"20d9e4f9-5a3e-4513-afb3-7b894bac9b31"],
 " is a vector-valued version of the ",
 StyleBox["If", "Program"],
 " function. It is evaluated to ",
 StyleBox["v", "Var"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cond", "Var"], "\[Equal]", 
    StyleBox["True", "Name"]}], TraditionalForm]],ExpressionUUID->
  "a0e5f973-8852-47aa-8205-81286a4402b9"],
 " and to 0 if  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["cond", "Var"], "\[Equal]", 
    StyleBox["False", "Name"]}], TraditionalForm]],ExpressionUUID->
  "466301f3-26f0-4539-9301-ee940ca7456a"],
 ". A number of rules of symbolic evaluation works with unresolved ",
 StyleBox["VIf", "Name"],
 "[...]. "
}], "Text",
 CellTags->{
  "VIf", "b:3.21"},ExpressionUUID->"80fc77b3-7f92-49a9-be7e-4d5713e502cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VNormal", "Subsubsection",
 CellTags->{
  "i:257", "VNormal", "b:3.21", 
   "c:288"},ExpressionUUID->"d89fe9ad-b7c8-4947-b46f-fdd844618930"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VNormal", "Program"], "[", 
    StyleBox["expr",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "fea9395f-eae6-40e3-ae1a-90be3cb7b5bf"],
 " tries to convert a vector expression to the standard (normal) form. \nIt \
expands out all ",
 ButtonBox["VTimes",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["SVTimes",
  BaseStyle->"AddOnsLink"],
 "  products in ",
 StyleBox["expr, ",
  FontSlant->"Italic"],
 "collects together terms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "i"], "*", "v"}], TraditionalForm]],ExpressionUUID->
  "f6adbf7f-639f-4ab4-9389-b8361fd54607"],
 " with the same ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "1b990d56-b873-4773-a834-359c7be3e7bc"],
 ", converts the scalar coefficients to the standard form. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VNormal", "b:3.21"},ExpressionUUID->"f2b74395-7f4a-45a5-a7ab-82e364380041"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VOrder", "Subsubsection",
 CellTags->{
  "i:258", "VOrder", "b:3.21", 
   "c:289"},ExpressionUUID->"6ba814b2-dcc0-4c29-ae3b-0785807e5e2b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VOrder", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "c49f54a2-eafb-440c-a5bd-7f769115ce41"],
 " returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", ",", 
    RowBox[{"+", "1"}], ",", 
    RowBox[{"-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "22a94ede-2f40-49c0-802d-d8c021d1f08f"],
 " depending on the order of vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "1"], TraditionalForm]],ExpressionUUID->
  "ad15053e-b4c9-4ed7-ae7a-7f123fa0742c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "2"], TraditionalForm]],ExpressionUUID->
  "48649a59-c12d-4874-a3af-27c8458f1f63"],
 ". The scalar coefficients are ignored. See also the ",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s function ",
 ButtonBox["Order",
  BaseStyle->"RefGuideLink"],
 ". "
}], "Text",
 CellChangeTimes->{{3.421508696216203*^9, 3.421508717286501*^9}},
 CellTags->{
  "VOrder", "b:3.21"},ExpressionUUID->"520bce8e-68fa-4674-9a0f-817f6d1f3d6b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VOrderQ", "Subsubsection",
 CellTags->{
  "i:259", "VOrderQ", "b:3.21", 
   "c:290"},ExpressionUUID->"5b2310cc-12e5-4323-bc5a-9beb391f3057"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VOrderQ", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "0b4bf6b3-a1b9-4364-829b-e5b0ca5b5661"],
 " returns ",
 StyleBox["True", "Program"],
 " or ",
 StyleBox["False", "Program"],
 " depending on the order of vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "1"], TraditionalForm]],ExpressionUUID->
  "505e0e9d-81ff-4d3c-a302-070a05e71cee"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "2"], TraditionalForm]],ExpressionUUID->
  "8f47e830-26d3-4611-91a5-948d5423c6b4"],
 ". The scalar coefficients are ignored. See also the ",
 StyleBox["Mathematica'",
  FontSlant->"Italic"],
 "s function ",
 ButtonBox["OrderedQ",
  BaseStyle->"RefGuideLink"],
 ". "
}], "Text",
 CellChangeTimes->{{3.421508729904645*^9, 3.4215087356328816`*^9}},
 CellTags->{
  "VOrderQ", "b:3.21"},ExpressionUUID->"2f96d837-99f2-487b-8547-31f9153afca6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VPlus", "Subsubsection",
 CellTags->{
  "i:260", "VPlus", "b:3.21", 
   "c:291"},ExpressionUUID->"ded9aa82-6a4c-4a3d-ad55-417a03931f22"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VPlus", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"4dcd0d77-cf90-48e6-b66c-7a5bc3b61c4b"],
 " is the vector sum of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", " ", 
    SubscriptBox["v", "2"], ",", "..."}], TraditionalForm]],ExpressionUUID->
  "bbb19420-c7ea-4c08-a308-f9196117f3f8"],
 " . The expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["v", "1"], "+", 
     SubscriptBox["v", "2"], "+"}], "..."}], TraditionalForm]],ExpressionUUID->
  "8e159c8f-c5e2-41b4-819c-5f1bf9093635"],
 " typed in the notebook is converted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VPlus", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"ba179c96-2fbb-4f71-b1e6-e0d82030fadd"],
 " if all terms are vectors. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VPlus", "b:3.21"},ExpressionUUID->"4106a41d-ed0d-4f56-a88c-3795b4f7a1a9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VPower", "Subsubsection",
 CellTags->{
  "i:261", "VPower", "b:3.21", 
   "c:292"},ExpressionUUID->"78df1e77-6a2e-4014-9be8-53f0eb67048e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VPower", "Program"], "[", 
    RowBox[{"v", ",", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "8eee9ea5-60f7-4f44-b031-9ecbada992c3"],
 " is the n-th symmetric power of the vector ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "48dd85e7-7c68-4b86-b267-569e3ff05fd5"],
 ".  The expressions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "^", "n"}], TraditionalForm]],ExpressionUUID->
  "875a1e3d-3015-4a09-9720-2c00bb11d220"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "n"], TraditionalForm]],ExpressionUUID->
  "0fa4b1e4-d77e-42ad-be1c-f2635a2946ea"],
 " typed in the notebook are converted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VPower", "Program"], "[", 
    RowBox[{"v", ",", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "761b71ae-f3b3-4326-9351-4e8e1c13baa4"],
 " if ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "f57836e8-eb8f-42b5-a269-a3133e8c1b36"],
 " is a vector. "
}], "Text",
 CellChangeTimes->{{3.4215088382704673`*^9, 3.421508852841419*^9}},
 CellTags->{
  "VPower", "b:3.21"},ExpressionUUID->"52880bac-848c-4626-9925-aaf9f23c896b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VSameQ", "Subsubsection",
 CellTags->{
  "i:262", "VSameQ", "b:3.21", 
   "c:293"},ExpressionUUID->"5fef989d-03a7-46d2-84df-bd579dff1bdb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VSameQ", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "b33a9a3b-43c8-459e-8e8b-a70748884279"],
 " returns ",
 StyleBox["True", "Program"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], "=", 
    RowBox[{
     SubscriptBox["c", "1"], "*", "v"}]}], TraditionalForm]],ExpressionUUID->
  "73caecfe-c6fd-4f87-b940-31237aa8c813"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "2"], "=", 
    RowBox[{
     SubscriptBox["c", "2"], "*", "v"}]}], TraditionalForm]],ExpressionUUID->
  "7640f6bf-2d42-4058-8242-59077c8bad6e"],
 " with same ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "35a6d617-087d-459d-88fa-06da2952c6a2"],
 " and scalars ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "1"], TraditionalForm]],ExpressionUUID->
  "cb24e813-5292-4285-81e9-2ad5ac7624b9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "2"], TraditionalForm]],ExpressionUUID->
  "b80806ea-d759-440a-90ed-556bc4cfcb39"],
 " and ",
 StyleBox["False", "Program"],
 " otherwise. "
}], "Text",
 CellTags->{
  "VSameQ", "b:3.21"},ExpressionUUID->"175d9065-c72a-4295-982c-f4fd13f78081"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VSolve", "Subsubsection",
 CellTags->{
  "i:263", "VSolve", "b:3.21", 
   "c:294"},ExpressionUUID->"8d4ae9bb-0e9f-4c82-bbfe-1c4f79527f69"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VSolve", "Program"], "[", 
    RowBox[{
     StyleBox["eqns",
      FontSlant->"Italic"], ",", 
     StyleBox["vars",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["...",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "fc7c5fd0-ce1a-4829-b6ff-aa55dec03388"],
 " attempts to solve an equation or set of equations for the vector variables \
",
 StyleBox["vars",
  FontSlant->"Italic"],
 ". For other parameters and options, see ",
 ButtonBox["Solve",
  BaseStyle->"RefGuideLink"],
 ". \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VSolve", "Program"], "[", 
    StyleBox["eqns",
     FontSlant->"Italic"], "]"}], TraditionalForm]],ExpressionUUID->
  "fd56bcbe-c995-4cc3-b3ea-fb48105e4477"],
 " treats all vector variables encountered as ",
 StyleBox["vars",
  FontSlant->"Italic"],
 " above. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VSolve", "b:3.21"},ExpressionUUID->"24d9b80e-b51c-426d-8209-724d7aaf87e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VSort", "Subsubsection",
 CellTags->{
  "i:264", "VSort", "b:3.21", 
   "c:295"},ExpressionUUID->"86a4fdc9-2fcc-43b1-a9b9-dbc2dc055727"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VSort", "Program"], "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["v", "1"], "+"}], "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"c2710897-2404-41ec-af31-a73c0b637acf"],
 " sorts the terms in the vector sum in the alphabetical order. The scalar \
coefficients are irrelevant for sorting. "
}], "Text",
 CellTags->{
  "VSort", "b:3.21"},ExpressionUUID->"620e445d-e26e-4896-92f3-4d2ff6f5dd61"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VSum", "Subsubsection",
 CellTags->{
  "i:265", "VSum", "b:3.21", 
   "c:296"},ExpressionUUID->"a77f099f-87e4-4374-acc1-5a6c27e1844c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VSum", "Program"], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ",", 
     StyleBox["iter",
      FontSlant->"Italic"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"8052fedd-8d01-4ffd-b5de-0bd66f3f8aba"],
 " is the vector-valued version of the ",
 ButtonBox["Sum",
  BaseStyle->"Link",
  ButtonData:>"paclet:ref/Sum"],
 " function. A number of rules of symbolic evaluation works with unresolved \
",
 StyleBox["VSum", "Program"],
 "[...]. \nFor both ",
 StyleBox["Sum", "Name"],
 " and ",
 StyleBox["VSum", "Name"],
 ", an alternative iterator  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", 
     RowBox[{
      StyleBox["from",
       FontSlant->"Italic"], "\[Rule]", 
      StyleBox["to",
       FontSlant->"Italic"]}]}], "}"}], TraditionalForm]],ExpressionUUID->
  "ec6bf021-2ae3-492b-ade4-2d4ecfae9564"],
 " is defined. If the difference ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diff",
     FontSlant->"Italic"], "=", 
    RowBox[{
     StyleBox["to",
      FontSlant->"Italic"], "-", 
     StyleBox["from",
      FontSlant->"Italic"]}]}], TraditionalForm]],ExpressionUUID->
  "3dc439ba-9c61-40eb-abad-4ad174a42756"],
 " is a number, this iterator is replaced by \n\t(a) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", 
     StyleBox["from",
      FontSlant->"Italic"], ",", 
     RowBox[{
      StyleBox["to",
       FontSlant->"Italic"], "-", "1"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"2b9ef52b-4c0d-49c6-b435-7fdc2374320a"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diff",
     FontSlant->"Italic"], ">", "0"}], TraditionalForm]],ExpressionUUID->
  "4758e316-3e67-4fd4-88f0-f7cbc8a8c198"],
 "; \n\t(b) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"i", ",", 
     StyleBox["to",
      FontSlant->"Italic"], ",", 
     RowBox[{
      StyleBox["from",
       FontSlant->"Italic"], "-", "1"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"6e49d87c-7d49-4182-a3d2-a1fba77e37c4"],
 " and the whole sum is multiplied by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]],ExpressionUUID->
  "29927912-e0d6-4834-80af-a0b6bf633c88"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diff",
     FontSlant->"Italic"], "<", "0"}], TraditionalForm]],ExpressionUUID->
  "348091f8-386c-4ae1-85cf-107b6da45841"],
 ". \n\t(c) the whole sum is replaced by ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "a8774cbe-8fe5-4c1a-a796-70f9b13ab7af"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diff",
     FontSlant->"Italic"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "30ad4191-4b37-4c43-b6ee-101c39467069"],
 "; "
}], "Text",
 CellChangeTimes->{{3.421508874392408*^9, 3.4215088816628623`*^9}, {
  3.623314768357065*^9, 3.623314777165078*^9}},
 CellTags->{
  "VSum", "b:3.21"},ExpressionUUID->"00205c38-3849-4046-891e-8a696060624f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VTimes", "Subsubsection",
 CellTags->{
  "i:266", "VTimes", "b:3.21", 
   "c:297"},ExpressionUUID->"e6894fbc-ff79-49c6-a72c-6b6bc4248cec"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VTimes", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"1a42869f-14ef-4fff-84e9-7f037e294cb6"],
 " is the product of vectors of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "1"], ",", " ", 
    SubscriptBox["v", "2"], ",", "..."}], TraditionalForm]],ExpressionUUID->
  "f34d3638-b97d-4b5d-b2d0-80f60479b2b1"],
 " . The vector product may have various meanings. It may be used for any \
associative operation. The expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["v", "1"], 
     SubscriptBox["v", "2."]}], ".."}], TraditionalForm]],ExpressionUUID->
  "3b0e4de6-c7bc-4e07-b049-4d06971f06ba"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["v", "1"], "*", 
     SubscriptBox["v", "2"], "*"}], "..."}], TraditionalForm]],ExpressionUUID->
  "186e447c-6f19-4870-8de2-e2e8a5088b99"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["v", "1"], "\[Times]", 
     SubscriptBox["v", "2"], "\[Times]"}], "..."}], TraditionalForm]],
  ExpressionUUID->"718d6fe1-f263-4909-bb21-b00130913a65"],
 " typed in the notebook is converted to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["VTimes", "Program"], "[", 
    RowBox[{
     SubscriptBox["v", "1"], ",", 
     SubscriptBox["v", "2"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"ffff1022-15c9-4b07-8401-48d13ba3856a"],
 " if all factors are vectors. \nThe vector product is non-symmetric by \
default, i.e., the terms are not sorted automatically. Use ",
 ButtonBox["Symmetric",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["UnSymmetric",
  BaseStyle->"AddOnsLink"],
 " to set and cancel the (super)symmetric sorting of terms. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "VTimes", "b:3.21"},ExpressionUUID->"1b8cb82f-bd3c-4a8c-9471-ac33ee4a6b8e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["W", "Subsection",
 CellTags->{
  "b:3.22", "c:298"},ExpressionUUID->"2f9efbd3-9bd5-48e6-8046-c51a69c09055"],

Cell[CellGroupData[{

Cell["Wedge, wedge, wPower", "Subsubsection",
 CellChangeTimes->{{3.5828181373746376`*^9, 3.5828181488433876`*^9}},
 CellTags->{
  "i:267", "Wedge", "wedge", "wPower", "b:3.22", 
   "c:299"},ExpressionUUID->"4dc5564e-6660-44f3-9f76-2df40673826c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["Wedge", "Program"], "[", 
     RowBox[{
      SubscriptBox["v", "1"], ",", 
      SubscriptBox["v", "2"], ",", "..."}], "]"}], " "}], TraditionalForm]],
  ExpressionUUID->"71a63437-1b1e-4861-9abf-16aee760cfd9"],
 "or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["v", "1"], "\[Wedge]", 
     SubscriptBox["v", "2"], "\[Wedge]"}], "..."}], TraditionalForm]],
  ExpressionUUID->"f52cf123-1866-4dd4-8e28-22c351f28e74"],
 " is the exterior multiplication (the operation in the exterior algebra). \
The operation is associative. The evaluation rules of ",
 StyleBox["Wedge", "Program"],
 " are ",
 ButtonBox["Linear",
  BaseStyle->"AddOnsLink"],
 ", ",
 ButtonBox["Symmetric",
  BaseStyle->"AddOnsLink"],
 " and ",
 ButtonBox["IdArg",
  BaseStyle->"AddOnsLink"],
 ".\nThe user may redefine the symmetry of ",
 StyleBox["Wedge", "Program"],
 " to ",
 ButtonBox["SkewSymmetric",
  BaseStyle->"AddOnsLink"],
 ".\nAfter sorting the operands, ",
 StyleBox["Wedge", "Program"],
 " is replaced by ",
 StyleBox["wedge", "Program"],
 ". "
}], "Text",
 CellChangeTimes->{{3.4215089175144143`*^9, 3.421508917804832*^9}, 
   3.5828184140777626`*^9},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Wedge", "wedge", "wPower", 
   "b:3.22"},ExpressionUUID->"20c036ef-e2d5-47b7-96fd-7cde27224fcd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["wedge", "Program"], "[", 
    SubscriptBox["e", "1"], ",", "...", ",", 
    SubscriptBox["e", "n"], "]"}], TraditionalForm]],ExpressionUUID->
  "4f60fd31-1635-4ba5-8f4f-f1148b20c9eb"],
 " is the internal representation of the basis of exterior algebras. The \
external representation is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["e", "1"], "\[Wedge]"}], "..."}], "\[Wedge]", 
    SubscriptBox["e", "n"]}], TraditionalForm]],ExpressionUUID->
  "c8875c1b-a71e-4300-9018-bdbfdea1b35c"],
 ". "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "wedge", "Wedge", "wPower", 
   "b:3.22"},ExpressionUUID->"e8b0c6f0-7e86-4c03-8e4f-0535e044d3aa"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["wPower", "Program"], "[", 
    RowBox[{"e", ",", "k"}], "]"}], TraditionalForm]],ExpressionUUID->
  "7928a8c2-144e-427b-85fd-d5162f503a44"],
 " is the ",
 StyleBox["k",
  FontSlant->"Italic"],
 "-th exterior power of ",
 StyleBox["e",
  FontSlant->"Italic"],
 ". The external representation is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"\[Wedge]", "k"}]], TraditionalForm]],ExpressionUUID->
  "9e8f2c04-5f4c-4d4c-b3db-e78d63d699fd"],
 ". "
}], "Text",
 CellChangeTimes->{{3.5828182721090126`*^9, 3.5828182913590126`*^9}, {
  3.5828183349996376`*^9, 3.5828183869683876`*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "wedge", "Wedge", "wPower", 
   "b:3.22"},ExpressionUUID->"7f90eded-4ed1-4997-96dd-19159aaf5994"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Weight", "Subsubsection",
 CellTags->{
  "i:269", "Weight", "b:3.22", 
   "c:300"},ExpressionUUID->"83acfeb0-6465-4921-a897-d0245e772aa1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Weight", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"b16f74bb-2988-4653-a64f-040c2de1e66f"],
 " is the weight of the vector ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "6adf11c8-ca1d-454f-ac14-6422cfa81d99"],
 ". The weight is defined for homogeneous elements only. "
}], "Text",
 CellTags->{
  "Weight", "b:3.22"},ExpressionUUID->"6f30c108-7a87-4c9c-9d53-a69f32997158"]
}, Open  ]],

Cell[CellGroupData[{

Cell["WeightMark", "Subsubsection",
 CellTags->{
  "i:270", "WeightMark", "b:3.22", 
   "c:301"},ExpressionUUID->"ca340272-c74e-4f9b-bd36-b95a0a7d9ab2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["WeightMark", "Program"], "[", 
    RowBox[{
     StyleBox["length",
      FontSlant->"Italic"], ",", " ", 
     SubscriptBox["m", "1"], ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"f89df8e8-db78-499e-bd06-d4e6cae3f9c0"],
 " returns a list of given ",
 StyleBox["length", "Var"],
 ". All elements of the result are initially set to 0. For every mark ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "i"], TraditionalForm]],ExpressionUUID->
  "492b4252-2b27-4cee-9d5b-1c7b21c9de28"],
 ", if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "i"], ">", "0"}], TraditionalForm]],ExpressionUUID->
  "5fb6cf38-492f-4baa-aca7-fed4169d573f"],
 ", then the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "i"], TraditionalForm]],ExpressionUUID->
  "85758455-3f7d-4cca-a909-7d7d4ed61784"],
 "-th element of the result is increased by 1. If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "i"], "<", "0"}], TraditionalForm]],ExpressionUUID->
  "d6d7019d-4e92-46d4-a1d8-fb559452aad6"],
 ", then the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"-", 
     SubscriptBox["m", "i"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "0ebb7953-c38a-41fb-9492-ae5b458f676e"],
 "-th element is diminished by 1. "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "WeightMark", 
   "b:3.22"},ExpressionUUID->"cfec2626-5921-445f-bcd2-573807f61d10"]
}, Open  ]],

Cell[CellGroupData[{

Cell["WeightToPolyGrade", "Subsubsection",
 CellTags->{
  "WeightToPolyGrade", "b:3.22", 
   "c:302"},ExpressionUUID->"4cd35f2d-e1f2-4691-b164-6d9a32531ca2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["WeightToPolyGrade", "Program"], "[", 
    RowBox[{"\[GothicG]", ",", "w"}], "]"}], TraditionalForm]],ExpressionUUID->
  "272bb4a3-e0d4-4760-aee1-e0af030417d9"],
 " returns the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalZ]", "n"], TraditionalForm]],
  ExpressionUUID->"23aa641a-dbd8-48e7-a56c-dffa1b61bec2"],
 "-grade of a vector with given weight. This function is defined for algebras \
built from Cartan matrix, see ",
 ButtonBox["CartanMatrixAlgebra",
  BaseStyle->"AddOnsLink"],
 ". "
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{3.421508936431616*^9},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "WeightToPolyGrade", 
   "b:3.22"},ExpressionUUID->"c8b60185-630c-4501-8ed4-99b7ac553b0a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["WithoutPreSL", "Subsubsection",
 CellTags->{
  "i:271", "WithoutPreSL", "b:3.22", 
   "c:303"},ExpressionUUID->"04fdac28-9f25-495f-ba8d-a95896d86a03"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["WithoutPreSL", "Program"], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ";", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"00444412-ac1a-44c1-8603-3d5af8f421be"],
 " to prevent preprocessing of expressions when the preprocessing is turned \
on. "
}], "Text",
 CellTags->{
  "WithoutPreSL", 
   "b:3.22"},ExpressionUUID->"8ee74d72-591d-4900-b83a-0646e1d624c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["WithUnique", "Subsubsection",
 CellTags->{
  "i:272", "WithUnique", "b:3.22", 
   "c:304"},ExpressionUUID->"d81075a1-6031-495d-a511-3d01f775a74a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["WithUnique", "Program"], "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["s", "1"], ",", "..."}], "}"}], ",", " ", 
     StyleBox["expr",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "20be77b6-221f-4dec-9922-2097e59b0437"],
 " evaluates ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " replacing the symbols ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "1"], ",", "..."}], TraditionalForm]],ExpressionUUID->
  "0c5a1c42-39b6-47d8-8e15-cc16b63c2ec7"],
 " by the new symbols with unique names. "
}], "Text",
 CellChangeTimes->{{3.42150895196395*^9, 3.4215089522643824`*^9}},
 CellTags->{
  "WithUnique", 
   "b:3.22"},ExpressionUUID->"7aa357dd-b8ef-4ee4-b8ec-8fefccc8869c"]
}, Open  ]]
}, Open  ]],

