Cell[CellGroupData[{

Cell["ExteriorAlgebra", "Subsubsection",
 CellTags->{
  "i:67", "ExteriorAlgebra", "b:3.4", 
   "c:69"},ExpressionUUID->"bdb8f6c2-b582-4c19-8b14-cf165540fcbb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ExteriorAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[CapitalOmega]",
      FontSlant->"Italic"], ",", " ", "x"}], "]"}], TraditionalForm]],
  ExpressionUUID->"9c1eef2f-0f18-46c0-94fc-13f1fbf97712"],
 " defines the exterior algebra on the space ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "17c53f32-b2a5-4c35-926a-71a12c032e52"],
 ". Options change the operation names: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["Wedge",
     BaseStyle->"AddOnsLink"], "\[Rule]"}], TraditionalForm]],ExpressionUUID->
  "cd10ca61-f56d-4704-9bae-0adef0d2811f"],
 "exterior product, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["Der",
     BaseStyle->"AddOnsLink"], "\[Rule]"}], TraditionalForm]],ExpressionUUID->
  "253f0784-2251-4d81-b627-8da9d5695184"],
 "derivative, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["CTimes",
     FontFamily->"Courier"], "\[Rule]"}], TraditionalForm]],ExpressionUUID->
  "0fac2b17-d163-4b65-baf0-34d575cd088c"],
 "the multiplication in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[CenterDot]", 
    StyleBox["dx",
     FontSlant->"Italic"]}], TraditionalForm]],ExpressionUUID->
  "ae976525-02e2-4988-98c7-4e82b185366e"],
 ". The ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    ButtonBox[
     StyleBox["PiRight", "Program"],
     BaseStyle->"AddOnsLink"], "Program"], TraditionalForm]],ExpressionUUID->
  "817694f5-36f9-4620-a2fa-cc46a561cb6d"],
 " relative of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "632ec459-68a5-46fc-b996-5c1ac0d135b2"],
 " should be defined."
}], "Text",
 CellTags->{
  "ExteriorAlgebra", 
   "b:3.4"},ExpressionUUID->"fb8e6138-fc97-477a-9904-2fcd766a112b"]
}, Open  ]]
}, Open  ]],

