Cell[CellGroupData[{

Cell["AntiSkewSymmetric", "Subsubsection",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellTags->{
  "i:9", "AntiSkewSymmetric", "b:3.0", 
   "c:10"},ExpressionUUID->"2c451c84-99fb-4f84-8d81-dd37f3249146"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AntiSkewSymmetric", "Program"], "[", "f", "]"}], 
   TraditionalForm]],ExpressionUUID->"70cb4a83-a721-49ca-879a-a656d0a2c03c"],
 " introduces the automatic sorting of arguments of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "e8cce983-1891-4e98-a480-431e07f3612c"],
 " using super-anti-skew symmetry  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"..", ",", "y", ",", "x", ",", ".."}], "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"P", "[", "x", "]"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"P", "[", "y", "]"}]}], ")"}]}]]}], " ", 
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "x", ",", "y", ",", ".."}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"633add1c-88e0-4502-b694-34f038530a6b"],
 "."
}], "Text",
 CellTags->{
  "AntiSkewSymmetric", 
   "b:3.0"},ExpressionUUID->"7772a237-66b3-48dc-ab15-989bcd668253"]
}, Open  ]],

