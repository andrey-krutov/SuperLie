Cell[CellGroupData[{

Cell["SVNormalRule", "Subsubsection",
 CellTags->{
  "i:199", "SVNormalRule", "b:3.18", 
   "c:224"},ExpressionUUID->"39a12aad-309f-43a0-8664-4de260e5e960"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["expr", "Var"], " ", "/.", " ", 
    StyleBox["SVNormalRule", "Name"]}], TraditionalForm]],ExpressionUUID->
  "65e30974-e6b5-4191-af64-118f609d0590"],
 " converts all scalar coefficients in ",
