  "60a06657-ddf8-4ba5-9c4a-4d8c8c9d19dd"],
 " form as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "[", 
    RowBox[{
     StyleBox["v", "Var"], "[", "...", "]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"cf748792-fcb6-4425-9445-2040519798d3"],
 " . \n",
