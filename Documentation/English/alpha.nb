Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["NewRelative", "Program"], "[", 
    RowBox[{"relation", ",", " ", 
     RowBox[{"V", "->", "W"}]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1f0067ea-5948-4b34-9bcb-a2f33e68d451"],
 " creates and attaches a new relative to the family of spaces-relatives. The \
first argument is the relation of the new space ",
 StyleBox["W", "Var"],
 " to the old space ",
 StyleBox["V", "Var"],
 ". The valid relations are ",
 StyleBox["CoLeft", "Name"],
 ", ",
 StyleBox["MRight", "Name"],
 ", ",
 StyleBox["CoRight", "Name"],
 ", ",
 StyleBox["PiRight", "Name"],
 ", ",
 StyleBox["DLeft", "Name"],
 ", ",
 StyleBox["PiLeft", "Name"],
 ", ",
 StyleBox["DRight", "Name"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "NewRelative", 
   "b:3.13"},ExpressionUUID->"5b3d8163-7b75-4f19-8f5f-b0c4c5bffe87"]
}, Open  ]],

