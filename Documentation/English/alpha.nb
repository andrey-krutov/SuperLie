 CellTags->{
  "i:13", "AntiSymmetricQ", "b:3.0", 
   "c:14"},ExpressionUUID->"7c99b38c-59fd-4e3d-953f-e8257a996496"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AntiSymmetricQ", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"1f22f37f-942f-4e8d-8b49-ce578a48ffde"],
 " returns ",
 StyleBox["True", "Program"],
 " if f was declared antisymmetric."
}], "Text",
 CellTags->{
  "AntiSymmetricQ", 
   "b:3.0"},ExpressionUUID->"28020f06-b845-419c-8c49-c7df5849f946"]
}, Open  ]],

Cell[CellGroupData[{

Cell["AntiSymmetricRule", "Subsubsection",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellTags->{
  "i:14", "AntiSymmetricRule", "b:3.0", 
   "c:15"},ExpressionUUID->"ed6bbbc1-a20f-4c7d-973a-ce8eb019e8d8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AntiSymmetricRule", "Program"], "[", "f", "]"}], 
   TraditionalForm]],ExpressionUUID->"3a5638df-7411-438f-832e-32003052c702"],
 " is the replacement rule for sorting of arguments of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "5027798e-5afa-4f43-8e7d-16494a12d514"],
 " using super-antisymmetry  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"..", ",", "y", ",", "x", ",", ".."}], "]"}], " ", "\[Rule]", 
    " ", 
    RowBox[{
     RowBox[{"-", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"P", "[", "x", "]"}], 
        RowBox[{"P", "[", "y", "]"}]}]]}], " ", 
     RowBox[{"f", "[", 
      RowBox[{"..", ",", "x", ",", "y", ",", ".."}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"e385b7c0-3ab5-4e33-b0e3-9612970dfcf8"],
 "."
}], "Text",
 CellTags->{
  "AntiSymmetricRule", 
   "b:3.0"},ExpressionUUID->"1a955129-a475-43e3-8de3-21afcac06693"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ApplySplit", "Subsubsection",
 CellTags->{
  "i:15", "ApplySplit", "b:3.0", 
   "c:16"},ExpressionUUID->"9ca11639-5d5c-4962-baa1-6af3c2a6e47e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ApplySplit", "Program"], "[", 
    RowBox[{"f", ",", " ", "e"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ac5798e1-a4bb-4de5-b7ec-22ed4daa553a"],
 " applies function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "dab0e939-35d8-487c-a96d-d59a6940a8e8"],
 " to terms of the ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " sum or list ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "8cc6f073-2578-478f-9e4b-56d3e6e30855"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ApplySplit", "Program"], "[", 
    RowBox[{"f", ",", " ", "e", ",", " ", 
     RowBox[{
      StyleBox["args",
       FontSlant->"Italic"], "..."}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"8d4af4ef-5553-4ad1-afdd-e950d25bd0ee"],
 " applies function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", 
    RowBox[{"f", "(", 
     RowBox[{"x", ",", 
      StyleBox["args",
       FontSlant->"Italic"]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "032bd899-95ec-42dc-8675-b8af4681f863"],
 " to terms of the ",
 StyleBox[ButtonBox["splitted",
  BaseStyle->"AddOnsLink",
  ButtonData:>"Splitting vector lists and expressions"],
  FontFamily->"Times New Roman"],
 " sum or list ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],ExpressionUUID->
  "71d848aa-ba53-433f-9530-8ccec0408850"],
 " "
}], "Text",
 CellChangeTimes->{{3.5828019368590126`*^9, 3.5828019567965126`*^9}, {
  3.5828020519683876`*^9, 3.5828020751402626`*^9}, {3.5828021196246376`*^9, 
  3.5828021563902626`*^9}, {3.5828021961402626`*^9, 3.5828022290465126`*^9}},
 CellTags->{
  "ApplySplit", 
   "b:3.0"},ExpressionUUID->"9a0c26a3-b7dc-4a2e-b827-090c3d7e5daa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ArgForm", "Subsubsection",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellTags->{
  "i:16", "ArgForm", "b:3.0", 
   "c:17"},ExpressionUUID->"4bce8f1a-aa7c-4811-9522-06b767b7c799"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["ArgForm", "Program"], "[", 
     StyleBox["controlstring",
      FontSlant->"Italic"], "]"}], " ", "[", 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "..."}], "]"}], "]"}], TraditionalForm]],
  ExpressionUUID->"5c01812f-19bc-4375-835c-ce5d6d48d69d"],
 " is equivalent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox[
      StyleBox["StringForm", "Program"],
      BaseStyle->"RefGuideLink"], "Program"], "[", 
    RowBox[{
     StyleBox["controlstring",
      FontSlant->"Italic"], ",", "x", ",", "..."}], "]"}], TraditionalForm]],
  ExpressionUUID->"dde76858-0905-42a3-9a50-f8526ca77321"],
 ". It is used as value of format options, e.g.,",
 ButtonBox["TeX",
  BaseStyle->"AddOnsLink"],
 StyleBox["\[Rule]ArgForm[\"\\\\left[`1`,\\\\,`2`\\\\right]\"]", "Program"],
 "."
}], "Text",
 CellTags->{
  "ArgForm", "b:3.0"},ExpressionUUID->"223b9c14-bb70-47f7-bfcb-5cda0445ebac"]
}, Open  ]],

