  "i:216", "ThreadGradedRule", "b:3.19", 
   "c:242"},ExpressionUUID->"61346fdf-e2e8-4427-802a-1d7073deed76"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ThreadGradedRule", "Program"], "[", "f", "]"}], 
   TraditionalForm]],ExpressionUUID->"7e07cc24-6894-4bfa-a63c-daf2427f2584"],
 " is the replacement rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"a", "\[SmallCircle]", "b"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"f", "[", "a", "]"}], "+", 
     RowBox[{"f", "[", "b", "]"}]}]}], TraditionalForm]],ExpressionUUID->
  "dd68605b-ebc7-4dc7-8e34-deb431f324f4"],
 " for any graded operation \[SmallCircle]. The function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "030df52c-6d4f-4fe0-8235-910d8efca71e"],
 " should be declared to be scalar or vector. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ThreadGradedRule", "Program"], "[", 
    RowBox[{"f", ",", 
     StyleBox["plus",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "e872b9af-c326-4a42-9e9b-36d92831ce22"],
 " is the replacement rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"a", "\[SmallCircle]", "b"}], "]"}], "\[Rule]", 
    RowBox[{
     StyleBox["plus",
      FontSlant->"Italic"], "[", 
     RowBox[{
      RowBox[{"f", "[", "a", "]"}], ",", 
      RowBox[{"f", "[", "b", "]"}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"566f7ba1-36be-45cb-9024-6b1fa7d1adbc"],
 " "
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ThreadGradedRule", 
   "b:3.19"},ExpressionUUID->"baa53225-8000-4dc1-b9ec-08973ce24979"]
}, Open  ]],

