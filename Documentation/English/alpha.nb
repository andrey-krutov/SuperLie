Cell["AlgebraDecomposition", "Subsubsection",
 CellTags->{
  "i:8", "AlgebraDecomposition", "b:3.0", 
   "c:9"},ExpressionUUID->"a7705f7e-66e0-494c-986d-5a186ee4dd15"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["AlgebraDecomposition", "Program"], "[", 
    RowBox[{"F", ",", "\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[GothicH]", "1"], ",", " ", "..."}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"fd71dd83-76c4-4aa5-91d4-dd6aba1ca6b6"],
 " - defines the decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", ":", "\[GothicG]"}], "\[Rule]", 
    RowBox[{
     SubscriptBox["\[GothicH]", "1"], "+"}]}], TraditionalForm]],
  ExpressionUUID->"4a7b243a-061e-4833-bc91-a7209e0893eb"],
 "... of the Lie (super)algebra \[GothicG] in the sum of subalgebras  \
\[GothicH]",
 Cell[BoxData[
