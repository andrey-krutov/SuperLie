Cell[CellGroupData[{

Cell["Scalar", "Subsubsection",
 CellTags->{
  "i:175", "Scalar", "b:3.18", 
   "c:198"},ExpressionUUID->"9fec133c-bce5-4133-a48e-3a285fab81f0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Scalar", "Program"], "[", 
    RowBox[{"c", ",", "..."}], "]"}], TraditionalForm]],ExpressionUUID->
  "e5b03935-65fe-4ba8-88d7-7756494d618b"],
 " declares that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ",", " ", "..."}], TraditionalForm]],ExpressionUUID->
  "5bf36db0-b291-4981-b402-e873c4bbecea"],
 " are scalars. Any expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "[", "...", "]"}], TraditionalForm]],ExpressionUUID->
  "bd166ec5-ebba-4ea5-8a43-b8ee70a83ee6"],
 " whose header is declared as scalar, is also a scalar. So ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Scalar", "Program"], "[", "f", "]"}], TraditionalForm]],
  ExpressionUUID->"f454560b-d085-4d95-8f06-20b12fff30c5"],
 " may be used to declare function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "9bdcf7bd-4f7f-44e4-bcc5-816e93c25b0d"],
 " scalar-valued.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Scalar", "Name"], "[", 
    RowBox[{"f", "\[Rule]", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "fd3e2b71-6dd4-427e-9655-4a9801135455"],
 " declares that the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "d7464ff6-628e-46ee-aa65-ed0e645d48fc"],
 "-th operand of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "ae314c39-56d1-4734-b6cd-a020123bf4f4"],
 " is scalar. Here ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "b5379d4f-135e-4e2e-9742-e8044e7c3de1"],
 " may be a number, ",
 StyleBox["First", "Program"],
 ", ",
 StyleBox["Last", "Program"],
 ", ",
 StyleBox["All", "Program"],
 " or ",
 StyleBox["_", "Program"],
 "."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Scalar", "b:3.18"},ExpressionUUID->"fac6e2ad-cfb4-4663-a16e-d9aaef7c9eaa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ScalarEquation", "Subsubsection",
 CellTags->{
  "i:176", "ScalarEquation", "b:3.18", 
   "c:199"},ExpressionUUID->"52b5dd84-7a73-4c78-8a70-a625817dec97"],

