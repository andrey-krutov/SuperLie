Cell[CellGroupData[{

Cell["ParamAssume", "Subsubsection",
 CellChangeTimes->{{3.5828133917340126`*^9, 3.5828133937808876`*^9}},
 CellTags->{
  "ParamAssume", "b:3.15", 
   "c:158"},ExpressionUUID->"0e19bfb1-8ef6-4ec5-a264-98085b60eddf"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ParamAssume", "Program"], "[", 
    StyleBox["code", "Var"], "]"}], TraditionalForm]],ExpressionUUID->
  "a8733d16-2b8e-48c6-a6b1-f942ccc899db"],
 " executes the code and collects all assumption made by ",
 Cell[BoxData[
  FormBox[
   ButtonBox["ParamSolve",
    BaseStyle->"RefGuideLink"], TraditionalForm]],ExpressionUUID->
  "1d5137f3-0a7f-4c83-8fae-823cf3694ffc"],
 " while solving equations.\nReturns the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox[
      RowBox[{"result", " ", "of", " ", "code"}],
      FontSlant->"Italic"], ",", " ", 
     StyleBox["assumptions",
      FontSlant->"Italic"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "ce67533a-344f-443e-8300-38bfba20dac6"],
 "."
}], "Text",
 CellChangeTimes->{
  3.5828136318590126`*^9, {3.5828136765777626`*^9, 3.5828137613746376`*^9}},
 CellTags->{
  "ParamAssume", 
   "b:3.15"},ExpressionUUID->"605f6cf3-7e94-4e9e-8d4d-9a8b23261b66"],

Cell[TextData[{
 "In case of nested ",
 StyleBox["ParamAssume", "Program"],
 ", the inner ",
 StyleBox["ParamAssume", "Program"],
 " takes into account the assumptions already made by the outer ",
 StyleBox["ParamAssume", "Program"],
 " and returns only the list of new assumptions. The outer ",
 StyleBox["ParamAssume", "Program"],
 " does not know the assumptions made by the inner ",
 StyleBox["ParamAssume", "Program"],
 ".\nThe assumptions made globally (collected in  ",
 Cell[BoxData[
  FormBox[
   ButtonBox["$ParamAssume",
    BaseStyle->"RefGuideLink"], TraditionalForm]],ExpressionUUID->
  "d2de2f6d-0497-4bd0-bb8b-5127f3e5fa97"],
 ") are treated as made in an implicit outer ",
 StyleBox["ParamAssume", "Program"],
 "."
}], "Text",
 CellChangeTimes->{{3.5828138094527626`*^9, 3.5828138712496376`*^9}, {
  3.5828142579215126`*^9, 3.5828143044215126`*^9}, {3.5828143388277626`*^9, 
  3.5828143764527626`*^9}, {3.5828147906715126`*^9, 3.5828148143433876`*^9}, {
  3.5828148491715126`*^9, 3.5828148974840126`*^9}, {3.5828149560777626`*^9, 
  3.5828150809683876`*^9}, {3.5828151135308876`*^9, 3.5828152295777626`*^9}, {
  3.5828153446871376`*^9, 3.5828153565152626`*^9}},
 CellTags->{
  "ParamAssume", 
   "b:3.15"},ExpressionUUID->"b590d222-0b4f-4aac-ba50-0aad81fa9c84"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ParamSolve", "Subsubsection",
 CellTags->{
  "ParamSolve", "b:3.15", 
   "c:159"},ExpressionUUID->"1eb5fffa-6178-40a8-bb80-b527da1b72c8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ParamSolve", "Program"], "[", 
    RowBox[{
     StyleBox["eq", "Var"], ",", 
     StyleBox["var", "Var"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "546ebe1f-3a64-434c-af0c-909b1030b46c"],
 "  solves a system of linear equations for given unknown(s) ",
 StyleBox["var", "Var"],
 " (the equations are not necessary linear in other parameters). \nReturns \
the general solution of the system and prints a message every time it divides \
something by a symbolic expression in order to eliminate a variable. The \
cases where the printed expressions are equal to zero may be not covered by \
the general solution and should be regarded separately."
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{{3.4215047452249565`*^9, 3.4215047633309917`*^9}, 
   3.42150484640044*^9, {3.4215049298404207`*^9, 3.4215052673257008`*^9}, {
   3.421505343385069*^9, 3.421505355933112*^9}, {3.423238165625779*^9, 
   3.423238169401208*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ParamSolve", 
   "b:3.15"},ExpressionUUID->"853a05d8-12ba-4eb1-a480-27f8d985b4da"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["ParamSolve", "Program"], "[", 
    RowBox[{
     StyleBox["eq", "Var"], ",", 
     StyleBox["var", "Var"], ",", 
     StyleBox["elim", "Var"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "35c77b43-70b7-434e-90b4-dc97709e543b"],
 " first eliminates the variable(s) given in ",
 StyleBox["elim",
  FontSlant->"Italic"],
 "."
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ParamSolve", 
   "b:3.15"},ExpressionUUID->"1b0dd9eb-c576-467f-a90f-0dc4d99bc49a"],

Cell[TextData[{
 "Each of parameters ",
 StyleBox["var",
  FontSlant->"Italic"],
 " and ",
 StyleBox["elim",
  FontSlant->"Italic"],
 " may be a list of variables, a single variable, or a pattern matching the \
variables."
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 CellChangeTimes->{3.421505301434747*^9},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ParamSolve", 
   "b:3.15"},ExpressionUUID->"19231eb8-9c1b-4967-ae6e-33739fd87557"],

Cell[TextData[{
 "If the characteristic of the base field is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "7d39360f-85ca-42b8-a613-089b9eff59b2"],
 " (see ",
 ButtonBox["FieldChar",
  BaseStyle->"AddOnsLink"],
 "), the function solves the equations modulo ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "17b857c5-aa2e-443f-a395-4e9c89093b8a"],
 "."
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "ParamSolve", 
   "b:3.15"},ExpressionUUID->"4b2ea5bd-3f92-4f6b-84b6-9e01f88492e9"],

Cell[TextData[{
 "Set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["$Solve",
     BaseStyle->"RefGuideLink"], "=", 
    StyleBox["ParamSolve", "Program"]}], TraditionalForm]],ExpressionUUID->
  "7b3452ec-5ce7-4c1b-bd31-a5c3752e8755"],
 " to use ",
 Cell[BoxData[
  FormBox[
   StyleBox["ParamSolve", "Program"], TraditionalForm]],ExpressionUUID->
  "a14303bc-2d1a-4c38-82d4-04091ae6930f"],
 " as standard procedure for solving scalar equations."
}], "Text",
 CellChangeTimes->{{3.5828114336246376`*^9, 3.5828114953902626`*^9}, {
  3.5828116905152626`*^9, 3.5828117596558876`*^9}, {3.5828118143590126`*^9, 
  3.5828118525777626`*^9}},
 CellTags->{
  "b:3.15", 
   "ParamSolve"},ExpressionUUID->"118807c3-baaf-4bb4-8aba-ad29228d2742"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parity", "Subsubsection",
 CellTags->{
  "i:141", "Parity", "b:3.15", 
   "c:160"},ExpressionUUID->"962ca34a-7348-45ff-82d3-11dce345efbc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Parity", "Program"], "[", "v", "]"}], TraditionalForm]],
  ExpressionUUID->"db9685ef-871d-430c-93e8-a463a9f552db"],
 " checks if ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]],ExpressionUUID->
  "70263585-0251-47ba-8977-8c9ed9b91508"],
 " is an homogeneous vector and returns its parity. For inhomogeneous \
vectors, and when the check fails, it returns ",
 StyleBox["Mixed", "Program"],
 ". "
}], "Text",
 CellChangeTimes->{{3.421505385796053*^9, 3.421505417571744*^9}},
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "Parity", "b:3.15"},ExpressionUUID->"2309b111-73f1-4de8-b207-64f51a2577d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["PartSplit", "Subsubsection",
 CellTags->{
  "i:142", "PartSplit", "b:3.15", 
   "c:161"},ExpressionUUID->"4df1dff2-f007-4b8a-8758-b43068fba8ca"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PartSplit", "Program"], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ",", 
     StyleBox["sel",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "59f3ded8-fc65-4a71-b9dc-48eb465a37a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PartSplit", "Program"], "[", 
    RowBox[{
     StyleBox["expr",
      FontSlant->"Italic"], ",", 
     StyleBox["sel",
      FontSlant->"Italic"], 
     StyleBox[",",
      FontSlant->"Italic"], 
     StyleBox["default",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "d33f0922-09ff-44a8-b07a-00836e294c47"],
 " return the part of splitted expression ",
 StyleBox["expr",
  FontSlant->"Italic"],
 " with given selector ",
 StyleBox["sel",
  FontSlant->"Italic"],
 " or the ",
 StyleBox["default",
  FontSlant->"Italic"],
 " if the part not found. The default value for ",
 StyleBox["default",
  FontSlant->"Italic"],
 " is 0."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "PartSplit", 
   "b:3.15"},ExpressionUUID->"d3561cbd-e1be-48ef-bade-1f7db06bcb48"]
}, Open  ]],

