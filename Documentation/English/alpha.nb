Cell[CellGroupData[{

Cell["PList", "Subsubsection",
 CellTags->{
  "i:148", "PList", "b:3.15", 
   "c:166"},ExpressionUUID->"09bf04fa-175f-4317-b726-2458bda1bce0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["PList", "Program"], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["p", "1"], ",", "..."}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"cff22f3f-0316-4f38-a15b-5176127e512e"],
 " is the optional parameter for some space constructors. It is the list of \
parities of either (a) the vectors forming a basis of the new space, (b) the \
generators of an algebra or a module, or (c) rows and columns of matrices.\n\n\
",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"PList", "[", "V", "]"}], "Program"], TraditionalForm]],
  ExpressionUUID->"ee056802-e01b-4856-b7a4-04c3b48f01a6"],
 " returns the parity list used in the definition of the space."
}], "Text",
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "PList", "b:3.15"},ExpressionUUID->"7eb29118-fe47-4f4c-af29-242539515de0"]
}, Open  ]],

