Cell[CellGroupData[{

Cell["QuotientAlgebra", "Subsubsection",
 CellTags->{
  "i:162", "QuotientAlgebra", "b:3.16", 
   "c:182"},ExpressionUUID->"132a5d9e-6ad0-422e-b7b2-30d8b0a8d0a3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["QuotientAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicF]",
      FontSlant->"Italic"], ",", "\[GothicG]", ",", "\[GothicH]"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"8397513b-7bc2-4cf7-b3e0-aca59efed566"],
 " builds the quotient algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicF]", "=", " ", 
    RowBox[{"\[GothicG]", "/", "\[GothicH]"}]}], TraditionalForm]],
  ExpressionUUID->"4c39faa1-adb2-4c88-a471-98bb3766c76e"],
 ", where \[GothicH] is defined as ideal in \[GothicG]. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["QuotientAlgebra", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicF]",
      FontSlant->"Italic"], ",", "\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", 
       RowBox[{"...", 
        SubscriptBox["g", "k"]}]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"dda0949b-53b0-41d0-adcc-274c73241633"],
 " builds the quotient algebra ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicF]", "=", " ", 
    RowBox[{"\[GothicG]", "/", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "\[RightAngleBracket]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"b0a1a26b-b796-48eb-877e-4bcfc5698583"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "i"], "\[Element]", "\[GothicG]"}], TraditionalForm]],
  ExpressionUUID->"1baf187f-f8b0-4140-93f3-fe89470f75a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubscriptBox["g", "1"], ",", "...", ",", 
     SubscriptBox["g", "k"]}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"a01573b0-7f70-4399-b905-297a9f1f2d35"],
 " is an ideal in \[GothicG] (no need to define this ideal explicitly). \nThe \
option ",
 ButtonBox["Split",
  BaseStyle->"AddOnsLink"],
 "\[Rule]",
 StyleBox["f", "Var"],
 "  instructs to split the spaces in order to accelerate calculations. The \
function ",
 StyleBox["f",
  FontSlant->"Italic"],
 " should define (poly)grading on \[GothicG]. \nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox["Mapping",
      BaseStyle->"AddOnsLink"], "Program"], "\[Rule]", 
    StyleBox["func", "Var"]}], TraditionalForm]],ExpressionUUID->
  "b7368601-36b8-4b0f-8fee-e81cc3a5076b"],
 " instructs to define the named function as projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "\[Rule]", 
    RowBox[{"\[GothicG]", "/", "\[GothicH]"}]}], TraditionalForm]],
  ExpressionUUID->"d0b1caea-1797-4368-979d-6341d6cfe0ed"],
 ". \nThe function ",
 StyleBox["QuotientAlgebra", "Program"],
 " is implemented only for finite dimensional algebras having simple \
representation of basis as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", "...", ",", 
    SubscriptBox["g", "n"]}], TraditionalForm]],ExpressionUUID->
  "794b78f6-8163-4d02-91f5-c7accd696d24"],
 " where ",
 StyleBox["g",
  FontSlant->"Italic"],
 " is the algebra name. To work with algebras that have different \
representations (e.g., matrix algebras or algebras of vector fields), use ",
 ButtonBox["SubAlgebra",
  BaseStyle->"AddOnsLink"],
 " to build a subalgebra ",
 StyleBox["s",
  FontSlant->"Italic"],
 " with basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["s", "l"]}]}], TraditionalForm]],ExpressionUUID->
  "0ba7a22d-dd5d-49a2-8125-c888f86d642f"],
 " (the subalgebra should coincide with the original algebra) and then build \
the quotient algebra of ",
 StyleBox["s",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.421505935015792*^9, 3.4215059434979887`*^9}, 
   3.4215060702702785`*^9},
 CellTags->{
  "QuotientAlgebra", 
   "b:3.16"},ExpressionUUID->"12219bed-f82b-4d43-bfe1-8a897c7a93b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["QuotientModule", "Subsubsection",
 CellTags->{
  "i:162", "QuotientModule", "b:3.16", 
   "c:183"},ExpressionUUID->"5f64d8fe-1c03-4de2-b7c5-05eaa2170117"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["QuotientModule", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicF]",
      FontSlant->"Italic"], ",", "\[GothicG]", ",", "\[GothicH]"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"e77408f0-dfe0-48ab-a5fe-ab663ed91541"],
 " builds the quotient module ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicF]", "=", " ", 
    RowBox[{"\[GothicG]", "/", "\[GothicH]"}]}], TraditionalForm]],
  ExpressionUUID->"9828452c-f4f7-4a3c-906b-6f0b8aa85828"],
 ", where \[GothicH] is defined as a submodule in \[GothicG]. \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["QuotientModule", "Program"], "[", 
    RowBox[{
     StyleBox["\[GothicF]",
      FontSlant->"Italic"], ",", "\[GothicG]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["g", "1"], ",", 
       RowBox[{"...", 
        SubscriptBox["g", "k"]}]}], "}"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"ffc2bf3e-5117-4eb1-a032-c59ba3a48edb"],
 " builds the quotient module ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicF]", "=", " ", 
    RowBox[{"\[GothicG]", "/", 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox["g", "1"], ",", "...", ",", 
       SubscriptBox["g", "k"]}], "\[RightAngleBracket]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"82599c7b-0aa7-49be-874d-51056e17d8f6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "i"], "\[Element]", "\[GothicG]"}], TraditionalForm]],
  ExpressionUUID->"71e2dff8-d8e1-43ee-80d0-ed039cb66254"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubscriptBox["g", "1"], ",", "...", ",", 
     SubscriptBox["g", "k"]}], "\[RightAngleBracket]"}], TraditionalForm]],
  ExpressionUUID->"36e3b759-2b47-48b9-99ad-0aa7ca7a274a"],
 " is a submodule in \[GothicG] (no need to define this submodule \
explicitly).\nThe option ",
 ButtonBox["Split",
  BaseStyle->"AddOnsLink"],
 "\[Rule]",
 StyleBox["f", "Var"],
 "  instructs to split the spaces in order to accelerate calculations. The \
function ",
 StyleBox["f",
  FontSlant->"Italic"],
 " should define (poly)grading on \[GothicG]. \nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     ButtonBox["Mapping",
      BaseStyle->"AddOnsLink"], "Program"], "\[Rule]", 
    StyleBox["func", "Var"]}], TraditionalForm]],ExpressionUUID->
  "c51e1b21-dc4a-4cd5-876e-ea1459c5c267"],
 " instructs to define the named function as projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[GothicG]", "\[Rule]", 
    RowBox[{"\[GothicG]", "/", "\[GothicH]"}]}], TraditionalForm]],
  ExpressionUUID->"9224b5e4-49ad-4f40-9182-3fcc3c59546a"],
 ". \nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Module", "Program"], "\[Rule]", 
    RowBox[{
     StyleBox["{", "Var"], 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "Var"], "1"], ",", 
      RowBox[{"...", 
       SubscriptBox["m", "l"]}]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "442b2730-9e40-470a-8cdf-31af8bf08d75"],
 " instructs to use the submodule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "Var"], "1"], ",", 
      RowBox[{"...", 
       SubscriptBox["m", "l"]}]}], "\[RightAngleBracket]"}], "\[Subset]", 
    "\[GothicG]"}], TraditionalForm]],ExpressionUUID->
  "df2feeaf-10ee-4115-9273-e49eee5f1630"],
 " instead of \[GothicG] (no need to define this submodule explicitly). Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "i"], TraditionalForm]],ExpressionUUID->
  "72e8499c-987b-4b4e-872e-cd4160aaa5e8"],
 " should be elements of the basis of \[GothicG]. \nThe option ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Algebra", "Program"], "\[Rule]", "\[GothicA]"}], 
   TraditionalForm]],ExpressionUUID->"35b8e41f-cb40-4b65-8051-9507017194dc"],
 " should be used if more than one algebra acts on the module ",
 Cell[BoxData[
  FormBox["\[GothicG]", TraditionalForm]],ExpressionUUID->
  "74d9c93a-100a-49d2-8174-5152fde4a7ef"],
 ". \nThe function ",
 StyleBox["QuotientModule", "Program"],
 " is implemented only for finite dimensional algebras having simple \
representation of basis as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "1"], ",", "...", ",", 
    SubscriptBox["g", "n"]}], TraditionalForm]],ExpressionUUID->
  "ea9e34a6-c0c6-4ec3-8cd0-aa85f25881a7"],
 " where ",
 StyleBox["g",
  FontSlant->"Italic"],
 " is the name of the algebra. To work with algebras that have different \
representations (e.g., matrix algebras or algebras of vector fields), use ",
 ButtonBox["SubAlgebra",
  BaseStyle->"AddOnsLink"],
 " to build a subalgebra ",
 StyleBox["s",
  FontSlant->"Italic"],
 " with basis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "1"], ",", 
    RowBox[{"...", 
     SubscriptBox["s", "l"]}]}], TraditionalForm]],ExpressionUUID->
  "0458d1e8-2869-42f6-9655-9e1531bb3b1b"],
 " (the subalgebra can coincide with the original algebra) and then use ",
 StyleBox["QuotientModule", "Program"],
 " with the option ",
 StyleBox["Algebra\[Rule]", "Program"],
 StyleBox["s", "Program",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.421505977556963*^9, 3.4215060374330606`*^9}, {
  3.421506079954203*^9, 3.421506080755355*^9}},
 CellTags->{
  "QuotientModule", 
   "b:3.16"},ExpressionUUID->"a10d7b45-a854-4960-a505-9e79655c3ed2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

