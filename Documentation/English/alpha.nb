Cell[CellGroupData[{

Cell["RamondAlgebra", "Subsubsection",
 CellTags->{
  "i:163", "RamondAlgebra", "b:3.17", 
   "c:185"},ExpressionUUID->"101ed5c9-515e-47e5-a49a-2ab2570f85fc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RamondAlgebra", "Program"], "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "\[Theta]", ",", "t"}], "}"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"bdbfc24f-ff4f-4fce-bf22-b1739c070868"],
 " defines the Ramond superalgebra ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "663a93ea-c855-4f9e-b3fd-44b64d9e0d3a"],
 " as the algebra of the polynomials in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     SubscriptBox["x", "1"],
     TraditionalForm], ",", "...", 
    SubscriptBox["x", "n"]}], TraditionalForm]],ExpressionUUID->
  "ce94b702-e90b-4a60-9a7a-e0ba14bd2826"],
 ", ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "fa2e9666-154a-4d65-98dd-5f433d345ad4"],
 ", and ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "7c512c96-7a4a-410e-b922-8fac48826d61"],
 ". The ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "fa0bf952-3544-418b-8b1b-677fe7976ce8"],
 " may be also a list of components, as in ",
 ButtonBox["PoissonAlgebra",
  BaseStyle->"AddOnsLink"],
 "."
}], "Text",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 TextAlignment->Left,
 TextJustification->1,
 CellTags->{
  "RamondAlgebra", 
   "b:3.17"},ExpressionUUID->"eacd896a-22b4-4bce-bb88-f45220917f87"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RamondD", "Subsubsection",
 CellTags->{
  "i:164", "RamondD", "b:3.17", 
   "c:186"},ExpressionUUID->"a23ff037-9fb1-409a-b905-70d6d0017b51"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["RamondD", "Program"], "[", 
    RowBox[{"f", ",", " ", "t", ",", " ", "\[Theta]", ",", " ", 
     StyleBox["ptrn",
      FontSlant->"Italic"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "3c177b0d-b700-492c-b569-63949deed52b"],
 "  is the \[ScriptCapitalD] operator used in the definition of the Ramond \
superalgebra. The pattern ",
 StyleBox["ptrn",
