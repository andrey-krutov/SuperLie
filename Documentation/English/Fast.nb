Notebook[{

Cell[CellGroupData[{
Cell["SuperLie: a Fast Introduction", "Title",
 FontSize->24,
 CellTags->{
  "i:1", "Fast Introduction", 
   "c:1"},ExpressionUUID->"9e4a14d6-a092-474c-a1f5-5df74ffce47c"],

Cell[CellGroupData[{

Cell["Purpose", "Section",
 CellTags->{
  "c:2", "b:0.0"},ExpressionUUID->"abe1d3fc-14eb-4daa-b92c-caf979e0dd0c"],

Cell[TextData[{
 "The ",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " Package is a tool for calculating various data for Lie algebras and Lie \
superalgebras. Using ",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " Package you can\n\[Bullet] make the numeric and symbolic calculations with \
vectors;\n\[Bullet] build vector (super)spaces, algebras and modules over \
algebras;\n\[Bullet] convert the results to ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"T", 
    AdjustmentBox["E",
     BoxBaselineShift->0.5,
     BoxMargins->{{-0.075, -0.085}, {0, 0}}], "X"}]]],ExpressionUUID->
  "c0fec7d6-ba63-4404-be52-ddb7d5cb332d"],
 " format."
}], "Text",
 CellChangeTimes->{{3.4213241409010816`*^9, 3.4213241714249725`*^9}},
 CellTags->"b:0.0",ExpressionUUID->"a3185182-28c2-42bf-86c7-79e8a45b8935"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Principles", "Section",
 CellTags->"c:3",ExpressionUUID->"94d90d15-6f71-4eaf-a86f-a5064ff3f13e"],

Cell[CellGroupData[{

Cell["Vectors and vector expressions", "Subsection",
 CellTags->{
  "c:4", "b:0.1.0"},ExpressionUUID->"2b19cb3f-c7f8-4c44-95ec-37edc8ed075a"],

Cell[CellGroupData[{

Cell["Vectors and scalars", "Subsubsection",
 CellTags->{
  "_sli_vect_scal", "c:5", 
   "b:0.1.0"},ExpressionUUID->"c34f08db-7f76-473e-82a5-1ddc0e32fcae"],

Cell[TextData[{
 StyleBox["Vectors", "Def"],
 " in ",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " are:\n\[Bullet] Symbols declared as vectors; such symbols with indices, as \
",
 Cell[BoxData[
  SubscriptBox["v", "i"]],ExpressionUUID->
  "6a9d4e8f-f235-4ead-8753-6a04f2bd545b"],
 " or ",
 Cell[BoxData[
  RowBox[{"v", "[", 
   RowBox[{"i", ",", "j"}], "]"}]],ExpressionUUID->
  "919ccc61-d251-45da-95e6-9effcd15e353"],
 ";\n\[Bullet] Linear combinations of vectors with scalar coefficients;\n\
\[Bullet] Vector expressions, like ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["v", "1"], "\[CircleTimes]", 
   SubscriptBox["v", "2"]}]],ExpressionUUID->
  "ecdf59dd-ca48-43bb-824a-d7c21f8b1bbc"],
 ";\n\[Bullet] The results of vector-valued functions and operators."
}], "Text",
 CellTags->{
  "_sli_vect_scal", 
   "b:0.1.0"},ExpressionUUID->"7b64a3c2-9943-47ee-a5f5-1be47ce372b0"],

Cell[TextData[{
 StyleBox["Scalars", "Def"],
 " in ",
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " are:\n\[Bullet] Symbols declared as scalars; such symbols with indices, as \
",
 Cell[BoxData[
  SubscriptBox["c", "i"]],ExpressionUUID->
  "53de9258-a557-498b-895d-2ee995d70c5e"],
 " or ",
 Cell[BoxData[
  RowBox[{"c", "[", 
   RowBox[{"i", ",", "j"}], "]"}]],ExpressionUUID->
  "e7cd2e12-f995-416d-ad36-8deb73a16ca0"],
 ";\n\[Bullet] Numbers and in-built ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " constants;\n\[Bullet] Scalar expressions, like ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["c", "1"], "+", 
   RowBox[{
    SubscriptBox["c", "2"], "*", 
    RowBox[{"Sin", "[", "\[Alpha]", "]"}]}]}]],ExpressionUUID->
  "55d5beb6-f108-44a6-8b79-d16b8fb3b395"],
 ";\n\[Bullet] The results (values) of scalar-valued functions and \
operators."
}], "Text",
 CellChangeTimes->{{3.4232277372404976`*^9, 3.4232277401847315`*^9}},
 CellTags->{
  "_sli_vect_scal", 
   "b:0.1.0"},ExpressionUUID->"88ccd152-a3e1-421a-bf62-a5f8e670c84c"],

