Cell[CellGroupData[{

Cell["Functions and evaluation rules for vector expressions", "Subsubsection",
 CellTags->{
  "_sli_vect_eval", "c:7", "i:3", 
   "b:0.1.0"},ExpressionUUID->"a8257800-75c1-43d3-959f-434a7fef42ad"],

Cell[TextData[{
 StyleBox["SuperLie",
  FontWeight->"Bold"],
 " defines a list of rules and functions used to evaluate or simplify vector \
expressions.\n\[Bullet] A rule may be applied manually, using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " replacement operator ",
 StyleBox["expr ", "Var"],
 ButtonBox["/.",
  BaseStyle->"RefGuideLink"],
 StyleBox[" rule", "Var"],
 " or ",
 StyleBox["expr", "Var"],
 " ",
 ButtonBox["//.",
  BaseStyle->"RefGuideLink"],
 " ",
 StyleBox["rule", "Var"],
 "\n\[Bullet] A rule may be declared as an operation property; then it will \
be applied automatically whenever possible."
}], "Text",
 CellTags->{
  "_sli_vect_eval", 
   "b:0.1.0"},ExpressionUUID->"a19270cd-008d-448d-a37b-c383d35037bd"],

