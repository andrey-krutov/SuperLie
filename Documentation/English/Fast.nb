Cell[CellGroupData[{

Cell["Vector operations", "Subsubsection",
 CellTags->{
  "_sli_vect_op", "c:6", "i:2", 
   "b:0.1.0"},ExpressionUUID->"141f118f-1b3a-4643-8f45-a673eb1af506"],

Cell[TextData[{
 "The arithmetic operations ",
 Cell[BoxData[
  FormBox["+", TraditionalForm]],ExpressionUUID->
  "17fc7fc3-9db8-4491-a5ec-6c49c7252818"],
 ", ",
 Cell[BoxData[
  FormBox["-", TraditionalForm]],ExpressionUUID->
  "6fd42dd3-74c8-437e-94b1-3786ba6e77e9"],
 ", ",
 Cell[BoxData[
  FormBox["*", TraditionalForm]],ExpressionUUID->
  "e7fae4ac-f0d6-4b67-8ed1-ee0d370e30e2"],
 ", ",
 Cell[BoxData[
  FormBox["/", TraditionalForm]],ExpressionUUID->
  "f6302aa1-fd3d-4b3c-96c0-c333ef794678"],
 " and ",
 Cell[BoxData[
  FormBox["^", TraditionalForm]],ExpressionUUID->
  "54212cc1-e5fa-453d-b6a6-8ac63acd7be0"],
 " can be used with vectors as well as with scalars.\nThe multiplication ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "*", "v", "*"}], "..."}], TraditionalForm]],ExpressionUUID->
  "e586e126-5edb-4af7-a858-635e7ce92d3b"],
 " of vectors is usually interpreted as operation in an associative algebra. \
It may be, e.g., (super)symmetric product, composition of differential \
operators, and so on.\nThere are also defined operations of tensor \
multiplications ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "\[CircleTimes]", "v", "\[CircleTimes]"}], "..."}], 
   TraditionalForm]],ExpressionUUID->"1fdb5d95-8c49-4cad-8e52-8f8982187fcb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "**", "v", "**"}], "..."}], TraditionalForm]],ExpressionUUID->
  "4ed10504-9451-4a07-815b-f0f003134908"],
 " , exterior multiplication ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"u", "\[Wedge]", "v", "\[Wedge]"}], "..."}], TraditionalForm]],
  ExpressionUUID->"470f3151-2331-42b6-96a1-925a01a9fcbc"],
 ", tensor power  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", 
    RowBox[{"\[CircleTimes]", "n"}]], TraditionalForm]],ExpressionUUID->
  "d241344f-bc13-4c97-9faa-3e0f530a35d6"],
 ".\nOther operators available in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " may also be defined as vector operations."
}], "Text",
 CellTags->{
  "_sli_vect_op", 
   "b:0.1.0"},ExpressionUUID->"c02880a6-b8c8-400c-8799-de426f92baec"],

