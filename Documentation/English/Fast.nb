Cell[CellGroupData[{

Cell["Splitting vector lists and expressions", "Subsubsection",
 CellTags->{
  "_sli_tool_split", "c:17", 
   "b:0.1.2"},ExpressionUUID->"a102a98b-5db0-4bc2-ae44-49e58ff1edf7"],

Cell[TextData[{
 StyleBox["Splitting",
  FontSlant->"Italic"],
 " is used to divide large vector expressions into homogeneous parts (e.g., \
of the same weight or degree).\nA ",
 StyleBox["splitted sum", "Def"],
 " is the list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["key",
       FontSlant->"Italic"], "1"], "\[Rule]", 
     SubscriptBox[
      StyleBox["expr",
       FontSlant->"Italic"], "1"]}], ",", 
    RowBox[{
     SubscriptBox[
      StyleBox["key",
       FontSlant->"Italic"], "2"], "\[Rule]", 
     SubscriptBox[
      StyleBox["expr",
       FontSlant->"Italic"], "2"]}], ",", "..."}], "}"}]],ExpressionUUID->
  "4b1ac0ea-b992-464a-ac9b-fcc778a31758"],
 ", where the keys are all different and sorted in canonical order, and ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["expr",
    FontSlant->"Italic"], "i"]],ExpressionUUID->
  "057bdb7f-5e6f-4aa3-a073-fd3c53b9f6cd"],
 StyleBox["  ",
  FontSize->6],
 "are vector expressions.\nA ",
 StyleBox["splitted list", "Def"],
 " is an expression of the same form, where the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["expr",
    FontSlant->"Italic"], 
   StyleBox["i",
    FontSlant->"Italic"]]],ExpressionUUID->
  "eb5bf09b-4dea-4cd9-8ead-fbb222efa3a6"],
 StyleBox[" ",
  FontSize->6],
 " are lists of vectors."
}], "Text",
 CellChangeTimes->{{3.4232278450154705`*^9, 3.4232278476092*^9}},
 CellTags->{
  "_sli_tool_split", 
   "b:0.1.2"},ExpressionUUID->"354a5169-16c0-4f31-8e9d-0accf131f97c"],

